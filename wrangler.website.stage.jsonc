{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-e2ee-website",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "main": "./src/workers/site.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/e"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "MEASUREMENTS",
      "dataset": "open_e2ee_website"
    }
  ],
  "observability": {
    "enabled": true
  }
}
