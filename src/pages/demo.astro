---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { codeThemes } from '../lib/code-theme.mjs';
import { SCENARIOS } from '../lib/demo/scenarios/catalog.ts';
import { scenarioCode } from '../lib/demo/scenarios/source.ts';
import sdkManifest from '@open-e2ee/signal-protocol-sdk/package.json';

/*
 * The page where the SDK is asked to fail.
 *
 * The homepage panel shows the protocol working, which is the easy half: a
 * reader who has already decided to trust it learns nothing from watching a
 * sentence come back. What decides an adoption is the other half — what the
 * thing does when something goes wrong — and every project on the internet
 * answers that in prose. So this page answers it by running it, in the
 * reader's tab, against the installed package, and printing the receiving
 * device's own log rather than a description of what the log would say.
 *
 * Each scenario is a closed `<details>`, and that is what "opened" means in
 * the one event this page measures. It is also the shape the page needs as
 * more scenarios land: a list a reader can read the titles of, and open the
 * one they came for. The `id` is on the `<details>`, so `/demo#flip-a-byte`
 * both scrolls to the scenario and opens it.
 *
 * Nothing SDK-shaped is on this page's initial payload. The frontmatter's
 * imports reach the scenario catalogue, which holds words and a filename;
 * the module that boots two clients is fetched by a dynamic `import()` in the
 * run handler, the same discipline as the homepage panel (invariant 7).
 */

const scenarios = SCENARIOS.map((scenario) => ({
  ...scenario,
  code: scenarioCode(scenario),
  filename: scenario.source.replace(/^\.\//, ''),
}));

const title = 'Watch it fail closed';
const description =
  'Corrupt a message in transit and see what the Signal Protocol does about it, running in ' +
  'your own browser against the installed SDK.';
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="stack">
        <h1>{title}</h1>
        <p class="lede measure">
          Every library says it detects tampering. This page does it to itself: the scenarios
          below run the installed SDK in this tab, break something on purpose, and print what the
          receiving device said about it — its own log, unedited.
        </p>
        {/*
          Invariant 5, before the reader has run anything rather than after.
          The cryptography is the shipped cryptography; the infrastructure
          under it is not, and on a page whose whole subject is failure the
          reader has to know which failures are real ones.
        */}
        <p class="muted measure">
          Real protocol and real cryptography, simulated infrastructure — <code>inMemoryStore()</code
          >{' '}and <code>inMemoryRelay()</code> run in the browser, so every device and the relay
          are this machine. {sdkManifest.name}@{sdkManifest.version}.
        </p>
      </div>

      <div class="scenario-list">
        {
          scenarios.map((scenario) => (
            <details class="scenario" id={scenario.slug} data-scenario={scenario.slug}>
              <summary class="scenario-summary">
                <span class="scenario-title">{scenario.title}</span>
                <span class="scenario-expectation">{scenario.expectation}</span>
              </summary>

              <div class="scenario-body">
                {/*
                  Sliced out of the module the button imports, at build time.
                  This is not an excerpt written to look like the code — it is
                  the code, and `scenarioCode` throws rather than print an
                  empty block if the markers ever go missing.
                */}
                <div class="code-block">
                  <p class="code-filename">{scenario.filename}</p>
                  <Code
                    code={scenario.code}
                    lang="ts"
                    themes={codeThemes}
                    defaultColor={false}
                    role="group"
                    aria-label={`The program this scenario runs: ${scenario.title}`}
                  />
                </div>

                <div class="scenario-controls">
                  <button class="oe-button" type="button" data-scenario-run>
                    {scenario.action}
                  </button>
                  <p class="scenario-status" data-scenario-status role="status">
                    Nothing has run yet.
                  </p>
                </div>

                <div class="scenario-output" data-scenario-output hidden />

                <p class="scenario-link">
                  <a href={scenario.link.href} target="_blank" rel="noopener">
                    {scenario.link.label}
                  </a>
                </p>
              </div>
            </details>
          ))
        }
      </div>

      {/*
        The one part of this page that is not a scenario.

        A scenario is a program with a verdict, and this is a conversation
        with another window — no code block, no expectation line, and nothing
        for the run handler above to run. It is also the only section whose
        relay is website code rather than the SDK's, which D3 requires be
        said in the reader's own words rather than a footnote, so the label
        is the second paragraph rather than a note under the fold.
      */}
      <div class="two-tab stack">
        <h2>Open this page in a second tab</h2>
        <p class="measure">
          The scenarios above run both accounts in one tab. That is the honest way to show a
          failure — everything is in one screen and nothing is hidden — and the least convincing
          way to show a delivery, because a sentence travelling between two variables is a data
          structure, not a message. So this section boots one account here, on a local store only
          this tab can read, and reaches the other account through a <code>BroadcastChannel</code>.
          Two tabs, two stores, one relay. Type in either one.
        </p>
        <p class="muted measure">
          The channel is demo infrastructure: a <code>BroadcastChannel</code> implementation of the
          SDK's relay interface, written for this page and living in this site's source, not the
          SDK's. It carries what a relay carries — envelopes, public key material, and the calls a
          device makes to register itself and fetch a bundle. What one tab hands the other is
          printed below, field by field, as the relay stores it.
        </p>
        <div class="scenario-controls">
          <button class="oe-button" type="button" data-two-tab-connect>Connect this tab</button>
          <p class="scenario-status" data-two-tab-status role="status">Nothing has run yet.</p>
        </div>
        <div class="two-tab-session" data-two-tab-output hidden></div>
      </div>

      {/*
        The same invitation the homepage makes, on the page where it is worth
        more: this one runs a protocol failure and still has nothing to report
        to anybody. What it does send is one beacon saying which scenario was
        opened, which is why the sentence names it rather than claiming
        silence.
      */}
      <p class="muted measure">
        All of it runs here. The only thing this page sends is one beacon naming the scenario you
        opened — no message content, no sizes, no timings. Check the network tab.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  /*
   * What each scenario's button runs, keyed by the slug in the catalogue.
   *
   * The wiring below is generic — every `[data-scenario]` on the page gets the
   * same handler — but the program behind a button is not: each scenario has
   * its own runner and its own result to print. This is the one place that
   * knows which is which, and a slug the catalogue ships without an entry here
   * says so on the page rather than doing nothing.
   *
   * Each `import()` stays inside its own function so that pressing one button
   * fetches one scenario. The 713 KB of SDK behind them is shared, and Vite
   * hands the second scenario the chunks the first already pulled.
   *
   * The renderers come the same way, in parallel, for the same reason: nothing
   * a reader has not asked for belongs on this page's initial path, and what
   * the page says about a result is only needed once there is a result. All
   * three buttons pull the one render chunk, so the second press fetches
   * nothing new. That leaves this script holding the wiring alone — which is
   * all of it that runs before a press.
   */
  const PROGRAMS: Record<
    string,
    (output: HTMLElement, status: HTMLElement) => Promise<void>
  > = {
    'flip-a-byte': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../lib/demo/scenarios/flip-a-byte.ts'),
        import('../lib/demo/render.ts'),
      ]);
      status.textContent = 'Booting two devices, then corrupting a message…';
      render.renderFlipAByte(output, await scenario.runFlipAByte(), scenario.describePayload);
    },
    'add-a-second-device': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../lib/demo/scenarios/add-a-second-device.ts'),
        import('../lib/demo/render.ts'),
      ]);
      status.textContent = 'Booting two accounts, then linking a device onto one of them…';
      render.renderSecondDevice(
        output,
        await scenario.runAddASecondDevice(),
        scenario.describePayload,
      );
    },
    'run-out-of-prekeys': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../lib/demo/scenarios/run-out-of-prekeys.ts'),
        import('../lib/demo/render.ts'),
      ]);
      status.textContent = 'Spending the prekey stash, then opening a new conversation…';
      render.renderRunOutOfPreKeys(output, await scenario.runOutOfPreKeys(), scenario.describePayload);
    },
    'reinstall-a-device': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../lib/demo/scenarios/reinstall-a-device.ts'),
        import('../lib/demo/render.ts'),
      ]);
      status.textContent = 'Destroying the receiving device, then writing to it anyway…';
      render.renderReinstallADevice(
        output,
        await scenario.reinstallADevice(),
        scenario.describePayload,
      );
    },
  };

  /*
   * One handler for every scenario on the page, wired from the `<details>`
   * elements rather than from a list this file keeps. A scenario added to the
   * catalogue is a scenario this runs, with no second place to edit.
   */
  for (const element of document.querySelectorAll<HTMLDetailsElement>('[data-scenario]')) {
    wire(element);
  }

  function wire(scenario: HTMLDetailsElement) {
    const slug = scenario.dataset.scenario ?? '';
    const run = scenario.querySelector<HTMLButtonElement>('[data-scenario-run]');
    const status = scenario.querySelector<HTMLElement>('[data-scenario-status]');
    const output = scenario.querySelector<HTMLElement>('[data-scenario-output]');
    if (!run || !status || !output) return;

    /*
     * One beacon the first time this scenario is opened, carrying the slug and
     * nothing else. Once per scenario per page: a reader who closes a
     * scenario and opens it again has not looked at a second scenario, and
     * counting the toggle would measure fidgeting.
     */
    let measured = false;
    scenario.addEventListener('toggle', () => {
      if (!scenario.open || measured) return;
      measured = true;
      window.oeMeasure?.('scenario_opened', slug);
    });

    /* Arriving at `/demo#flip-a-byte` is asking for this scenario, so open it.
       The `toggle` above then measures it, which is correct: the reader asked
       for this one by name. */
    if (location.hash === `#${slug}`) scenario.open = true;

    const program = PROGRAMS[slug];
    if (!program) {
      /* Said out loud, on the scenario, rather than left as a button that does
         nothing: the catalogue ships this scenario, so the missing half is
         this page's. */
      status.textContent = 'No program is wired to this scenario, so there is nothing to run.';
      run.disabled = true;
      return;
    }

    let running = false;
    run.addEventListener('click', async () => {
      if (running) return;
      running = true;
      run.disabled = true;
      output.hidden = true;
      status.textContent = 'Loading the SDK…';

      try {
        /* The 713 KB the page has kept off its own payload, fetched now that
           the reader has asked for it. */
        await program(output, status);
        output.hidden = false;
        /* Every scenario boots its own devices and puts them away again, so
           this is true of all of them: nothing is reused between presses. */
        status.textContent = 'Done. Press it again and it runs again on new devices.';
      } catch (cause) {
        /* A scenario that cannot run says so in its own status line. There is
           no recorded fallback here as there is on the homepage: this page
           promises a live failure, and a recording of one would be worth
           nothing. */
        status.textContent =
          `This scenario could not run: ${cause instanceof Error ? cause.message : String(cause)}`;
        output.hidden = true;
      } finally {
        running = false;
        run.disabled = false;
      }
    });
  }

  /*
   * The two-tab section, on the same discipline as the buttons above: the SDK
   * and the relay arrive on the press, never on the page.
   *
   * One press per tab and no second one. The session behind it owns a device,
   * a subscription and a share of a channel, and a reader who pressed twice
   * would get a second account of the same name arguing with the first over
   * the same mail. So the button leaves once it has worked — it has nothing
   * left to offer — and comes back only if the connection failed.
   */
  wireTwoTab();

  function wireTwoTab() {
    const connect = document.querySelector<HTMLButtonElement>('[data-two-tab-connect]');
    const status = document.querySelector<HTMLElement>('[data-two-tab-status]');
    const output = document.querySelector<HTMLElement>('[data-two-tab-output]');
    if (!connect || !status || !output) return;

    let connecting = false;
    connect.addEventListener('click', async () => {
      if (connecting) return;
      connecting = true;
      connect.disabled = true;
      status.textContent = 'Loading the SDK…';

      try {
        const [twoTab, view] = await Promise.all([
          import('../lib/demo/two-tab.ts'),
          import('../lib/demo/two-tab-view.ts'),
        ]);
        status.textContent = 'Registering a device in this tab…';
        const session = await twoTab.startTwoTabSession();
        view.mountTwoTab(output, session, {
          setStatus: (text) => {
            status.textContent = text;
          },
        });
        output.hidden = false;
        connect.hidden = true;
        status.textContent =
          session.role === 'host'
            ? `Connected as ${session.me}, holding the relay. Open this page in one more tab.`
            : `Connected as ${session.me}, through the relay in the other tab.`;
      } catch (cause) {
        /* Same rule as a scenario: this page promises live cryptography, so a
           tab that could not boot one says why rather than showing a pane. */
        status.textContent =
          `This tab could not connect: ${cause instanceof Error ? cause.message : String(cause)}`;
        output.hidden = true;
        connecting = false;
        connect.disabled = false;
      }
    });
  }
</script>
