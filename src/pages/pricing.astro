<script>
  /*
   * The dialog's open state, and nothing else. The browser owns the focus
   * trap, Escape, the return of focus to the trigger that opened it, and the
   * inert page. Two triggers stand on the page, one in the table and one over
   * the compact list, and width shows one of them at a time. A
   * press on the backdrop reaches the dialog element itself and nothing inside
   * it, which is how it is told apart from a press on the content.
   */
  const dialog = document.querySelector<HTMLDialogElement>('[data-included]');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-included-trigger]');
  if (dialog && triggers.length) {
    for (const trigger of triggers) trigger.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-included-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
