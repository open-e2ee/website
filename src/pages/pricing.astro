---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Term from '../components/Term.astro';
import PlanValue from '../components/PlanValue.astro';
import {
  relayDevelopmentEnvironment,
  relayMeterDefinitions,
  relayPlans,
  relayProductionRetention,
} from '../data/relay-pricing.mjs';
import { startupTier, tiers } from '../data/pricing.mjs';
import { startAction, startPromise } from '../lib/site-navigation';
import { INCLUDED, NO_OVERAGE } from '../lib/relay-plan-values';
import {
  ACTIONS,
  BAND,
  BAND_HEAD,
  BAND_SURFACE,
  CONTAINER,
  DEFINITION_ROWS,
  LEAD,
  MEASURE,
  METADATA,
  TEXT_LINKS,
} from '../lib/recipes';

/*
 * The four self-service plans are the columns of one table, and what a plan
 * carries is its rows. A buyer arrives with a size in mind, reads the Relay
 * MAU row first because that is the meter every plan is sized by, and reads
 * down the column that fits it. The table holds the rows that differ by plan
 * and one row every plan shares, the SDK license, because a buyer with a
 * proprietary application asks whether the SDK's license reaches it before
 * asking how many users a plan carries. What else every plan shares opens from
 * one control in the head, described once rather than ticked four times, and
 * stays out of the way of the choice.
 *
 * The plans are the page. There is no hero above them: the head over the table
 * is the page's opening, a label, the heading, and a lead that says what the
 * team gets, and the table starts on the first screen.
 *
 * The table holds to 62rem. Below that the same rows render as one block per
 * plan, from the same data, and the other rendering leaves the document.
 */
const PLAN_TABLE = 'w-full table-fixed border-collapse text-[0.9375rem] [&_th]:text-left [&_th]:align-top [&_td]:align-middle';

/*
 * No scroll region around this table. It is full width and fixed layout inside
 * the container, and it leaves the document below 62rem, so it can never be
 * wider than its column; a scroll box here would be a tab stop that does
 * nothing. One did stand here, and it clipped the row tooltips and counted
 * their hidden boxes as scroll height, so the table scrolled against the page.
 */
const PLAN_TABLE_AT = 'max-[62rem]:hidden';

/* A column head is a stack: marker, name, price, note, action. */
const PLAN_HEAD = '[&>*+*]:mt-3';

/*
 * Every cell carries its own padding, so the tint on the marked column has an
 * inset on all four sides: the head starts under a 3px edge, the values sit a
 * gutter in from the tint's sides, and the last row that differs by plan
 * closes it with room to spare. The other heads carry the same edge in no
 * color, so every name sits on one baseline.
 */
const HEAD_CELL = `${PLAN_HEAD} border-t-[3px] px-4 pt-4 pb-6 font-normal`;
const ROW_HEAD = 'rule-t pr-4 font-medium text-text-1';
const ROW_UNIT = `${METADATA} mt-1 block text-text-3`;
const CELL = 'rule-t px-4 font-[family-name:var(--oe-metadata-font-family)] tabular-nums';

/*
 * The row a buyer decides by is set apart by size and room, not by color. Its
 * name is a step up from the other row names, and its values are a step up
 * again, in the weight the price above them carries, so the eye lands on the
 * price and then on this row before anything else in the table.
 */
const LEAD_HEAD = 'text-[1.0625rem]';
const LEAD_VALUE = 'text-[1.375rem] leading-[1.15] font-medium text-text-1';

const COMPACT = 'm-0 grid list-none grid-cols-2 gap-x-8 p-0 min-[62rem]:hidden max-[44rem]:grid-cols-1';

const COMPACT_PLAN = 'py-6 [&>*+*]:mt-3';

const COMPACT_ROWS = 'm-0 w-full text-[0.9375rem] [&>div]:flex [&>div]:justify-between [&>div]:gap-4 [&>div]:rule-t [&>div]:py-2';
const COMPACT_VALUE = 'm-0 text-right font-[family-name:var(--oe-metadata-font-family)] tabular-nums';
const COMPACT_LEAD = 'items-baseline text-[1.0625rem]';


/*
 * The head over the table is the page's hero: the heading, one sentence, and
 * the two actions, left-aligned on the edge the row names share, so one eye
 * line runs from the heading through the actions into the table. Centering
 * would set the actions over the Free and Starter columns and off the grid
 * that follows. The primary creates the project, at the full control height
 * the home and Relay heroes use, and carries its promise as the note inside
 * it; the secondary opens what every plan carries. The section opens the page, so it
 * carries the opening's room above and no rule: the site header draws the one
 * rule that belongs there.
 */
const PLANS = 'pt-[clamp(2.5rem,1.75rem+4vw,4.5rem)] pb-[clamp(3rem,2rem+4vw,5.5rem)]';
/* The lead runs the width of the table under it, not the recipe's measure. */
const PLANS_LEAD = 'max-w-none';
const PLANS_HEAD = 'mb-10 text-center [&>*+*]:mt-4';
const PLANS_ACTIONS = 'justify-center mt-8!';
const PLANS_PRIMARY = 'oe-button oe-button-large oe-button-stacked';

/*
 * What every plan carries opens in a dialog, one card per capability, so the
 * table keeps its space for what differs by plan. The trigger is the hero's
 * secondary action, beside the primary that creates the project, at every
 * width. The dialog is the native element that traps
 * focus, closes on Escape, returns focus to the trigger, and makes the page
 * behind it inert, and it is the surface above the page plane DESIGN.md gives
 * the popover shadow and its inset ring. The page behind it stays visible
 * through a clear backdrop: overlap occludes, it never blends, so there is no
 * half-transparent scrim. A press on the backdrop closes it; the content sits
 * in its own box so a press on the padding does not. Each card is a hairline
 * on the panel ground, and the set is a definition list, a term over what it
 * means, because these are not tiers and carry no heading. Nine cards sit
 * three across, so the deck reads as one grid, and each leads with a chrome
 * icon from the design package so a reader scanning the deck finds a card by
 * its shape before its words. None is a padlock or a shield.
 */
const INCLUDED_TRIGGER = 'oe-button oe-button-secondary oe-button-large';
const INCLUDED_DIALOG =
  'm-auto w-[min(60rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] overflow-y-auto border-0 bg-ground-raised p-0 text-text-1 ' +
  'shadow-[var(--oe-shadow-md),inset_0_0_0_1px_var(--oe-border-1)] backdrop:bg-transparent';
const INCLUDED_BODY = 'p-6 max-[34rem]:p-4';
const INCLUDED_HEAD = 'mb-6 flex items-start justify-between gap-4';
const INCLUDED_TITLE = 'm-0 text-[1.25rem] leading-tight font-semibold tracking-[var(--oe-heading-tracking-display)] text-text-1';
const INCLUDED_LEAD = 'mt-2 text-[0.9375rem] text-text-3';
const INCLUDED_CARDS = 'm-0 grid grid-cols-3 gap-3 [--oe-icon-size:1rem] max-[48rem]:grid-cols-2 max-[34rem]:grid-cols-1';
const INCLUDED_CARD = 'rule bg-ground-panel px-5 py-4';
const INCLUDED_CARD_TITLE = 'm-0 flex items-center gap-2 text-[0.9375rem] font-medium text-text-1';
const INCLUDED_CARD_ICON = 'shrink-0 text-text-3';
const INCLUDED_CARD_DETAIL = 'm-0 mt-1 text-[0.9375rem] leading-[1.5] text-text-3';

/*
 * The Development environment and the licenses are ruled rows: a name and
 * price on the left, what it carries and its action on the right. Enterprise
 * takes the same grid inside one outlined band under the table, so the fifth
 * plan reads as the table's last row and not as a footnote.
 */
const TIERS = 'm-0 list-none p-0';

const TIER_GRID =
  'grid grid-cols-[minmax(12rem,1fr)_minmax(0,2fr)] items-start gap-6 max-[58rem]:grid-cols-1 max-[58rem]:gap-4';

const TIER = `${TIER_GRID} rule-t py-8`;

const ENTERPRISE_BAND = `${TIER_GRID} mt-8 rule bg-ground-panel px-6 py-6 max-[34rem]:px-4`;

const TIER_NAME = 'flex flex-col items-start gap-2';

/*
 * The price is the largest thing in a column or a row, and the name reads as
 * its label. A pricing page answers the price question first.
 */
const TIER_HEADING = 'text-[1.0625rem] leading-tight font-semibold text-text-1';

const TIER_PRICE =
  'font-[family-name:var(--oe-metadata-font-family)] ' +
  'text-[clamp(1.875rem,1.5rem+1.2vw,2.5rem)] leading-none font-medium ' +
  'tracking-[var(--oe-metadata-tracking)] text-text-1';

const TIER_NOTE = `${METADATA} text-text-3`;

/*
 * One plan carries the label and the filled action; the founder chose Starter
 * on 2026-09-07 (`docs/decisions.md`). Its table column is tinted, and the
 * label sits in the color this site uses where something is settled. The other
 * columns carry the same element with no text, so every name sits on one
 * baseline.
 */
const HIGHLIGHT = 'relay_starter_v1';
const HIGHLIGHT_LABEL = 'Most popular';
const PLAN_MARK = `${METADATA} min-h-[1lh] text-[var(--oe-sealed)]`;

const TIER_BODY = 'flex max-w-[58ch] flex-col items-start gap-3 text-text-3';

/*
 * Every self-service plan opens the Console route that creates a project,
 * because a production plan is activated inside a project. A paid plan names
 * itself in the query so the Console can offer that plan first once the
 * project exists. The highlighted plan is the filled action; the others are
 * secondary, and every one of them opens the same route. Every action carries
 * the plan's name and nothing else; "Start with Starter" stuttered, and the
 * name under the name already says what pressing it picks. Free is the one
 * plan that costs nothing, so its action is the strong secondary, the frame in
 * the foreground: it reads apart from the paid secondaries, and the filled
 * control stays the one accent in the row.
 */
const RELAY_PROJECT = startAction.href;

type Plan = (typeof relayPlans)[number];

const FREE = 'relay_free_v1';

const selfServe = relayPlans.filter((plan) => plan.monthlyPriceUsd !== null);
const enterprise = relayPlans.find((plan) => plan.monthlyPriceUsd === null);
if (!enterprise) throw new Error('pricing.astro: the Relay catalog has no negotiated plan');

const startHref = (plan: Plan) => (plan.id === FREE ? RELAY_PROJECT : `${RELAY_PROJECT}?plan=${plan.id}`);
const startLabel = (plan: Plan) => plan.name;
const planMark = (plan: Plan) => (plan.id === HIGHLIGHT ? HIGHLIGHT_LABEL : '');
const startClasses = (plan: Plan) => [
  'oe-button',
  'oe-button-full',
  plan.id !== HIGHLIGHT && 'oe-button-secondary',
  plan.id === FREE && 'oe-button-strong',
];

/* The marked column: a sealed edge over the head, and the panel ground down
 * every row that differs by plan. */
const marked = (plan: Plan) => plan.id === HIGHLIGHT;
const headClasses = (plan: Plan) => [HEAD_CELL, marked(plan) ? 'border-t-[var(--oe-sealed)] bg-ground-panel' : 'border-t-transparent'];
const compactPlanClasses = (plan: Plan) => [
  COMPACT_PLAN,
  marked(plan) ? '-mx-4 border-t-[3px] border-t-[var(--oe-sealed)] bg-ground-panel px-4' : 'rule-t',
];

const ENTERPRISE_ACTION = {
  href: 'mailto:licensing@open-e2ee.dev?subject=OpenE2EE%20Relay%20Enterprise%20plan',
  label: 'Ask about Enterprise',
};

/*
 * The rows that differ by plan. Monthly active users lead, because that is the
 * count a buyer sizes a plan by, and its overage sits directly under it so the
 * two numbers a buyer does arithmetic on are read together. Every row is named
 * by what the plan provides, with the meter that counts it as the unit under
 * the name, and each name defines itself on hover. Delivery and storage
 * overage price the same on every paid plan, so they are the note under the
 * table rather than two rows of one repeated figure. Allowances are monthly,
 * which the same note says once; the price under each name already reads
 * "per month". Free has no overage, so its overage cell reads as the cap it is.
 * Retention is the same on every plan, so it sits with what every plan carries.
 *
 * The last row is the one every plan shares, the founder's 2026-09-08 call:
 * the project commercial SDK license in section 4 of the Relay service terms.
 * The meters do not answer whether the SDK's AGPL reaches a proprietary
 * application, and that is the question a buyer asks before sizing. Every plan
 * carries the license, Free included, so every cell is the check, and the
 * definition repeats the grant's limits so the row promises nothing the terms
 * do not.
 */
const define = (name: string) => {
  const meter = relayMeterDefinitions.find((entry) => entry.name === name);
  if (!meter) throw new Error(`pricing.astro: the catalog defines no meter named ${name}`);
  return meter.definition;
};

type Row = { label: string; tail?: string; definition: string; unit?: string; lead?: boolean; value: (plan: Plan) => string };
const rows: Row[] = [
  { label: 'Monthly Active Users', tail: '(MAU)', lead: true, definition: define('Relay MAU'), value: (plan) => plan.relayMau },
  {
    label: 'Additional MAU',
    unit: '$ per MAU',
    definition: 'Each Relay MAU beyond the plan allowance in a month, charged only once overage is on. Free has no overage and stops at its cap.',
    value: (plan) => plan.overage?.relayMau ?? NO_OVERAGE,
  },
  { label: 'Message Delivery', unit: 'Delivery Units', definition: define('Delivery unit'), value: (plan) => plan.deliveryUnits },
  { label: 'Encrypted Attachments', unit: 'Attachment Uploads', definition: define('Attachment upload'), value: (plan) => plan.attachmentOperations },
  { label: 'Encrypted Storage', definition: define('Storage'), value: (plan) => plan.storage },
  {
    label: 'SDK Commercial License',
    definition:
      'Use @open-e2ee/signal-protocol-sdk in one proprietary application that connects to the project, for as long as the project is active. Every plan carries it, Free included. It grants no self-hosting right and no right to redistribute the SDK.',
    value: () => INCLUDED,
  },
];

/* The compact list has one line per row, so the tail joins the label. */
const compactLabel = (row: Row) => [row.label, row.tail].filter(Boolean).join(' ');
const rowId = (row: Row, scope: string) => `${scope}-${row.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

/* The lead row has room around it; the last row closes the tint. */
const rowPadding = (row: Row, index: number) => (row.lead ? ['pt-5', 'pb-4'] : ['pt-3', index === rows.length - 1 ? 'pb-6' : 'pb-3']);
const rowHeadClasses = (row: Row, index: number) => [ROW_HEAD, ...rowPadding(row, index), row.lead && LEAD_HEAD];
const cellClasses = (row: Row, index: number, plan: Plan) => [
  CELL,
  ...rowPadding(row, index),
  row.lead ? LEAD_VALUE : 'text-text-3',
  marked(plan) && 'bg-ground-panel',
];
const compactRowClasses = (row: Row) => (row.lead ? COMPACT_LEAD : undefined);
const compactLabelClasses = (row: Row) => (row.lead ? 'text-text-1' : 'text-text-3');
const compactValueClasses = (row: Row) => [COMPACT_VALUE, row.lead ? LEAD_VALUE : 'text-text-1'];

/*
 * What every plan carries, one card per relay capability, each in the words
 * the relay's own routes and concepts use. These do not differ by plan, so
 * the whole set opens in one dialog rather than taking the table's space.
 */
const included: { icon: IconName; label: string; detail: string }[] = [
  {
    icon: 'send',
    label: 'Encrypted delivery',
    detail: 'Durable encrypted device mailboxes, pull or a live connection, acknowledgment, retry requests, and bounded fan-out.',
  },
  {
    icon: 'key',
    label: 'Keys and sessions',
    detail: 'Identity key and prekey distribution, post-quantum ML-KEM prekeys included, with stale-key cleanup.',
  },
  { icon: 'unseen', label: 'Sealed sender', detail: 'Sender certificates, access keys, and unidentified delivery to devices and groups.' },
  {
    icon: 'people',
    label: 'Zero-knowledge groups',
    detail: 'Group send credentials, signed encrypted group revisions, fan-out status, and group recovery.',
  },
  {
    icon: 'device',
    label: 'Multi-device',
    detail: 'Device registration and linking, device authorization, account recovery, identity migration, and account deletion.',
  },
  {
    icon: 'attachment',
    label: 'Encrypted attachments',
    detail: 'Private encrypted attachment storage with authorized upload, download, and deletion.',
  },
  {
    icon: 'clock',
    label: 'Ciphertext retention',
    detail: `${relayProductionRetention} in device mailboxes and attachment storage before ciphertext expires. A project can set a shorter retention.`,
  },
  {
    icon: 'pulse',
    label: 'Push wakes and operations',
    detail: 'Push wakes, exact usage, quotas, capacity, lifecycle controls, and recovery drills.',
  },
  { icon: 'terminal', label: 'Development environment', detail: 'One with every project, at no cost and without a card.' },
];
const INCLUDED_HEADING = 'Included on every plan';
const INCLUDED_ID = 'included-on-every-plan';
const INCLUDED_ACTION = 'See what is included';

/* The note under the table prices delivery and storage overage once, which
 * holds only while every paid plan prices them the same. */
const overageRates = (key: 'delivery' | 'storage') => {
  const rates = new Set(selfServe.flatMap((plan) => (plan.overage ? [plan.overage[key]] : [])));
  if (rates.size !== 1) throw new Error(`pricing.astro: paid plans price ${key} overage ${rates.size} ways; the note under the table states one`);
  return [...rates][0];
};
const deliveryOverage = overageRates('delivery');
const storageOverage = overageRates('storage');

const licenseHeading = (tier: (typeof tiers)[number]) =>
  /license/i.test(tier.name) ? tier.name : `${tier.name} license`;
---

<BaseLayout
  title="Pricing"
  description={`OpenE2EE Relay plans from Free through Starter, Growth, Business, and Enterprise, with every meter and overage rate, and SDK commercial licensing from ${startupTier.price} per year.`}
  canonical="/pricing"
>
  <section id="relay-plans" class={PLANS}>
    <div class={CONTAINER}>
      <div class={PLANS_HEAD} data-plans-head>
        <h1>Free to start, pricing that scales.</h1>
        <p class:list={[LEAD, PLANS_LEAD]}>Ship fully featured end-to-end encrypted messaging, securely, and at scale.</p>
        <div class:list={[ACTIONS, PLANS_ACTIONS]} data-actions="pricing">
          <a class={PLANS_PRIMARY} href={RELAY_PROJECT}>{startAction.label}{' '}<span class="oe-button-note">{startPromise}</span></a>
          <button type="button" class={INCLUDED_TRIGGER} aria-haspopup="dialog" data-included-trigger>{INCLUDED_ACTION}</button>
        </div>
      </div>
      <div class={PLAN_TABLE_AT}>
        <table class={PLAN_TABLE} itemscope itemtype="https://schema.org/Product">
          <caption class="oe-visually-hidden" itemprop="name">OpenE2EE Relay plans, monthly prices, allowances, and what every plan includes</caption>
          <colgroup><col class="w-[15rem]" />{selfServe.map(() => <col />)}</colgroup>
          <thead>
            <tr>
              <td class="pr-4"></td>
              {selfServe.map((plan) => (
                <th scope="col" class:list={headClasses(plan)} data-relay-plan={plan.id} itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <meta itemprop="priceCurrency" content="USD" />
                  <meta itemprop="price" content={String(plan.monthlyPriceUsd)} />
                  <p class={PLAN_MARK}>{planMark(plan)}</p>
                  <h3 class={TIER_HEADING} itemprop="name">{plan.name}</h3>
                  <p class={TIER_PRICE}>{plan.price}</p>
                  <p class={TIER_NOTE}>per month</p>
                  <a class:list={startClasses(plan)} href={startHref(plan)}>{startLabel(plan)}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, index) => (
              <tr>
                <th scope="row" class:list={rowHeadClasses(row, index)}>
                  <Term id={rowId(row, 'table')} label={row.label} tail={row.tail} definition={row.definition} />
                  {row.unit && <span class={ROW_UNIT}>{row.unit}</span>}
                </th>
                {selfServe.map((plan) => <td class:list={cellClasses(row, index, plan)}><PlanValue value={row.value(plan)} /></td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class={COMPACT}>
        {selfServe.map((plan) => (
          <li class:list={compactPlanClasses(plan)} data-relay-plan-compact={plan.id}>
            <p class={PLAN_MARK}>{planMark(plan)}</p>
            <h3 class={TIER_HEADING}>{plan.name}</h3>
            <p class={TIER_PRICE}>{plan.price}</p>
            <p class={TIER_NOTE}>per month</p>
            <a class:list={startClasses(plan)} href={startHref(plan)}>{startLabel(plan)}</a>
            <dl class={COMPACT_ROWS}>
              {rows.map((row) => (
                <div class:list={compactRowClasses(row)}>
                  <dt class={compactLabelClasses(row)}><Term id={rowId(row, plan.id)} label={compactLabel(row)} definition={row.definition} /></dt>
                  <dd class:list={compactValueClasses(row)}><PlanValue value={row.value(plan)} /></dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
      <dialog class={INCLUDED_DIALOG} aria-labelledby={INCLUDED_ID} data-included>
        <div class={INCLUDED_BODY}>
          <div class={INCLUDED_HEAD}>
            <div>
              <h2 id={INCLUDED_ID} class={INCLUDED_TITLE}>{INCLUDED_HEADING}</h2>
              <p class={INCLUDED_LEAD}>Every plan carries all of these, Free included. Paid plans add capacity and optional overage.</p>
            </div>
            <button type="button" class="oe-icon-button" aria-label="Close" data-included-close><Icon name="close" /></button>
          </div>
          <dl class={INCLUDED_CARDS}>
            {included.map((item) => (
              <div class={INCLUDED_CARD}>
                <dt class={INCLUDED_CARD_TITLE}><Icon name={item.icon} class={INCLUDED_CARD_ICON} />{item.label}</dt>
                <dd class={INCLUDED_CARD_DETAIL}>{item.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </dialog>
      <div class={ENTERPRISE_BAND} data-relay-plan={enterprise.id}>
        <div class={TIER_NAME}>
          <h3 class={TIER_HEADING}>{enterprise.name}</h3>
          <p class={TIER_PRICE}>{enterprise.price}</p>
          <p class={TIER_NOTE}>Negotiated</p>
        </div>
        <div class={TIER_BODY}>
          <p>{enterprise.detail} Every Relay protocol feature, as on every other plan.</p>
          <p class={ACTIONS}>
            <a class="oe-button oe-button-secondary" href={ENTERPRISE_ACTION.href}>{ENTERPRISE_ACTION.label}</a>
          </p>
        </div>
      </div>
      <p class:list={['mt-8', MEASURE]}>Prefer to operate the delivery layer yourself? The SDK is free under AGPLv3. Self-hosting it inside a proprietary product takes an <a href="#licensing">SDK commercial license</a>, from {startupTier.price} per year, and a Relay plan grants no self-hosting rights.</p>
      <p class:list={['mt-4 text-text-3', MEASURE]}>Prices and allowances are monthly, and taxes can apply. Once overage is on, additional delivery units are {deliveryOverage} and additional storage is {storageOverage} on every paid plan. Attachment uploads are a hard cap on every plan, and Free stops at every cap. The <a href="/legal/relay-terms">Relay service terms</a> control a managed project.</p>
      <p class:list={['mt-4', TEXT_LINKS]}><a href="/relay">What Relay operates</a><a href="/compare/virgil-security">Compare with Virgil Security</a></p>
    </div>
  </section>

  <section id="development" class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>Included with every project</h2>
        <p class={MEASURE}>The Development environment is separate from the production plan. It uses isolated state, credentials, limits, and lifecycle controls, and it is not a production plan.</p>
      </div>
      <ul class={TIERS}>
        <li class={TIER}>
          <div class={TIER_NAME}>
            <h3 class={TIER_HEADING}>Development environment</h3>
            <p class={TIER_PRICE}>Included</p>
            <p class={TIER_NOTE}>No card</p>
          </div>
          <div class={TIER_BODY}>
            <p>{relayDevelopmentEnvironment.relayMau}, {relayDevelopmentEnvironment.deliveryUnits} delivery units and {relayDevelopmentEnvironment.attachmentOperations} attachment uploads per month, and {relayDevelopmentEnvironment.storage} storage.</p>
            <p class={TIER_NOTE}>{relayDevelopmentEnvironment.detail}</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section id="meters" class={BAND}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>What the meters count</h2>
        <p class={MEASURE}>The four meters the table counts, defined the way the Relay service terms define them.</p>
      </div>
      <dl class={DEFINITION_ROWS}>{relayMeterDefinitions.map((meter) => <div><dt>{meter.name}</dt><dd>{meter.definition}</dd></div>)}</dl>
    </div>
  </section>

  <section id="licensing" class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>SDK commercial licensing</h2>
