---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Term from '../components/Term.astro';
import PlanValue from '../components/PlanValue.astro';
import {
  relayMeterDefinitions,
  relayPlans,
  relayProductionRetention,
} from '../data/relay-pricing.mjs';
import { startupTier, tiers } from '../data/pricing.mjs';
import { startAction, startPromise } from '../lib/site-navigation';
import { INCLUDED, NO_OVERAGE } from '../lib/plan-values.mjs';
import {
  ACTIONS,
  BAND,
  BAND_HEAD,
  BAND_SURFACE,
  CONTAINER,
  LEAD,
  MEASURE,
  METADATA,
} from '../lib/recipes';

/*
 * The four self-service plans are the columns of one table, and what a plan
 * carries is its rows. A buyer arrives with a size in mind, reads the Relay
 * MAU row first because that is the meter every plan is sized by, and reads
 * down the column that fits it. The table holds the rows that differ by plan
 * and one row every plan shares, the SDK license, because a buyer with a
 * proprietary application asks whether the SDK's license reaches it before
 * asking how many users a plan carries. What else every plan shares stands in
 * its own section under the plans, one card per capability, described once
 * rather than ticked four times, so the reader chooses before reading it.
 *
 * The plans are the page. There is no hero above them: the head over the table
 * is the page's opening, a label, the heading, and a lead that says what the
 * team gets, and the table starts on the first screen.
 *
 * The table holds to 62rem. Below that the same rows render as one block per
 * plan, from the same data, and the other rendering leaves the document.
 */
const PLAN_TABLE = 'w-full table-fixed border-collapse text-[0.9375rem] [&_th]:text-left [&_th]:align-top [&_td]:align-middle';

/*
 * No scroll region around this table. It is full width and fixed layout inside
 * the container, and it leaves the document below 62rem, so it can never be
 * wider than its column; a scroll box here would be a tab stop that does
 * nothing. One did stand here, and it clipped the row tooltips and counted
 * their hidden boxes as scroll height, so the table scrolled against the page.
 */
const PLAN_TABLE_AT = 'max-[62rem]:hidden';

/* A column head is a stack: marker, name, price, note. The action stands in
 * the foot, under every row, so a reader chooses after reading what each plan
 * holds; the founder's 2026-09-08 call. The foot's corner is empty, like the
 * head's: the buttons need no instruction. */
const PLAN_HEAD = '[&>*+*]:mt-3';

/*
 * Every cell carries its own padding, so the tint on the marked column has an
 * inset on all four sides: the head starts under a 3px edge, the values sit a
 * gutter in from the tint's sides, and the foot cell that carries the action
 * closes it with room to spare. The other heads carry the same edge in no
 * color, so every name sits on one baseline.
 */
const HEAD_CELL = `${PLAN_HEAD} border-t-[3px] px-4 pt-4 pb-4 font-normal`;

/*
 * The corner of the Relay table names it, the founder's 2026-09-09 call: the
 * name stands in the head's empty corner, at the top of the head row, in the
 * size a plan name takes, so it reads as the table's name and not as a fifth
 * column. It carries no top padding and no edge, so it floats at the table's
 * top, above the plan heads' first line, the founder's 2026-09-09 call.
 * The narrow rendering has no corner, so the name stands over the blocks.
 */
const TABLE_NAME = 'Signal Protocol Relay';
const CORNER = 'pr-4 pt-0 pb-4 align-top text-[1.25rem] leading-tight font-semibold text-text-1';
const COMPACT_NAME = 'm-0 pt-2 text-[1.25rem] leading-tight font-semibold text-text-1 min-[62rem]:hidden';
const FOOT_CELL = 'rule-t px-4 py-5';
const ROW_HEAD = 'rule-t pr-4 font-medium text-text-1';
const CELL = 'rule-t px-4 font-[family-name:var(--oe-metadata-font-family)] tabular-nums';

/*
 * The row a buyer decides by is set apart by size and room, not by color. Its
 * name is a step up from the other row names, and its values are a step up
 * again, in the weight the price above them carries, so the eye lands on the
 * price and then on this row before anything else in the table.
 */
const LEAD_HEAD = 'text-[1.0625rem]';
const LEAD_VALUE = 'text-[1.375rem] leading-[1.15] font-medium text-text-1';

const COMPACT = 'm-0 grid list-none grid-cols-2 gap-x-8 p-0 min-[62rem]:hidden max-[44rem]:grid-cols-1';

const COMPACT_PLAN = 'py-6 [&>*+*]:mt-3';

/* The action closes the block the way the foot closes the table. */
const COMPACT_ACTION = 'mt-5!';
const COMPACT_ROWS = 'm-0 w-full text-[0.9375rem] [&>div]:flex [&>div]:justify-between [&>div]:gap-4 [&>div]:rule-t [&>div]:py-2';
const COMPACT_VALUE = 'm-0 text-right font-[family-name:var(--oe-metadata-font-family)] tabular-nums';
const COMPACT_LEAD = 'items-baseline text-[1.0625rem]';


/*
 * The head over the table is the page's hero: the heading, one sentence, and
 * the two actions, left-aligned on the edge the row names share, so one eye
 * line runs from the heading through the actions into the table. Centering
 * would set the actions over the Free and Starter columns and off the grid
 * that follows. The primary creates the project, at the full control height
 * the home and Relay heroes use, and carries its promise as the note inside
 * it; the secondary leads down to what every plan carries. The section opens the page, so it
 * carries the opening's room above and no rule: the site header draws the one
 * rule that belongs there.
 */
const PLANS = 'pt-[clamp(2.5rem,1.75rem+4vw,4.5rem)] pb-[clamp(3rem,2rem+4vw,5.5rem)]';
/* The lead runs the width of the table under it, not the recipe's measure. */
const PLANS_LEAD = 'max-w-none';
const PLANS_HEAD = 'mb-10 text-center [&>*+*]:mt-4';
const PLANS_ACTIONS = 'justify-center mt-8!';
const PLANS_PRIMARY = 'oe-button oe-button-large oe-button-stacked';

/*
 * What every plan carries stands in its own section under the plans, one card
 * per capability, so the table keeps its space for what differs by plan and
 * the reader chooses a plan before reading what all of them share; the
 * founder's 2026-09-08 call, in place of the dialog the hero used to open. The
 * hero's secondary action, beside the primary that creates the project, is
 * the link down to it. Each card is a hairline on the panel ground, and the
 * set is a definition list, a term over what it means, because these are not
 * tiers and carry no heading. Nine cards sit three across, so the deck reads
 * as one grid, and each leads with a chrome icon from the design package so a
 * reader scanning the deck finds a card by its shape before its words. None
 * is a padlock or a shield.
 *
 * A card answers the pointer the way the design package's controls do: it
 * lifts by two pixels, takes the hover ground and the stronger edge, casts the
 * elevation shadow, and its icon comes forward from the muted text to the
 * foreground. Every part is a transition on the package's durations, so under
 * reduced motion it collapses with them, and the lift itself is off there:
 * the hovered card changes ground and edge, and nothing moves. Nothing fades,
 * and no card animates on its own; a card that is not under the pointer is
 * still.
 */
const INCLUDED_TRIGGER = 'oe-button oe-button-secondary oe-button-large';
const INCLUDED_CARDS = 'm-0 grid grid-cols-3 gap-4 [--oe-icon-size:1.125rem] max-[48rem]:grid-cols-2 max-[34rem]:grid-cols-1';
const INCLUDED_CARD =
  'group rule bg-ground-panel px-5 py-5 transition-[transform,box-shadow,border-color,background-color] duration-[var(--oe-duration-normal)] ease-out ' +
  'hover:-translate-y-0.5 hover:border-border-2 hover:bg-ground-hover hover:shadow-[var(--oe-shadow-md)] motion-reduce:hover:translate-y-0';
const INCLUDED_CARD_TITLE = 'm-0 flex items-center gap-2.5 text-[1rem] font-medium text-text-1';
const INCLUDED_CARD_ICON = 'shrink-0 text-text-3 transition-[color] duration-[var(--oe-duration-normal)] ease-out group-hover:text-text-1';
const INCLUDED_CARD_DETAIL = 'm-0 mt-2 text-[0.9375rem] leading-[1.5] text-text-3';

/*
 * The licenses are a second table in the shape of the first, the founder's
 * 2026-09-09 call: one column per license in catalog order, one row per right
 * that differs by license, and the action in the foot. The narrow rendering
 * makes the blocks the plans make, on the same grid: three across would push
 * the last column's definitions past a 48rem window. No column is marked; the
 * entry license carries the filled action.
 */
const LICENSE_HEAD = `${HEAD_CELL} border-t-transparent`;

/*
 * Enterprise is one outlined band under the table, so the fifth plan reads as
 * the table's last row and not as a footnote. The founder's 2026-09-09 call:
 * the band is one row as tall as its button plus padding, close under the
 * table. Name and detail sit on the button's centerline, and the actions keep
 * to the end: a subdued link down to the SDK licenses, then the action. The
 * link is the secondary control in the muted text, so it reads a step behind
 * the action beside it. The band prints no price: "Custom" is not one, and it
 * outsized the name. Under 34rem the row wraps and the actions take a line of
 * their own.
 */
const ENTERPRISE_BAND = 'mt-4 flex flex-wrap items-center gap-x-5 gap-y-3 rule bg-ground-panel px-5 py-3 max-[34rem]:px-4';

const ENTERPRISE_DETAIL = 'm-0 text-[0.9375rem] text-text-3';

const ENTERPRISE_LINK_CLASS = 'oe-button oe-button-secondary ms-auto text-text-3! hover:text-text-1! max-[34rem]:ms-0';
const ENTERPRISE_ACTION_CLASS = 'oe-button oe-button-secondary';
const ENTERPRISE_LINK = { href: '#licensing', label: 'SDK commercial licenses' };

/*
 * The price is the largest thing in a column or a row, and the name reads as
 * its label. A pricing page answers the price question first.
 */
const TIER_HEADING = 'text-[1.25rem] leading-tight font-semibold text-text-1';

const TIER_PRICE =
  'font-[family-name:var(--oe-metadata-font-family)] ' +
  'text-[clamp(1.875rem,1.5rem+1.2vw,2.5rem)] leading-none font-medium ' +
  'tracking-[var(--oe-metadata-tracking)] text-text-1';

const TIER_NOTE = `${METADATA} text-text-3`;

/*
 * One plan carries the label and the filled action; the founder chose Starter
 * on 2026-09-07 (`docs/decisions.md`). Its table column is tinted, and the
 * label sits in the color this site uses where something is settled. The other
 * columns carry the same element with no text, so every name sits on one
 * baseline.
 */
const HIGHLIGHT = 'relay_starter_v1';
const HIGHLIGHT_LABEL = 'Most popular';
const PLAN_MARK = `${METADATA} min-h-[1lh] text-[var(--oe-sealed)]`;

/*
 * Every self-service plan opens the Console route that creates a project,
 * because a production plan is activated inside a project. A paid plan names
 * itself in the query so the Console can offer that plan first once the
 * project exists. The highlighted plan is the filled action; the others are
 * secondary, and every one of them opens the same route. Each action carries
 * the label the founder chose for it on 2026-09-08 (`docs/messaging.md`); the
 * plan keeps its name in the heading over the column, and the label under the
 * rows is the invitation. Free is the one plan that costs nothing, so its
 * action is the strong secondary, the frame in the foreground: it reads apart
 * from the paid secondaries, and the filled control stays the one accent in
 * the row.
 */
const RELAY_PROJECT = startAction.href;

type Plan = (typeof relayPlans)[number];

const FREE = 'relay_free_v1';

const selfServe = relayPlans.filter((plan) => plan.monthlyPriceUsd !== null);
const enterprise = relayPlans.find((plan) => plan.monthlyPriceUsd === null);
if (!enterprise) throw new Error('pricing.astro: the Relay catalog has no negotiated plan');

const startHref = (plan: Plan) => (plan.id === FREE ? RELAY_PROJECT : `${RELAY_PROJECT}?plan=${plan.id}`);
const ACTION_LABEL: Record<string, string> = {
  relay_free_v1: 'Fun & Free',
  relay_starter_v1: 'Startup Starter',
  relay_growth_v1: 'Get Growing',
  relay_business_v1: 'Big Business',
};
const startLabel = (plan: Plan) => {
  const label = ACTION_LABEL[plan.id];
  if (!label) throw new Error(`pricing.astro: no action label for the ${plan.id} plan`);
  return label;
};
const planMark = (plan: Plan) => (plan.id === HIGHLIGHT ? HIGHLIGHT_LABEL : '');
const startClasses = (plan: Plan) => [
  'oe-button',
  'oe-button-full',
  plan.id !== HIGHLIGHT && 'oe-button-secondary',
  plan.id === FREE && 'oe-button-strong',
];

/* The marked column: a sealed edge over the head, and the panel ground down
 * every row that differs by plan. */
const marked = (plan: Plan) => plan.id === HIGHLIGHT;
const headClasses = (plan: Plan) => [HEAD_CELL, marked(plan) ? 'border-t-[var(--oe-sealed)] bg-ground-panel' : 'border-t-transparent'];
const footClasses = (plan: Plan) => [FOOT_CELL, marked(plan) && 'bg-ground-panel'];
const compactPlanClasses = (plan: Plan) => [
  COMPACT_PLAN,
  marked(plan) ? '-mx-4 border-t-[3px] border-t-[var(--oe-sealed)] bg-ground-panel px-4' : 'rule-t',
];

const ENTERPRISE_ACTION = {
  href: 'mailto:licensing@open-e2ee.dev?subject=OpenE2EE%20Relay%20Enterprise%20plan',
  label: 'Ask about Enterprise',
};

/*
 * The rows that differ by plan. Monthly active users lead, because that is the
 * count a buyer sizes a plan by, and its overage sits directly under it so the
 * two numbers a buyer does arithmetic on are read together. Every row is named
 * by what the plan provides, in the founder's words of 2026-09-08, with no
 * unit line under it, and each name defines itself on hover. Delivery and storage
 * overage price the same on every paid plan, so each is a sentence in the
 * definition of its row rather than a row of one repeated figure. Allowances
 * are monthly, which the price under each name already reads as "per month".
 * Free has no overage, so its overage cell reads as the cap it is.
 * Retention is the same on every plan, so it sits with what every plan carries.
 *
 * The last row is the one every plan shares, the founder's 2026-09-08 call:
 * the project commercial SDK license in section 4 of the Relay service terms.
 * The meters do not answer whether the SDK's AGPL reaches a proprietary
 * application, and that is the question a buyer asks before sizing. Every plan
 * carries the license, Free included, so every cell is the check, and the
 * definition repeats the grant's limits so the row promises nothing the terms
 * do not.
 */
const define = (name: string) => {
  const meter = relayMeterDefinitions.find((entry) => entry.name === name);
  if (!meter) throw new Error(`pricing.astro: the catalog defines no meter named ${name}`);
  return meter.definition;
};

/* The definitions price delivery and storage overage once each, which holds
 * only while every paid plan prices them the same. */
const overageRates = (key: 'delivery' | 'storage') => {
  const rates = new Set(selfServe.flatMap((plan) => (plan.overage ? [plan.overage[key]] : [])));
  if (rates.size !== 1) throw new Error(`pricing.astro: paid plans price ${key} overage ${rates.size} ways; the row definition states one`);
  return [...rates][0];
};
const deliveryOverage = overageRates('delivery');
const storageOverage = overageRates('storage');

type RowShape = { label: string; definition: string; lead?: boolean };
type Row = RowShape & { value: (plan: Plan) => string };
const rows: Row[] = [
  { label: 'Monthly Active Users', lead: true, definition: define('Relay MAU'), value: (plan) => plan.relayMau },
  {
    label: 'Additional MAU',
    definition: 'Each Relay MAU beyond the plan allowance in a month, charged only once overage is on. Free has no overage and stops at its cap.',
    value: (plan) => plan.overage?.relayMau ?? NO_OVERAGE,
  },
  {
    label: 'Message Delivery Units',
    definition: `${define('Delivery unit')} Once overage is on, additional units are ${deliveryOverage} on every paid plan.`,
    value: (plan) => plan.deliveryUnits,
  },
  { label: 'Attachment Uploads', definition: `${define('Attachment upload')} A hard cap on every plan.`, value: (plan) => plan.attachmentOperations },
  {
    label: 'Encrypted Storage',
    definition: `${define('Storage')} Once overage is on, additional storage is ${storageOverage} on every paid plan.`,
    value: (plan) => plan.storage,
  },
  {
    label: 'SDK Commercial License',
    definition:
      'Use @open-e2ee/signal-protocol-sdk in one proprietary application that connects to the project, for as long as the project is active. Every plan carries it, Free included. It grants no self-hosting right and no right to redistribute the SDK.',
    value: () => INCLUDED,
  },
];

const rowId = (row: RowShape, scope: string) => `${scope}-${row.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

/* The lead row has room around it; the foot closes the tint. */
const rowPadding = (row: RowShape) => (row.lead ? ['pt-5', 'pb-4'] : ['pt-3', 'pb-3']);
const rowHeadClasses = (row: RowShape) => [ROW_HEAD, ...rowPadding(row), row.lead && LEAD_HEAD];
const cellClasses = (row: Row, plan: Plan) => [
  CELL,
  ...rowPadding(row),
  row.lead ? LEAD_VALUE : 'text-text-3',
  marked(plan) && 'bg-ground-panel',
];
const compactRowClasses = (row: RowShape) => (row.lead ? COMPACT_LEAD : undefined);
const compactLabelClasses = (row: RowShape) => (row.lead ? 'text-text-1' : 'text-text-3');
const compactValueClasses = (row: RowShape) => [COMPACT_VALUE, row.lead ? LEAD_VALUE : 'text-text-1'];

/*
 * The rows that differ by license, each named by the right it is and defined
 * on hover, as the Relay rows are. Whether the product can be closed source
 * leads, because that is the question that sends a buyer to this table. The
 * values are the catalog's, and the definitions state each license's answer
 * in the words of the agreement that gives it.
 */
type Tier = (typeof tiers)[number];
type LicenseRow = RowShape & { value: (tier: Tier) => string };
const agpl = tiers.find((tier) => tier.id === 'agplv3');
if (!agpl) throw new Error('pricing.astro: the license catalog has no AGPLv3 tier');
const licenseRows: LicenseRow[] = [
  {
    label: 'Closed Source',
    lead: true,
    definition: `Ship a proprietary product without the AGPLv3 source obligations. ${agpl.detail}`,
    value: (tier) => tier.closedSource,
  },
  {
    label: 'Products Covered',
    definition:
      'The products one grant reaches. AGPLv3 reaches any product that meets its obligations. A Startup license covers one named product owned by one legal entity. An Enterprise license states its product and component scope in the contract.',
    value: (tier) => tier.products,
  },
  {
    label: 'Redistribution',
    definition:
      'Shipping the SDK as a standalone component, or inside a product that others then distribute. AGPLv3 permits it under its own terms. A Startup license excludes standalone redistribution. An Enterprise license negotiates portfolio or OEM rights.',
    value: (tier) => tier.redistribution,
  },
  {
    label: 'SDK Updates',
    definition:
      'New releases of @open-e2ee/signal-protocol-sdk. Every release is public under AGPLv3. A Startup license includes generally available updates during its term. An Enterprise contract states its own.',
    value: (tier) => tier.updates,
  },
  {
    label: 'Support',
    definition:
      'AGPLv3 carries no support. A Startup license includes reasonable email support during its term, and no implementation services or response times. An Enterprise license negotiates implementation support and service levels.',
    value: (tier) => tier.support,
  },
  {
    label: 'Security Review',
    definition:
      'A review of your integration with OpenE2EE. A Startup license does not include one unless a signed order form states it. An Enterprise license negotiates one.',
    value: (tier) => tier.securityReview,
  },
];
const licenseCellClasses = (row: RowShape) => [CELL, ...rowPadding(row), row.lead ? LEAD_VALUE : 'text-text-3'];
const licenseActionClasses = (tier: Tier) => ['oe-button', 'oe-button-full', tier.cta.secondary && 'oe-button-secondary'];

/*
 * What every plan carries, one card per relay capability, each in the words
 * the relay's own routes and concepts use. These do not differ by plan, so
 * the whole set stands in one section under the plans rather than taking the
 * table's space.
 */
const included: { icon: IconName; label: string; detail: string }[] = [
  {
    icon: 'send',
    label: 'Encrypted delivery',
    detail: 'Durable encrypted device mailboxes, pull or a live connection, acknowledgment, retry requests, and bounded fan-out.',
  },
  {
    icon: 'key',
    label: 'Keys and sessions',
    detail: 'Identity key and prekey distribution, post-quantum ML-KEM prekeys included, with stale-key cleanup.',
  },
  { icon: 'unseen', label: 'Sealed sender', detail: 'Sender certificates, access keys, and unidentified delivery to devices and groups.' },
  {
    icon: 'people',
    label: 'Zero-knowledge groups',
    detail: 'Group send credentials, signed encrypted group revisions, fan-out status, and group recovery.',
  },
  {
    icon: 'device',
    label: 'Multi-device',
    detail: 'Device registration and linking, device authorization, account recovery, identity migration, and account deletion.',
  },
  {
    icon: 'attachment',
    label: 'Encrypted attachments',
    detail: 'Private encrypted attachment storage with authorized upload, download, and deletion.',
  },
  {
    icon: 'clock',
    label: 'Ciphertext retention',
    detail: `${relayProductionRetention} in device mailboxes and attachment storage before ciphertext expires. A project can set a shorter retention.`,
  },
  {
    icon: 'pulse',
    label: 'Push wakes and operations',
    detail: 'Push wakes, exact usage, quotas, capacity, lifecycle controls, and recovery drills.',
  },
  { icon: 'terminal', label: 'Development environment', detail: 'One with every project, at no cost and without a card.' },
];
const INCLUDED_HEADING = 'Signal Protocol Relay features built into every plan';
const INCLUDED_ID = 'built-into-every-plan';
const INCLUDED_ANCHOR = 'included';
const INCLUDED_ACTION = 'See what is included';

---

<BaseLayout
  title="Pricing"
  description={`OpenE2EE Relay plans from Free through Starter, Growth, Business, and Enterprise, with every meter and overage rate, and SDK commercial licensing from ${startupTier.price} per year.`}
  canonical="/pricing"
>
  <section id="relay-plans" class={PLANS}>
    <div class={CONTAINER}>
      <div class={PLANS_HEAD} data-plans-head>
        <h1>Pricing that scales to zero.</h1>
        <p class:list={[LEAD, PLANS_LEAD]}>Ship fully featured end-to-end encrypted messaging, securely, and at scale.</p>
        <div class:list={[ACTIONS, PLANS_ACTIONS]} data-actions="pricing">
          <a class={PLANS_PRIMARY} href={RELAY_PROJECT}>{startAction.label}{' '}<span class="oe-button-note">{startPromise}</span></a>
          <a class={INCLUDED_TRIGGER} href={`#${INCLUDED_ANCHOR}`}>{INCLUDED_ACTION}</a>
        </div>
      </div>
      <div class={PLAN_TABLE_AT}>
        <table class={PLAN_TABLE} itemscope itemtype="https://schema.org/Product">
          <caption class="oe-visually-hidden" itemprop="name">OpenE2EE Relay plans, monthly prices, allowances, and what every plan includes</caption>
          <colgroup><col class="w-[15rem]" />{selfServe.map(() => <col />)}</colgroup>
          <thead>
            <tr>
              <th scope="col" class={CORNER}>{TABLE_NAME}</th>
              {selfServe.map((plan) => (
                <th scope="col" class:list={headClasses(plan)} data-relay-plan={plan.id} itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <meta itemprop="priceCurrency" content="USD" />
                  <meta itemprop="price" content={String(plan.monthlyPriceUsd)} />
                  <p class={PLAN_MARK}>{planMark(plan)}</p>
                  <h3 class={TIER_HEADING} itemprop="name">{plan.name}</h3>
                  <p class={TIER_PRICE}>{plan.price}</p>
                  <p class={TIER_NOTE}>per month</p>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row" class:list={rowHeadClasses(row)}>
                  <Term id={rowId(row, 'table')} label={row.label} definition={row.definition} />
                </th>
                {selfServe.map((plan) => <td class:list={cellClasses(row, plan)}><PlanValue value={row.value(plan)} /></td>)}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <td class="rule-t pr-4"></td>
              {selfServe.map((plan) => (
                <td class:list={footClasses(plan)} data-relay-plan-action={plan.id}>
                  <a class:list={startClasses(plan)} href={startHref(plan)}>{startLabel(plan)}</a>
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>
      <p class={COMPACT_NAME}>{TABLE_NAME}</p>
      <ul class={COMPACT}>
        {selfServe.map((plan) => (
          <li class:list={compactPlanClasses(plan)} data-relay-plan-compact={plan.id}>
            <p class={PLAN_MARK}>{planMark(plan)}</p>
            <h3 class={TIER_HEADING}>{plan.name}</h3>
            <p class={TIER_PRICE}>{plan.price}</p>
            <p class={TIER_NOTE}>per month</p>
            <dl class={COMPACT_ROWS}>
              {rows.map((row) => (
                <div class:list={compactRowClasses(row)}>
                  <dt class={compactLabelClasses(row)}><Term id={rowId(row, plan.id)} label={row.label} definition={row.definition} /></dt>
                  <dd class:list={compactValueClasses(row)}><PlanValue value={row.value(plan)} /></dd>
                </div>
              ))}
            </dl>
            <a class:list={[startClasses(plan), COMPACT_ACTION]} href={startHref(plan)}>{startLabel(plan)}</a>
          </li>
        ))}
      </ul>
      <div class={ENTERPRISE_BAND} data-relay-plan={enterprise.id}>
        <h3 class={TIER_HEADING}>{enterprise.name}</h3>
        <p class={ENTERPRISE_DETAIL}>{enterprise.detail}</p>
        <a class={ENTERPRISE_LINK_CLASS} href={ENTERPRISE_LINK.href}>{ENTERPRISE_LINK.label}</a>
        <a class={ENTERPRISE_ACTION_CLASS} href={ENTERPRISE_ACTION.href}>{ENTERPRISE_ACTION.label}</a>
      </div>
    </div>
  </section>

  <section id={INCLUDED_ANCHOR} class={BAND} aria-labelledby={INCLUDED_ID}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2 id={INCLUDED_ID}>{INCLUDED_HEADING}</h2>
      </div>
      <dl class={INCLUDED_CARDS}>
        {included.map((item) => (
          <div class={INCLUDED_CARD}>
            <dt class={INCLUDED_CARD_TITLE}><Icon name={item.icon} class={INCLUDED_CARD_ICON} />{item.label}</dt>
            <dd class={INCLUDED_CARD_DETAIL}>{item.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="licensing" class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>SDK commercial licensing</h2>
        {/* The lead says what the reader gets, as the hero's does, not what
          * the product is. The claims are the landing page's: the complete SDK,
          * closed-source products, the same build, and no meter. The table
          * under it says what differs. */}
        <p class={MEASURE}>Ship the complete SDK in a closed-source product, on infrastructure you run. Same build, every feature, no meter.</p>
      </div>
      <div class={PLAN_TABLE_AT}>
        <table class={PLAN_TABLE}>
          <thead>
            <tr>
              <td class="pr-4"></td>
              {tiers.map((tier) => (
                <th scope="col" class={LICENSE_HEAD} data-license={tier.id}>
                  <h3 class={TIER_HEADING}>{tier.name}</h3>
                  <p class={TIER_PRICE}>{tier.price}</p>
                  <p class={TIER_NOTE}>{tier.note}</p>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {licenseRows.map((row) => (
              <tr>
                <th scope="row" class:list={rowHeadClasses(row)}>
                  <Term id={rowId(row, 'license-table')} label={row.label} definition={row.definition} />
                </th>
                {tiers.map((tier) => <td class:list={licenseCellClasses(row)}><PlanValue value={row.value(tier)} /></td>)}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <td class="rule-t pr-4"></td>
              {tiers.map((tier) => (
                <td class={FOOT_CELL} data-license-action={tier.id}>
                  <a class:list={licenseActionClasses(tier)} href={tier.cta.href}>{tier.cta.label}</a>
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>
      <ul class={COMPACT}>
        {tiers.map((tier) => (
          <li class={COMPACT_PLAN} data-license-compact={tier.id}>
            <h3 class={TIER_HEADING}>{tier.name}</h3>
            <p class={TIER_PRICE}>{tier.price}</p>
            <p class={TIER_NOTE}>{tier.note}</p>
            <dl class={COMPACT_ROWS}>
              {licenseRows.map((row) => (
                <div class:list={compactRowClasses(row)}>
                  <dt class={compactLabelClasses(row)}><Term id={rowId(row, `license-${tier.id}`)} label={row.label} definition={row.definition} /></dt>
                  <dd class:list={compactValueClasses(row)}><PlanValue value={row.value(tier)} /></dd>
                </div>
              ))}
            </dl>
            <a class:list={[licenseActionClasses(tier), COMPACT_ACTION]} href={tier.cta.href}>{tier.cta.label}</a>
          </li>
        ))}
      </ul>
      <p class:list={['text-text-3', MEASURE]}>A Startup commercial license renews annually until you cancel before the renewal date. Taxes may apply. The <a href="/legal/terms">self-hosted agreement</a> controls that grant, covered products, support, renewal, and post-expiration rights.</p>
    </div>
  </section>
</BaseLayout>
