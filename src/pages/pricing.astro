---
import BaseLayout from '../layouts/BaseLayout.astro';
import { relayPlans } from '../data/relay-pricing.mjs';
import { startupTier, tiers } from '../data/pricing.mjs';

const starter = relayPlans.find((plan) => plan.id === 'relay_starter_v1');
if (!starter) throw new Error('The Relay catalog has no Starter plan.');
---

<BaseLayout
  title="Pricing"
  description={`Choose managed OpenE2EE Relay capacity or a self-hosted OpenE2EE Signal Protocol SDK commercial license from ${startupTier.price} per year.`}
  canonical="/pricing"
>
  <header class="page-hero">
    <div class="container measure">
      <p class="label">Pricing</p>
      <h1>Choose who operates the encrypted delivery layer.</h1>
      <p class="lead">OpenE2EE Relay is the managed delivery product. Self-hosted licensing covers a proprietary application that operates its own infrastructure. These are separate products with separate meters and rights.</p>
      <p>Free under AGPLv3. Commercial self-hosting starts at {startupTier.price} per year.</p>
    </div>
  </header>

  <section class="band">
    <div class="container">
      <ul class="tiers">
        <li class="tier">
          <div class="tier-name"><h2>OpenE2EE Relay</h2><p class="tier-price">Free<span>then {starter.price} per month</span></p></div>
          <div class="tier-body"><p>Managed encrypted delivery for the OpenE2EE Signal Protocol SDK. Includes development and Free production, encrypted device mailboxes, group fan-out, private attachment storage, push wakes, exact usage, and lifecycle controls.</p><p class="muted">Plans use Relay MAU, destination-device delivery units, attachment operations, and exact live encrypted storage.</p><p class="text-links"><a href="/relay/pricing">Review Relay plans</a><a href="/relay">What Relay operates</a></p></div>
        </li>
        {tiers.map((tier) => (
          <li class="tier">
            <div class="tier-name"><h2>{tier.name}</h2><p class="tier-price">{tier.price}{tier.period && <span>{tier.period}</span>}</p></div>
            <div class="tier-body"><p>{tier.body}</p><p class="muted">{tier.detail}</p><p class="text-links"><a href={tier.cta.href}>{tier.cta.label}</a></p></div>
          </li>
        ))}
      </ul>
      <p class="muted measure">A managed Relay subscription does not grant general self-hosting rights. A Startup commercial license renews annually until you cancel before the renewal date. Taxes may apply. Your <a href="/legal/terms">agreement</a> controls the grant, covered products, support, renewal, and post-expiration rights.</p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head"><h2>How buying works</h2></div>
      <dl class="definition-rows">
        <div><dt>Managed Relay</dt><dd>Start with no-card development. Production activation uses a separate managed project, exact limits, and the plan selected in Console.</dd></div>
        <div><dt>Startup license</dt><dd>Sign in, name the legal entity and covered product, accept the commercial terms, and complete annual checkout.</dd></div>
        <div><dt>Growth and Enterprise license</dt><dd>Portfolio rights, redistribution, integration support, security review, and service levels need a signed order form.</dd></div>
      </dl>
      <p class="text-links"><a href="/relay/pricing">Review Relay limits</a><a href="/licensing">Compare self-hosted rights</a><a href="mailto:licensing@open-e2ee.dev?subject=Commercial%20licensing%20question">Ask a licensing question</a></p>
    </div>
  </section>
</BaseLayout>
