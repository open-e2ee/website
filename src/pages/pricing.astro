---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableScroll from '../components/TableScroll.astro';
import {
  relayDevelopmentEnvironment,
  relayMeterDefinitions,
  relayPlans,
  relayProductionRetention,
} from '../data/relay-pricing.mjs';
import { startupTier, tiers } from '../data/pricing.mjs';
import { startAction } from '../lib/site-navigation';
import {
  ACTIONS,
  BAND,
  BAND_HEAD,
  BAND_SURFACE,
  CONTAINER,
  CONTAINER_MEASURE,
  DEFINITION_ROWS,
  LABEL,
  LEAD,
  MEASURE,
  METADATA,
  PAGE_HERO,
  TEXT_LINKS,
} from '../lib/recipes';

/*
 * The four self-service plans are the columns of one table, and the meters are
 * its rows. A buyer arrives with a size in mind and reads down the column that
 * fits it; the deck this replaced put the same numbers in five prose lists and
 * left every meter a reader compares across plans on another page.
 *
 * The table holds to 62rem. Below that the same rows render as one block per
 * plan, from the same data, and the other rendering leaves the document.
 */
const PLAN_TABLE =
  'w-full table-fixed border-collapse text-[0.9375rem] ' +
  '[&_th]:text-left [&_th]:align-top [&_td]:text-left [&_td]:align-top ' +
  '[&_thead_th]:pr-6 [&_thead_th]:pb-6 [&_thead_th]:font-normal [&_thead_td]:pr-6 ' +
  '[&_tbody_th]:rule-t [&_tbody_th]:py-3 [&_tbody_th]:pr-4 [&_tbody_th]:font-medium [&_tbody_th]:text-text-1 ' +
  '[&_tbody_td]:rule-t [&_tbody_td]:py-3 [&_tbody_td]:pr-6 [&_tbody_td]:text-text-3 ' +
  '[&_tbody_td]:font-[family-name:var(--oe-metadata-font-family)] [&_tbody_td]:tabular-nums';

const PLAN_TABLE_AT = 'max-[62rem]:hidden';

/* A column head is a stack: marker, name, price, note, action. */
const PLAN_HEAD = '[&>*+*]:mt-3';

const COMPACT = 'm-0 grid list-none grid-cols-2 gap-x-8 p-0 min-[62rem]:hidden max-[44rem]:grid-cols-1';

const COMPACT_PLAN = 'rule-t py-6 [&>*+*]:mt-3';

const COMPACT_ROWS =
  'm-0 w-full text-[0.9375rem] [&>div]:flex [&>div]:justify-between [&>div]:gap-4 [&>div]:rule-t [&>div]:py-2 ' +
  '[&_dt]:text-text-3 [&_dd]:m-0 [&_dd]:text-right [&_dd]:text-text-1 ' +
  '[&_dd]:font-[family-name:var(--oe-metadata-font-family)] [&_dd]:tabular-nums';

/*
 * The Development environment and the licenses are ruled rows: a name and
 * price on the left, what it carries and its action on the right. Enterprise
 * takes the same grid inside one outlined band under the table, so the fifth
 * plan reads as the table's last row and not as a footnote.
 */
const TIERS = 'm-0 list-none p-0';

const TIER_GRID =
  'grid grid-cols-[minmax(12rem,1fr)_minmax(0,2fr)] items-start gap-6 max-[58rem]:grid-cols-1 max-[58rem]:gap-4';

const TIER = `${TIER_GRID} rule-t py-8`;

const ENTERPRISE_BAND = `${TIER_GRID} mt-8 rule bg-ground-panel px-6 py-6 max-[34rem]:px-4`;

const TIER_NAME = 'flex flex-col items-start gap-2';

/*
 * The price is the largest thing in a column or a row, and the name reads as
 * its label. A pricing page answers the price question first.
 */
const TIER_HEADING = 'text-[1.0625rem] leading-tight font-semibold text-text-1';

const TIER_PRICE =
  'font-[family-name:var(--oe-metadata-font-family)] ' +
  'text-[clamp(1.875rem,1.5rem+1.2vw,2.5rem)] leading-none font-medium ' +
  'tracking-[var(--oe-metadata-tracking)] text-text-1';

const TIER_NOTE = `${METADATA} text-text-3`;

/*
 * One plan carries the label and the filled action; the founder chose Starter
 * on 2026-09-07 (`docs/decisions.md`). Its table column is tinted, and the
 * label sits in the color this site uses where something is settled. The other
 * columns carry the same element with no text, so every name sits on one
 * baseline.
 */
const HIGHLIGHT = 'relay_starter_v1';
const HIGHLIGHT_LABEL = 'Most popular';
const PLAN_MARK = `${METADATA} min-h-[1lh] text-[var(--oe-sealed)]`;

const TIER_BODY = 'flex max-w-[58ch] flex-col items-start gap-3 text-text-3';

/*
 * Every self-service plan opens the Console route that creates a project,
 * because a production plan is activated inside a project. A paid plan names
 * itself in the query so the Console can offer that plan first once the
 * project exists. The highlighted plan is the filled action; the others,
 * Free among them, are secondary, and every one of them opens the same route.
 */
const RELAY_PROJECT = startAction.href;

type Plan = (typeof relayPlans)[number];

const FREE = 'relay_free_v1';

const selfServe = relayPlans.filter((plan) => plan.monthlyPriceUsd !== null);
const enterprise = relayPlans.find((plan) => plan.monthlyPriceUsd === null);
if (!enterprise) throw new Error('pricing.astro: the Relay catalog has no negotiated plan');

const startHref = (plan: Plan) => (plan.id === FREE ? RELAY_PROJECT : `${RELAY_PROJECT}?plan=${plan.id}`);
const startLabel = (plan: Plan) => (plan.id === FREE ? 'Start free' : `Start with ${plan.name}`);
const planMark = (plan: Plan) => (plan.id === HIGHLIGHT ? HIGHLIGHT_LABEL : '');
const startClasses = (plan: Plan) => ['oe-button', 'oe-button-full', plan.id !== HIGHLIGHT && 'oe-button-secondary'];

const ENTERPRISE_ACTION = {
  href: 'mailto:licensing@open-e2ee.dev?subject=OpenE2EE%20Relay%20Enterprise%20plan',
  label: 'Ask about Enterprise',
};

/* One row per meter, then one per overage rate, then retention. Allowances
 * are monthly, which the note under the table says once; the price under each
 * name already reads "per month". Free has no overage, so its three overage
 * cells read as the cap they are. */
const HARD_CAP = 'Hard cap';
const rows: { label: string; value: (plan: Plan) => string }[] = [
  { label: 'Relay MAU', value: (plan) => plan.relayMau },
  { label: 'Delivery units', value: (plan) => plan.deliveryUnits },
  { label: 'Attachment uploads', value: (plan) => plan.attachmentOperations },
  { label: 'Storage', value: (plan) => plan.storage },
  { label: 'Additional MAU', value: (plan) => plan.overage?.relayMau ?? HARD_CAP },
  { label: 'Additional delivery units', value: (plan) => plan.overage?.delivery ?? HARD_CAP },
  { label: 'Additional storage', value: (plan) => plan.overage?.storage ?? HARD_CAP },
  { label: 'Ciphertext retention', value: () => relayProductionRetention },
];

const licenseHeading = (tier: (typeof tiers)[number]) =>
  /license/i.test(tier.name) ? tier.name : `${tier.name} license`;
---

<BaseLayout
  title="Pricing"
  description={`OpenE2EE Relay plans from Free through Starter, Growth, Business, and Enterprise, with every meter and overage rate, and SDK commercial licensing from ${startupTier.price} per year.`}
  canonical="/pricing"
>
  <header class={PAGE_HERO}>
    <div class={CONTAINER_MEASURE}>
      <p class={LABEL}>Pricing</p>
      <h1>OpenE2EE Relay, free to start.</h1>
      <p class={LEAD}>OpenE2EE Relay is the managed delivery product for applications built on the OpenE2EE Signal Protocol SDK. Every plan carries every Relay protocol feature: groups, attachments, sealed sender, multi-device delivery, and push.</p>
      <p>Every project starts with a Development environment, at no cost and without a card.</p>
    </div>
  </header>

  <section id="relay-plans" class={BAND}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>OpenE2EE Relay plans</h2>
        <p class={MEASURE}>Four self-service plans on one set of meters. Paid plans add capacity and optional overage.</p>
      </div>
      <div class={PLAN_TABLE_AT}>
        <TableScroll label="OpenE2EE Relay plans">
          <table class={PLAN_TABLE} itemscope itemtype="https://schema.org/Product">
            <caption class="oe-visually-hidden" itemprop="name">OpenE2EE Relay plans, monthly prices, and limits</caption>
            <colgroup><col class="w-[11rem]" />{selfServe.map((plan) => <col class={plan.id === HIGHLIGHT ? 'bg-ground-panel' : undefined} />)}</colgroup>
            <thead>
              <tr>
                <td></td>
                {selfServe.map((plan) => (
                  <th scope="col" class={PLAN_HEAD} data-relay-plan={plan.id} itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                    <meta itemprop="priceCurrency" content="USD" />
                    <meta itemprop="price" content={String(plan.monthlyPriceUsd)} />
                    <p class={PLAN_MARK}>{planMark(plan)}</p>
                    <h3 class={TIER_HEADING} itemprop="name">{plan.name}</h3>
                    <p class={TIER_PRICE}>{plan.price}</p>
                    <p class={TIER_NOTE}>per month</p>
                    <a class:list={startClasses(plan)} href={startHref(plan)}>{startLabel(plan)}</a>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr><th scope="row">{row.label}</th>{selfServe.map((plan) => <td>{row.value(plan)}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </TableScroll>
      </div>
      <ul class={COMPACT}>
        {selfServe.map((plan) => (
          <li class={COMPACT_PLAN} data-relay-plan-compact={plan.id}>
            <p class={PLAN_MARK}>{planMark(plan)}</p>
            <h3 class={TIER_HEADING}>{plan.name}</h3>
            <p class={TIER_PRICE}>{plan.price}</p>
            <p class={TIER_NOTE}>per month</p>
            <a class:list={startClasses(plan)} href={startHref(plan)}>{startLabel(plan)}</a>
            <dl class={COMPACT_ROWS}>{rows.map((row) => <div><dt>{row.label}</dt><dd>{row.value(plan)}</dd></div>)}</dl>
          </li>
        ))}
      </ul>
      <div class={ENTERPRISE_BAND} data-relay-plan={enterprise.id}>
        <div class={TIER_NAME}>
          <h3 class={TIER_HEADING}>{enterprise.name}</h3>
          <p class={TIER_PRICE}>{enterprise.price}</p>
          <p class={TIER_NOTE}>Negotiated</p>
        </div>
        <div class={TIER_BODY}>
          <p>{enterprise.detail} Every Relay protocol feature, as on every other plan.</p>
          <p class={ACTIONS}>
            <a class="oe-button oe-button-secondary" href={ENTERPRISE_ACTION.href}>{ENTERPRISE_ACTION.label}</a>
          </p>
        </div>
      </div>
      <p class:list={['mt-8', MEASURE]}>Prefer to operate the delivery layer yourself? The SDK is free under AGPLv3. Self-hosting it inside a proprietary product takes an <a href="#licensing">SDK commercial license</a>, from {startupTier.price} per year, and a Relay plan grants no self-hosting rights.</p>
      <p class:list={['mt-4 text-text-3', MEASURE]}>Prices and allowances are monthly, and taxes can apply. Attachment uploads are a hard cap on every plan. The <a href="/legal/relay-terms">Relay service terms</a> control a managed project.</p>
      <p class:list={['mt-4', TEXT_LINKS]}><a href="/relay">What Relay operates</a><a href="/compare/virgil-security">Compare with Virgil Security</a></p>
    </div>
  </section>

  <section id="development" class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>Included with every project</h2>
        <p class={MEASURE}>The Development environment is separate from the production plan. It uses isolated state, credentials, limits, and lifecycle controls, and it is not a production plan.</p>
      </div>
      <ul class={TIERS}>
        <li class={TIER}>
          <div class={TIER_NAME}>
            <h3 class={TIER_HEADING}>Development environment</h3>
            <p class={TIER_PRICE}>Included</p>
            <p class={TIER_NOTE}>No card</p>
          </div>
          <div class={TIER_BODY}>
            <p>{relayDevelopmentEnvironment.relayMau}, {relayDevelopmentEnvironment.deliveryUnits} delivery units and {relayDevelopmentEnvironment.attachmentOperations} attachment uploads per month, and {relayDevelopmentEnvironment.storage} storage.</p>
            <p class={TIER_NOTE}>{relayDevelopmentEnvironment.detail}</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section id="meters" class={BAND}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>What the meters count</h2>
        <p class={MEASURE}>The four meters in the table, defined the way the Relay service terms define them.</p>
      </div>
      <dl class={DEFINITION_ROWS}>{relayMeterDefinitions.map((meter) => <div><dt>{meter.name}</dt><dd>{meter.definition}</dd></div>)}</dl>
    </div>
  </section>

  <section id="licensing" class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}>
        <h2>SDK commercial licensing</h2>
        <p class={MEASURE}>The OpenE2EE Signal Protocol SDK is a separate product from OpenE2EE Relay, with separate rights and no meter. These grants cover a proprietary product that operates its own infrastructure, and each one renews annually.</p>
      </div>
      <ul class={TIERS}>
        {tiers.map((tier) => (
          <li class={TIER}>
            <div class={TIER_NAME}>
              <h3 class={TIER_HEADING}>{licenseHeading(tier)}</h3>
              <p class={TIER_PRICE}>{tier.price}</p>
              {tier.period && <p class={TIER_NOTE}>{tier.period}</p>}
            </div>
            <div class={TIER_BODY}>
              <p>{tier.body}</p>
              <p class={TIER_NOTE}>{tier.detail}</p>
              <p class={ACTIONS}>
                <a class:list={['oe-button', tier.cta.secondary && 'oe-button-secondary']} href={tier.cta.href}>{tier.cta.label}</a>
              </p>
            </div>
          </li>
        ))}
      </ul>
      <p class:list={['text-text-3', MEASURE]}>A Startup commercial license renews annually until you cancel before the renewal date. Taxes may apply. The <a href="/legal/terms">self-hosted agreement</a> controls that grant, covered products, support, renewal, and post-expiration rights.</p>
    </div>
  </section>

  <section class={BAND}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}><h2>How buying works</h2></div>
      <dl class={DEFINITION_ROWS}>
        <div><dt>Relay plan</dt><dd>Create a project and build in its Development environment without a card. To activate Production, save a verified card in Console and choose a plan. Free charges nothing and stops at its caps. A paid plan bills monthly, and overage stays off until you turn it on.</dd></div>
        <div><dt>At a cap</dt><dd>At a hard cap or spend limit, Relay refuses new billable work. It preserves receive, pull, acknowledgment, deletion, revocation, usage export, and billing access.</dd></div>
        <div><dt>Overage</dt><dd>Overage is off until an organization administrator accepts the rate and sets a monthly spend limit in Console. Reaching that limit stops new billable work and preserves pull, acknowledgment, deletion, revocation, recovery, and mailbox draining.</dd></div>
        <div><dt>Self-hosting</dt><dd>A Relay plan covers the managed service and grants no self-hosting rights. Self-hosting the SDK inside a proprietary product takes an SDK commercial license.</dd></div>
        <div><dt>Startup license</dt><dd>Sign in, name the legal entity and covered product, accept the commercial terms, and complete annual checkout.</dd></div>
        <div><dt>Growth and Enterprise / OEM licenses</dt><dd>Portfolio rights, redistribution, integration support, security review, and service levels need a signed order form.</dd></div>
      </dl>
      <p class={TEXT_LINKS}><a href="/licensing">Compare self-hosted rights</a><a href="mailto:licensing@open-e2ee.dev?subject=Commercial%20licensing%20question">Ask a licensing question</a></p>
    </div>
  </section>
</BaseLayout>
