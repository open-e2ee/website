---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  BAND,
  BAND_SURFACE,
  CONTAINER,
  CONTAINER_MEASURE,
  DEFINITION_ROWS,
  LABEL,
  LEAD,
  PAGE_HERO,
  TEXT_LINKS,
} from '../lib/recipes';

/*
 * The SDK is dual-licensed since 2026-09-22: MIT or Apache-2.0, at the user's
 * option. The page that stood here sold the AGPLv3 path against a commercial
 * license, and every link into it still reads "Licensing", so the route
 * survives and the page answers the question the links carry now: which of
 * the two licenses to take, and what each asks.
 *
 * The console's docs/licensing page states the same two rows in the same
 * words, so a reader who follows either route reads one answer.
 */
const LICENSE_MIT = 'https://github.com/open-e2ee/signal-protocol-js/blob/main/LICENSE-MIT';
const LICENSE_APACHE = 'https://github.com/open-e2ee/signal-protocol-js/blob/main/LICENSE-APACHE';
---

<BaseLayout
  title="Licensing"
  description="The OpenE2EE Signal Protocol SDK is dual-licensed under the MIT License or the Apache License 2.0, at your option."
>
  <header class={PAGE_HERO}>
    <div class={CONTAINER_MEASURE}>
      <p class={LABEL}>Licensing</p>
      {/*
        The heading names the two licenses instead of counting them, as the
        AGPLv3 page before it named its two paths. The lead states the one
        disclaimer once, at the top, which is how Elastic's and MongoDB's
        license pages lead.
      */}
      <h1>MIT or Apache-2.0, at your option.</h1>
      <p class={LEAD}>
        This page summarizes the two licenses. The license text controls.
      </p>
    </div>
  </header>

  <section class={BAND}>
    <div class={CONTAINER}>
      <dl class={DEFINITION_ROWS}>
        <div>
          <dt>MIT</dt>
          <dd>
            Use, copy, modify, and redistribute, in open or proprietary products. Keep the copyright
            and license notice.
          </dd>
        </div>
        <div>
          <dt>Apache-2.0</dt>
          <dd>
            The same rights, with an express patent grant from contributors. Keep the notices and
            state your changes to the files.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class:list={[BAND, BAND_SURFACE]}>
    <div class={`${CONTAINER_MEASURE} prose`}>
      <h2>The license file is the license</h2>
      <p>
        Neither license requires a fee, a signed agreement, or an account, and neither requires you
        to publish your own source. The SPDX expression on the package is{' '}
        <code>MIT OR Apache-2.0</code>. Where this page and a license file differ, the license file
        controls.
      </p>
      <p>
        The OpenE2EE Signal Protocol Relay is a separate service with its own{' '}
        <a href="/legal/relay-terms">service terms</a> and <a href="/pricing">plans</a>. The SDK
        runs against it, or against a relay you operate, under the same two licenses.
      </p>
      <p class={TEXT_LINKS}>
        <a href={LICENSE_MIT}>LICENSE-MIT</a>
        <a href={LICENSE_APACHE}>LICENSE-APACHE</a>
        <a href="mailto:licensing@open-e2ee.dev?subject=Licensing%20question">
          Ask a licensing question
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
