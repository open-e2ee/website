---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  demoBookingUrl,
  signalRelayEnterpriseBookingUrl,
} from '../data/booking.mjs';
import { docs, reporting } from '../lib/assurance.mjs';
import {
  BAND,
  CONTAINER,
  CONTAINER_MEASURE,
  LABEL,
  LEAD,
  PAGE_HERO,
  ROWS,
  TEXT_LINKS,
} from '../lib/recipes';

/*
 * One page, one channel per reason to write. A prospect reads this before an
 * account exists, so nothing here sits behind console sign-in, and support is
 * the address that the Relay terms name for it. Every address and calendar
 * link on this page is the same one the pricing, licensing, and legal pages
 * already use, so a reader who arrives from any of them lands on a channel
 * they have seen.
 */
---

<BaseLayout
  title="Contact"
  description="How to reach OpenE2EE: get product support, discuss Relay plans, report a vulnerability, or send a legal or privacy request."
>
  <header class={PAGE_HERO}>
    <div class={CONTAINER_MEASURE}>
      <p class={LABEL}>Contact</p>
      <h1>Write to the channel that answers.</h1>
      <p class={LEAD}>
        Each address below is read by the person who can act on it. State what you are building,
        which product it concerns, and what you need from us, and the first reply carries an
        answer rather than a question.
      </p>
    </div>
  </header>

  <section class={BAND}>
    <div class={CONTAINER}>
      <ul class={ROWS}>
        <li>
          <p class={LABEL}>Vulnerability report</p>
          <h3><a href={`mailto:${reporting.address}`}>{reporting.address}</a></h3>
          <p>
            Acknowledged within {reporting.acknowledgment}, with an initial assessment within{' '}
            {reporting.assessment}. Do not open a public issue. Resolution targets by severity and
            the safe harbor for good-faith research are on the{' '}
            <a href="/security#reporting">security page</a> and in the{' '}
            <a href={docs.reporting}>disclosure policy</a>.
          </p>
        </li>
        <li>
          <p class={LABEL}>Signal Protocol Relay</p>
          <h3><a href={signalRelayEnterpriseBookingUrl}>Schedule a meeting</a></h3>
          <p>
            Capacity beyond the published plans, a dedicated deployment, or a data-processing
            question about the Relay service. Bring the monthly active users and regions you
            expect. Or email <a href="mailto:sales@open-e2ee.dev?subject=Relay%20plans">sales@open-e2ee.dev</a>.
          </p>
        </li>
        <li>
          <p class={LABEL}>See it run</p>
          <h3><a href={demoBookingUrl}>Schedule a demo</a></h3>
          <p>
            A walk through the SDK and the console against your use case, before any agreement.
          </p>
        </li>
        <li>
          <p class={LABEL}>Legal questions</p>
          <h3>
            <a href="mailto:legal@open-e2ee.dev?subject=Legal%20question">
              legal@open-e2ee.dev
            </a>
          </h3>
          <p>
            A question about the <a href="/legal/signal-relay-terms">Signal Protocol Relay service terms</a>, the{' '}
            <a href="/legal/dpa">data processing agreement</a>, or a formal notice.
            For SDK license choices and required notices, read the <a href="/licensing">licensing page</a>
            or email your question here.
          </p>
        </li>
        <li>
          <p class={LABEL}>Privacy requests</p>
          <h3>
            <a href="mailto:privacy@open-e2ee.dev?subject=Privacy%20request">
              privacy@open-e2ee.dev
            </a>
          </h3>
          <p>
            A data-subject request, a question about the <a href="/legal/privacy">privacy notice</a>,
            or the <a href="/legal/subprocessors">subprocessor list</a>.
          </p>
        </li>
      </ul>
      <p class={TEXT_LINKS}>
        <a href="mailto:support@open-e2ee.dev">Customer support</a>
        <a href="/pricing">Pricing</a>
        <a href="/security">Security model</a>
      </p>
    </div>
  </section>
</BaseLayout>
