---
import BaseLayout from '../layouts/BaseLayout.astro';
import { checks, dependencies, docs, reporting, specifications } from '../lib/assurance.mjs';
import { startupTier } from '../data/pricing.mjs';

/*
 * The page for the reviewer, not the buyer.
 *
 * A platform or security engineer evaluating this SDK has a checklist, and
 * every item on it was already answered somewhere — in the threat model, the
 * protocol policy, the assurance summary, the licence. Scattered across four
 * repositories and three pages, "already answered" is indistinguishable from
 * "no answer". This page is the assembly: every question, the short answer,
 * and the primary source that wins any disagreement.
 *
 * It is deliberately not the pricing page. It links there once, at the end,
 * because a review usually precedes a purchase rather than following one.
 */
const answers = [
  {
    question: 'What is the threat model?',
    /* This answer stands alone — no adjacent paragraph qualifies it — so the
     * first-contact limit is in the out-of-scope list here, where the security
     * model itself puts it, rather than paraphrased away by an absolute. */
    answer:
      'Stated in full, with what is in scope and what is explicitly not. An attacker in control of your relay can serve stale or hostile responses and observe every routing field; the relay never needs message plaintext or device private keys, and once trust is pinned, an identity substitution that would reach them fails closed. Authenticity on unverified first contact without a safety-number check, compromised endpoints, hostile same-process code, guaranteed memory erasure, and traffic-analysis resistance beyond the implemented padding are out of scope.',
    links: [
      { href: '/security', label: 'Summary, with the envelope field by field' },
      { href: docs.securityModel, label: 'Security model and threat model' },
    ],
  },
  {
    question: 'Which protocol modes are supported, and which fail closed?',
    answer:
      'Post-quantum key agreement is the default and fails closed: PQXDH with ML-KEM-1024, and an ML-KEM Braid ratchet. There is no public disabled mode. Identity signatures remain classical Ed25519 and X25519, so the protection is against harvest-now-decrypt-later, not against a quantum adversary forging identities.',
    links: [{ href: docs.protocolPolicy, label: 'Protocol policy' }],
  },
  {
    question: 'Is it interoperable with Signal Messenger?',
    answer:
      'No, and deliberately not. The cryptographic core follows the published specifications — same key agreement, same ratchet — but the wire profile is its own. Messages, identities, and sessions do not cross between the two, and safety numbers will never match. Every difference is documented with its reason and its cost.',
    links: [{ href: docs.deviations, label: 'DEVIATIONS — every difference, and what it costs' }],
  },
  {
    question: 'What is the dependency footprint?',
    answer: `${dependencies.direct} direct production dependencies — ${dependencies.names.join(', ')} — resolving to ${dependencies.resolved} packages in total: the only transitive edges are the @noble packages depending on one another, so the resolved tree adds nothing the list above does not already name. Everything else in the tree is a development or optional peer dependency. Continuous integration runs a production-tree advisory audit at moderate severity on every change.`,
    links: [{ href: docs.thirdParty, label: 'Third-party notices' }],
  },
  {
    question: 'What is tested, and how do I know?',
    answer: `The most recent full run, on ${checks.measuredOn}, executed ${checks.modules} modules and ${checks.assertions} assertions with ${checks.failed} failures and ${checks.skipped} skipped. Coverage includes cryptographic known-answer checks against published vector data, conformance scenarios for session, group, and sealed-sender invariants, property-based checks, and the quickstart printed in the README, which is executed as written on every change. The checks live in a private engineering repository and the published repository is a filtered export of it, which is stated plainly rather than papered over.`,
    links: [{ href: docs.assurance, label: 'Assurance — what runs, what is published, and why' }],
  },
  {
    question: 'Has it been audited or validated?',
    answer:
      'Reviewed continuously by adversarial AI agents; not audited by any independent firm. Every change passes an adversarial AI review before it merges, and recurring whole-codebase AI audit passes run against the engineering repository. What that covers — and what it does not — is stated in the assurance summary. No independent firm has audited the SDK, and none is engaged. Separately, pure-JavaScript cryptography is not FIPS 140-validated, and no part of this SDK is offered as a validated cryptographic module. If your programme requires a validated module, this is the wrong choice and we would rather you learned it here than in week six.',
    links: [
      { href: docs.assurance, label: 'Assurance — what the checks cover, and what they do not' },
      { href: '/security', label: 'The limits we publish rather than bury' },
    ],
  },
  {
    question: 'What are the licence terms?',
    answer:
      `AGPL-3.0 for the complete SDK, with no held-back features. Proprietary products buy annual commercial production rights at a published price rather than by negotiation, starting at ${startupTier.price} ${startupTier.period}; Growth and Enterprise scopes are set by a signed order form.`,
    links: [
      { href: '/licensing', label: 'What AGPL use requires' },
      { href: '/legal/terms', label: 'Commercial terms' },
      { href: docs.license, label: 'LICENSE' },
    ],
  },
];
---

<BaseLayout
  title="Evaluate"
  description="The security review pack for the OpenE2EE Signal Protocol SDK: threat model, protocol policy, pinned specification revisions, dependency count, test figures, audit and validation status, licence terms, and how to reach us for a review."
>
  <header class="page-hero">
    <div class="container measure">
      <p class="label">Security review</p>
      <h1>Everything a reviewer asks for, on one page.</h1>
      <p class="lead">
        For the platform or security engineer who has been handed this SDK and a questionnaire.
        Each answer below is short and links to the document it came from; the documents win any
        disagreement with this page.
      </p>
      <p class="maturity">0.1.x alpha — public APIs and persisted formats may change before 1.0.</p>
    </div>
  </header>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>The questions, answered</h2>
      </div>
      <dl class="definition-rows">
        {answers.map((item) => (
          <div>
            <dt>{item.question}</dt>
            <dd>
              <p>{item.answer}</p>
              <p class="text-links">
                {item.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        <h2>Specifications, pinned by revision</h2>
        <p class="measure">
          The implementation follows its own versioned profile, based on these published
          specifications at these revisions. Mirrored from the SDK README, which is the maintained
          source.
        </p>
      </div>
      <div class="table-scroll">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">Specification</th>
              <th scope="col">Revision</th>
            </tr>
          </thead>
          <tbody>
            {specifications.map((spec) => (
              <tr>
                <th scope="row"><a href={spec.href}>{spec.name}</a></th>
                <td>{spec.revision}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container measure stack">
      <h2>Reporting a vulnerability</h2>
      <p>
        Email <a href={`mailto:${reporting.address}`}>{reporting.address}</a> rather than opening a
        public issue. Acknowledgment within {reporting.acknowledgment}, initial assessment within{' '}
        {reporting.assessment}. The full policy, including disclosure handling and severity
        targets, is in the repository.
      </p>
      <p class="text-links">
        <a href={docs.reporting}>Vulnerability reporting policy</a>
        <a href={docs.architecture}>Architecture and layer model</a>
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container measure stack">
      <h2>If you need more than documents</h2>
      <p>
        Enterprise and OEM agreements include a scoped security review, service levels, and
        negotiated portfolio or redistribution rights. That is a conversation rather than a
        checkout, and it starts with a meeting.
      </p>
      <div class="actions">
        <a class="oe-button" href="https://console.open-e2ee.dev/contact?plan=enterprise">
          Plan a security review
        </a>
        <a class="oe-button oe-button-secondary" href="/pricing">See what the tiers cover</a>
      </div>
      <p class="muted">
        For a question about the code, the threat model, or a questionnaire answer, email{' '}
        <a href="mailto:security@open-e2ee.dev">security@open-e2ee.dev</a>. You do not need a
        licence, a meeting, or an account first.
      </p>
    </div>
  </section>
</BaseLayout>
