---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { relayDevelopmentEnvironment, relayMeterDefinitions, relayOverages, relayPlans } from '../../data/relay-pricing.mjs';
import TableScroll from '../../components/TableScroll.astro';
import {
  BAND,
  BAND_HEAD,
  BAND_SURFACE,
  CONTAINER,
  CONTAINER_MEASURE,
  DATA_TABLE,
  DEFINITION_ROWS,
  LABEL,
  LEAD,
  MEASURE,
  PAGE_HERO,
  TEXT_LINKS,
} from '../../lib/recipes';
---

<BaseLayout
  title="OpenE2EE Relay pricing"
  description="OpenE2EE Relay production plans from Free through Starter, Growth, Business, and Enterprise, with an automatic Development environment for every project."
  canonical="/relay/pricing"
>
  <header class={PAGE_HERO}>
    <div class={CONTAINER_MEASURE}>
      <p class={LABEL}>OpenE2EE Relay pricing</p>
      <h1>Every Relay feature. Capacity that grows with the application.</h1>
      <p class={LEAD}>Groups, attachments, sealed sender, multi-device delivery, and push are available across tiers. Plans differ by capacity, support, service terms, and approved operational controls.</p>
    </div>
  </header>

  <section class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}><h2>Development environment included</h2></div>
      <p class={MEASURE}>Every project gets an automatic hosted Development environment. It is separate from the production plan and uses isolated state, credentials, limits, and lifecycle controls.</p>
      <dl class={DEFINITION_ROWS}>
        <div><dt>Relay MAU</dt><dd>{relayDevelopmentEnvironment.relayMau}</dd></div>
        <div><dt>Delivery units</dt><dd>{relayDevelopmentEnvironment.deliveryUnits} per month</dd></div>
        <div><dt>Attachment operations</dt><dd>{relayDevelopmentEnvironment.attachmentOperations} per month</dd></div>
        <div><dt>Exact live storage</dt><dd>{relayDevelopmentEnvironment.storage}</dd></div>
      </dl>
      <p class:list={['text-text-3', MEASURE]}>{relayDevelopmentEnvironment.detail}</p>
    </div>
  </section>

  <section class={BAND}>
    <div class={CONTAINER}>
      <TableScroll label="OpenE2EE Relay plans">
        <table class={DATA_TABLE} itemscope itemtype="https://schema.org/Product">
          <caption class="oe-visually-hidden" itemprop="name">OpenE2EE Relay plans and monthly limits</caption>
          <thead><tr><th scope="col">Plan</th><th scope="col">Monthly price</th><th scope="col">Relay MAU</th><th scope="col">Delivery units</th><th scope="col">Attachment operations</th><th scope="col">Exact live storage</th></tr></thead>
          <tbody>{relayPlans.map((plan) => <tr data-plan-id={plan.id} itemprop={plan.monthlyPriceUsd === null ? undefined : 'offers'} itemscope={plan.monthlyPriceUsd === null ? undefined : true} itemtype={plan.monthlyPriceUsd === null ? undefined : 'https://schema.org/Offer'}><th scope="row">{plan.name}<small>{plan.detail}</small></th><td>{plan.monthlyPriceUsd === null ? plan.price : <><meta itemprop="priceCurrency" content="USD" /><meta itemprop="price" content={String(plan.monthlyPriceUsd)} />{plan.price}</>}</td><td>{plan.relayMau}</td><td>{plan.deliveryUnits}</td><td>{plan.attachmentOperations}</td><td>{plan.storage}</td></tr>)}</tbody>
        </table>
      </TableScroll>
      <p class:list={['text-text-3', MEASURE]}>Paid prices are monthly. Taxes can apply. Production ciphertext retains for at most 30 days. The direct encrypted-envelope limit is 256 KiB. A mailbox holds at most 3,000 messages and can reach its project storage cap first.</p>
    </div>
  </section>

  <section class:list={[BAND, BAND_SURFACE]}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}><h2>Exact meters</h2></div>
      <dl class={DEFINITION_ROWS}>{relayMeterDefinitions.map((meter) => <div><dt>{meter.name}</dt><dd>{meter.definition}</dd></div>)}</dl>
    </div>
  </section>

  <section class={BAND}>
    <div class={CONTAINER}>
      <div class={BAND_HEAD}><h2>Optional paid overage</h2></div>
      <dl class={DEFINITION_ROWS}>
        <div><dt>Delivery</dt><dd>{relayOverages.delivery}</dd></div>
        <div><dt>Storage</dt><dd>{relayOverages.storage}</dd></div>
        <div><dt>Relay MAU</dt><dd>{relayOverages.relayMau}</dd></div>
        <div><dt>Attachment operations</dt><dd>{relayOverages.attachmentOperations}</dd></div>
      </dl>
      <p class={MEASURE}>Overage is off until an organization administrator accepts the rate and sets a monthly spend limit. Reaching that limit stops new billable work but preserves pull, acknowledgment, deletion, revocation, recovery, and mailbox draining.</p>
      <p class={TEXT_LINKS}><a href="https://console.open-e2ee.dev">Create a project</a><a href="/relay">What Relay operates</a><a href="/legal/relay-terms">Relay service terms</a><a href="/compare/virgil-security">Compare with Virgil Security</a></p>
    </div>
  </section>
</BaseLayout>
