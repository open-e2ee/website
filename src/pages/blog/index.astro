---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextStep from '../../components/NextStep.astro';
import { byPublication, readingMinutes } from '../../lib/article.mjs';
import {
  BAND,
  CONTAINER,
  CONTAINER_MEASURE,
  MEASURE,
  PAGE_HERO,
  TEXT_LINKS,
} from '../../lib/recipes';

/*
 * The index of posts. A ruled row per post, the date in its own column beside
 * the title and the description, and the whole row is the link.
 */
const POST_LIST = 'm-0 list-none p-0 [&>li]:rule-t';

const POST_LINK =
  'grid grid-cols-[minmax(7rem,9rem)_minmax(0,1fr)] gap-x-6 gap-y-0 py-8 text-[inherit] no-underline ' +
  'max-[44rem]:grid-cols-1 max-[44rem]:gap-2 ' +
  'hover:[&_h2]:underline hover:[&_h2]:[text-underline-offset:0.2em] ' +
  '[&_time]:pt-[0.4rem] [&_time]:font-[family-name:var(--oe-metadata-font-family)] ' +
  '[&_time]:text-[length:var(--oe-metadata-size)] [&_time]:font-medium ' +
  '[&_time]:tracking-[var(--oe-metadata-tracking)] [&_time]:text-text-3 ' +
  '[&_h2]:col-start-2 [&_h2]:text-[1.375rem] [&_h2]:tracking-[var(--oe-heading-tracking-text)] ' +
  '[&_p]:col-start-2 [&_p]:mt-2 [&_p]:max-w-[64ch] [&_p]:text-text-3 ' +
  'max-[44rem]:[&_h2]:col-start-1 max-[44rem]:[&_p]:col-start-1';

/*
 * What a row costs and what it is about.
 *
 * The rows carried a date, a title, and a description. A reader choosing
 * between three long essays had nothing to choose on: no length, and no
 * subject beyond the sentence they were already reading. Both values are
 * already on the post page, and both were absent here.
 *
 * A `<span>` rather than a second paragraph. `POST_LINK` dresses every `p` in
 * the row as the description, so a second one would arrive at the description's
 * size, color, and measure.
 */
const POST_META =
  'col-start-2 mt-3 flex flex-wrap gap-3 font-[family-name:var(--oe-metadata-font-family)] ' +
  'text-[length:var(--oe-metadata-size)] font-[var(--oe-metadata-weight)] ' +
  'tracking-[var(--oe-metadata-tracking)] text-text-3 max-[44rem]:col-start-1';

/*
 * One ordering, shared with the article's previous and next links through
 * src/lib/article.mjs. Every post on this journal carries the same publication
 * date, so a sort on the date alone leaves the order to whatever the loader
 * returns, and the index and the article can disagree about which post is
 * older.
 */
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byPublication);
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  /* content.config.ts coerces publishedAt to a UTC midnight Date. Without this,
   * Intl formats in the build machine's zone and every date west of Greenwich
   * renders one day early: the shipped cards read "Jul 24, 2026" beside a
   * datetime attribute of 2026-07-25. The same source built on a UTC runner
   * printed a different date, so this was also non-deterministic. */
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Engineering journal"
  description="Writing about JavaScript cryptography, protocol implementation, interoperability, and building encrypted applications."
>
  {/*
    One layer under the title, not three. Of eleven developer-infrastructure
    blog indexes measured, nine carry nothing under the heading and the longest
    description found is Cloudflare's at eighteen words. The heading itself is a
    plain label on every one of them — "Cloudflare Blog", "Blog", "Supabase
    Blog" — so the slogan that stood here is gone with the eyebrow that
    duplicated it and the description that restated both.
  */}
  <header class={PAGE_HERO}>
    <div class={CONTAINER_MEASURE}>
      <h1>Engineering journal</h1>
      <p class={TEXT_LINKS}>
        <a href="/rss.xml">Subscribe by RSS</a>
      </p>
    </div>
  </header>

  <section class={BAND}>
    <div class={CONTAINER}>
      {posts.length === 0 ? (
        <p class:list={['text-text-3', MEASURE]}>Nothing published yet.</p>
      ) : (
        <ul class={POST_LIST}>
          {posts.map((post) => (
            <li>
              <a class={POST_LINK} href={`/blog/${post.id}/`}>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {dateFormatter.format(post.data.publishedAt)}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class={POST_META}>
                  <span>{readingMinutes(post.body ?? '')} min read</span>
                  {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {/* The journal is three posts long, so the index ended at 918 px on a
          1390 px page and handed the rest to the site footer. The offer closes
          it, and it is the same offer the end of a post carries. */}
      <div class="mt-12"><NextStep /></div>
    </div>
  </section>
</BaseLayout>
