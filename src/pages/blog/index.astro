---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title="Engineering journal"
  description="Writing about JavaScript cryptography, protocol implementation, interoperability, and building encrypted applications."
>
  {/*
    One layer under the title, not three. Of eleven developer-infrastructure
    blog indexes measured, nine carry nothing under the heading and the longest
    description found is Cloudflare's at eighteen words. The heading itself is a
    plain label on every one of them — "Cloudflare Blog", "Blog", "Supabase
    Blog" — so the slogan that stood here is gone with the eyebrow that
    duplicated it and the description that restated both.
  */}
  <header class="page-hero">
    <div class="container measure">
      <h1>Engineering journal</h1>
      <p class="text-links">
        <a href="/rss.xml">Subscribe by RSS</a>
      </p>
    </div>
  </header>

  <section class="band">
    <div class="container">
      {posts.length === 0 ? (
        <p class="muted measure">Nothing published yet.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="post-link" href={`/blog/${post.id}/`}>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {dateFormatter.format(post.data.publishedAt)}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
