---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  CONTAINER_MEASURE,
  LABEL,
  LEAD,
  PAGE_HERO,
  TEXT_LINKS,
} from '../lib/recipes';
---

{/*
  Thirteen words and one link. The page used to carry a five-link recovery
  list, and every one of those destinations is in the header or the footer on
  the same screen — three of them under the identical label. A bespoke site map
  maintained by hand is what a 404 accumulates when the chrome is assumed not
  to work. Vercel, Stripe and Cloudflare all ship a single home link or none.
*/}
<BaseLayout title="Page not found" description="This page does not exist.">
  <header class={PAGE_HERO}>
    <div class={CONTAINER_MEASURE}>
      <p class={LABEL}>404</p>
      <h1>Page not found.</h1>
      <p class={LEAD}>The page moved, or the address is incomplete.</p>
      <p class={TEXT_LINKS}>
        <a href="/">Home</a>
      </p>
    </div>
  </header>
</BaseLayout>
