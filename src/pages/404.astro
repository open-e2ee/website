---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested OpenE2EE page could not be found.">
  <header class="page-hero">
    <div class="container measure">
      <p class="label">404</p>
      <h1>Nothing here to open.</h1>
      <p class="lead">
        The page may have moved, or the address may be incomplete. These are the ones worth having.
      </p>
      <p class="text-links">
        <a href="/">Home</a>
        <a href="/product">Signal Protocol SDK</a>
        <a href="/learn">How E2EE changes your architecture</a>
        <a href="/security">Security model</a>
        <a href="https://docs.open-e2ee.dev">Documentation</a>
      </p>
    </div>
  </header>
</BaseLayout>
