---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarrierPanel from '../components/CarrierPanel.astro';
import SignatureDiagram from '../components/SignatureDiagram.astro';

const differentiators = [
  {
    title: 'Pure TypeScript, everywhere your app runs',
    body: 'Expo, React Native, browsers, and Node from one package. No native modules, no prebuild step, no ejecting.',
  },
  {
    title: 'Post-quantum from the first handshake',
    body: 'PQXDH with ML-KEM establishes the session; the Double Ratchet carries it forward. Not a future roadmap item.',
  },
  {
    title: 'Your backend stays yours',
    body: 'Storage, relay, and encrypted-object adapters are composed by your application. We do not host anything, and nothing phones home.',
  },
  {
    title: 'The hard parts are included',
    body: 'Multi-device, groups, sealed sender, safety numbers, encrypted attachments and files — the work teams usually discover three months in.',
  },
  {
    title: 'Every claim is inspectable',
    body: 'The implementation, the protocol profile, the threat model, and the exact list of metadata the relay still sees are all published.',
  },
  {
    title: 'AGPL, or a commercial licence',
    body: 'The complete SDK is free under AGPL-3.0. Proprietary products buy annual production rights at a published price.',
  },
];

const trustLinks = [
  { href: '/security', label: 'What the relay can and cannot see' },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/SECURITY.md',
    label: 'The security model and threat model',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/ARCHITECTURE.md',
    label: 'Architecture and protocol profile',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js',
    label: 'View the SDK on GitHub',
  },
];
---

<BaseLayout
  title="OpenE2EE"
  description="Open-source, protocol-level end-to-end encryption for TypeScript. Your relay carries sealed envelopes it cannot read — in Expo, React Native, browsers, and Node."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Your relay carries it.<br />Your relay can&rsquo;t read it.</h1>
        <p class="lead">
          Pure TypeScript. Expo, React Native, browsers, and Node. Post-quantum PQXDH and the Double
          Ratchet, multi-device, groups, sealed sender, encrypted attachments. No native modules. No
          prebuild step.
        </p>
        <p class="honesty">
          It still sees metadata. We document exactly what, and what sealed sender does and
          doesn&rsquo;t hide.
        </p>
        <p class="maturity">0.1.0-alpha.1 — public APIs and persisted formats may change before 1.0.</p>
        <div class="actions">
          <a class="cta-primary" href="https://docs.open-e2ee.dev/getting-started">
            <span class="button">Build your first encrypted message</span>
            <span class="cta-sublabel">two clients · no account · no server</span>
          </a>
          <a class="button button-secondary" href="#what-the-relay-stores">See what the relay stores</a>
        </div>
        <p class="text-links">
          <a href="https://github.com/open-e2ee/signal-protocol-js">View the SDK on GitHub</a>
          <a href="/security">Read the security model</a>
        </p>
      </div>

      <div id="what-the-relay-stores">
        <CarrierPanel />
      </div>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>What you get, and what it costs you to find out</h2>
        <p class="measure">
          Six things that decide whether protocol-level encryption is workable for your product.
        </p>
      </div>
      <ul class="rows">
        {differentiators.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>One message, end to end</h2>
        <p class="measure">
          Plaintext and private keys exist only inside a device outline. Everything between them is
          sealed — and carries metadata your relay can still see.
        </p>
      </div>
      <div class="diagram">
        <SignatureDiagram />
      </div>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>Why this exists at all</h2>
        <p class="measure">
          If something else fit, you should use it. Here is the honest state of the alternatives;
          the full matrix, with links to every project, is in the SDK README.
        </p>
      </div>
      <dl class="definition-rows">
        <div>
          <dt>The official implementation</dt>
          <dd>
            <code>@signalapp/libsignal-client</code> is actively maintained and post-quantum, and it
            ships prebuilt native binaries for Windows, macOS, and Linux. It does not run in Expo,
            React Native, or a browser.
          </dd>
        </div>
        <div>
          <dt>The older JavaScript ports</dt>
          <dd>
            <code>libsignal-protocol-javascript</code> was archived in 2021.
            <code>@privacyresearch/libsignal-protocol-typescript</code> last shipped in 2023. Neither
            is post-quantum, and neither documents a React Native path.
          </dd>
        </div>
        <div>
          <dt>A different protocol</dt>
          <dd>
            <code>ts-mls</code> is well maintained and runs everywhere, but it implements MLS, not
            the Signal Protocol. That is a real choice — a different one.
          </dd>
        </div>
        <div>
          <dt>This SDK</dt>
          <dd>
            An independent TypeScript implementation of the published Signal Protocol
            specifications, running in the JavaScript runtimes your product already targets, with
            storage and transport left to you and a commercial licence available.
          </dd>
        </div>
      </dl>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js#how-it-compares">
          See the full comparison table
        </a>
        <a href="/product">See the SDK surface</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container measure">
      <figure class="quote">
        <blockquote>Use outside of Signal is unsupported.</blockquote>
        <figcaption>libsignal, the official implementation</figcaption>
      </figure>
      <p class="lead">So we built the one that is supported.</p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>Check the work</h2>
        <p class="measure">
          Not yet audited; an independent review is planned. Until then, every claim on this page
          has something you can read behind it.
        </p>
      </div>
      <ul class="rows rows-single">
        {trustLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
