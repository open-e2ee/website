---
import BaseLayout from '../layouts/BaseLayout.astro';
import BatteryMark from '../components/BatteryMark.astro';
import DemoConsole from '../components/demo/DemoConsole.astro';
import CommitLine from '../components/CommitLine.astro';
import DeckIcon from '../components/DeckIcon.astro';
import type { DeckIconName } from '../components/DeckIcon.astro';
import StarfieldMark from '../components/StarfieldMark.astro';
import HeroSnippet from '../components/HeroSnippet.astro';
import OsiMark from '../components/OsiMark.astro';
import PlatformStrip from '../components/PlatformStrip.astro';
import TypeScriptMark from '../components/TypeScriptMark.astro';
import { startupTier } from '../data/pricing.mjs';

/* Annotated rather than inferred: a bare array literal widens `icon` to
 * `string`, and the point of naming the icons is that a typo is a build error
 * instead of a row that silently renders nothing. `DeckIcon.astro` throws on an
 * unknown name for the same reason, one layer down. */
interface Differentiator {
  id?: string;
  title: string;
  icon: DeckIconName;
  body: string;
  link?: { href: string; label: string };
}

const differentiators: Differentiator[] = [
  {
    title: 'Pure TypeScript, everywhere your app runs',
    icon: 'code-square',
    /* "No native modules, no prebuild step, no ejecting" was true of the crypto
     * and false of the storage this site's own /product page documents: the
     * encrypted Expo store is expo-sqlite with SQLCipher, which Expo Go does
     * not carry. The limit belongs in the same breath as the capability.
     *
     * Appending the limit was not enough: "no prebuild step" and "needs a
     * development build" stayed in one sentence, and two readers called it a
     * contradiction, because a development build is native project generation
     * however it is spelled. The claim is now scoped the way the approved
     * proof point in docs/messaging.md §5 scopes it — to the *protocol code*,
     * which really is pure TypeScript — rather than to the package as a whole.
     * /product keeps the full reconciliation, where there is room to explain
     * that `npx expo prebuild` is not a command the reader types. */
    body: 'Expo, React Native, browsers, and Node from one package. The protocol code is pure TypeScript with no native crypto module to link — the encrypted Expo store uses SQLCipher, which needs a development build rather than Expo Go.',
  },
  {
    /* The cell closed on "Not a future roadmap item", which spends its last
     * sentence on what a competitor has not done. The default is the better
     * fact and it is the reader's: nothing to turn on, and the scope stated
     * with it. Both halves are the installed README's, which says the session
     * establishment is "on without configuration, and fail closed" and that
     * identities are classical Ed25519 — so the cell claims post-quantum for
     * key agreement, which is what ships, and not for signatures. */
    title: 'Post-quantum from the first handshake',
    icon: 'key',
    body: 'PQXDH with ML-KEM establishes every session and the Double Ratchet carries it forward, on without configuration and failing closed. Key agreement is post-quantum; identity signatures are Ed25519.',
  },
  {
    title: 'Your backend stays yours',
    icon: 'server',
    body: 'You compose the storage, relay, and encrypted-object adapters and run them where you already run things. We host nothing, and nothing phones home.',
  },
  {
    /* The clause here used to be "the work teams usually discover three
       months in". Two fresh readers flagged it independently and both were
       right: "three months" is a statistic, nobody measured it, and there are
       no teams to have measured it on. One wrote "unsourced vendor line —
       which teams? I discount it entirely", the other "a made-up number in a
       page that is otherwise scrupulous about sourcing". That is the exact
       trade the rest of the page refuses — borrowing the authority of a
       measurement without doing one — and it was buying a rhetorical beat.
       The replacement says the same thing as a fact about scope, which any
       reader can check against their own prototype.

       It then said "the parts a working one-to-one prototype still leaves to
       build", which is the same fact told as the reader's remaining work. The
       list is the value; naming what ships is enough. */
    title: 'The hard parts are included',
    icon: 'package',
    body: 'Multi-device, groups, sealed sender, safety numbers, encrypted attachments and files all ship in the same package as the one-to-one case. Each is a protocol in its own right.',
  },
  {
    title: 'Every claim is inspectable',
    icon: 'telescope',
    body: 'The implementation, the protocol profile, the threat model, and the exact list of metadata the relay holds are all published.',
  },
  {
    /* This cell said "at a published price" and showed no price, for the whole
     * loop. A fresh reader took the word "published" literally and was right
     * to: "it promises a number that is not on the page and not linked", and
     * they listed it as one of two go/no-go inputs they could not get. The
     * number existed the entire time — /pricing has carried $5,000 since
     * before this loop started, and the header links to it. The page was
     * being coy about the one fact a solo developer decides on.
     *
     * The price is read from the same module /pricing renders, so the two
     * surfaces cannot disagree. Naming the entry tier only, because "starts
     * at" is the honest shape of a three-tier table and the link carries the
     * rest. */
    id: 'agpl-or-commercial',
    title: 'AGPL, or a commercial license',
    icon: 'law',
    body: `The complete SDK is free under AGPL-3.0 — every feature, nothing time-limited. Closed-source products buy annual production rights, from ${startupTier.price} ${startupTier.period} for one product.`,
    link: { href: '/pricing', label: 'See the tiers' },
  },
  /*
   * The deck's one limit, and it is written as the property that produces it
   * rather than as a loss. Three fresh readers in two consecutive waves
   * arrived at that limit unaided and made it their largest gap: one asked
   * what happens to dispute resolution, fraud review and trust-and-safety; one
   * wrote that support messages under E2EE cannot be produced under subpoena,
   * cannot be supervised, and cannot have DLP run over them, and that "the
   * page never names the tradeoff — not to solve it, not even to acknowledge
   * it exists." Their shared conclusion was not that the product is wrong. It
   * is that a page which omits the one cost every evaluator finds in the first
   * meeting has not met an evaluator yet, and that reading is more expensive
   * than the cost itself.
   *
   * The answer to them was a cell titled "What you give up", with the band's
   * lead sending readers into it before anything else. The two are not in
   * conflict with a deck that states value: what the relay holds is the
   * property the whole product rests on, and what a backend can do with it
   * follows from that and nothing else. So the cell leads with the property,
   * and docs/messaging.md §1.2 — the limit is part of the claim, not a
   * disclaimer under it — is what keeps the rest of the sentence attached.
   *
   * The row named here is the one the demo directly above records, which is
   * the only reason this page can assert any of it. No regulation is named:
   * §2 bans "required for HIPAA / GDPR / SOC 2" outright, and the honest form
   * is the capability a team loses, not a rule someone must obey.
   *
   * The last sentence sends the wrong reader away on purpose. The brief
   * optimises for qualified starts of a ten-minute quickstart, and a team that
   * needs server-side moderation will discover this either way — the only
   * variable is whether they discover it here or after the ten minutes, and
   * only one of those two outcomes is repairable.
   *
   * It said "if your product needs any of that" for one round, and that was
   * too wide. A fresh reader building a marketplace pointed out that
   * client-side reporting — the user's own device attaches the plaintext to a
   * report — is a solved pattern, so the page was disqualifying products it
   * actually fits, in the last sentence they would read before closing the
   * tab. The condition is server-side capability, not the capability itself,
   * and the sentence still says so. It stops there deliberately: the SDK ships
   * no reporting API, and describing the client-side pattern as though it
   * were one would trade an over-disqualification for an invented feature.
   */
  {
    id: 'your-relay-holds-ciphertext',
    title: 'Your relay holds ciphertext',
    icon: 'lock',
    body: 'It stores the row the demo above records: ciphertext, with routing metadata on the outside. That row is all your backend can leak and all it can produce for a legal request, which is the same reason search, moderation, and restoring a user who has lost every device stay yours to design — the SDK ships encrypted device-to-device transfer to build the last one on. If any of the three has to run on your server, encrypt in transit and at rest instead.',
  },
];

/*
 * The runtime question is the first one a visitor has, and one quickstart per
 * runtime makes "does it run where I run" a click instead of a search. It sits
 * under the differentiator that raises it rather than in the hero, where three
 * more links were competing with the hero's primary action.
 */
const runtimes = [
  { href: 'https://docs.open-e2ee.dev/start/expo', label: 'Expo' },
  { href: 'https://docs.open-e2ee.dev/start/browser', label: 'Browser' },
  { href: 'https://docs.open-e2ee.dev/start/node', label: 'Node' },
];
---

<BaseLayout
  title="OpenE2EE"
  description="Add end-to-end encrypted messaging to a TypeScript app. The Signal Protocol in one npm package for Expo, React Native, browsers, and Node — your relay never needs message plaintext or device private keys."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        {/* "Add …" rather than naming the thing. The noun phrase described a
            category and left the reader to work out their own relationship to
            it; the verb states the job, and the job is the reason anyone is
            here — this goes into an app that already exists. It also puts the
            headline and the meta description into the same words, which they
            were not before. */}
        <h1>
          Add <span class="keep-together">end-to-end</span> encrypted messaging to your TypeScript
          app.
        </h1>
        {/* "Pure TypeScript" is the widest form of a scoped claim, and it is
            load-bearing that the scope is stated elsewhere. docs/messaging.md
            §5 approves the adjective of the *protocol code*; one level down the
            encrypted Expo store is expo-sqlite with SQLCipher and needs a
            development build. As its own sentence the phrase reads across the
            whole package, so the exception in the feature band below is not a
            footnote to it — it is the condition on it, and
            `tests/site-content.test.mjs` fails if the lead makes this claim
            while the page drops the exception.

            No runtime list and no adapter ownership in this paragraph. Both
            are on the page — the runtime links, and the quickstart caveat
            under the feature band — and the second line of the page is the position
            that decides whether a reader keeps reading, which is too expensive
            to spend on a compatibility matrix. The meta description carries the
            four names for a reader arriving from a search result.

            "Fully open source" took the slot "Drop-in E2EE" had, and the trade
            is deliberate. "Drop-in" was the only word here promising an easy
            integration, but the headline one line above already makes that
            promise in more words than a hyphen can — "Add … to your TypeScript
            app" is a verb about an app that already exists — and "Batteries
            included" carries the rest of it. What the page had nowhere above
            the fold was the licence, which is the first thing a developer
            evaluating a dependency wants and the one answer no competitor in
            this category can copy. "Fully" is the load-bearing word, and it is
            not decoration: the feature band below states that every feature is
            AGPL-3.0 with nothing time-limited, which is what makes the adverb
            true rather than promotional.

            Three fragments, three marks: one per clause, or the pattern reads
            as an accident. All three are now drawings rather than emoji. ⚡ went
            first — a bolt reads "fast" beside a clause that is not about speed,
            and TypeScript has a mark of its own that states the claim instead
            of decorating it. 🔋 followed, because one emoji left among two real
            marks is the accident rather than the pattern; `BatteryMark.astro`
            is drawn here, since "batteries included" is a figure of speech
            about defaults and nobody owns a mark for it.

            Only the keyhole is exposed to assistive technology, and only
            because it is a trademark drawn under conditions, one of which is
            that it links to opensource.org. The other two are aria-hidden:
            "TypeScript" and "batteries" are the nouns they stand before, so
            announcing them would repeat the sentence. See
            `src/components/OsiMark.astro` for the conditions, and for why that
            artwork is the solid mark rather than the outline one that shipped
            for a round and read as a smudge at this size. */}
        <p class="lead">
          {/* Keep each mark and the words around it on one line. Astro deletes
              the whitespace between a text run and an inline element, so
              wrapping this paragraph at a tag boundary silently joins a
              sentence to the mark after it — it rendered "Pure TypeScript.🔋"
              once. Where a line does have to break, the separator has to come
              back as an explicit {' '}. `tests/site-content.test.mjs` checks
              both edges of all three marks in the built HTML. */}
          <OsiMark /> Fully Open Source. <TypeScriptMark /> Pure TypeScript.{' '}
          <BatteryMark /> Batteries included.
        </p>
        <div class="actions">
          {/* Two actions, founder-set labels. The primary is the demo, not the
              quickstart: it scrolls to `#demo`, which is the exhibit itself
              and not the band around it, so the reader arrives at the running
              scene rather than at the sentence describing it. The
              GitHub button is gone from the hero — the repo stays one click
              away from the closing licence band, the footer, and /product, and
              a third button split the decision this row exists to force.

              No sublabel under either button. This page ends on the licence
              rather than on a second ask, so "ten minutes · two clients · no
              account" is only on the pages a reader reaches after deciding to
              spend them, /product and /learn. A scroll needs no time promise,
              and a third line of small grey type here would stand between the
              offer and the proof. */}
          <a class="cta-primary" href="#demo">
            <span class="oe-button">See Demo</span>
          </a>
          <a class="oe-button oe-button-secondary" href="https://docs.open-e2ee.dev/start/quickstart">
            Quickstart Docs
          </a>
        </div>
        {/* Below the actions, never above them. The hero headline's floor is
            33px specifically because at 390px that is the difference between a
            three-line and a four-line headline. At that width the action row's
            bottom measures 361px against a real-device fold of 664 (headless
            Chrome, 2026-08-09), so the row clears the fold — margin that
            anything inserted between the lead and the actions spends. The
            primary action staying above the fold is an acceptance gate rather
            than a preference.

            The runtime question is the first one a visitor has, and it was
            answered until now only by three links two screens down and a
            sentence in the feature band. This answers it where it is asked
            without bidding against the offer. */}
      </div>

      {/* A grid child rather than the last thing in `.hero-copy`, so it takes
          the container's full width like the install command and the code panel
          under it instead of the copy column's 48rem reading measure. Seven
          entries want more room than a paragraph does.

          No caveat paragraph under it. Store maturity is stated in the
          quickstart caveat under the feature band and on the Store selector's
          own labels, and the S3 qualification is carried by the heading
          plus the entry's name — see `src/lib/platform-marks.mjs`. Both are
          test-pinned to the installed SDK. */}
      <PlatformStrip />

      {/* The code panel sits under the offer now, rather than beside the copy
          in a second column, and it closes the hero.

          A column is the wrong thing to size a program to. The panel was the
          wide half of a 4.75/7.25 split — 645px — and the longest line of the
          ten variants is 91 characters, so the code had to be set at 13px by a
          desktop-only exception to make the two meet. Down the middle the
          panel is sized to the program instead: it takes whatever the code
          needs, and the size exception now runs the other way. The panel is
          52rem because 91 characters at 15px paint 754px, not the other way
          about; global.css states the arithmetic where the rule is.

          What a reader is deciding here is whether to spend ten minutes, and
          the question they ask first is what the API looks like — the
          two-column layout answered that for free by putting the panel level
          with the headline, and a single column only keeps it if the panel
          follows the offer directly. */}
      <div class="hero-demo">
        <HeroSnippet />
        {/* The caption, the "Not in this example, and yours to supply"
            disclosure list, and the objections group that followed — the two
            "Why not" paragraphs, the relay-formula line, and the maturity and
            licence line — were cut by founder decision on 2026-08-09 as
            explanatory hedging the hero does not carry. The facts they stated
            did not leave the site: /security carries the relay formula and the
            metadata admission, /product and /security carry the maturity line,
            the licence cell in the feature band names the AGPL/commercial
            split, the quickstart caveat below the feature band grades the
            stores, and /product carries the libsignal facts. */}
      </div>
    </div>
  </section>

  {/*
    The demo opens the page's evidence, directly after the code sample the
    hero closes on: the program a reader has just read is the program running
    here. The band starts at this heading, but `#demo` does not: the fragment
    is on the exhibit inside `DemoConsole.astro`, so that pressing Demo lands
    on the animation instead of on the paragraph above it. The reasoning is
    written where the id is, and `public/_redirects` sends /demo to the same
    fragment.
  */}
  <section class="band band-surface">
    <div class="container stack">
      {/*
        The demo is one exhibit across the page rather than a panel beside a
        figure, and the band's head is inside it: the console hangs Demo
        Settings off the heading's own line, which it can only do if the
        heading is under its root. That is the whole reason for the slot — the
        copy in it is still this page's, written here.

        The two-column arrangement that stood here put the drawing next to the
        controls and asked the reader to hold both. It also had a second window
        in it: the live panel's other end was a paired tab, so the most
        interesting half of an end-to-end demo was somewhere the reader had to
        go and open. Both are gone. Two SDK clients now run in this page, in one
        scene of three columns — a device, the relay, the other device — which is
        the same cast as the quickstart sample further up this page, and the same
        order the message travels in. Each column carries its own conversation
        and its own timings, so there is one exhibit rather than a drawing above
        a table restating it.

        The reasons the signature diagram left this slot still hold, and the
        drawing that replaced it is still answerable to each. It is not a
        restatement of the prose, because every state it shows was entered
        because the SDK reported something. It is not a second signature device:
        there is no mark in it, and the relay is drawn as infrastructure rather
        than as a brand, which is what stops it putting the vendor's logo on the
        one node this project insists the reader hosts. And it does not rest on
        the low-contrast content bars for its meaning — the figcaption under it
        is a live region stating every step in words, and the SVG is hidden from
        assistive technology because that caption already carries what it would
        announce.
      */}
      <DemoConsole>
        <Fragment slot="head">
          <h2>Live demo, in your browser</h2>
          {/* The heading makes the claim and the paragraph is the evidence for
              it, in that order. The band used to open on the end-to-end claim
              and reach the running program three clauses later, as a denial:
              "Not a mock-up". That asks a reader to rule out a mock-up before
              anyone has told them there is one. Founder's call, and the plainer
              shape: say it is live, then show what live means.

              Short sentences on purpose. This is the one band whose subject is
              the thing directly under it, so the copy's whole job is to get out
              of the way of it.

              "Ciphertext" and not "sealed". Sealed sender is a real feature of
              this SDK, and the row the relay stores in the scene below prints
              `senderUserId` in the clear. This caption stands directly over that
              row, so the loose sense of the word would promise what the evidence
              under it withholds.

              The sentence used to close on "and metadata", and the admission has
              not left the page with it: the carrier panel below prints every
              field the relay was recorded holding, and the "Every claim is
              inspectable" cell says the list is published. Naming it here as
              well made the shortest paragraph on the page carry the longest
              qualification.

              Which is also why the closing sentence is about plaintext and not
              about ciphertext. An "only sees ciphertext" formulation is the
              shorter line and it is false: the row two bands down prints
              `senderUserId`, `senderDeviceId` and `serverTimestamp` in the
              clear, so the page would be contradicted by its own evidence
              before a reader finished scrolling. Stated as a negative about
              plaintext the claim is exact, and it is the one the whole product
              rests on.

              `tests/site-content.test.mjs` pins the live-demo claim and "against
              the in-memory relay": the claim and its limit belong together, and
              the relay is the half that is simulated. `tests/demo-panel.test.mjs`
              pins "type a sentence", because the `<noscript>` inside the console
              exists to answer that offer.

              The offer itself is width-dependent: below 60rem the console gives
              way to the autonomous mobile loop and there is nothing to type
              into, so the sentence swaps its middle for what that reader
              actually gets. An offer that cannot be taken is the "nothing to
              press" defect this band has already paid for once. */}
          <p class="measure">
            <span class="demo-offer-wide">Type a sentence and the installed SDK encrypts it</span><span class="demo-offer-narrow">A scripted conversation plays through the installed SDK</span>{' '}
            against the in-memory relay. Keys stay on the devices. The relay never sees plaintext.
          </p>
        </Fragment>
      </DemoConsole>

      {/* The demo's own log is the only thing under the demo. The hero, the
          header, and the footer all carry the quickstart already. An offer
          repeated at every band boundary stops reading as an offer, and a link
          that scrolls the reader forward one band is furniture.

          "Start demo" is the one free-standing filled button in this band, and
          it sits over the scene it starts. Each device's "Send" carries the same
          fill and does not compete with it. It sits against its own text field
          inside a phone, as a form control. */}
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band-head">
        {/* "What you get, and what it costs you to find out" for eight rounds.
            The second half priced the reader's attention rather than naming
            anything the product does, which framed a deck of seven
            capabilities as a bill. A head with two halves also asks the
            reader to hold a structure before they have read a single cell —
            the rows do that work themselves. So: one clause, and the clause
            is the offer. */}
        <h2>What ships in the box</h2>
        <p class="measure">
          {/* The lead used to open on the deck's one limit and send the reader
              to that cell before any other: a reader whose product cannot live
              without server-side moderation left early and cheaply, which is
              worth more than the visit. It cost every other reader the band,
              though — a deck of seven capabilities that opens by naming the
              thing it cannot do reads as a warning rather than as an offer.
              The disqualifier is still on the page, last in the deck, written
              as the property it follows from. A reader who needs it recognises
              "Your relay holds ciphertext" from the demo they just watched.

              What is left is the count and the tense. Both are load-bearing:
              seven is what the reader is about to scroll, and "the first time
              you install it" is the claim the deck's own cells keep — nothing
              here is configured on, bought separately, or coming later. */}
          Seven things that are true the first time you install it.
        </p>
      </div>
      {/* `rows-iconed` and not `rows`: every other deck on the site is text,
          and this one gains an icon column, which changes the row's layout
          rather than its content. The icon carries no accessible name —
          `DeckIcon.astro` argues that where they are drawn — so the row reads
          exactly as it did before to anything that is not looking at it. */}
      <ul class="rows rows-iconed">
        {differentiators.map((item) => (
          <li id={item.id}>
            <DeckIcon name={item.icon} />
            <div class="row-body">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {/* Only the licence cell carries one. A row of links here would
                  flatten the band into a nav list; one link, on the one cell
                  whose answer lives on another page, reads as a continuation. */}
              {item.link && (
                <p class="row-link">
                  <a href={item.link.href}>{item.link.label}</a>
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p class="platform-links">
        <span>Start where you are:</span>
        {runtimes.map((runtime) => <a href={runtime.href}>{runtime.label}</a>)}
      </p>
      {/* This sentence tracks the shipped release, not a remembered one. The
          installed ADAPTERS.md marks no store experimental, so the sentence
          has one side; the maturity test derives both sides from that file,
          so a store the SDK newly marks fails the build instead of drifting
          into a page that quietly keeps grading it the old way. */}
      <p class="muted measure">
        The Expo, Node, browser, and bare React Native stores implement the storage interface
        in full.{' '}
        <a href="/product">What each store holds</a>.
      </p>
    </div>
  </section>

  {/* The hero calls the SDK fully open source three folds up, beside a mark
      drawn under OSI's trademark conditions. This band is where that adverb is
      cashed, for a reader who has scrolled the whole page and is deciding
      whether to take the dependency.

      The usual shape of this band on a developer site is social proof: a star
      count, a contributor wall, a "join us". That is unavailable — the public
      repository has one star and no forks — and a version built out of anything
      else would be the one band on the page making a claim a reader cannot
      check. So the band is about the reader's position instead, and it argues
      it in a drawing rather than in prose: four commits for what the licence
      hands over, and the line running on past them for the grant not expiring.
      `CommitLine.astro` holds the reasoning for the shape, including why it
      neither forks nor merges.

      OSI's mark is repeated here, and that is the expensive part. `OsiMark.astro`
      draws it in the hero at text size on the condition that it never reaches
      badge scale, because a larger use in a band headed by an open-source claim
      is the implied endorsement the trademark licence rules out. The star field
      draws it at badge scale anyway, at the founder's direction and in the
      page's own ink rather than OSI's; that file records the breach and what
      survives it. */}
  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        {/* Every verb is a use. "Change it" is accurate as a right and is how
            the free-software definition words it, but on a landing page next to
            a 0.x version number it reads as an invitation to fix something. */}
        <h2>Open Source — read, run, share, and build on</h2>
        {/* `docs/messaging.md` §4 renders the second option as "commercial
            license" and nothing else — the tier vocabulary it bans describes a
            different product shape, one where the free thing is the smaller
            thing. Here the two are the same build, so the sentence says what
            the licence changes instead: what you may ship, never what the code
            does. */}
        <p class="measure">
          AGPL-3.0-or-later, or a commercial license — the same build either way, every feature in
          the package, none of it time-limited.
        </p>
      </div>

      {/* The two figures carry this band between them: the graph says what the
