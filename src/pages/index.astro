---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarrierPanel from '../components/CarrierPanel.astro';
import HeroSnippet from '../components/HeroSnippet.astro';
import Icon from '../components/Icon.astro';
import SignatureDiagram from '../components/SignatureDiagram.astro';

const differentiators = [
  {
    title: 'Pure TypeScript, everywhere your app runs',
    body: 'Expo, React Native, browsers, and Node from one package. No native modules, no prebuild step, no ejecting.',
  },
  {
    title: 'Post-quantum from the first handshake',
    body: 'PQXDH with ML-KEM establishes the session; the Double Ratchet carries it forward. Not a future roadmap item.',
  },
  {
    title: 'Your backend stays yours',
    body: 'Storage, relay, and encrypted-object adapters are composed by your application. We do not host anything, and nothing phones home.',
  },
  {
    title: 'The hard parts are included',
    body: 'Multi-device, groups, sealed sender, safety numbers, encrypted attachments and files — the work teams usually discover three months in.',
  },
  {
    title: 'Every claim is inspectable',
    body: 'The implementation, the protocol profile, the threat model, and the exact list of metadata the relay still sees are all published.',
  },
  {
    title: 'AGPL, or a commercial license',
    body: 'The complete SDK is free under AGPL-3.0. Proprietary products buy annual production rights at a published price.',
  },
];

/*
 * The runtime question is the first one a visitor has, and one quickstart per
 * runtime makes "does it run where I run" a click instead of a search. It sits
 * under the differentiator that raises it rather than in the hero, where three
 * more links were competing with the one action the hero is for.
 */
const runtimes = [
  { href: 'https://docs.open-e2ee.dev/start/expo', label: 'Expo' },
  { href: 'https://docs.open-e2ee.dev/start/browser', label: 'Browser' },
  { href: 'https://docs.open-e2ee.dev/start/node', label: 'Node' },
];

/*
 * Everything a reader can check, in the band that exists to be checked. The
 * security model and the review pack used to sit in a third row of links in
 * the hero, where they read as afterthoughts to the CTA rather than as the
 * page's answer to "prove it".
 */
const trustLinks = [
  { href: '/security', label: 'What the relay can and cannot see' },
  { href: '/evaluate', label: 'The security review pack' },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/SECURITY.md',
    label: 'The security model and threat model',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/ARCHITECTURE.md',
    label: 'Architecture and protocol profile',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js',
    label: 'View the SDK on GitHub',
  },
];
---

<BaseLayout
  title="OpenE2EE"
  description="Open-source, protocol-level end-to-end encryption for TypeScript. Your relay carries sealed envelopes it cannot read — in Expo, React Native, browsers, and Node."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>End-to-end encryption for TypeScript, on the Signal Protocol.</h1>
        <p class="lead">
          Pure TypeScript, from one package: Expo, React Native, browsers, and Node. Post-quantum
          PQXDH and the Double Ratchet, multi-device, groups, sealed sender, encrypted attachments.
          No native modules. No prebuild step.
        </p>
        <p class="honesty">
          The relay never needs message plaintext or device private keys. It still sees metadata —
          we document exactly what, and what sealed sender does and doesn&rsquo;t hide.
        </p>
        <div class="actions">
          <a class="cta-primary" href="https://docs.open-e2ee.dev/start/quickstart">
            <span class="oe-button">Build your first encrypted message</span>
            <span class="cta-sublabel">ten minutes · two clients · no account</span>
          </a>
          <a class="oe-button oe-button-secondary" href="https://github.com/open-e2ee/signal-protocol-js">
            <Icon name="github" />
            View the SDK on GitHub
          </a>
        </div>
        {/* Closes the column rather than interrupting it. The rule above this
            line is what makes it read as the terms of the offer above, and a
            reader who has got this far has already seen the offer. */}
        <p class="maturity">0.1.x alpha — public APIs and persisted formats may change before 1.0.</p>
      </div>

      {/* The demo takes the side the proof panel used to hold. A reader
          deciding whether to spend ten minutes is asking what the API looks
          like, and this answers it without a click; the panel that answers
          "what does the relay actually hold" now sits with the diagram that
          raises the question. */}
      <div class="hero-demo">
        <HeroSnippet />
        <p class="muted">
          Send and receive, lifted from the quickstart as recorded.{' '}
          <a href="/product">See the whole file</a> — registering the devices with the relay, and
          Bob&rsquo;s own client, are real work this excerpt drops.
        </p>
      </div>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>What you get, and what it costs you to find out</h2>
        <p class="measure">
          Six things that decide whether protocol-level encryption is workable for your product.
        </p>
      </div>
      <ul class="rows">
        {differentiators.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
      <p class="platform-links">
        <span>Start where you are:</span>
        {runtimes.map((runtime) => <a href={runtime.href}>{runtime.label}</a>)}
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>One message, end to end</h2>
        <p class="measure">
          Plaintext and private keys exist only inside a device outline. Everything between them is
          sealed — and carries metadata your relay can still see.
        </p>
      </div>
      <div class="diagram">
        <SignatureDiagram />
      </div>

      {/* The diagram states it; this shows it. Keeping the two together means
          the claim and the recording are read in one pass, which is the whole
          argument of the band. */}
      <div id="what-the-relay-stores" class="carrier-proof">
        <h3>The same message, recorded</h3>
        <p class="measure">
          Not a mock-up: the plaintext as Bob&rsquo;s device decrypted it, and the row the relay
          held, captured by running the documented quickstart against the mock relay.
        </p>
        <CarrierPanel />
      </div>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>Why this exists at all</h2>
        <p class="measure">
          If something else fit, you should use it. Here is the honest state of the alternatives;
          the full matrix, with links to every project, is in the SDK README.
        </p>
      </div>
      <dl class="definition-rows">
        <div>
          <dt>The official implementation</dt>
          <dd>
            <code>@signalapp/libsignal-client</code> is actively maintained and post-quantum, and it
            ships prebuilt native binaries for Windows, macOS, and Linux. It does not run in Expo,
            React Native, or a browser.
          </dd>
        </div>
        <div>
          <dt>The older JavaScript ports</dt>
          <dd>
            <code>libsignal-protocol-javascript</code> was archived in 2021.
            <code>@privacyresearch/libsignal-protocol-typescript</code> last shipped in 2023. Neither
            is post-quantum, and neither documents a React Native path.
          </dd>
        </div>
        <div>
          <dt>A different protocol</dt>
          <dd>
            <code>ts-mls</code> is well maintained and runs everywhere, but it implements MLS, not
            the Signal Protocol. That is a real choice — a different one.
          </dd>
        </div>
        <div>
          <dt>This SDK</dt>
          <dd>
            An independent TypeScript implementation of the published Signal Protocol
            specifications, running in the JavaScript runtimes your product already targets, with
            storage and transport left to you and a commercial license available.
          </dd>
        </div>
      </dl>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js#how-it-compares">
          See the full comparison table
        </a>
        <a href="/product">See the SDK surface</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container measure">
      <figure class="quote">
        <blockquote>Use outside of Signal is unsupported.</blockquote>
        <figcaption>libsignal, the official implementation</figcaption>
      </figure>
      <p class="lead">So we built the one that is supported.</p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>Check the work</h2>
        <p class="measure">
          Not yet audited; an independent review is planned. Until then, every claim on this page
          has something you can read behind it.
        </p>
      </div>
      <ul class="rows rows-single">
        {trustLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
