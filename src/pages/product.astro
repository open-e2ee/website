---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignatureDiagram from '../components/SignatureDiagram.astro';
import capture from '../data/carrier-capture.json';

/*
 * Every subpath and symbol on this page is copied from the SDK's own public
 * surface. A marketing page that invents an import is a support ticket.
 */
const capabilities = [
  {
    title: 'Identity and trust',
    body: 'One versioned X25519 and Ed25519 composite tuple is the trust object. Safety numbers, rotation, and fail-closed trust mutation once an identity is pinned.',
    subpaths: ['./keys', './safety', './profile', './username'],
  },
  {
    title: 'Sessions and messaging',
    body: 'PQXDH establishment and the Double Ratchet, with post-quantum ratcheting, replay boundaries, skipped-key limits, and bounded state recovery.',
    subpaths: ['.', './client', './client/compose', './client/headless'],
  },
  {
    title: 'Devices and groups',
    body: 'Multi-device fan-out, provisioning and transfer flows, group state, and sealed sender.',
    subpaths: ['./device', './device/provisioning', './groups', './sealed-sender'],
  },
  {
    title: 'Attachments and files',
    body: 'Encrypted attachments and files with digest verification, retry decisions, and pointer metadata handled by the SDK.',
    subpaths: ['./media', './files'],
  },
  {
    title: 'Application integration',
    body: 'Lifecycle hooks, blocking, server clock skew handling, and typed errors your application can act on.',
    subpaths: ['./hooks', './blocking', './server-clock', './types'],
  },
  {
    title: 'Anonymous group credentials',
    body: 'ZK credential primitives, for products whose group membership should not be legible to the server.',
    subpaths: ['./zk/groups', './zk/credentials'],
  },
];

const adapters = [
  {
    role: 'Local store',
    body: 'Where protocol state lives on the device.',
    options: [
      './local/store/expo',
      './local/store/web',
      './local/store/node',
      './local/store/react-native',
      './local/store/mock',
    ],
  },
  {
    role: 'Secret vault',
    body: 'Where bootstrap secrets live, backed by a platform keystore.',
    options: ['./local/vault', './local/vault/expo-secure-store'],
  },
  {
    role: 'Relay',
    body: 'How sealed envelopes reach the other device. Your backend, your contract.',
    options: ['./remote/relay/convex', './remote/relay/mock', './remote/relay/types'],
  },
  {
    role: 'Object store',
    body: 'Where encrypted attachment bytes go.',
    options: ['./remote/object-store/convex-r2', './remote/object-store/s3'],
  },
];

/*
 * Mirrored from the "How it compares" table in the SDK README, which is the
 * maintained source and wins any disagreement. Every dated claim there was
 * measured from the GitHub and npm registry APIs on 2026-07-24; repeating the
 * measurement date rather than writing "currently" is what keeps this table
 * honest as it ages. Each alternative is a real project doing a real job.
 */
const COMPARED_ON = '2026-07-24';

const rivals = [
  { name: '@open-e2ee/signal-protocol-sdk', ours: true },
  { name: '@signalapp/libsignal-client', href: 'https://github.com/signalapp/libsignal' },
  {
    name: 'libsignal-protocol-javascript',
    href: 'https://github.com/signalapp/libsignal-protocol-javascript',
  },
  {
    name: '@privacyresearch/libsignal-protocol-typescript',
    href: 'https://github.com/privacyresearchgroup/libsignal-protocol-typescript',
  },
  { name: 'ts-mls', href: 'https://github.com/LukaJCB/ts-mls' },
];

const comparison = [
  {
    axis: 'Expo / React Native',
    cells: [
      'Yes',
      'No — Node native addon, prebuilt for Windows, macOS, and Linux only',
      'No',
      'No documented React Native path',
      'Yes',
    ],
  },
  {
    axis: 'Maintained',
    cells: [
      'Yes — 0.1.0-alpha, active',
      'Yes — very active',
      'No — archived, last push 2021-08-04',
      'No — last npm publish 2023-05-06, last repo push 2023-07-18',
      'Yes — very active',
    ],
  },
  {
    axis: 'Post-quantum',
    cells: [
      'Yes — PQXDH with ML-KEM, default, fails closed',
      'Yes',
      'No',
      'No',
      'Yes',
    ],
  },
  {
    axis: 'TypeScript-native',
    cells: ['Yes', 'No — Rust core with TypeScript bindings', 'No — JavaScript', 'Yes', 'Yes'],
  },
  {
    axis: 'Commercial license offered',
    cells: ['Yes', 'No — AGPL-3.0 only', 'No — GPL-3.0', 'No — GPL-3.0', 'Not needed — MIT'],
  },
];
---

<BaseLayout
  title="Signal Protocol SDK"
  description="Pure TypeScript Signal Protocol for Expo, React Native, browsers, and Node. Post-quantum PQXDH and the Double Ratchet, multi-device, groups, sealed sender, encrypted attachments."
>
  <header class="page-hero">
    <div class="container measure">
      <p class="label">Signal Protocol SDK</p>
      <h1>The Signal Protocol, where your app actually runs.</h1>
      <p class="lead">
        Pure TypeScript. Expo, React Native, browsers, and Node. Post-quantum PQXDH and the Double
        Ratchet, multi-device, groups, sealed sender, encrypted attachments. No native modules. No
        prebuild step.
      </p>
      <p class="honesty">
        It still sees metadata. We document exactly what, and what sealed sender does and
        doesn&rsquo;t hide.
      </p>
      <p class="maturity">0.1.x alpha — public APIs and persisted formats may change before 1.0.</p>
      <div class="actions">
        <a class="cta-primary" href="https://docs.open-e2ee.dev/start/quickstart">
          <span class="button">Build your first encrypted message</span>
          <span class="cta-sublabel">ten minutes · two clients · no account</span>
        </a>
        <a class="button button-secondary" href="https://github.com/open-e2ee/signal-protocol-js">
          View the SDK on GitHub
        </a>
      </div>
    </div>
  </header>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>Two clients, one relay, no account</h2>
        <p class="measure">
          The quickstart runs entirely on your machine against the development adapters. This is the
          whole program.
        </p>
      </div>
      <div class="code-block">
        <p class="code-filename">quickstart.ts</p>
        <pre><code>{capture.quickstartCode}</code></pre>
      </div>
      <p class="muted measure">
        <code>mockStore()</code> and <code>mockRelay()</code> are development adapters: in-memory, no
        auth, no durability. Swap them for a real store and relay when the shape of your integration
        is settled — the client code above does not change.
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        <h2>What the package covers</h2>
        <p class="measure">
          One coherent API surface, imported by subpath so your bundle only carries what you use.
        </p>
      </div>
      <ul class="rows">
        {capabilities.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="subpath-list">
              {item.subpaths.map((path) => <code>{path}</code>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>Composition, not configuration</h2>
        <p class="measure">
          Four boundaries are yours. You pass adapters into <code>createSignalProtocolClient</code>;
          the protocol logic above them never changes, and no credentials ever reach us.
        </p>
      </div>
      <dl class="definition-rows">
        {adapters.map((adapter) => (
          <div>
            <dt>{adapter.role}</dt>
            <dd>
              {adapter.body}
              <span class="subpath-list">
                {adapter.options.map((path) => <code>{path}</code>)}
              </span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="muted measure">
        Browser and bare React Native stores are experimental; the Expo and Node stores are the
        well-trodden paths. You can also implement <code>ISignalProtocolLocalStore</code> or{' '}
        <code>ISignalProtocolRelayServer</code> yourself — they are documented interfaces, not
        internals.
      </p>
      <div class="callout measure">
        <p>
          One caveat worth knowing before you plan a sprint: the encrypted local store uses{' '}
          <code>expo-sqlite</code> with SQLCipher, and SQLCipher requires a development build — it
          is not available in Expo Go. There is no native module of ours to link and{' '}
          <code>npx expo prebuild</code> is not involved, but you do need a dev build rather than
          the Expo Go sandbox.
        </p>
      </div>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js/blob/main/ADAPTERS.md">
          Adapter reference
        </a>
        <a href="https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/CLIENT_COMPOSITION.md">
          Client composition guide
        </a>
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        <h2>Where your data actually sits</h2>
        <p class="measure">
          Plaintext and private keys never leave a device outline. Your relay carries sealed
          envelopes, and those envelopes still have addresses on them.
        </p>
      </div>
      <div class="diagram">
        <SignatureDiagram />
      </div>
      <p class="text-links">
        <a href="/security">See exactly what the relay stores</a>
        <a href="/learn">Learn how E2EE changes your app</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>How it compares</h2>
        <p class="measure">
          If something else fits your product, use it. These are the five axes this SDK was built
          to change — not a quality ranking, and not an argument that the alternatives are bad at
          what they do. Measured from the GitHub and npm registry APIs on {COMPARED_ON}.
        </p>
      </div>
      <div class="table-scroll">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              {rivals.map((rival) => (
                <th scope="col">
                  {rival.ours ? <code>{rival.name}</code> : <a href={rival.href}><code>{rival.name}</code></a>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.axis}</th>
                {row.cells.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        Two things the columns cannot say on their own. <code>ts-mls</code> implements MLS (RFC
        9420), a different protocol with different properties — if MLS suits your product it is a
        good library, and its MIT licence already permits proprietary use, so the last row is not a
        cost it imposes. <code>@signalapp/libsignal-client</code> is the implementation Signal
        Messenger itself uses, and its README states that use outside Signal Messenger is
        unsupported.
      </p>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js#how-it-compares">
          The maintained version of this table, with every measurement
        </a>
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container measure stack">
      <h2>Licensing</h2>
      <p>
        The complete SDK is available under AGPL-3.0. Proprietary products purchase annual
        commercial production rights at a published price, starting at $5,000 per year.
      </p>
      <p class="text-links">
        <a href="/pricing">License for closed source</a>
        <a href="/licensing">Understand AGPL use</a>
      </p>
    </div>
  </section>
</BaseLayout>
