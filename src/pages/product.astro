---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SignatureDiagram from '../components/SignatureDiagram.astro';
import capture from '../data/carrier-capture.json';
import { codeThemes } from '../lib/code-theme.mjs';
import { MEASURED_ON, axes, libsignalReadme, notes, projects } from '../lib/comparison.mjs';
import { maturityLine } from '../lib/sdk.mjs';
import { startupTier } from '../data/pricing.mjs';

/*
 * Every subpath and symbol on this page is copied from the SDK's own public
 * surface. A marketing page that invents an import is a support ticket.
 */
const capabilities = [
  {
    title: 'Identity and trust',
    body: 'One versioned X25519 and Ed25519 composite tuple is the trust object. Safety numbers, rotation, and fail-closed trust mutation once an identity is pinned.',
    subpaths: ['./keys', './safety', './profile', './username'],
  },
  {
    title: 'Sessions and messaging',
    body: 'PQXDH establishment and the Double Ratchet, with post-quantum ratcheting, replay boundaries, skipped-key limits, and bounded state recovery.',
    subpaths: ['.', './client', './client/compose', './client/headless'],
  },
  {
    title: 'Devices and groups',
    body: 'Multi-device fan-out, provisioning and transfer flows, group state, and sealed sender.',
    subpaths: ['./device', './device/provisioning', './groups', './sealed-sender'],
  },
  {
    title: 'Attachments and files',
    body: 'Encrypted attachments and files with digest verification, retry decisions, and pointer metadata handled by the SDK.',
    subpaths: ['./media', './files'],
  },
  {
    title: 'Application integration',
    body: 'Lifecycle hooks, blocking, server clock skew handling, and typed errors your application can act on.',
    subpaths: ['./hooks', './blocking', './server-clock', './types'],
  },
  {
    title: 'Anonymous group credentials',
    body: 'ZK credential primitives, for products whose group membership should not be legible to the server.',
    subpaths: ['./zk/groups', './zk/credentials'],
  },
];

/*
 * Everything a reader can check, in the band that exists to be checked. These
 * links spent time in a third row under the homepage hero, where they read as
 * an afterthought to the CTA rather than as an answer to "prove it"; they are
 * on this page because the claims they answer for are on this page.
 *
 * A second entry here pointed at /evaluate as "the security review pack". That
 * page asked the questions /security answers and rendered the same pinned
 * specifications from the same module, so the two links sent a reader to one
 * body of content under two names. /security absorbed it and this list names
 * it once.
 */
const trustLinks = [
  { href: '/security', label: 'What the relay can and cannot see' },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/SECURITY.md',
    label: 'The security model and threat model',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/ARCHITECTURE.md',
    label: 'Architecture and protocol profile',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js',
    label: 'View the SDK on GitHub',
  },
];

const adapters = [
  {
    role: 'Local store',
    body: 'Where protocol state lives on the device.',
    options: [
      './local/store/expo',
      './local/store/web',
      './local/store/node',
      './local/store/react-native',
      './local/store/memory',
    ],
  },
  {
    role: 'Secret vault',
    body: 'Where bootstrap secrets live, backed by a platform keystore.',
    options: ['./local/vault', './local/vault/expo-secure-store'],
  },
  {
    role: 'Relay',
    body: 'How sealed envelopes reach the other device. Your backend, your contract.',
    options: ['./remote/relay/convex', './remote/relay/memory', './remote/relay/types'],
  },
  {
    role: 'Object store',
    body: 'Where encrypted attachment bytes go.',
    options: ['./remote/object-store/convex-r2', './remote/object-store/s3'],
  },
];

/*
 * The comparison lives here, in the two bands below, and used to be a page of
 * its own at /compare.
 *
 * It was a nav item because "why not libsignal" is the first question anyone
 * asks. But a reader only asks it while they are weighing this package, and
 * that is this page — sending them to a second route to find the answer put a
 * navigation step inside the one comparison they came to make, and split the
 * claims across two surfaces that each had to be kept true. The nav item is
 * gone, `public/_redirects` keeps `/compare` pointing at the first of these two
 * bands, and the homepage still summarises them in four rows.
 *
 * The data stays in src/lib/comparison.mjs. It is the one file on this site
 * that makes claims about other people's projects, and the homepage summary and
 * these bands read the same measurements so neither can drift from the other.
 */
const byKey = Object.fromEntries(notes.map((note) => [note.key, note]));
const ordered = projects.map((project) => ({ project, note: byKey[project.key] }));
---

<BaseLayout
  title="Signal Protocol SDK"
  description="Pure TypeScript Signal Protocol for Expo, React Native, browsers, and Node. Post-quantum PQXDH and the Double Ratchet, multi-device, groups, sealed sender, encrypted attachments."
>
  <header class="page-hero">
    <div class="container measure">
      <p class="label">Signal Protocol SDK</p>
      <h1>The Signal Protocol, where your app actually runs.</h1>
      {/* "No native modules. No prebuild step." was true of the crypto and false of the storage
          this page documents 100 lines further down: the encrypted Expo store is expo-sqlite with
          SQLCipher, which Expo Go does not carry. The lead contradicted its own page. Scoped here
          the way the landing page scopes it — to the protocol code, which really is pure
          TypeScript — because appending the limit to the unqualified claim was tried twice and
          read as a contradiction both times. The full reconciliation stays in the storage section,
          which has room to say that `npx expo prebuild` is not a command the reader types. */}
      <p class="lead">
        Expo, React Native, browsers, and Node from one package. Post-quantum PQXDH and the Double
        Ratchet, multi-device, groups, sealed sender, encrypted attachments. The protocol code is
        pure TypeScript with no native crypto module to link — the encrypted Expo store uses
        SQLCipher, which needs a development build rather than Expo Go.
      </p>
      <p class="maturity">{maturityLine}</p>
      <div class="actions">
        <a class="cta-primary" href="https://docs.open-e2ee.dev/start/quickstart">
          <span class="oe-button">Build your first encrypted message</span>
          <span class="cta-sublabel">ten minutes · two clients · no account</span>
        </a>
        <a class="oe-button oe-button-secondary" href="https://github.com/open-e2ee/signal-protocol-js">
          View the SDK on GitHub
        </a>
      </div>
    </div>
  </header>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>Two clients, one relay, no account</h2>
        <p class="measure">
          The quickstart runs entirely on your machine against the development adapters. This is the
          whole program.
        </p>
      </div>
      <div class="code-block">
        <p class="code-filename">quickstart.ts</p>
        {/* The same theme and the same reasons as the hero excerpt this page
            is the destination for — a reader who follows "See the whole file"
            should land on the same program, not a monochrome copy of it. */}
        <Code
          code={capture.quickstartCode}
          lang="ts"
          themes={codeThemes}
          defaultColor={false}
          role="group"
          aria-label="The quickstart program"
        />
      </div>
      <p class="muted measure">
        <code>inMemoryStore()</code> and <code>inMemoryRelay()</code> run the real protocol and the
        real cryptography against simulated infrastructure: no auth, no durability, nothing that
        outlives the process. Swap them for a real store and relay when the shape of your
        integration is settled — the client code above does not change.
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        <h2>What the package covers</h2>
        <p class="measure">
          One coherent API surface, imported by subpath so your bundle only carries what you use.
        </p>
      </div>
      <ul class="rows">
        {capabilities.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="subpath-list">
              {item.subpaths.map((path) => <code>{path}</code>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>Composition, not configuration</h2>
        <p class="measure">
          Four boundaries are yours. You pass adapters into <code>createSignalProtocolClient</code>;
          the protocol logic above them never changes, and no credentials ever reach us.
        </p>
      </div>
      <dl class="definition-rows">
        {adapters.map((adapter) => (
          <div>
            <dt>{adapter.role}</dt>
            <dd>
              {adapter.body}
              <span class="subpath-list">
                {adapter.options.map((path) => <code>{path}</code>)}
              </span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="muted measure">
        The Expo, Node, browser, and bare React Native stores implement{' '}
        <code>ISignalProtocolLocalStore</code> in full, so groups and multi-device work
        on any of them. They differ in where the bytes land: the Expo store is{' '}
        <code>expo-sqlite</code> with SQLCipher, the Node store is an encrypted filesystem under{' '}
        <code>node:crypto</code> with 0600 permissions, the browser store is IndexedDB scoped
        to the page&rsquo;s origin, and the bare React Native store writes through a key-value
        backend you supply and verify with the SDK&rsquo;s exported backend-conformance kit. You
        can also implement{' '}
        <code>ISignalProtocolLocalStore</code> or <code>ISignalProtocolRelayServer</code> yourself —
        they are documented interfaces, not internals.
      </p>
      <div class="callout measure">
        <p>
          One caveat worth knowing before you plan a sprint: the encrypted local store uses{' '}
          <code>expo-sqlite</code> with SQLCipher, and SQLCipher requires a development build — it
          is not available in Expo Go. There is no native module of ours to link and{' '}
          <code>npx expo prebuild</code> is not involved, but you do need a dev build rather than
          the Expo Go sandbox.
        </p>
      </div>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js/blob/main/ADAPTERS.md">
          Adapter reference
        </a>
        <a href="https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/CLIENT_COMPOSITION.md">
          Client composition guide
        </a>
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        <h2>Where your data actually sits</h2>
        <p class="measure">
          Plaintext and private keys never leave a device outline. Your relay carries sealed
          envelopes, and those envelopes still have addresses on them.
        </p>
      </div>
      <div class="diagram">
        <SignatureDiagram />
      </div>
      <p class="text-links">
        <a href="/security">See exactly what the relay stores</a>
        <a href="/learn">Learn how E2EE changes your app</a>
      </p>
    </div>
  </section>

  <section class="band" id="how-it-compares">
    <div class="container stack">
      <div class="band-head">
        <h2>How it compares</h2>
        <p class="measure">
          libsignal is excellent, actively maintained, and the most scrutinised Signal Protocol
          code there is. It is also a native Node addon that does not run in a browser, in Expo, or
          in React Native, and its maintainers say plainly that use outside Signal is not something
          they support. That is the gap.
        </p>
        {/* Both sentences, not the famous one on its own. The first is the
            licence answer and the second is the roadmap answer, and a reader
            planning a year of work needs the second one. src/lib/comparison.mjs
            keeps them as separate fields for the homepage, which has room for
            one. */}
        <figure class="quote">
          <blockquote>{libsignalReadme.quote} {libsignalReadme.continuation}</blockquote>
          <figcaption>
            <a href={libsignalReadme.href}>{libsignalReadme.attribution}</a>
          </figcaption>
        </figure>
        {/* Inside the band head, where /compare had it, and not a direct child
            of `.stack`. `.stack > *` sets `max-width: 100%` at the same
            specificity as `.measure` and is written after it, so a bare
            `.measure` paragraph parked directly in a stack was capped by
            nothing — eight elements rendered that way, three on the home page,
            three here, two on /security, until `.stack > .measure` in
            global.css restored the cap at child specificity. That eight was
            counted by computed max-width rather than by shape. Counting by
            shape gives ten, and both of the two extra are `callout measure`
            children of a stack — one here, one on /security. `.callout`
            capped them at the same 68ch all along, so the fix moved them by
            nothing. An element that is itself `container measure stack` was
            capped correctly throughout, because both rules only reach
            children, but that fact accounts for none of the gap: all three of
            those on this site are band children, never stack children.
            `.band-head` caps at 62ch and is unaffected. */}
        <p class="muted measure">
          Read from the GitHub API, the npm registry API, and the published package tarballs on
          {' '}{MEASURED_ON}. Dates are the ones those APIs returned. The axes are the ones this
          SDK was built to change, so the table is not a quality ranking — and the column for our
          own package is the one column nobody independent measured.
        </p>
      </div>
      <div class="table-scroll">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              {projects.map((project) => (
                <th scope="col">
                  {project.ours ? (
                    <code>{project.name}</code>
                  ) : (
                    <a href={project.href}><code>{project.name}</code></a>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {axes.map((row) => (
              <tr>
                <th scope="row">{row.axis}</th>
                {row.cells.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        A licence row is not a scorecard either. <code>ts-mls</code> is MIT, which already permits
        proprietary use, so &ldquo;no commercial licence offered&rdquo; costs its users nothing.
        Ours is AGPLv3 with a commercial licence available, which is a cost to some
        readers and the reason the row is there.
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        <h2>What each one is actually for</h2>
        <p class="measure">
          A table flattens the thing a table is worst at: what a project is good at. Two of the five
          below end with a recommendation that is not this SDK.
        </p>
        <p class="muted measure">
          {/* The explicit space is load-bearing, the same way it is in the
              homepage band that summarises these projects: Astro collapses the
              newline between a text node and a following inline element, and
              this rendered as "the top of`src/lib/comparison.mjs`". */}
          Take none of it on our word. Every project links to its repository, every date
          came from a public API, and the commands that read them are in the comment at the top of{' '}
          <code>src/lib/comparison.mjs</code>.
        </p>
      </div>
      <dl class="definition-rows">
        {ordered.map(({ project, note }) => (
          <div>
            <dt>
              {note.heading} —{' '}
              {project.ours ? (
                <code>{project.name}</code>
              ) : (
                <a href={project.href}><code>{project.name}</code></a>
              )}
            </dt>
            <dd>
              <p>{note.body}</p>
              <p class="verdict">{note.verdict}</p>
            </dd>
          </div>
        ))}
      </dl>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js#how-it-compares">
          The shorter table in the SDK README
        </a>
      </p>
    </div>
  </section>

  {/* Plain band, not band-surface. The comparison arrived as two bands rather
      than the one summary paragraph that used to link to /compare, so the
      alternation down this page shifted by one and this section absorbs it.
      tests/site-content.test.mjs checks the alternation on every page. */}
  <section class="band">
    <div class="container measure stack">
      <h2>Licensing</h2>
      <p>
        The complete SDK is available under AGPLv3. Proprietary products purchase annual
        commercial production rights at a published price, starting at {startupTier.price}{' '}
        {startupTier.period}.
      </p>
      <p class="text-links">
        <a href="/pricing">License for closed source</a>
        <a href="/licensing">Understand AGPLv3 use</a>
      </p>
    </div>
  </section>

  {/* This band closed the homepage until the landing page was cut back to the
      demo, the feature deck, and the licence. It answers "prove it" for a
      reader who has just read a page of capability claims, which is the page
      it belongs on now — /security states the same assurance sentence inside
      its published limits, at the length that page has room for. */}
  <section class="band band-surface">
    <div class="container">
      <div class="band-head">
        <h2>Check the work</h2>
        {/* The promise of a firm review was retired on 2026-08-09, when
            adversarial AI review became the assurance approach. docs/messaging.md
            §7 fixes the sentence and the rule that governs it: the two halves
            never separate, and no future firm engagement is promised in any
            tense. The band whose subject is what a reader can check is the last
            place the site should round up. */}
        <p class="measure">
          Reviewed continuously by adversarial AI agents; not audited by any independent firm.
          Every change passes an adversarial AI review before it merges, and recurring
          whole-codebase AI audit passes run against the engineering repository — so every claim
          on this page has something you can read behind it.
        </p>
      </div>
      <ul class="rows rows-single">
        {trustLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    The h1 was approved by founder review on 2026-08-09, so the proposed-copy
    annotation that used to close this page is gone. The design contract now
    requires the annotation only for proposed taglines, and this page no
    longer uses one; tests/site-content.test.mjs holds that line.
  */}
</BaseLayout>
