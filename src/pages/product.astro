---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MEASURED_ON, axes, libsignalReadme, notes, projects } from '../lib/comparison.mjs';
import { maturityLine } from '../lib/sdk.mjs';
import { startupTier } from '../data/pricing.mjs';

/*
 * Every subpath and symbol on this page is copied from the SDK's own public
 * surface. A marketing page that invents an import is a support ticket.
 *
 * Three of the six carry no body. `./device`, `./device/provisioning`,
 * `./groups` and `./sealed-sender` under the heading "Devices and groups" said
 * everything the sentence above them said, and the same held for Attachments
 * and files and for Application integration. The three that keep a body say
 * something the subpaths do not: what the trust object is, which protocols run,
 * and who the credentials hide membership from.
 */
const capabilities = [
  {
    title: 'Identity and trust',
    body: 'One versioned X25519 and Ed25519 tuple is the trust object. Safety numbers, rotation, and fail-closed trust mutation after pinning.',
    subpaths: ['./keys', './safety', './profile', './username'],
  },
  {
    title: 'Sessions and messaging',
    body: 'PQXDH and the Double Ratchet, with post-quantum ratcheting, replay boundaries, skipped-key limits, and bounded state recovery.',
    subpaths: ['.', './client', './client/compose', './client/headless'],
  },
  {
    title: 'Devices and groups',
    subpaths: ['./device', './device/provisioning', './groups', './sealed-sender'],
  },
  {
    title: 'Attachments and files',
    subpaths: ['./media', './files'],
  },
  {
    title: 'Application integration',
    subpaths: ['./hooks', './blocking', './server-clock', './types'],
  },
  {
    title: 'Anonymous group credentials',
    body: 'ZK credential primitives, for products whose group membership should not be legible to the relay.',
    subpaths: ['./zk/groups', './zk/credentials'],
  },
];

/*
 * Everything a reader can check, in the band that exists to be checked. These
 * links spent time in a third row under the homepage hero, where they read as
 * an afterthought to the CTA rather than as an answer to "prove it"; they are
 * on this page because the claims they answer for are on this page.
 *
 * A second entry here pointed at /evaluate as "the security review pack". That
 * page asked the questions /security answers and rendered the same pinned
 * specifications from the same module, so the two links sent a reader to one
 * body of content under two names. /security absorbed it and this list names
 * it once.
 */
const trustLinks = [
  { href: '/security', label: 'What the relay can and cannot see' },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/SECURITY.md',
    label: 'Threat model',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/ARCHITECTURE.md',
    label: 'Architecture',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/ASSURANCE.md',
    label: 'Assurance',
  },
  {
    href: 'https://github.com/open-e2ee/signal-protocol-js',
    label: 'SDK on GitHub',
  },
];

const adapters = [
  {
    role: 'Local store',
    body: 'Where protocol state lives on the device.',
    options: [
      './local/store/expo',
      './local/store/web',
      './local/store/node',
      './local/store/react-native',
      './local/store/memory',
    ],
  },
  {
    role: 'Secret vault',
    body: 'Where bootstrap secrets live, backed by a platform keystore.',
    options: ['./local/vault', './local/vault/expo-secure-store'],
  },
  {
    role: 'Relay',
    body: 'How sealed envelopes reach the other device. Use your own backend contract or OpenE2EE Relay.',
    options: ['./remote/relay/convex', './remote/relay/memory', './remote/relay/types'],
  },
  {
    role: 'Object store',
    body: 'Where encrypted attachment bytes go.',
    options: ['./remote/object-store/convex-r2', './remote/object-store/s3'],
  },
];

/*
 * The comparison lives here, in the two bands below, and used to be a page of
 * its own at /compare.
 *
 * It was a nav item because "why not libsignal" is the first question anyone
 * asks. But a reader only asks it while they are weighing this package, and
 * that is this page — sending them to a second route to find the answer put a
 * navigation step inside the one comparison they came to make, and split the
 * claims across two surfaces that each had to be kept true. The nav item is
 * gone, `public/_redirects` keeps `/compare` pointing at the first of these two
 * bands, and the homepage still summarizes them in four rows.
 *
 * The data stays in src/lib/comparison.mjs. It is the one file on this site
 * that makes claims about other people's projects, and the homepage summary and
 * these bands read the same measurements so neither can drift from the other.
 */
/* Column order, minus our own column. `notes` covers the four alternatives and
 * nothing else, so this joins on the note rather than on the project. */
const byKey = Object.fromEntries(notes.map((note) => [note.key, note]));
const ordered = projects
  .filter((project) => byKey[project.key])
  .map((project) => ({ project, note: byKey[project.key] }));
---

{/* The description was 178 characters, so a search result dropped the last two
    features. PQXDH is the post-quantum handshake, so naming it and
    "post-quantum" in the same list spends characters saying one thing twice.
    148 now. */}
<BaseLayout
  title="Signal Protocol SDK"
  description="Pure TypeScript Signal Protocol for Expo, React Native, browsers, and Node. PQXDH, Double Ratchet, multi-device, groups, sealed sender, attachments."
>
  <header class="page-hero">
    <div class="container measure">
      <p class="label">Signal Protocol SDK</p>
      {/* This h1 is not free copy. It is the `product-hero` entry in
          @open-e2ee/design's tagline registry, status `approved` since the founder
          review of 2026-08-09, and tests/site-content.test.mjs asserts this page is
          the one surface that carries it. The 2026-08-18 copy pass proposed cutting
          "actually" here with the site's four other uses of the word. Retiring an
          approved tagline is a founder call and a design-package change, so the
          word stays on this line alone. */}
      <h1>The Signal Protocol, where your app actually runs.</h1>
      {/* "No native modules. No prebuild step." was true of the crypto and false of the storage
          this page documents further down: the encrypted Expo store is expo-sqlite with SQLCipher,
          which Expo Go does not carry. The words that scope the claim are "the protocol code" and
          "crypto module", and they do the whole job. The SQLCipher limit was appended here as well,
          which put the same qualifier on the page twice and made the final sentence 28 words. It is
          stated once now, in the Composition callout that owns storage. */}
      <p class="lead">
        Expo, React Native, browsers, and Node from one package. Post-quantum PQXDH, the Double
        Ratchet, multi-device, groups, sealed sender, and encrypted attachments. The protocol code is
        pure TypeScript with no native crypto module to link.
      </p>
      <p class="maturity">{maturityLine}</p>
      <div class="actions">
        <a class="cta-primary" href="https://docs.open-e2ee.dev/start/quickstart">
          <span class="oe-button">Build your first encrypted message</span>
          <span class="cta-sublabel">ten minutes · two clients · no account</span>
        </a>
        <a class="oe-button oe-button-secondary" href="https://github.com/open-e2ee/signal-protocol-js">
          SDK on GitHub
        </a>
        <a class="oe-button oe-button-secondary" href="/relay">
          Managed Relay
        </a>
      </div>
    </div>
  </header>

  {/*
    "Two clients, one relay, no account" printed the whole 29-line quickstart
    here. The homepage code panel ships ten tabbed variants of that same
    program, including the in-memory pair, with the same identifiers and the
    same message string, and docs.open-e2ee.dev/start/quickstart owns the
    runnable file that the hero button already points at. A reader on this page
    arrived through the panel, or arrived to compare.

    Its one non-duplicated fact was that the in-memory adapters run the real
    protocol and the real cryptography against simulated infrastructure. The
    Composition band lists ./local/store/memory and ./remote/relay/memory, so
    that fact is stated there.

    The `Code` component, the shared code theme, and the carrier-capture import
    that fed it left the page with the band.
  */}
  {/* Surfaces re-flipped down the page. Three bands left the tree in this pass
      and the alternation shifted with them; tests/site-content.test.mjs checks
      it on every page. */}
  <section class="band">
    <div class="container stack">
      <div class="band-head">
        <h2>What the package covers</h2>
        <p class="measure">
          One coherent API surface, imported by subpath so your bundle only carries what you use.
        </p>
      </div>
      <ul class="rows">
        {capabilities.map((item) => (
          <li>
            <h3>{item.title}</h3>
            {item.body && <p>{item.body}</p>}
            <p class="subpath-list">
              {item.subpaths.map((path) => <code>{path}</code>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container stack">
      <div class="band-head">
        {/* "Composition, not configuration" was an X-not-Y heading that also
            failed as navigation: a reader scanning for the adapter list could
            not tell this band held it. The lead's own first clause is the
            heading, and it names the thing the band lists. */}
        <h2>Four adapter boundaries you own</h2>
        <p class="measure">
          You pass adapters into <code>createSignalProtocolClient</code>. The protocol logic
          above them does not change.
        </p>
      </div>
      <dl class="definition-rows">
        {adapters.map((adapter) => (
          <div>
            <dt>{adapter.role}</dt>
            <dd>
              {adapter.body}
              <span class="subpath-list">
                {adapter.options.map((path) => <code>{path}</code>)}
              </span>
            </dd>
          </div>
        ))}
      </dl>
      {/* The second sentence here ran 57 words listing four stores and the
          conformance kit. It is four clauses now. "expo-sqlite with SQLCipher"
          was stated in it and again in the callout four lines below, so this
          keeps the store name and the callout keeps the consequence.

          "npx expo prebuild is not involved" is gone rather than defended.
          messaging.md §5 lists native project generation as a requirement of
          the Expo SQLCipher store, and positioning.md §3 records that Expo
          build tools can run Prebuild on the reader's behalf. The defensible
          claim is that the reader does not type the command, which is not worth
          a clause. */}
      <p class="muted measure">
        The Expo, Node, browser, and bare React Native stores implement{' '}
        <code>ISignalProtocolLocalStore</code> in full, so groups and multi-device work on any of
        them. They differ in where the bytes land. Expo uses{' '}
        <code>expo-sqlite</code> with SQLCipher, and Node an encrypted filesystem under{' '}
        <code>node:crypto</code> with 0600 permissions. The browser uses IndexedDB scoped to the
        page&rsquo;s origin, and bare React Native a key-value backend you supply.{' '}
        <code>ISignalProtocolLocalStore</code> and <code>ISignalProtocolRelayServer</code> are
        documented interfaces, so you can write your own.
      </p>
      <div class="callout measure">
        <p>
          The Expo store needs a development build, because SQLCipher is not available in Expo Go.
          There is no native module of ours to link.
        </p>
      </div>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js/blob/main/ADAPTERS.md">
          Adapter reference
        </a>
        <a href="https://github.com/open-e2ee/signal-protocol-js/blob/main/docs/CLIENT_COMPOSITION.md">
          Client composition guide
        </a>
      </p>
    </div>
  </section>

  {/*
    "Where your data actually sits" stood here and rendered
    src/components/SignatureDiagram.astro, which /security also renders. Not a
    similar band: the same component, under a paraphrase of the same sentence.

    messaging.md §3 requires the fixed relay formula everywhere the question
    "what does the server see" arises. This band raised that question and the
    page carried the formula zero times, while /security opens with it verbatim
    and draws the same picture underneath. Cutting the band resolves both ends:
    the question stops being asked on the wrong page, and the reader meets the
    formula where it is stated. "Check the work" below already links /security
    as "What the relay can and cannot see".
  */}
  <section class="band" id="how-it-compares">
    <div class="container stack">
      <div class="band-head">
        <h2>How it compares</h2>
        {/* "That is the gap." was a rhetorical closer, and the clause before it
            paraphrased the blockquote printed four lines below. The quotation is
            the evidence, so it makes that half of the point in the
            maintainers' own words. */}
        <p class="measure">
          libsignal is the most scrutinized Signal Protocol code there is, and it is actively
          maintained. It is also a Node native addon with no browser, Expo, or React Native build.
        </p>
        {/* Both sentences, not the famous one on its own. The first is the
            license answer and the second is the roadmap answer, and a reader
            planning a year of work needs the second one. src/lib/comparison.mjs
            keeps them as separate fields for the homepage, which has room for
            one. */}
        <figure class="quote">
          <blockquote>{libsignalReadme.quote} {libsignalReadme.continuation}</blockquote>
          <figcaption>
            <a href={libsignalReadme.href}>{libsignalReadme.attribution}</a>
          </figcaption>
        </figure>
        {/* Inside the band head, where /compare had it, and not a direct child
            of `.stack`. `.stack > *` sets `max-width: 100%` at the same
            specificity as `.measure` and is written after it, so a bare
            `.measure` paragraph parked directly in a stack was capped by
            nothing — eight elements rendered that way, three on the home page,
            three here, two on /security, until `.stack > .measure` in
            global.css restored the cap at child specificity. That eight was
            counted by computed max-width rather than by shape. Counting by
            shape gives ten, and both of the two extra are `callout measure`
            children of a stack — one here, one on /security. `.callout`
            capped them at the same 68ch all along, so the fix moved them by
            nothing. An element that is itself `container measure stack` was
            capped correctly throughout, because both rules only reach
            children, but that fact accounts for none of the gap: all three of
            those on this site are band children, never stack children.
            `.band-head` caps at 62ch and is unaffected. */}
        <p class="muted measure">
          Read from the GitHub API, the npm registry API, and the published package tarballs on
          {' '}{MEASURED_ON}. Dates are the ones those APIs returned. The axes are the ones this SDK
          was built to change, not a quality ranking. Nobody independent measured our own column.
        </p>
      </div>
      <div class="table-scroll">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              {projects.map((project) => (
                <th scope="col">
                  {project.ours ? (
                    <code>{project.name}</code>
                  ) : (
                    <a href={project.href}><code>{project.name}</code></a>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {axes.map((row) => (
              <tr>
                <th scope="row">{row.axis}</th>
                {row.cells.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {/* Three spellings of "licence" against a table row headed "Commercial
          license offered", and the note quoted that row back as "no commercial
          licence offered" where the cell reads "Not needed — MIT".
          messaging.md §4 approves "commercial license". "A licence row is not a
          scorecard either" was an invented contrast whose "either" pointed at
          the note above it. */}
      <p class="muted measure">
        <code>ts-mls</code> is MIT, which already permits proprietary use, so that row costs its
        users nothing. This SDK is AGPLv3 with a commercial license available, which is a real cost
        to some readers.
      </p>
      {/*
        "What each one is actually for" was a band of its own here: five
        definition rows of 50 to 91 words, 39 percent of the page's prose, each
        re-describing in sentences what a cell of the table above states. The
        libsignal body alone repeated five cells. The entry for this SDK
        restated the hero and printed the audit formula a second time, 300 words
        before "Check the work" prints it again.

        The verdicts are what the table cannot carry, and two of the four send
        the reader somewhere else, so they sit under the rows they follow from.
        There is no verdict for our own column because the table is the case
        for it.
      */}
      <dl class="definition-rows">
        {ordered.map(({ project, note }) => (
          <div>
            <dt>
              {note.heading} &mdash;{' '}
              <a href={project.href}><code>{project.name}</code></a>
            </dt>
            <dd>{note.verdict}</dd>
          </div>
        ))}
      </dl>
      <p class="muted measure">
        {/* The explicit space is load-bearing, the same way it is in the
            homepage band that summarizes these projects: Astro collapses the
            newline between a text node and a following inline element, and
            this rendered as "the top of`src/lib/comparison.mjs`". */}
        Every project links to its repository, and every date came from a public API. The commands
        are in the comment at the top of{' '}
        <code>src/lib/comparison.mjs</code>.
      </p>
      <p class="text-links">
        <a href="https://github.com/open-e2ee/signal-protocol-js#how-it-compares">
          The shorter table in the SDK README
        </a>
      </p>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container measure stack">
      <h2>Licensing</h2>
      <p>
        The complete SDK is available under AGPLv3. Proprietary products purchase annual
        commercial production rights at a published price, starting at {startupTier.price}{' '}
        {startupTier.period}.
      </p>
      <p class="text-links">
        <a href="/pricing">Pricing</a>
        <a href="/licensing">Licensing</a>
      </p>
    </div>
  </section>

  {/* This band closed the homepage until the landing page was cut back to the
      demo, the feature deck, and the license. It answers "prove it" for a
      reader who has just read a page of capability claims, which is the page
      it belongs on now — /security states the same assurance sentence inside
      its published limits, at the length that page has room for. */}
  <section class="band">
    <div class="container">
      <div class="band-head">
        <h2>Check the work</h2>
        {/* The promise of a firm review was retired on 2026-08-09, when
            adversarial AI review became the assurance approach. docs/messaging.md
            §7 fixes the sentence and the rule that governs it: the two halves
            never separate, and no future firm engagement is promised in any
            tense. The band whose subject is what a reader can check is the last
            place the site should round up. */}
        {/* The expansion used to end "— so every claim on this page has
            something you can read behind it", which is a rhetorical conclusion
            in the place messaging.md §7 puts the one pointer a security
            reviewer needs. ASSURANCE.md was unreachable from the band whose
            subject is what a reader can check; it is the fifth link now. */}
        <p class="measure">
          Reviewed continuously by adversarial AI agents; not audited by any independent firm. Every
          change passes an adversarial AI review before it merges, and recurring whole-codebase AI
          audit passes run against the engineering repository. The assurance summary states what
          that covers and what it does not.
        </p>
      </div>
      <ul class="rows rows-single">
        {trustLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    The h1 was approved by founder review on 2026-08-09, so the proposed-copy
    annotation that used to close this page is gone. The design contract now
    requires the annotation only for proposed taglines, and this page no
    longer uses one; tests/site-content.test.mjs holds that line.
  */}
</BaseLayout>
