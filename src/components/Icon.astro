---
/*
 * The chrome icons, inlined so they inherit `currentColor` and cost no
 * request.
 *
 * The paths come from `@open-e2ee/design/icons` rather than living here. They
 * used to live here because the design system owned no icon set; it does now,
 * and the console draws the same six from the same source. The package ships
 * geometry rather than a component precisely so this file can stay Astro while
 * the console's stays React — the element is ours, the drawing is not.
 *
 * Octicons 19.32.0 (MIT, GitHub Inc.); the license text ships with the package
 * and is recorded in THIRD_PARTY_NOTICES.md. The GitHub mark has to be the real
 * one — an approximation of someone else's trademark is worse than no mark at
 * all — and taking the rest from the same family keeps one drawing hand across
 * the header.
 *
 * These are interface chrome, not diagram grammar. DESIGN.md's material law
 * (open is outlined, opaque is filled) governs what a shape *means* inside a
 * diagram; a theme switch is not making a claim about encryption.
 */
import { ICON_VIEW_BOX, iconPaths } from '@open-e2ee/design/icons';
import type { IconName } from '@open-e2ee/design/icons';

export type { IconName };

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

/* An unknown name would otherwise render an empty <svg>: a control with no
   visible label, which is the thing the icon was there to prevent. */
const paths = iconPaths[name];
if (!paths) {
  throw new Error(`Icon "${name}" is not in @open-e2ee/design/icons`);
}
---

<svg
  class:list={['oe-icon', className]}
  viewBox={ICON_VIEW_BOX}
  width="16"
  height="16"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {paths.map((d) => <path d={d} />)}
</svg>
