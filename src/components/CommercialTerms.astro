---
/*
 * One document, two routes: `/legal/terms` is what a new order accepts, and
 * `/legal/terms/2026-07-23` is the immutable copy an existing order is bound to.
 * They render from this component so the two can never drift while they are the
 * same version; publishing a new version means a new dated page, not an edit.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  commercialTermsEffectiveDate,
  commercialTermsPath,
  commercialTermsVersion,
} from '../lib/legal.mjs';

interface Props {
  canonical: string;
}

const { canonical } = Astro.props;
---

<BaseLayout
  title="Terms"
  description="Website terms and versioned Startup commercial license terms for OpenE2EE."
  canonical={canonical}
>
  <article>
    <header class="article-header">
      <div class="container article-column">
        <a class="back-link" href="/legal">Legal</a>
        <h1>Terms of Service and Startup Commercial License Terms</h1>
        <p class="lead">
          These Terms govern the OpenE2EE website, documentation, console, and each self-service
          Startup commercial license order.
        </p>
        <p class="article-meta">
          <span>Effective {commercialTermsEffectiveDate}</span>
          <span>Version {commercialTermsVersion}</span>
        </p>
        <p class="legal-pin">
          Startup checkout records the version you accept. The immutable copy of this one is
          published at <a href={commercialTermsPath}><code>{commercialTermsPath}</code></a>.
        </p>
      </div>
    </header>

    <div class="container article-column">
      <div class="prose">
        <aside class="callout" aria-label="Agreement summary">
          <p class="label">Startup order summary</p>
          <p>
            One named legal entity receives annual proprietary production rights for one named
            product using <code>@open-e2ee/signal-protocol-sdk</code>. The current list price is
            $5,000 per year plus applicable taxes. The subscription renews annually until canceled.
          </p>
        </aside>

        <nav class="legal-toc" aria-label="Terms contents">
          <p class="label">Contents</p>
          <ol>
            <li><a href="#agreement">Agreement and authority</a></li>
            <li><a href="#website">Website and open-source materials</a></li>
            <li><a href="#commercial-license">Startup commercial license</a></li>
            <li><a href="#fees-renewal">Fees, renewal, and cancellation</a></li>
            <li><a href="#ownership">Ownership and third-party materials</a></li>
            <li><a href="#security">Customer responsibilities and security</a></li>
            <li><a href="#warranties">Disclaimers and liability</a></li>
            <li><a href="#termination">Term and termination</a></li>
            <li><a href="#changes">Changes to these Terms</a></li>
            <li><a href="#general">General terms</a></li>
          </ol>
        </nav>

        <h2 id="agreement">1. Agreement and authority</h2>
        <p>
