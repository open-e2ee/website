---
import { Code } from 'astro:components';
import Icon from './Icon.astro';
import { codeThemes } from '../lib/code-theme.mjs';
import {
  defaultVariant,
  installCommand,
  relayOptions,
  snippetVariants,
  storageOptions,
} from '../lib/hero-snippet.mjs';

/*
 * The demo, for a package. A developer decides whether an SDK is worth ten
 * minutes by looking at the shape of its API, and until now the homepage
 * asked them to take that on trust and click through.
 *
 * The snippet is no longer one fixed excerpt. `src/lib/hero-snippet.mjs`
 * builds ten of them — five device stores by two relays — and all ten are
 * rendered here at build time. That is the only way this can work under the
 * CSP: `script-src 'self'` has no room for a highlighter, so a variant that
 * did not exist before the page loaded could never be colored. Ten complete
 * programs is a few kilobytes of HTML and no runtime cost at all.
 */
---

{/*
  The install line reads as a terminal now, and it is its own panel rather than
  the code block's header row.

  It was set in the metadata style — 12px, muted, on the ruled top edge of the
  snippet — which is the treatment this site gives captions and bills of
  materials. So the one line a reader is meant to take away with them was the
  quietest thing in the panel, and it looked like a label for the code rather
  than a command to run. It moved onto Ghostty's own surface with a prompt in
  front of it, and it is now set a step above the code rather than under it.

  That step was a correction to this note as much as to the page. It read "the
  same size as code" for several rounds and the two were never the same size:
  the command was a flat 13.5px while the panel below it solves for its own
  width and renders at 17.2px. The claim was true of the intent and false of the
  render, which is the kind of comment that stops anyone from re-checking the
  thing it describes. The sizes are now related by a written ratio in
  `global.css` instead of by an assertion here, and a test holds it.

  Nothing is drawn around it. A titlebar strip and a block cursor were both
  tried and both removed: Ghostty draws neither — it is a native window with
  the desktop's own furniture, and its cursor belongs to the shell session, not
  to a command sitting on a page. The fill, the `$` and the mono face are the
  quotation, and they are the whole of it.

  The `$` is decoration in the strict sense: it carries no information a reader
  needs and it must never end up in what they paste. It is `aria-hidden`, it is
  `user-select: none` so a drag-select skips it, and the button copies
  `data-copy` — the command string itself — rather than the element's text.
  Three independent paths to the same guarantee, because a prompt glyph in a
  pasted command is the classic way a copy affordance wastes someone's minute.
*/}
{/*
  The one number `global.css` cannot work out for itself.

  The row fits its width by solving for a font size, and the solution needs the
  length of the string. That string is the installed package's name, so a
  rename moves it — and a constant in the stylesheet would keep the old length
  and either wrap the line again or leave it smaller than it has to be, with
  nothing failing. Passing it from the same module the command comes from is
  what makes the two impossible to separate.
*/}
<div class="terminal" style={`--terminal-command-chars: ${installCommand.length}`}>
  <p class="terminal-line">
    <span class="terminal-prompt" aria-hidden="true">$</span>
    <span class="terminal-command">{installCommand}</span>
    <button
      type="button"
      class="copy-button terminal-copy"
      data-install-copy
      data-copy={installCommand}
    >
      <Icon name="copy" class="copy-icon copy-icon-idle" />
      <Icon name="check" class="copy-icon copy-icon-done" />
      <span class="oe-visually-hidden">Copy the install command</span>
    </button>
    {/* The result goes in its own live region, not into the button's name.
        Two reasons. A control's accessible name should say what it does, and
        this one used to change to "Install command copied" — a past-tense
        report standing where the affordance belongs, so a reader arriving
        afterwards is told what already happened rather than what the button
        is for. And NVDA and JAWS do not reliably re-announce a focused
        control whose name mutates in place, which is the whole population
        this feedback exists for: the visual swap to a check icon is the
        sighted path, and before this element there was no other. The region
        is in the DOM at load and empty, because a live region inserted at the
        same moment as its text is not reliably announced either. Clearing it
        is silent, and the failure branch below stays silent by writing
        nothing — a refused clipboard should not claim success. */}
    <span class="oe-visually-hidden" role="status" data-copy-status></span>
  </p>
</div>

<div class="code-block hero-snippet">
  {/*
    The editor's tab strip, which is where the page's central claim stops being
    a sentence and becomes something a reader can operate. "Your backend stays
    yours" and "Expo, React Native, browsers, and Node from one package" are
    both assertions until you change the dropdown and watch the program change
    with it. What moves is the adapter's own lines — the import it needs and
    the expression that builds it. What holds still is everything under
    `createSignalProtocolClient`: the client, the hook, the send. That is the
    argument, and the second half is the half worth being exact about.

    This said "one line of the program changes with it — and nothing else" for
    several rounds, and that was never true: swapping an adapter has always
    moved an import as well as a construction. The Convex relay now brings its
    own client and generated API in with it, so the false version of the claim
    would be visibly false on the second dropdown a reader touches.

    Two selects rather than one, because there are genuinely two choices and
    they compose: `adapters: { storage, relay }` has two keys, and the controls
    are shaped like the object they edit.

    `(experimental)` goes in the option text rather than beside the control,
    because the label is where the choice is made and a caveat placed anywhere
    else is a caveat a reader can select past. No option carries it now, but
    the marker machinery stays wired to the
    flags in `src/lib/hero-snippet.mjs`, and a test holds those flags to the
    installed ADAPTERS.md, so the next experimental store gets the label
    without anyone remembering to add it.
  */}
  {/* The filename carried an `aria-describedby` from both selects, on the
      reasoning that a control should say which file it edits. Checked against
      the accessibility tree it came out as "Store, combobox, quickstart.ts",
      which is not that sentence — a description slot filled with a bare
      filename is noise in the one place a screen reader user cannot skim past.
      The selects are inside the panel and labeled "Device Store" and "Relay
      Server"; the example itself is a labeled group. The relationship was
      already there.

      Each name is longer than the key it sets on purpose: `storage` and `relay`
      are what the code calls them, and the toolbar is read before the code is.
      The qualifier is a span of its own because that is what a narrow panel
      drops first: `global.css` hides it where the full name would not fit
      beside the combobox, and the label falls back to "Store" and "Relay" — the
      words a reader can still act on. The filename goes next, and the row never
      stacks. The widths that decide are measured and written there. */}
  <div class="code-toolbar">
    <span class="code-filename">quickstart.ts</span>
    <span class="code-adapters">
      <label class="code-select">
        <span class="code-select-label"><span class="code-select-qualifier">Device </span>Store</span>
        <select data-adapter="storage">
          {
            storageOptions.map((option) => (
              <option value={option.id} selected={option.id === defaultVariant.storage}>
                {option.label}
                {option.experimental ? ' (experimental)' : ''}
              </option>
            ))
          }
        </select>
      </label>
      <label class="code-select">
        <span class="code-select-label">Relay<span class="code-select-qualifier"> Server</span></span>
        <select data-adapter="relay">
          {
            relayOptions.map((option) => (
              <option value={option.id} selected={option.id === defaultVariant.relay}>
                {option.label}
              </option>
            ))
          }
        </select>
      </label>
    </span>
    {/* Changing a select swaps which of ten blocks is visible, which is a
        loud change on screen and a silent one otherwise: focus stays on the
        combobox, so the only thing announced is the option name — "Expo" —
        and nothing says the program changed with it. This region says what is
        now showing. Empty at load and in the DOM from the start, because a
        live region inserted alongside its first text is not reliably
        announced. */}
    <span class="oe-visually-hidden" role="status" data-variant-status></span>
  </div>

  {/* Shiki runs at build time and ships no script, which the CSP requires:
      `script-src 'self'` has no room for a highlighter, and `style-src` allows
      the inline color it writes on each span. `defaultColor={false}` emits
      both palettes as `--shiki-light` / `--shiki-dark` custom properties and
      leaves the choice to `:root.dark`, so the panel follows the theme toggle
      without a second copy of the markup. */}
  {/* The name identifies the region; it does not describe scrolling. It used
      to end in "scrollable", on the stated reasoning that "the block scrolls
      sideways on a narrow screen" — which is backwards. Measured at 1440, 390
      and 320: a narrow screen is where it cannot scroll, because the rule
      below switches it to `pre-wrap` and wrapped text has nothing to scroll
      to; the wide screen keeps `white-space: pre` and is the only place a long
      line could overflow.

      Shiki's `tabindex` stays. It is there because a highlighter cannot know
      whether a given snippet will overflow, and a scroll container reachable
      only by mouse fails 2.1.1. A stop that announces what the panel is costs
      a keyboard user one Tab.

      The label names the adapters rather than saying "excerpt", which is what
      it said while this was one. Nine of the ten are `hidden`, so only the
      selected one is in the accessibility tree and only its label is read. */}
  {/*
    The program, and the control that takes it away.

    The copy button used to stand at the far end of the toolbar, beside the two
    comboboxes. That row is where the example is *configured*, and the control
    that copies it is not another setting — a reader scanning the row met three
    controls and had to read all three to find the one that does not change the
    program. It sits in the code's own top-right corner now, where every editor
    and every code host on the internet puts it.

    Absolutely positioned against this box and not against the `<pre>`, because
    the `<pre>` is the scroll container: pinned inside it the button would slide
    off the panel the moment a reader scrolled a long line. It carries the
    editor surface as its own background for the same reason it has to overlap
    at all — below 48rem the program scrolls under it, and a transparent chip
    over code is unreadable. Above that width nothing runs into it: the
    hero-snippet size solves for a 91-character line and the import on line one
    is 76, so the code stops well short of the corner.
  */}
  <div class="code-body">
    <button type="button" class="copy-button code-copy" data-code-copy>
      <Icon name="copy" class="copy-icon copy-icon-idle" />
      <Icon name="check" class="copy-icon copy-icon-done" />
      <span class="oe-visually-hidden">Copy the example</span>
    </button>
    {/* Its own region, for the same reason the install button has one. This
        button's name must keep saying what it does. */}
    <span class="oe-visually-hidden" role="status" data-code-copy-status></span>

    {
      snippetVariants.map((variant) => (
        <div
          class="code-variant"
          data-storage={variant.storage}
          data-relay={variant.relay}
          hidden={!variant.isDefault}
        >
          <Code
            code={variant.code}
            lang="ts"
            themes={codeThemes}
            defaultColor={false}
            role="group"
            aria-label={`Quickstart example, ${variant.storageLabel} store, ${variant.relayLabel} relay`}
          />
          {/* The disclosure that used to sit here as a `<p class="code-note">` is
              in the program now. It named three objects the reader brings, and
              they did not turn out to be the same kind of thing. `convex` and
              `api` are importable — a Convex client and a generated API module —
              so the Convex variant imports them, and a name a program binds needs
              no caption. `storage` is not: the store wants an implementation of
              `ReactNativeKeyValueStorage`, which is the reader's to write, so it
              keeps a comment on the line above. Either way the disclosure is now
              inside what the copy button copies, which prose under the panel
              never was. `snippetComments` in src/lib/hero-snippet.mjs holds the
              comments; the imports are on the option itself. */}
        </div>
      ))
    }
  </div>
</div>

<script>
  /* Bundled rather than inline: the CSP is script-src 'self'. */

  /* ---- the install command ---- */
  const button = document.querySelector<HTMLButtonElement>('[data-install-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  let restore: ReturnType<typeof setTimeout> | undefined;

  button?.addEventListener('click', async () => {
    const command = button.dataset.copy;
    if (!command) return;
    try {
      await navigator.clipboard.writeText(command);
    } catch {
      /* Clipboard access can be refused, and a button that lies about having
         copied is worse than one that quietly does nothing. */
      return;
    }
    button.dataset.copied = 'true';
    if (status) status.textContent = 'Install command copied';
    clearTimeout(restore);
    restore = setTimeout(() => {
      delete button.dataset.copied;
      if (status) status.textContent = '';
    }, 2000);
  });

  /* ---- the adapter selector ---- */
  const panel = document.querySelector<HTMLElement>('.hero-snippet');
  const selects = panel?.querySelectorAll<HTMLSelectElement>('select[data-adapter]');
  const variants = panel?.querySelectorAll<HTMLElement>('.code-variant');

  /* Every combination is already in the document, so switching is showing one
     and hiding the rest. No fetch, no highlighter, and nothing to fail: with
     scripting off the default variant is the one the server rendered and it is
     still complete, correct and copyable. */
  const variantStatus = panel?.querySelector<HTMLElement>('[data-variant-status]');

  const show = () => {
    if (!panel || !selects || !variants) return;
    const wanted: Record<string, string> = {};
    for (const select of selects) wanted[select.dataset.adapter ?? ''] = select.value;
    for (const variant of variants) {
      const match =
        variant.dataset.storage === wanted.storage && variant.dataset.relay === wanted.relay;
      variant.hidden = !match;
    }
    /* The shown block's own accessible name is already the sentence this
       wants — "Quickstart example, Expo store, Convex relay" — so it is read
       from there rather than rebuilt, and the two cannot drift apart. */
    const shown = panel.querySelector('.code-variant:not([hidden]) .astro-code');
    const label = shown?.getAttribute('aria-label');
    if (variantStatus && label) variantStatus.textContent = label;
  };

  selects?.forEach((select) => select.addEventListener('change', show));

  /* ---- the example ---- */
  const codeButton = panel?.querySelector<HTMLButtonElement>('[data-code-copy]');
  const codeStatus = panel?.querySelector<HTMLElement>('[data-code-copy-status]');
  let codeRestore: ReturnType<typeof setTimeout> | undefined;

  codeButton?.addEventListener('click', async () => {
    /* Read from the visible variant rather than from an attribute: ten copies
       of the program in `data-copy` would double the panel's weight to say
       what the panel already says. The line numbers are `::before` content, so
       they are not in `textContent` and cannot reach the clipboard. */
    const visible = panel?.querySelector<HTMLElement>('.code-variant:not([hidden]) pre');
    const code = visible?.textContent;
    if (!code) return;
    try {
      await navigator.clipboard.writeText(code);
    } catch {
      return;
    }
    codeButton.dataset.copied = 'true';
    if (codeStatus) codeStatus.textContent = 'Example copied';
    clearTimeout(codeRestore);
    codeRestore = setTimeout(() => {
      delete codeButton.dataset.copied;
      if (codeStatus) codeStatus.textContent = '';
    }, 2000);
  });
</script>
