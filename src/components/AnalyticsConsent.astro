---
import { getCollection } from 'astro:content';
const staticPages = Object.keys(import.meta.glob('../pages/**/*.astro')).filter((path) => !path.includes('[')).map((path) => path.replace('../pages', '').replace(/\/index\.astro$/, '').replace(/\.astro$/, '') || '/');
const articles = await getCollection('blog', ({ data }) => !data.draft);
const routes = [...staticPages, ...articles.map(({ id }) => `/blog/${id}`)];
---
<div data-analytics-routes={JSON.stringify(routes)} hidden></div>
<aside data-analytics-panel hidden aria-label="Analytics preferences" class="fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-2xl border border-border-3 bg-ground-raised p-5 shadow-lg">
  <h2 class="text-lg font-semibold">Optional analytics</h2>
  <p class="mt-2 text-sm">With your permission, we use PostHog to measure page visits and selected actions across this site, documentation, status page, and Console. If you sign in, we can link these visits to your account through an opaque identifier. No message content, keys, or form text is collected.</p>
  <p data-analytics-status aria-live="polite" class="mt-2 text-sm"></p>
  <div class="mt-4 flex flex-wrap gap-3 text-sm">
    <button data-analytics-accept type="button" class="border border-border-3 px-4 py-2 disabled:opacity-50">Accept analytics</button>
    <button data-analytics-reject type="button" class="border border-border-3 px-4 py-2">Reject analytics</button>
    <button data-analytics-close type="button" class="px-4 py-2 underline">Close</button>
    <a href="/legal/privacy#cookies" class="px-4 py-2 underline">Privacy notice</a>
  </div>
</aside>
<script>
  import { mountAnalytics } from '../lib/analytics/client';
  const data = document.querySelector<HTMLElement>('[data-analytics-routes]');
  mountAnalytics(new Set(JSON.parse(data?.dataset.analyticsRoutes ?? '[]')));
</script>
