---
/*
 * The line the plaintext does not cross.
 *
 * The carrier panels stack three labelled panes — your device, the relay, the
 * other device — separated by identical hairlines, and the only thing marking
 * the middle one as different in kind was a slightly darker background. A
 * reader had to already know why one box holds a sentence and the next holds
 * base64. The whole argument of the panel is that one of those three boxes is
 * infrastructure you do not have to trust, and nothing drew it.
 *
 * The vocabulary is not new. `src/components/diagrams/` has drawn this
 * boundary four times — WhoHoldsPlaintext, WhereQueriesRun, WhereWorkMoves,
 * ExpoKeyMap — always as a 2px line dashed 2-on-6-off in
 * `--oe-diagram-boundary`, labelled `seal` and `open`. Those are SVG and this
 * is a row of HTML between two divs, so the dash is a repeating gradient
 * rather than a `stroke-dasharray`, with the same rhythm and the same token.
 * A reader who meets `seal` in a blog-post diagram meets the same word and
 * the same gold dashes here.
 *
 * The note beside the word is what the diagrams get from surrounding shapes
 * and this row has to say outright: standing alone on a rule, "seal" is a
 * hint rather than a label.
 */

interface Props {
  /** `seal` where plaintext becomes ciphertext, `open` where it comes back. */
  kind: 'seal' | 'open';
}

const { kind } = Astro.props;

const note = kind === 'seal' ? 'plaintext stops here' : 'plaintext resumes here';
---

<div class:list={['carrier-boundary', `carrier-boundary-${kind}`]}>
  <span class="carrier-boundary-label">{kind}</span>
  <span class="carrier-boundary-note">{note}</span>
</div>
