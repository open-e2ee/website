---
import capture from '../data/carrier-capture.json';
import sdkManifest from '@open-e2ee/signal-protocol-sdk/package.json';

/*
 * The proof moment. Both panes come from `src/data/carrier-capture.json`,
 * which `scripts/record-carrier-capture.mjs` writes by running the documented
 * quickstart against the in-memory relay and reading the envelope the relay
 * actually held. Nothing in this component is drawn, mocked up, or hand-typed:
 * if the recorded ciphertext were replaced by something plausible-looking, the
 * page would be making exactly the claim the brand exists to avoid.
 *
 * The recording path is a committed script rather than a story about how the
 * file once came to exist, which is what lets a reader run it — `npm run
 * capture:record` — and get a row of their own.
 */

interface Props {
  /** Base64 characters of ciphertext to show before truncating. */
  excerpt?: number;
}

const { excerpt = 420 } = Astro.props;

const shown = capture.ciphertext.slice(0, excerpt);

/*
 * Every metadata field the recording holds, in the order it recorded them,
 * read from `capture.metadataFields` rather than retyped. It used to be a
 * hand-written array of six, and the recording holds ten — `senderDeviceId`
 * and `serverTimestamp` had gone missing from a panel captioned "the row",
 * silently, in the direction that flatters us. The capture's own note on the
 * second one reads "Real relays assign this too."
 *
 * A hand-kept copy of recorded data will drift, and on this panel drift is
 * indistinguishable from curation. Deriving it means the only way to change
 * what the relay appears to hold is to change what the relay actually held.
 *
 * Exactly two fields are held back, and the reader is told about both:
 *   ciphertext — rendered above as the bytes themselves, not as a table row.
 *   id — `msg-1` is the in-memory relay counting sends. A production relay
 *        assigns its own format, so printing this one would teach a reader
 *        something false about their own database. The field is named in the
 *        note under the list rather than dropped in silence.
 */
const HELD_BACK = new Set(['ciphertext', 'id']);
const visible = capture.metadataFields.filter((entry) => !HELD_BACK.has(entry.field));

/*
 * The recording is not refreshed on every release, and the caption has to stay
 * honest in between.
 *
 * It is re-recorded when the program in it stops being true of the package —
 * alpha.10 renamed both adapters, so the recorded file named two subpaths that
 * no longer existed and it had to be run again. A version bump on its own does
 * not earn one: a re-record proves the envelope's shape on one day, and the
 * check below proves the shape held across every release since the recording,
 * which is the stronger of the two claims and the one a sceptical reader is
 * actually asking about.
 *
 * That check is what the third caption line rests on:
 * `tests/site-content.test.mjs` reads the recorded field names out of the
 * capture and asserts each one against the `Envelope` interface in the
 * installed type declarations. A release that drops a field fails the build
 * rather than shipping a caption that has quietly become false.
 *
 * The line is printed only when the two versions differ, which today they do
 * not. Naming the same version twice in one caption answers a question no
 * reader has yet — the gap is what raises it, and until there is a gap the
 * stamp above already says everything the line would.
 */
const installedVersion = sdkManifest.version;
const recordedAtInstalled = capture.sdkVersion === installedVersion;
---

<figure class="carrier-panel">
  <div class="carrier-pane">
    <span class="label">device — bob</span>
    <p class="carrier-message">{capture.plaintext}</p>
  </div>

  <div class="carrier-pane carrier-pane-relay">
    <span class="label">relay — the row in your database</span>
    {/*
      The blob is hidden from assistive technology and the note below is not.
      A screen reader was announcing ~420 base64 characters one at a time,
      with no heading or landmark to escape to, immediately before the line
      that already carries the entire meaning — the count, the decoded size,
      and the fact that it is an excerpt. The bytes are evidence for a reader
      who can scan them at a glance and confirm they are not words; read
      aloud they are only a wall. Nothing is withheld: the note states what
      the blob is and how much of it there is, which is strictly more than a
      listener could have recovered from hearing it.
    */}
    <p class="carrier-cipher" aria-hidden="true">{shown}<span>…</span></p>
    <p class="carrier-cipher-note">
      {`ciphertext — ${capture.ciphertextStringLength.toLocaleString('en-US')} base64 characters, ${capture.ciphertextBytes.toLocaleString('en-US')} bytes decoded, excerpt shown`}
    </p>
    <dl class="carrier-meta">
      {visible.map((entry) => (
        <>
          <dt>{entry.field}</dt>
          <dd>{entry.value}</dd>
        </>
      ))}
    </dl>
    <p class="carrier-cipher-note">
      and a relay-assigned envelope id, in whatever format your relay assigns
    </p>
  </div>

  <figcaption class="carrier-caption">
    {/* It used to read "recorded from a real round trip". A fresh reader put
        that against the disclosure five lines below it — the quickstart, run
        against the relay that keeps its queue in this process — and was right:
        the cryptography in this capture is real, the transport is simulated,
        and "a real round trip" claims the second. On the one panel whose
        entire job is that the page will not overstate its evidence, that is
        the most expensive place on the site to overstate by one adjective. */}
    <span>recorded by running the quickstart</span>
    <span>{capture.packageName}@{capture.sdkVersion}</span>
    {!recordedAtInstalled && (
      <span>every field shown is still in the envelope at {installedVersion}</span>
    )}
  </figcaption>
</figure>
