---
import { geometry, pathsForVariant, variantForSize } from '../lib/brand';

interface Props {
  /** Rendered size in CSS pixels. Selects the silhouette. */
  size?: number;
  /** Use visible bounds when the surrounding lockup supplies clear space. */
  lockup?: boolean;
  /** Decorative marks inside a lockup are labeled by the wordmark beside them. */
  decorative?: boolean;
  class?: string;
}

const { size = 32, lockup = false, decorative = true, class: className } = Astro.props;
const variant = variantForSize(size);
const paths = pathsForVariant(variant);
const bounds = geometry[variant].construction.artwork;
const viewBox = lockup ? `${bounds.x} ${bounds.y} ${bounds.width} ${bounds.height}` : geometry[variant].viewBox;
const titleId = `oe-mark-${crypto.randomUUID().slice(0, 8)}`;
---

<svg
  class:list={['oe-mark', className]}
  viewBox={viewBox}
  width={size}
  height={size}
  fill="currentColor"
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-labelledby={decorative ? undefined : titleId}
>
  {!decorative && <title id={titleId}>OpenE2EE</title>}
  {paths.map((d) => <path d={d} fill-rule="evenodd" />)}
</svg>
