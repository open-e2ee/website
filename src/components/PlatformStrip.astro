---
/*
 * What the SDK is compatible with, under the hero's actions.
 *
 * Every entry is checked against the installed package rather than against the
 * roadmap. The four runtimes each have a local store under ./local/store, and
 * the three backends each have a shipped adapter: ./remote/relay/convex,
 * ./remote/object-store/convex-r2, ./remote/object-store/s3. The in-memory
 * store and relay are not here — they are development adapters, not platforms.
 *
 * The names are visible rather than tooltip-only, and that is the difference
 * between a compatibility list and a partner wall. It also carries the
 * precision the marks cannot: a bucket glyph on its own means nothing, and the
 * Cloudflare mark on its own would claim the platform when what is supported is
 * one object store — so that entry is the mark plus "R2", which reads as
 * "Cloudflare R2" while spending one word. `src/lib/platform-marks.mjs` holds
 * the provenance and the trademark position for each mark, and the two labels
 * that are the founder's word rather than the SDK's.
 */
import { platformMarks } from '../lib/platform-marks.mjs';

/* The hero is the only caller, and it owns the distance between the strip and
   the panel below it. That is the one thing the caller passes; the strip owns
   everything else, alignment included. */
interface Props {
  readonly class?: string;
}

const { class: className } = Astro.props;

/* One row of marks and names, sized from four custom properties so the mark,
   the name, the gap between entries and the gap inside an entry all scale off
   the same viewport term. */
/* Both lists take the same row. The cluster gap equals the entry gap, so a row
   of seven reads as one row; the nesting only becomes visible when the row runs
   out of width, and then it decides where the break lands. The clusters wrap
   internally as well, so the narrowest phone gets four short rows rather than
   two long ones scrolling off the edge. */
const ROW =
  'm-0 flex list-none flex-wrap items-center justify-center gap-y-2 gap-x-[var(--platform-gap)] p-0';

/* Marks are referenced rather than looked up by a string id, so a typo is a
   build error instead of an empty <path> nobody notices.

   Runtimes first, then backends. The row is not to be sorted alphabetically or
   by mark width.

   The two clusters are the wrap unit. On one line they read as a single row —
   the gap between them is the gap inside them — and when the row runs out of
   width the backends drop together instead of the break landing wherever the
   seventh name happens to fall. A row that breaks after "Convex" says the three
   backends are unrelated, which is the one thing the strip is asserting they
   are not.

   Maturity is not shown here. The maturity line below the strip carries it, and
   `tests/site-content.test.mjs` holds that line to the `(experimental)` markers
   in the installed ADAPTERS.md, so a store the SDK newly marks or clears fails
   the build instead of drifting. */
const clusters = [
  [platformMarks.expo, platformMarks['react-native'], platformMarks.browser, platformMarks.node],
  [platformMarks.convex, platformMarks['cloudflare-r2'], platformMarks.s3],
];
---

<div
  class:list={[
    'flex w-full flex-col items-center gap-2',
    '[--platform-mark-size:clamp(20px,5.6vw,34px)]',
    '[--platform-name-size:clamp(0.75rem,3.4vw,1rem)]',
    '[--platform-gap:clamp(0.5rem,2.6vw,1rem)]',
    '[--platform-entry-gap:clamp(0.25rem,1.6vw,0.5rem)]',
    className,
  ]}
>
  {/* Third-tier and not `--oe-subtle`, which is the tempting token and is
      forbidden for text: it carries `--oe-border-control`'s value, held to 3:1,
      and it measures 3.93 on the light canvas. Third-tier is 6.12 light and
      7.08 dark. */}
  {/* Named by `data-platform-label`. The class list is utilities now, so the
      heading has no name in it, and what the heading says is a claim the site
      holds to an allowlist — see `tests/site-content.test.mjs`, which reads the
      word through this attribute. */}
  <p class="m-0 text-[0.8125rem] text-text-3" data-platform-label>
    Built for
  </p>
  <ul class={ROW}>
    {
      clusters.map((cluster) => {
        /* A flex item that is itself a flex container. `display: contents`
           would be fewer boxes and it is the wrong tool: it takes list
           semantics off the element in more than one shipping engine, and here
           it would also dissolve the very box that makes the cluster a wrap
           unit. */
        return (
          <li class="flex">
            <ul class={ROW}>
              {cluster.map((mark) => {
                /* The name never wraps away from its own mark. Every entry is
                   one word now — "React Native" and "Cloudflare R2" were the
                   two that were not — so this guards the remaining break the
                   text could take on its own, which is "Node.js" at the dot.
                   The list wraps between entries instead, which is the only
                   place a break means anything.

                   The mark is `aria-hidden` because the visible name beside it
                   is already the accessible name; announcing both would read
                   every entry twice.

                   `fillRule` is narrowed here rather than typed in the data
                   module: the marks are plain JS, so it widens to `string` and
                   SVGAttributes will not take it. The comparison is also the
                   only thing standing between a mistyped rule and a mark that
                   silently fills its own counters. */
                return (
                  <li class="inline-flex items-center gap-[var(--platform-entry-gap)] text-[length:var(--platform-name-size)] whitespace-nowrap text-text-3">
                    <svg
                      class="h-[var(--platform-mark-size)] w-[var(--platform-mark-size)] flex-none fill-current"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill-rule={mark.fillRule === 'evenodd' ? 'evenodd' : 'nonzero'}
                        d={mark.path}
                      />
                    </svg>
                    <span>{mark.label}</span>
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })
    }
  </ul>
</div>
