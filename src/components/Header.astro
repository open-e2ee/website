---
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';
import ThemeToggle from './ThemeToggle.astro';
import {
  consoleUrl,
  currentNavigation,
  headerNavigation,
  repositoryUrl,
} from '../lib/site-navigation';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href="/" aria-label="OpenE2EE home"><Lockup /></a>
    <nav class="site-nav" aria-label="Primary">
      {headerNavigation.map((link) => (
        <a href={link.href} aria-current={currentNavigation(link.href, path)}>{link.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="oe-icon-link" href={repositoryUrl} aria-label="SDK on GitHub">
        <Icon name="github" />
      </a>
      <ThemeToggle />
      <a class="text-link desktop-only" href={consoleUrl}>Console</a>
      {/*
        The phone's copy of the navigation, and the console's sheet is the
        pattern: a button that owns `aria-expanded`, a panel it names, Escape to
        close with focus back on the trigger, and a press outside to dismiss.
        `<details>` stood here and needed no script, which the sheet does; the
        trade is the two behaviors a disclosure element cannot express, and the
        footer below carries every destination in this panel except the demo,
        which sits on the page the mark already links to.

        The trigger is drawn rather than spelled: at this width it stands in a
        row of icon controls — the mark and the theme toggle — and the one word
        among them was the odd thing in it. The bars are the universal drawing
        for this panel, and the same set's cross replaces them while it is open,
        so the control always shows what pressing it does next. The name stays
        real text for anything that reads names rather than shapes, the way the
        theme toggle carries its own.
      */}
      <div class="nav-sheet" data-nav-sheet>
        <button
          class="oe-icon-button"
          type="button"
          aria-controls="site-navigation-sheet"
          aria-expanded="false"
          data-nav-sheet-trigger
        >
          <Icon name="menu" class="nav-sheet-icon nav-sheet-icon-open" />
          <Icon name="close" class="nav-sheet-icon nav-sheet-icon-close" />
          <span class="oe-visually-hidden">Menu</span>
        </button>
        <nav aria-label="Site" hidden id="site-navigation-sheet">
          {headerNavigation.map((link) => (
            <a href={link.href} aria-current={currentNavigation(link.href, path)}>{link.label}</a>
          ))}
          <a href={consoleUrl}>Console</a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  /*
   * The sheet's open state, and nothing else. The panel is in the page at every
   * width; the stylesheet decides which width shows the trigger, so a desktop
   * reader never reaches this.
   *
   * Escape closes and returns focus to the trigger, because a reader who
   * dismisses a panel with the keyboard has nowhere else to land. A pointer
   * press outside the root closes without stealing the press, so the link the
   * reader was actually aiming at still receives it.
   */
  const root = document.querySelector<HTMLElement>('[data-nav-sheet]');
  const trigger = root?.querySelector<HTMLButtonElement>('[data-nav-sheet-trigger]');
  const panel = root?.querySelector<HTMLElement>('nav');

  if (root && trigger && panel) {
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    trigger.addEventListener('click', () => {
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      trigger.focus();
    });
  }
</script>
