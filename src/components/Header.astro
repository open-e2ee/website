---
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/*
 * Nav follows the funnel: choose, learn, build, verify, buy, read.
 *
 * There is no Compare slot. It held one, directly after Product, because "why
 * not libsignal" is the first question anyone asks. The question is real; the
 * route was not. A reader asks it while they are weighing this package, which
 * is what /product is for, so the nav item interrupted the one comparison it
 * existed to serve — and one product's claims split across two routes is two
 * surfaces to keep true. The table and the five project notes are now the two
 * bands under "How it compares" on /product, and `public/_redirects` keeps
 * `/compare` pointing at them.
 *
 * There is no Demo slot either. It held one, on the argument that Product
 * claims, Compare cites and Demo runs — the only page that answered a question
 * by executing the shipped package in the reader's own tab. That argument was
 * right about the evidence and wrong about where it belonged: a demo behind a
 * nav item is a demo a reader has to decide to visit, and the exemplars the
 * design review checked all put the running thing directly under the code that
 * describes it. The scenarios are now a homepage section, one band below the
 * panel they are the second half of, and `public/_redirects` keeps `/demo`
 * pointing at them.
 */
const links = [
  { href: '/product', label: 'Product' },
  { href: '/learn', label: 'Learn' },
  { href: 'https://docs.open-e2ee.dev', label: 'Docs' },
  { href: '/security', label: 'Security' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
];

/*
 * The repository is the seventh nav item everywhere else on the internet and
 * the mark is how it is recognised, so it leaves the word list and joins the
 * actions as an icon. In the menu, where there is room for words and no room
 * for a row of icons, it stays a link that says GitHub.
 */
const repository = 'https://github.com/open-e2ee/signal-protocol-js';

/* The destination is the console. Calling the link "Sign in" described the
 * doorway rather than the room, and named the one step a reader has to take
 * before they get anything. */
const consoleUrl = 'https://console.open-e2ee.dev';

const current = (href: string) =>
  href.startsWith('/') && (path === href || path.startsWith(`${href}/`)) ? 'page' : undefined;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href="/" aria-label="OpenE2EE home"><Lockup /></a>
    <nav class="site-nav" aria-label="Primary">
      {links.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="oe-icon-link desktop-only" href={repository} aria-label="The SDK on GitHub">
        <Icon name="github" />
      </a>
      <ThemeToggle />
      <a class="text-link desktop-only" href={consoleUrl}>Console</a>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Site">
          {links.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
          <a href={repository}>GitHub</a>
          <a href={consoleUrl}>Console</a>
          <a href="https://docs.open-e2ee.dev/start/quickstart">Build your first encrypted message</a>
        </nav>
      </details>
    </div>
  </div>
</header>
