---
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';
import ThemeToggle from './ThemeToggle.astro';
import { CONTAINER, QUIET_LINK } from '../lib/recipes';
import {
  consoleUrl,
  currentNavigation,
  headerNavigation,
  repositoryUrl,
} from '../lib/site-navigation';

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-10 border-b border-border-1 bg-ground-canvas">
  <div
    class:list={[
      CONTAINER,
      'flex min-h-16 items-center gap-6 max-[62rem]:justify-between max-[62rem]:gap-3',
    ]}
  >
    <a class="inline-flex text-[inherit] no-underline" href="/" aria-label="OpenE2EE home"><Lockup /></a>
    {/* The row of words, and the sheet below carries the same set at phone
        width. 62rem is where the words stop fitting beside the actions. */}
    <nav class="me-auto flex gap-6 text-[0.9375rem] max-[62rem]:hidden" aria-label="Primary">
      {headerNavigation.map((link) => (
        <a
          class:list={[
            QUIET_LINK,
            'aria-[current=page]:text-text-1 aria-[current=page]:underline aria-[current=page]:underline-offset-[0.35em]',
          ]}
          href={link.href}
          aria-current={currentNavigation(link.href, path)}>{link.label}</a>
      ))}
    </nav>
    {/* `--oe-icon-size` is 2em on this row and nowhere else. `.oe-icon` is
        1em so an icon takes the size of the text beside it, which is right in
        a sentence and wrong here: none of these three has text beside it, and
        at the header's 15px they were the smallest things in the row they are
        the actions of. 2em is 30px, 75% of the 40px control box, and the
        tallest thing in the row. The override sits on the row rather than on
        the token, so it is these three instances that change. */}
    <div class="flex items-center gap-4 text-[0.9375rem] [--oe-icon-size:2em]">
      <a class="oe-icon-link" href={repositoryUrl} aria-label="SDK on GitHub">
        <Icon name="github" />
      </a>
      <ThemeToggle />
      <a class:list={[QUIET_LINK, 'max-[62rem]:hidden']} href={consoleUrl}>Console</a>
      {/*
        The phone's copy of the navigation, and the console's sheet is the
        pattern: a button that owns `aria-expanded`, a panel it names, Escape to
        close with focus back on the trigger, and a press outside to dismiss.
        `<details>` stood here and needed no script, which the sheet does; the
        trade is the two behaviors a disclosure element cannot express, and the
        footer below carries every destination in this panel except the demo,
        which sits on the page the mark already links to.

        The trigger is drawn rather than spelled: at this width it stands in a
        row of icon controls — the mark and the theme toggle — and the one word
        among them was the odd thing in it. The bars are the universal drawing
        for this panel, and the same set's cross replaces them while it is open,
        so the control always shows what pressing it does next. The name stays
        real text for anything that reads names rather than shapes, the way the
        theme toggle carries its own.
      */}
      <div class="relative hidden max-[62rem]:block" data-nav-sheet>
        <button
          class="oe-icon-button"
          type="button"
          aria-controls="site-navigation-sheet"
          aria-expanded="false"
          data-nav-sheet-trigger
        >
          {/* Bars closed, cross open: one control, and it always draws what
              the next press does. Both icons ship, and the trigger's own
              state chooses between them, so the control is never an empty
              box while a module loads. */}
          <Icon name="menu" class="[[aria-expanded=true]_&]:hidden" />
          <Icon name="close" class="hidden [[aria-expanded=true]_&]:block" />
          <span class="oe-visually-hidden">Menu</span>
        </button>
        {/* The panel hangs from the trigger, which is the last control in the
            row, so it spans the gutters rather than the width of the trigger.
            `hidden` is what the script sets, and a flex container ignores it
            without the attribute selector. */}
        <nav
          class="absolute right-4 left-4 mt-2 flex flex-col border border-border-3 bg-ground-raised shadow-[var(--oe-shadow-md)] [&[hidden]]:hidden"
          aria-label="Site"
          hidden
          id="site-navigation-sheet"
        >
          {headerNavigation.map((link) => (
            <a
              class="border-b border-border-1 px-4 py-3 text-text-1 no-underline last:border-b-0"
              href={link.href}
              aria-current={currentNavigation(link.href, path)}>{link.label}</a>
          ))}
          <a
            class="border-b border-border-1 px-4 py-3 text-text-1 no-underline last:border-b-0"
            href={consoleUrl}>Console</a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  /*
   * The sheet's open state, and nothing else. The panel is in the page at every
   * width; the stylesheet decides which width shows the trigger, so a desktop
   * reader never reaches this.
   *
   * Escape closes and returns focus to the trigger, because a reader who
   * dismisses a panel with the keyboard has nowhere else to land. A pointer
   * press outside the root closes without stealing the press, so the link the
   * reader was actually aiming at still receives it.
   */
  const root = document.querySelector<HTMLElement>('[data-nav-sheet]');
  const trigger = root?.querySelector<HTMLButtonElement>('[data-nav-sheet-trigger]');
  const panel = root?.querySelector<HTMLElement>('nav');

  if (root && trigger && panel) {
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    trigger.addEventListener('click', () => {
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      trigger.focus();
    });
  }
</script>
