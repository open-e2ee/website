---
import CarrierPanel from '../CarrierPanel.astro';
import DemoLog from './DemoLog.astro';
import DemoScene from './DemoScene.astro';

/*
 * The demo: one scene, one button, and the relay's own row under it.
 *
 * Two SDK clients run in this page. There is no second window and nothing to
 * pair — the reader gets both ends of the conversation at once, which is what
 * the homepage's own quickstart sample twenty lines above already shows: one
 * relay, `alice`, `bob`. The demo is a live rendering of the code the reader
 * has just read.
 *
 * ------------------------------------------------------ the recorded row ---
 *
 * `CarrierPanel` prints a round trip that happened once, on a machine that is
 * not the reader's, and it is server-rendered and visible on arrival. It is the
 * page's answer to a reader whose scripts are off, whose browser the SDK will
 * not run in, or whose chunk never arrived: without it the homepage only
 * *asserts* what a relay holds, and the one artefact on the site that shows it
 * instead would have gone out with a layout change.
 *
 * The script hides it as soon as the console is interactive, and puts it back
 * if the run could not be brought up. So it is the state the page starts in and
 * the state it returns to, never decoration under a working demo.
 *
 * ------------------------------------------------------------- two clocks ---
 *
 * The protocol runs at full speed and is recorded; the drawing replays that
 * recording at the reader's pace. Every number printed on this page comes from
 * the recording. `trace.ts` makes that structural rather than promised: the pace
 * layer is handed cues with every measurement stripped out, so the pacing cannot
 * move a figure — there is no figure in scope for it to move.
 *
 * The line under the log states this for the reader. A round-trip figure can
 * appear before the drawing shows the envelope arriving. The reader must not
 * have to work out why.
 *
 * -------------------------------------------------------------- one button ---
 *
 * Start is the only control in the open, and it sits over the scene it starts.
 * Reset and the two switches are behind Settings, because they change the terms
 * of a run instead of starting one. Before the first press, the reader has one
 * thing to press.
 *
 * There is no play, step or scrub control. A transport makes the reader operate
 * a recording, and the recording is not the subject. `playback.ts` chooses the
 * pace and the replay runs to the end.
 *
 * There is no "exchange keys" control, because key agreement is not an action a
 * person takes. A device publishes its bundle when it comes online, and the
 * first message that needs a session agrees one. That is what `run.ts` does
 * inside `send()`. Start brings the devices up and puts their bundles on the
 * relay. The first sentence anyone types agrees the keys, in the recording,
 * where the reader can watch it happen.
 *
 * --------------------------------------------------------------- the names ---
 *
 * `NAMES` is rendered into the column headings *and* into the root's data
 * attributes, and the script starts the run with the values it reads back. One
 * source, so the label over a column and the account the SDK is really using
 * cannot drift. A script cannot read this frontmatter directly — `define:vars`
 * writes an inline script and the site's CSP has no inline scripts in it — so
 * the DOM is the channel, and it is the same DOM the reader is looking at.
 */
const NAMES = { a: 'alice', b: 'bob' } as const;

/*
 * The two switches.
 *
 * There is no "Post-quantum required" switch, because it would draw no
 * difference here. The SDK's setting is `required` or `compatible`, and
 * `compatible` still runs PQXDH against any peer that carries ML-KEM material.
 * Both devices on this page carry it. The setting only decides whether the SDK
 * refuses a peer that carries none, and this page has no such peer. A checkbox
 * whose two positions produce the same session teaches something false about
 * what it controls.
 *
 * Post-quantum protection is not a switch on this page, it is the run: the
 * demo asks for `required`, the key agreement is PQXDH, and each wheel is
 * captioned with the ratchet the SDK reports it selected — "triple ratchet"
 * when the post-quantum ratchet is in it. That is the SDK's own report of what
 * happened rather than a restatement of what was asked for, and the SDK
 * publishes no way to run without it.
 *
 * Braid is a real difference and stays. It chooses how the post-quantum key
 * material travels — in bounded chunks, one riding along with each message, or
 * whole in a single message — and both are the post-quantum ratchet. Off by
 * default, as the newer of the two modes.
 *
 * Sealed sender is the odd one and is marked so on the page: the demo has no
 * trust root to mint a sender certificate against, so that switch is a lens
 * over the relay's real row rather than a session setting.
 */
const TOGGLES = [
  {
    id: 'sealed-sender',
    key: 'sealedSender',
    label: 'Sealed sender',
    on: true,
    note: 'a lens over the relay’s real row — off shows the fields it would strike',
  },
  {
    id: 'braid',
    key: 'braid',
    label: 'Braid',
    on: false,
    note: 'carries the ML-KEM key in 32-byte chunks, one per message, instead of whole',
  },
] as const;
---

<div
  class="demo-console"
  data-demo="console"
  data-console-name-a={NAMES.a}
  data-console-name-b={NAMES.b}
>
  {/*
    The stage holds the scene, the settings, and the curtain. The settings and
    the curtain sit over the scene instead of around it, so all three share one
    positioned box.
  */}
  <div class="demo-console-stage">
    <DemoScene />

    {/*
      The settings, in the corner above the scene. Everything that changes the
      terms of a run is behind this control, so Start is the only control in the
      open.

      A native `<details>` instead of a scripted popover. It opens, closes and
      answers the keyboard with no script at all. This page measures the script
      it ships before the reader touches anything.

      Everything inside ships disabled and the script enables it. A control that
      does nothing is worse than a control that is absent. The reader presses it
      and nothing happens. That reads as a broken demo, not as a chunk that is
      still arriving.
    */}
    <details class="demo-console-settings">
      <summary class="demo-console-settings-summary">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="demo-console-settings-mark">
          <path
            d="M3 8h18M3 16h18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
          <circle cx="9" cy="8" r="3" fill="currentColor"></circle>
          <circle cx="16" cy="16" r="3" fill="currentColor"></circle>
        </svg>
        Settings
      </summary>

      <div class="demo-console-settings-panel">
        <fieldset class="demo-console-toggles" data-console-toggles disabled>
          <legend class="demo-console-toggles-legend">Protocol</legend>
          {
            TOGGLES.map((toggle) => (
              <label class="demo-console-toggle" for={`demo-toggle-${toggle.id}`}>
                <input
                  type="checkbox"
                  id={`demo-toggle-${toggle.id}`}
                  data-console-toggle={toggle.key}
                  checked={toggle.on}
                />
                <span class="demo-console-toggle-label">{toggle.label}</span>
                <span class="demo-console-toggle-note">{toggle.note}</span>
              </label>
            ))
          }
        </fieldset>

        <button type="button" class="oe-button oe-button-secondary" data-console-reset disabled>
          Reset
        </button>
      </div>
    </details>

    {/*
      The curtain covers the scene and carries the one control that starts it.
      The reader looks at the scene while deciding to run it.

      Start brings both devices online and publishes their public bundles. It
      calls the real `syncToServer` on each client instead of animating one.
      That is everything a device does before anyone writes a message. The first
      message agrees the keys, which is where a real session agrees them.

      The script lifts the curtain once the run is up, and Reset puts it back. A
      reader with no scripts keeps a blurred scene under a button that is
      visibly unavailable, with the recorded row below it.
    */}
    <div class="demo-console-curtain" data-console-curtain>
      <button type="button" class="oe-button" data-console-start disabled>Start demo</button>
    </div>
  </div>

  <p class="demo-console-status" data-console-status role="status" aria-live="polite"></p>

  {/*
    The log, last, because it is the transcript rather than the story: the
    scene is paced for reading and this is the recording's own clock, printed
    the moment each event exists. A reader who wants the exact order and the
    exact call comes down here; nobody has to.
  */}
  <DemoLog />

  {/*
    Each sentence answers one misreading. The first: the drawing is a replay,
    and the run behind every figure went at full speed. The second: the timings
    under each device are not latency, because the relay runs in this tab. No
    number here contains a network, and nothing on the page simulates one.
  */}
  <p class="demo-console-note measure">
    Recorded at full speed, replayed at reading pace — every number comes from the run. The relay
    is in this tab, so no timing includes a network.
  </p>

  {/*
    The recorded capture: server-rendered, visible on arrival, hidden by the
    script once the console can actually be pressed, and restored if the run
    could not be brought up.

    The `<noscript>` is the only thing on the page that can address the reader
    it is for, because the script that would otherwise explain the panel is the
    thing that is not running. The copy above this component offers that reader
    an interaction — "type a sentence" — and a page that makes an offer to
    someone who cannot take it owes them the reason in the same breath.
  */}
  <div class="demo-console-recorded" data-console-recorded>
    <noscript>
      <p class="demo-console-note measure">
        The live demo needs JavaScript, which is off here, so what follows is a recording of a
        round trip rather than one running in your browser. Every value in it came off a real
        envelope.
      </p>
    </noscript>
    <CarrierPanel />
  </div>
</div>

<script>
  /*
   * The console's wiring.
   *
   * Nothing protocol-shaped is imported at the top of this file. `run.ts` pulls
   * the SDK behind it and the homepage is measured for what it fetches before a
   * reader asks for anything, so every import that carries weight is inside
   * `chunks()`, on the far side of a press.
   *
   * ------------------------------------------------- what follows which clock ---
   *
   * Two things arrive from the recording and they are deliberately on different
   * clocks.
   *
   * The metrics print the moment the measurement exists. They describe a run
   * that has already finished at full speed, they are not part of the story
   * being paced, and holding them back would make the transport look like it was
   * timing something.
   *
   * The log prints on that same measured clock, and deliberately: it is the
   * transcript, not the story, and a reader consulting it wants the order the
   * protocol really went in.
   *
   * Everything that tells the story — the scene, the bubbles inside the phones,
   * the row under the relay — waits for the reel. A reader should not be shown
   * the sentence arriving at the far device before the envelope has visibly got
   * there. `apply()` is the one place those move, so they cannot fall out of
   * step with each other.
   */
  import type { DemoRun, DeviceActor } from '../../lib/demo/run';
  import type { Playback } from '../../lib/demo/playback';
  import type { SceneCue, SceneToggles, SceneView, Side } from '../../lib/demo/scene-view';
  import type { TraceEvent } from '../../lib/demo/trace';

  /*
   * The log is a separate island with its own inline module, so neither script
   * can import the other's. `DemoLog.astro` hangs this on its own root element
   * once it has mounted, and this is that shape restated where it is called —
   * a structural type, so a change to the handle is a compile error here.
   */
  interface DemoLogHandle {
    append(event: TraceEvent): void;
    clear(): void;
  }

  const mount = document.querySelector<HTMLElement>('[data-demo="console"]');
  if (mount) upgrade(mount);

  function upgrade(root: HTMLElement) {
    const need = <E extends Element>(selector: string): E => {
      const found = root.querySelector<E>(selector);
      if (!found) throw new Error(`demo console: ${selector} is missing from the markup`);
      return found;
    };

    const startButton = need<HTMLButtonElement>('[data-console-start]');
    const curtain = need<HTMLElement>('[data-console-curtain]');
    const reset = need<HTMLButtonElement>('[data-console-reset]');
    const status = need<HTMLElement>('[data-console-status]');
    const hex = need<HTMLElement>('[data-console-hex]');
    const row = need<HTMLElement>('[data-console-row]');
    const rowNote = need<HTMLElement>('[data-console-row-note]');
    const relayEmpty = need<HTMLElement>('[data-console-relay-empty]');
    const recorded = need<HTMLElement>('[data-console-recorded]');
    const toggleBox = need<HTMLFieldSetElement>('[data-console-toggles]');
    const sceneRoot = need<HTMLElement>('[data-demo-scene]');
    const logRoot = need<HTMLElement>('[data-demo-log]');
    /*
     * The readings, keyed the way the scene writes them: a device's four are
     * `a-publish`, `a-establish`, `a-send`, `a-trip` and the same for `b`, and
     * the relay has one.
     *
     * Looked up by key rather than held as five named handles, because the
     * routing is now by *actor* and a named handle invites the mistake this
     * replaces. Each of these four measures is recorded by `run.ts` against the
     * device that did the work — `encryptMs` on the sender, `roundTripMs` on the
     * receiver, `establishMs` on the device that agreed the keys, `publishMs` on
     * the one that published — and the console used to print `encryptMs` under
     * alice and `roundTripMs` under bob no matter which of them had acted. Every
     * reply leg therefore printed bob's send time under alice's name. The
     * numbers were real and every one of them was under the wrong device.
     */
    const readings = new Map<string, HTMLElement>(
      [...root.querySelectorAll<HTMLElement>('[data-console-metric]')].map((element) => [
        element.dataset.consoleMetric ?? '',
        element,
      ]),
    );
    const reading = (key: string): HTMLElement | undefined => readings.get(key);
    /* Nine: four under each device and one under the relay. A selector that
       matched none of them would otherwise print nothing, silently, and a demo
       whose timings never appear looks exactly like one nobody pressed. */
    if (readings.size !== 9) {
      throw new Error(`demo console: expected 9 readings in the scene, found ${readings.size}`);
    }

    /* The composer belongs to the device now, so there are two of them and
       either may start a conversation. Both are read out of the scene rather
       than duplicated here: the phone that shows the message is the phone that
       accepted it, and one selector proves that rather than asserting it. */
    const composers: Record<Side, { input: HTMLInputElement; send: HTMLButtonElement }> = {
      a: {
        input: need<HTMLInputElement>('[data-scene-input="a"]'),
        send: need<HTMLButtonElement>('[data-scene-send="a"]'),
      },
      b: {
        input: need<HTMLInputElement>('[data-scene-input="b"]'),
        send: need<HTMLButtonElement>('[data-scene-send="b"]'),
      },
    };

    const toggleInputs = new Map<string, HTMLInputElement>(
      [...root.querySelectorAll<HTMLInputElement>('[data-console-toggle]')].map((input) => [
        input.dataset.consoleToggle ?? '',
        input,
      ]),
    );

    const names = { a: root.dataset.consoleNameA ?? 'a', b: root.dataset.consoleNameB ?? 'b' };

    /*
     * Exactly two fields are held back, and the reader is told about both.
     *
     *   ciphertext — printed above as the bytes themselves, not as a table row.
     *   id         — the in-memory relay counts sends, so this reads `msg-1`. A
     *                production relay assigns its own format, and printing this
     *                one would teach a reader something false about their own
     *                database.
     *
     * A list of what is deliberately not shown, and never a list of what is:
     * every other field arrives by iterating the envelope, so a field the SDK
     * adds appears without anyone editing this file, and one it removes vanishes
     * rather than lingering as a stale row.
     */
    const HELD_BACK = new Set(['ciphertext', 'id']);

    /*
     * The envelope fields this file names, and the only ones it may.
     *
     * The relay's row is built from `Object.entries` of the live envelope and
     * from nothing else — a hand-written list of what to show is the mechanism
     * the drift `demo-panel.test.mjs` guards against actually needs. These are
     * not that list. Two are the addressing drawn on the envelope graphic,
     * which cannot be derived: something has to say which field is the
     * recipient. One is quoted in the note under the row.
     *
     * They are gathered here rather than reached for inline so that the test
     * can lift them out of this source and check each against the installed
     * `Envelope`. Named inline, a rename in the SDK would leave the graphic
     * addressed to an em dash and the note quoting `undefined`, on a panel
     * whose whole job is not overstating the evidence — quietly, and in the
     * direction that flatters us, which is how the same defect landed once
     * already.
     */
    const NAMED_FIELDS = {
      to: 'targetUserId',
      from: 'senderUserId',
      mode: 'messageType',
    } as const;

    /*
     * What sealed sender takes off the envelope.
     *
     * The demo does not run sealed sender — it needs a trust root and a sender
     * certificate to mint against, and this page has neither — so the switch is
     * a lens over the real row rather than a session setting, and it is drawn
     * as one. The fields below are marked in place instead of hidden, because
     * the useful thing to see is *which* fields go, and a row that silently
     * shortened would teach nothing. The relay's own `messageType` says which
     * mode really ran: `unidentified_sender` is sealed, and the envelopes here
     * are not.
     *
     * The names live in `scene-view.ts` so that a Node test can hold them
     * against a real envelope; they are read off the lazily-loaded module here
     * rather than imported statically, which would pull the whole scene into
     * the eager bundle for the sake of two strings.
     */

    type Loaded = {
      run: typeof import('../../lib/demo/run');
      playback: typeof import('../../lib/demo/playback');
      scene: typeof import('../../lib/demo/scene-view');
      ciphertext: typeof import('../../lib/demo/ciphertext');
    };

    /** The row the relay took, waiting for the reel to reach the step that took it. */
    interface Row {
      readonly envelope: Record<string, unknown>;
      readonly bytes: number;
    }

    let loaded: Loaded | null = null;
    let run: DemoRun | null = null;
    let scene: SceneView | null = null;
    let reel: Playback<SceneCue> | null = null;
    let starting: Promise<void> | null = null;
    /** Whether a run has ever come up here. Reset drops the run; this survives. */
    let everStarted = false;
    let busy = false;
    /* Set from the recording rather than from the press that caused it. The
       session is agreed inside the first send, so the only thing that knows one
       exists is the step the SDK recorded when it did. */
    let sessionExists = false;
    /* What the relay is holding, counted as the reel stores each row rather than
       as the trace reports it. The distinction matters now that the reading sits
       in the relay's own column, an inch from the mailbox that draws the same
       fact: the trace runs ahead of the drawing, so a reading taken from it says
       "1 row" over a mailbox still drawing "nothing waiting". Two claims about
       one relay, disagreeing, in one glance. */
    let bytesHeld = 0;
    let rowsHeld = 0;
    const pending: Row[] = [];
    /* The slowest publish seen, per device. Both devices publish, and each one's
       own figure belongs under its own phone — a single shared maximum would put
       one device's work under the other's name. */
    const publishedMs: Record<Side, number> = { a: 0, b: 0 };

    /*
     * Public keys the relay is holding for each device, as the relay itself
     * reports them.
     *
     * Not a count of publish events — that would say "two", which is the number
     * of devices rather than the number of keys, and would go on saying two
     * however much material each one actually put up. `run.ts` reads the relay
     * back after each publish and reports what is on the shelf for that one
     * device, so the shelf is drawn from the store rather than from the page's
     * own bookkeeping.
     *
     * The same number fills each device's own key store. Every public key the
     * relay holds for a device is one half of a pair whose other half never
     * left that device, so the two drawings are the same count seen from the
     * two ends — which is the point the picture is making.
     */
    const published: Record<Side, number> = { a: 0, b: 0 };

    /*
     * Message keys derived, per device. The ratchet's notches are this count and
     * nothing else.
     *
     * Counted where the derivation happens rather than shared between the two:
     * the sender derives one when it seals, the receiver derives one when it
     * opens, and a single counter would draw both devices turning together,
     * which is the one thing a ratchet does not do.
     */
    const derived: Record<Side, number> = { a: 0, b: 0 };

    /** The switches, as the scene and the next session read them. */
    let toggles: SceneToggles = { sealedSender: true, braid: false };

    /** The sender's bubble that has not yet been confirmed at the far device. */
    let awaitingDelivery: HTMLElement | null = null;

    /** The row the inspector is currently showing, so the lens can redraw it. */
    let shownRow: Row | null = null;

    const say = (text: string) => {
      status.textContent = text;
    };

    /*
     * One event, the first time a sentence completes a round trip on this page,
     * carrying nothing about it — not the sentence, not its length, not the
     * byte counts or the milliseconds printed beside it. The beacon reads
     * `demo_run /` and there is no third field for it to read.
     *
     * Once per page rather than once per send. The question it exists to answer
     * (plan D5) is whether readers who ran the demo go on to enter and finish
     * the quickstart, and its denominator is readers; counting sends would
     * measure how much someone enjoyed pressing the button. Nothing here
     * identifies a page view, so this is the closest a cookieless model gets to
     * "a reader ran it", and it is deliberately the conservative direction.
     *
     * `public/measure.js` owns the beacon; this owns the moment. The site's
     * delegated click handler reads links, and this is a button in a module it
     * knows nothing about.
     */
    let reportedRun = false;
    const reportRun = () => {
      if (reportedRun) return;
      reportedRun = true;
      window.oeMeasure?.('demo_run');
    };
    const ms = (value: number) => `${value.toFixed(1)} ms`;
    const count = (value: number) => value.toLocaleString('en-US');

    /*
     * What may be pressed.
     *
     * The devices are the demo, so once they are up both composers are live and
     * there is nothing else to operate. Key agreement is not a control here — a
     * device publishes when it comes online and the session is agreed by the
     * first message that needs one, which is what `run.ts` does inside `send()`
     * whether or not anything asked it to.
     */
    const enable = () => {
      const running = run !== null;
      startButton.disabled = busy || running;
      reset.disabled = busy || !running;
      /* The curtain is up whenever no run is behind it. This state decides it,
         not the press. A start that throws leaves the reader the button that
         starts one, and Reset gives the button back. */
      curtain.hidden = running;
      /* Braid chooses what the *next* session negotiates, so it goes unavailable
         once one exists. A switch that appeared to change a running session
         would be describing key agreement wrongly, and Reset is the honest way
         back to a different answer. The sealed-sender lens is not a session
         setting and stays live throughout — see the note by
         `SEALED_SENDER_HIDES`. */
      toggleBox.disabled = false;
      for (const [key, input] of toggleInputs) {
        if (key !== 'sealedSender') input.disabled = busy || sessionExists;
      }
      for (const side of ['a', 'b'] as const) {
        composers[side].input.disabled = busy || !running;
        composers[side].send.disabled = busy || !running;
      }
    };

    /**
     * The four modules the console needs, fetched together on the first press.
     *
     * One `Promise.all` rather than four awaited in turn: they are independent,
     * and a reader who pressed a button is waiting on the slowest of them rather
     * than on their sum. The SDK is behind `run`, which is the whole reason any
     * of this is here instead of at the top of the file.
     */
    async function chunks(): Promise<Loaded> {
      const [runModule, playback, sceneModule, ciphertext] = await Promise.all([
        import('../../lib/demo/run'),
        import('../../lib/demo/playback'),
        import('../../lib/demo/scene-view'),
        import('../../lib/demo/ciphertext'),
      ]);
      return { run: runModule, playback, scene: sceneModule, ciphertext };
    }

    /**
     * Bring the run up, once, however many controls asked for it.
     *
     * The promise is shared rather than re-entered: a reader who presses
     * "Exchange keys" and then "Send" before the chunk lands has asked for one
     * run, and two would boot two pairs of devices against two relays and record
     * both into one drawing.
     */
    function start(): Promise<void> {
      if (run) return Promise.resolve();
      if (starting) return starting;

      say('Fetching the SDK…');
      const attempt = (async () => {
        const parts = await chunks();
        loaded = parts;

        /* Mounted once for the life of the page. Reset drops the run and comes
           back through here, and a second mount would leave the first view
           holding elements the second one is also writing to. */
        scene ??= parts.scene.mountScene(sceneRoot, names);
        scene.setToggles(toggles);

        /*
         * The pace, with the per-step dwell `playback.ts` already publishes.
         *
         * Keyed on the same step names the recording uses, so a step added to
         * the protocol arrives here with a dwell rather than silently taking a
         * default. The dwell is a constant and is not derived from a duration
         * token: `tokens.css` collapses those to a hundredth of a millisecond
         * under `prefers-reduced-motion`, and a reader who asked for less motion
         * should lose the motion, not the information.
         */
        if (!reel) {
          reel = parts.playback.createPlayback<SceneCue>({
            show: apply,
            /* A second watch starts from an empty drawing. The reel's first cue
               is `devices-ready`, so everything the scene shows is put back by
               replaying it — except the conversation, which appends. */
            rewind: () => {
              scene?.clear();
              awaitingDelivery = null;
            },
            dwellMs: parts.playback.STEP_DWELL_MS,
          });
        }

        /*
         * The protocol options, read here and nowhere later — this is the only
         * moment they can take effect, which is why braid locks once a session
         * exists.
         *
         * `postQuantum` is not a switch on this page and is asked for outright.
         * `compatible` would not have been "post-quantum off": it still runs
         * PQXDH against a peer that has KEM material, and both peers here do, so
         * the two settings would have produced the same session and a control
         * offering them would have taught a reader something false. See the
         * `TOGGLES` note above.
         */
        run = await parts.run.startDemoRun({
          a: names.a,
          b: names.b,
          protocol: {
            postQuantum: 'required',
            braid: toggles.braid ? 'required' : 'disabled',
          },
        });
        /*
         * The recording starts before anything can subscribe to it.
         *
         * `startDemoRun` boots both devices and records `devices-ready` on its
         * way, so by the time it resolves the first events are already in the
         * trace and a bare `on()` would never see them. That is not a dropped
         * frame: `devices-ready` is the step that brings the phones online and
         * puts the first line in the log, so the demo came up with both devices
         * reading "offline" through a whole successful key exchange.
         *
         * Replayed before subscribing rather than after, and with no `await`
         * between the two, so no event can arrive in the gap and none is seen
         * twice — `on()` delivers only what is appended after it.
         */
        for (const event of run.trace.events) record(event);
        run.trace.on(record);
        everStarted = true;
        say('');
      })();

      starting = attempt.finally(() => {
        starting = null;
      });
      return starting;
    }

    /** Recorded: print what was measured, log it, and queue the story for the reel. */
    function record(event: TraceEvent) {
      printMetrics(event);
      /* Looked up per event rather than held: the log is a separate island and
         may mount after this one, so a reference taken at upgrade time could be
         a reference to nothing. */
      (logRoot as HTMLElement & { demoLog?: DemoLogHandle }).demoLog?.append(event);
      if (event.step === 'bundles-published') {
        /* Absent when the relay had nothing for this device — `run.ts` keeps an
           unobserved reading out of the trace rather than reporting it as a
           zero, so an absent one leaves the last known count standing. */
        const keys = (event.detail as { publicKeys?: unknown } | undefined)?.publicKeys;
        const actor = event.actor;
        if ((actor === 'a' || actor === 'b') && typeof keys === 'number') published[actor] = keys;
      }
      if (event.step === 'session-established') sessionExists = true;
      if (event.step === 'stored-at-relay') {
        const envelope = (event.detail as { envelope?: Record<string, unknown> })?.envelope;
        if (envelope) pending.push({ envelope, bytes: event.measures?.ciphertextBytes ?? 0 });
      }
      reel?.push(toCue(event));
      /* The first cue is what makes the transport worth offering, so the
         controls are re-read here rather than only on a press. */
      enable();
      reel?.play();
    }

    /**
     * Print each measurement under the device that produced it.
     *
     * Routed by `event.actor`, which is the device `run.ts` recorded the work
     * against, and never by which column the figure would look tidy in. Every
     * one of these four is a device-side operation: sealing, agreeing a key,
     * publishing a bundle, and the wait for the far end to answer. None of them
     * is a network time and none is simulated — the relay is in this tab, which
     * the note under the inspector says in the reader's own words.
     *
     * A measure recorded against the relay has no device row to go in and is
     * dropped here rather than assigned to a device; the relay's own reading is
     * what it is holding, below.
     */
    function printMetrics(event: TraceEvent) {
      const measures = event.measures;
      if (!measures) return;
      const actor = event.actor === 'a' || event.actor === 'b' ? event.actor : null;

      if (actor) {
        const put = (key: string, value: number) => {
          const element = reading(`${actor}-${key}`);
          if (element) element.textContent = ms(value);
        };
        if (typeof measures.encryptMs === 'number') put('send', measures.encryptMs);
        if (typeof measures.roundTripMs === 'number') put('trip', measures.roundTripMs);
        if (typeof measures.establishMs === 'number') put('establish', measures.establishMs);
        /* A device publishes once, but the reading is kept as a maximum so a
           second publish on the same device cannot make the figure fall — the
           bundles go up in parallel and the slower one is when that device was
           actually ready. */
        if (typeof measures.publishMs === 'number') {
          publishedMs[actor] = Math.max(publishedMs[actor], measures.publishMs);
          put('publish', publishedMs[actor]);
        }
      }

    }

    /** The relay's own reading, as of the row the reel has just stored. */
    function printHolding(bytes: number) {
      bytesHeld += bytes;
      rowsHeld += 1;
      const held = reading('relay-holding');
      if (held) {
        held.textContent = `${count(rowsHeld)} row${rowsHeld === 1 ? '' : 's'} · ${count(bytesHeld)} bytes`;
      }
    }

    /**
     * A recorded event as something the drawing can be given.
     *
     * A projection and nothing else: it reads the event and returns a cue, and
     * the cue is where the paced half of the page gets everything it knows.
     *
     * This used to claim that every number it touches becomes a string on the
     * way, and that there is therefore no number left on a cue to scale. Neither
     * is true, and both were written before the scene had a ratchet to turn: the
     * lines below put real numbers on `ratchet`, `bundles` and `keys` on purpose,
     * to size a notch list and a key shelf. The honest invariant is narrower and
     * is the one `demo-run.test.mjs` actually holds — every number on a cue lives
     * on one of those three named fields, and every other value, at any depth, is
     * a string. A measurement arriving on a fourth field is the regression, and
     * telling it apart by size would not work: `bundles` counts real prekeys and
     * runs into the hundreds, the same order as a ciphertext byte count.
     */
    function toCue(event: TraceEvent): SceneCue {
      const detail = (event.detail ?? {}) as Record<string, unknown>;
      /* A trace event's `from` and `to` may name the relay, and a sentence
         belongs to a device. Asked rather than asserted: which actor a step
         belongs to is a fact about the recording, and a cast here would let a
         step recorded against the relay put a sentence inside a relay slot. */
      const device = (actor: TraceEvent['from']): DeviceActor | null =>
        actor === 'a' || actor === 'b' ? actor : null;
      const from = device(event.from);
      const to = device(event.to);
      const base: SceneCue = {
        step: event.step,
        actor: event.actor,
        ...(event.from === undefined ? {} : { from: event.from }),
        ...(event.to === undefined ? {} : { to: event.to }),
      };

      /* Counted at the step that derives the key, and snapshotted into the cue
         rather than read from the counter when the cue plays. The protocol runs
         well ahead of the reader, so a cue that read a live counter would draw
         a ratchet that had already turned several more times than the step it
         is showing. */
      if (event.step === 'encrypted' && from) derived[from] += 1;
      if (event.step === 'opened' && to) derived[to] += 1;
      const turned = { ratchet: { a: derived.a, b: derived.b } };

      if (event.step === 'devices-ready') {
        return { ...base, ...turned };
      }
      /*
       * Which ratchet ran, from the SDK rather than from the switches.
       *
       * `run.ts` puts the `ProtocolSelectionEvent` on this step, and this is the
       * one place the demo can honestly caption the wheel: the switches say what
       * was asked for, and the selection says what was agreed. They can differ —
       * `postQuantum: 'compatible'` against a peer with no ML-KEM is exactly the
       * case where they do — and the caption has to follow the second.
       *
       * Nullable all the way down and left that way. A callback that stops
       * firing leaves the wheel captioned plainly rather than captioned wrongly,
       * which is the direction that does not flatter us. `demo-run.test.mjs`
       * holds the event itself against a real key agreement so that the absent
       * case cannot quietly become the normal one.
       */
      if (event.step === 'session-established') {
        const selection = detail.selection as { usedTripleRatchet?: unknown } | null | undefined;
        return {
          ...base,
          ...turned,
          ...(typeof selection?.usedTripleRatchet === 'boolean'
            ? { ratchetKind: selection.usedTripleRatchet ? ('triple' as const) : ('double' as const) }
            : {}),
        };
      }
      if (event.step === 'bundles-published') {
        return {
          ...base,
          ...turned,
          bundles: published.a + published.b,
          keys: { a: published.a, b: published.b },
        };
      }
      /* The addressing rides from the moment the envelope is sealed, not from
         the moment the relay files it. An envelope drawn in flight with an
         em dash where the recipient goes says the routing is decided somewhere
         between the two, which is the opposite of what this demo is for. These
         are the names this page gave the two devices; `stored-at-relay` below
         replaces them with the fields read off the relay's own copy, which is
         where the claim about what the relay can see has to come from. */
      if (event.step === 'encrypted' || event.step === 'in-transit') {
        const addressed = {
          ...(to === null ? {} : { to: names[to] }),
          ...(from === null ? {} : { from: names[from] }),
        };
        if (event.step === 'in-transit') return { ...base, ...turned, meta: addressed };
        return {
          ...base,
          ...turned,
          meta: addressed,
          ...(typeof detail.text === 'string' && from
            ? { sentence: { side: from, text: detail.text } }
            : {}),
        };
      }
      if (event.step === 'stored-at-relay') {
        const envelope = (detail.envelope ?? {}) as Record<string, unknown>;
        /* The addressing on the drawn envelope is the addressing on the real
           one, read off the same object the relay stored, so the two cannot
           disagree about who the relay can see. */
        return {
          ...base,
          ...turned,
          meta: {
            ...(typeof envelope[NAMED_FIELDS.to] === 'string'
              ? { to: envelope[NAMED_FIELDS.to] as string }
              : {}),
            ...(typeof envelope[NAMED_FIELDS.from] === 'string'
              ? { from: envelope[NAMED_FIELDS.from] as string }
              : {}),
          },
        };
      }
      if (event.step === 'opened' && to) {
        const opened = detail.decrypted as { content?: unknown } | undefined;
        const text = typeof opened?.content === 'string' ? opened.content : '';
        return { ...base, ...turned, sentence: { side: to, text } };
      }
      return { ...base, ...turned };
    }

    /**
     * How long the envelope takes to cross, in milliseconds.
     *
     * A share of the step's own dwell, capped, so travel always finishes inside
     * the time the step is held and a longer-held step gets a longer glide. It
     * is a presentation number derived from another presentation number, and it
     * touches no measurement — see the two-clock note at the top of this file.
     *
     * The share was two fifths and is now most of the step, which is the
     * difference between an animation and a slideshow: at the old dwells the
     * envelope was in motion for one and seven tenths of the twenty-eight and a
     * half seconds the reel took — six per cent of it — and the rest was still
     * frames. Shorter dwells and a larger share put the movement back where the
     * eye is already looking.
     */
    const FLIGHT_CAP_MS = 700;
    const FLIGHT_SHARE = 0.75;
    function flightFor(step: string): number {
      if (!loaded) return 0;
      const dwell = loaded.playback.STEP_DWELL_MS[step] ?? loaded.playback.DEFAULT_DWELL_MS;
      return Math.min(FLIGHT_CAP_MS, dwell * FLIGHT_SHARE);
    }

    /** One step of the story, everywhere it is told. */
    function apply(cue: SceneCue) {
      scene?.show(cue, flightFor(cue.step));
      /* The bubble lands with the step that produced it: sealed at the sender
         when it is encrypted, plain at the receiver when it is opened. */
      if (cue.sentence) {
        const mine = cue.step === 'encrypted';
        const bubble = scene?.say(cue.sentence.side, cue.sentence.text, mine, mine) ?? null;
        if (mine) awaitingDelivery = bubble;
      }
      /* The sender's own bubble stops being pending when the far device has it,
         which is the only moment anything on this page knows that it does. */
      if (cue.step === 'delivered' && awaitingDelivery) {
        awaitingDelivery.dataset.pending = 'false';
        awaitingDelivery = null;
      }
      /* The relay's three claims about one row — the count, the bytes it is made
         of, and the mailbox it is waiting in — all move on this beat, because
         they are one fact told three ways. */
      if (cue.step === 'stored-at-relay') {
        const next = pending.shift();
        if (next) {
          printHolding(next.bytes);
          showRow(next.envelope, next.bytes);
        }
      }
    }

    /* The relay's column: the bytes, then every field that is not held back. */
    function showRow(envelope: Record<string, unknown>, bytes: number) {
      if (!loaded) return;
      shownRow = { envelope, bytes };
      const encoded = String(envelope.ciphertext);
      hex.textContent = loaded.ciphertext.hexStrip(envelope.ciphertext).join('\n');
      hex.hidden = false;
      relayEmpty.hidden = true;

      row.replaceChildren();
      const sealedFields = new Set<string>(loaded.scene.SEALED_SENDER_HIDES);
      let shown = 0;
      let sealable = 0;
      for (const [field, value] of Object.entries(envelope)) {
        if (HELD_BACK.has(field)) continue;
        const hides = sealedFields.has(field);
        if (hides) sealable += 1;
        const term = document.createElement('dt');
        term.textContent = field;
        const definition = document.createElement('dd');
        definition.textContent = String(value);
        /* A field the SDK puts on the envelope and leaves unset is a real row —
           `Object.entries` only reaches keys the object actually has — and the
           inspector shows it rather than hiding it, because "the relay can see
           this field is here and empty" is a different fact from "there is no
           such field". But an unmarked `undefined` in a value column reads as a
           template that failed rather than as the value it is, so it is marked
           and dimmed. The text stays the literal, which is what a developer
           would find on the object. */
        if (value === undefined || value === null) definition.dataset.unset = 'true';
        if (hides) {
          term.dataset.sealedHidden = 'true';
          definition.dataset.sealedHidden = 'true';
        }
        row.append(term, definition);
        shown += 1;
      }
      row.dataset.sealedLens = String(toggles.sealedSender);
      /* The note is a sibling of the list rather than its last child: a `<dl>`
         may hold terms, definitions and grouping `<div>`s, and a paragraph
         inside one is invalid however well it renders. */
      /* Three clauses, one job each. The count shows the script derived the row
         and did not list it. The second accounts for the ciphertext. The third
         accounts for the id, which `HELD_BACK` withholds, so the reader learns
         about every omission. */
      rowNote.textContent =
        `${count(shown)} fields, off the envelope itself · ciphertext above, ${count(bytes)} ` +
        `bytes as ${count(encoded.length)} base64 characters · the id is held back, because this ` +
        'in-memory relay numbers rows in a way yours would not.' +
        (toggles.sealedSender
          ? ` Struck: the ${count(sealable)} fields sealed sender removes. This envelope's ` +
            `${NAMED_FIELDS.mode} is ${String(envelope[NAMED_FIELDS.mode])}, so it is not a sealed ` +
            'one — the demo has no authority to mint a certificate against.'
          : '');
      row.hidden = false;
      rowNote.hidden = false;
    }

    /* One place that turns a thrown error into a sentence, so no path can fail
       silently and leave a reader pressing a button that has stopped working. */
    async function guard(what: string, action: () => Promise<void>) {
      busy = true;
      enable();
      try {
        await action();
      } catch (error) {
        say(`${what} did not finish: ${error instanceof Error ? error.message : String(error)}`);
      } finally {
        busy = false;
        /* If nothing was ever brought up, the demo could not run and the page
           owes the reader the recording again — the status line above says
           why. A failure after a run exists is one action's failure, not the
           demo's, and the reader keeps what they have already watched.
           Asked of `everStarted` rather than of `run`, because Reset drops the
           run on purpose and a reader who has just reset has not lost the
           demo. */
        recorded.hidden = everStarted;
        enable();
      }
    }

    startButton.addEventListener('click', () => {
      void guard('the start', async () => {
        await start();
        /* Coming online is publishing: a device puts its public bundle on the
           relay before anyone has written anything, and the keys are agreed by
           the first message that needs them. This is the real `syncToServer` on
           both clients — the same call `send()` would make on its way past. */
        await run?.publishBundles();
        say(
          'Both devices are online, public bundles on the relay and the private halves still at ' +
            'home. Type a message on either device — the first one agrees the keys.',
        );
      });
    });

    /* Either device may send, so the handler is written once against a side.
       The device that accepted the sentence is the device the SDK is asked to
       send from, which is what makes the reply leg a real reply rather than a
       second outbound message drawn backwards. */
    for (const side of ['a', 'b'] as const) {
      const { input, send } = composers[side];
      send.addEventListener('click', () => {
        const text = input.value.trim();
        if (text === '') {
          say('Type something to send.');
          return;
        }
        void guard('the send', async () => {
          await start();
          await run?.send(side, text);
          /* Cleared after the send resolves rather than on the press: a field
             emptied by a send that threw takes the reader's sentence with it. */
          input.value = '';
          /* After the send resolves, not when it was pressed: the round trip is
             the thing being counted, and a press that threw is not one. */
          reportRun();
        });
      });

      /* The composer answers the return key, because a text field beside a
         button is a form to everyone who has ever used one. */
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          send.click();
        }
      });
    }

    /*
     * The switches.
     *
     * `sealedSender` is a lens and takes effect at once, including on a row the
     * relay is already showing. `braid` is session policy and is locked by
     * `enable()` once a session exists, so its handler only has to record the
     * choice that the next `startDemoRun` will read.
     */
    for (const [key, input] of toggleInputs) {
      input.addEventListener('change', () => {
        toggles = { ...toggles, [key]: input.checked };
        scene?.setToggles(toggles);
        /* Redrawn rather than toggled, because the note under the row names how
           many fields the lens is marking and that sentence has to change with
           it. One place builds the row; the lens does not get a second. */
        if (key === 'sealedSender' && shownRow) showRow(shownRow.envelope, shownRow.bytes);
      });
    }

    reset.addEventListener('click', () => {
      void guard('the reset', async () => {
        reel?.reset();
        scene?.clear();
        (logRoot as HTMLElement & { demoLog?: DemoLogHandle }).demoLog?.clear();
        /*
         * Stopped and dropped rather than reset in place.
         *
         * `run.reset()` re-boots the devices against the options the run was
         * created with, so a reader who came back here to change the protocol
         * switches would get the old policy again and a page that had lied to
         * them about what Reset is for. Dropping the run means the next press
         * builds one from the switches as they now stand. The modules are
         * already fetched, so this costs a boot and not a download.
         */
        await run?.stop();
        run = null;
        sessionExists = false;
        bytesHeld = 0;
        rowsHeld = 0;
        publishedMs.a = 0;
        publishedMs.b = 0;
        published.a = 0;
        published.b = 0;
        derived.a = 0;
        derived.b = 0;
        awaitingDelivery = null;
        shownRow = null;
        pending.length = 0;
        for (const side of ['a', 'b'] as const) composers[side].input.value = '';
        /* Every reading, from the same map that fills them — a hand-written list
           here would go on clearing whatever it was written for while a reading
           added to the scene kept a stale number through a reset. */
        for (const element of readings.values()) element.textContent = '—';
        hex.hidden = true;
        row.hidden = true;
        rowNote.hidden = true;
        relayEmpty.hidden = false;
        say('Reset. Fresh devices, a fresh relay, nothing recorded — braid is open again.');
      });
    });

    /* The console is interactive from here, so the recording stops being what
       the reader is looking at. This runs on script execution rather than on
       the first press: a reader who can press the buttons is not the reader
       the recording is for. */
    recorded.hidden = true;
    enable();
  }
</script>
