---
import CarrierPanel from '../CarrierPanel.astro';
import DemoLog from './DemoLog.astro';
import DemoMobile from './DemoMobile.astro';
import DemoScene from './DemoScene.astro';

/*
 * The demo: one scene, one button.
 *
 * Two SDK clients run in this page. There is no second window and nothing to
 * pair — the reader gets both ends of the conversation at once, which is what
 * the homepage's own quickstart sample twenty lines above already shows: one
 * relay, `alice`, `bob`. The demo is a live rendering of the code the reader
 * has just read.
 *
 * ------------------------------------------------------ the recorded row ---
 *
 * `CarrierPanel` prints a round trip that happened once, on a machine that is
 * not the reader's, and it is server-rendered and visible on arrival. It is the
 * page's answer to a reader whose scripts are off, whose browser the SDK will
 * not run in, or whose chunk never arrived: without it the homepage only
 * *asserts* what a relay holds, and the one artefact on the site that shows it
 * instead would have gone out with a layout change.
 *
 * The script hides it as soon as the console is interactive, and puts it back
 * if the run could not be brought up. So it is the state the page starts in and
 * the state it returns to, never decoration under a working demo.
 *
 * ------------------------------------------------------------- two clocks ---
 *
 * The protocol runs at full speed and is recorded; the drawing replays that
 * recording at the reader's pace. Every number printed on this page comes from
 * the recording. `trace.ts` makes that structural rather than promised: the pace
 * layer is handed cues with every measurement stripped out, so the pacing cannot
 * move a figure — there is no figure in scope for it to move.
 *
 * The line under the log states this for the reader. A round-trip figure can
 * appear before the drawing shows the envelope arriving. The reader must not
 * have to work out why.
 *
 * -------------------------------------------------------------- one button ---
 *
 * Start is the only control in the open, and it sits over the scene it starts.
 * Reset and the two switches are behind Settings, because they change the terms
 * of a run instead of starting one. Before the first press, the reader has one
 * thing to press.
 *
 * Start raises the relay and nothing else. Each phone then carries one
 * "Register with relay" button, because bringing a device up *is* an action a
 * person takes — you install the app, and the device registers, makes its
 * keys and publishes the public halves. Two buttons rather than one "wake
 * both", so the reader watches a single device's bring-up end to end and then
 * does it again, which is what makes the order legible: register, then keys,
 * then publish.
 *
 * There is no play, step or scrub control. A transport makes the reader operate
 * a recording, and the recording is not the subject. `playback.ts` chooses the
 * pace and the replay runs to the end.
 *
 * There is no "exchange keys" control, because key agreement is not an action a
 * person takes. A device publishes its bundle on activation, and the first
 * message that needs a session agrees one. That is what `run.ts` does inside
 * `send()`. The first sentence anyone types agrees the keys, in the recording,
 * where the reader can watch it happen.
 *
 * --------------------------------------------------------------- the names ---
 *
 * `NAMES` is rendered into the column headings *and* into the root's data
 * attributes, and the script starts the run with the values it reads back. One
 * source, so the label over a column and the account the SDK is really using
 * cannot drift. A script cannot read this frontmatter directly — `define:vars`
 * writes an inline script and the site's CSP has no inline scripts in it — so
 * the DOM is the channel, and it is the same DOM the reader is looking at.
 */
const NAMES = { a: 'Alice', b: 'Bob' } as const;

/*
 * The two switches.
 *
 * There is no "Post-quantum required" switch, because it would draw no
 * difference here. The SDK's setting is `required` or `compatible`, and
 * `compatible` still runs PQXDH against any peer that carries ML-KEM material.
 * Both devices on this page carry it. The setting only decides whether the SDK
 * refuses a peer that carries none, and this page has no such peer. A checkbox
 * whose two positions produce the same session teaches something false about
 * what it controls.
 *
 * Post-quantum protection is not a switch on this page, it is the run: the
 * demo asks for `required`, the key agreement is PQXDH, and each wheel is
 * captioned with the ratchet the SDK reports it selected — "triple ratchet"
 * when the post-quantum ratchet is in it. That is the SDK's own report of what
 * happened rather than a restatement of what was asked for, and the SDK
 * publishes no way to run without it.
 *
 * Braid is a real difference and stays. It chooses how the post-quantum key
 * material travels — in bounded chunks, one riding along with each message, or
 * whole in a single message — and both are the post-quantum ratchet. Off by
 * default, as the newer of the two modes.
 *
 * Sealed sender is the odd one and is marked so on the page: the demo has no
 * trust root to mint a sender certificate against, so that switch is a lens
 * over the envelope's addressing rather than a session setting.
 */
const TOGGLES = [
  {
    id: 'sealed-sender',
    key: 'sealedSender',
    label: 'Sealed sender',
    on: true,
    note: 'a lens over the envelope’s addressing — seals the sender the relay would see',
  },
  {
    id: 'braid',
    key: 'braid',
    label: 'Braid',
    on: false,
    note: 'carries the ML-KEM key in 32-byte chunks, one per message, instead of whole — watch the mailbox size',
  },
] as const;
---

<div
  class="demo-console"
  data-demo="console"
  data-console-name-a={NAMES.a}
  data-console-name-b={NAMES.b}
>
  {/*
    The band's own heading and paragraph, passed in by the page that writes
    them, so the console can put a control on the heading's line. The page kept
    them in a `.band-head` beside the console until the settings control was
    asked for the top right corner: the gap between that heading and the top of
    the scene is however tall the paragraph wrapped to, so no absolutely
    positioned control can find the heading's line across it. The slot moves
    the boundary instead of guessing the distance, and everything the script
    drives stays under one root.
  */}
  <div class="demo-console-head">
    <slot name="head" />

    {/*
      The settings, on the heading's line. Everything that changes the terms of
      a run is behind this control, so Start is the only control in the open.

      A native `<details>` instead of a scripted popover. It opens, closes and
      answers the keyboard on its own. The script adds one behaviour the
      element does not have: a press outside it closes it, because a panel
      that floats over the scene reads as a popover and a popover that stays
      up under an outside press reads as stuck.

      "Demo Settings" and not "Settings". On the heading's line the control
      stands in the band's own corner rather than the scene's, where the bare
      word could be read as the site's settings.

      Everything inside ships disabled and the script enables it. A control that
      does nothing is worse than a control that is absent. The reader presses it
      and nothing happens. That reads as a broken demo, not as a chunk that is
      still arriving.
    */}
    <details class="demo-console-settings" data-console-settings>
      <summary class="demo-console-settings-summary">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="demo-console-settings-mark">
          <path
            d="M3 8h18M3 16h18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
          <circle cx="9" cy="8" r="3" fill="currentColor"></circle>
          <circle cx="16" cy="16" r="3" fill="currentColor"></circle>
        </svg>
        Demo Settings
      </summary>

      <div class="demo-console-settings-panel">
        <fieldset class="demo-console-toggles" data-console-toggles disabled>
          <legend class="demo-console-toggles-legend">Protocol</legend>
          {
            TOGGLES.map((toggle) => (
              <label class="demo-console-toggle" for={`demo-toggle-${toggle.id}`}>
                <input
                  type="checkbox"
                  id={`demo-toggle-${toggle.id}`}
                  data-console-toggle={toggle.key}
                  checked={toggle.on}
                />
                <span class="demo-console-toggle-label">{toggle.label}</span>
                <span class="demo-console-toggle-note">{toggle.note}</span>
              </label>
            ))
          }
        </fieldset>

        <button type="button" class="oe-button oe-button-secondary" data-console-reset disabled>
          Reset
        </button>
      </div>
    </details>
  </div>

  {/*
    `id="demo"` is here, on the running thing, and not on the band around it.

    A reader who presses Demo in the nav, or "See Demo" in the hero, is asking
    for the exhibit. Pointing the fragment at the section landed them on the
    heading and the paragraph with the animation below the fold — at every
    width measured, not only on a phone: at 1440x900 the scene's last 38px
    were still under the fold, and at 390x664 the animation began 328px down a
    664px screen. The offset that fixes it is the height of a paragraph that
    wraps differently at every width, so the fragment has to name the exhibit
    rather than the band. `:target` in `global.css` clears the sticky header.

    One box for the two exhibits, because which one is drawn depends on the
    width — the stage from 60rem up, the mobile figure below it — and the
    fragment must land on whichever it is. The box carries no styles of its
    own: the hidden exhibit contributes no height, so it is exactly as tall as
    the one on screen.

    The scene is taller than a phone screen (676px against 664 at 390 wide), so
    this lands its top under the header rather than fitting its bottom to the
    fold. Bottom-fitting would push the beginning of the animation off the top
    of a phone, which is where the conversation starts.
  */}
  <div id="demo" class="demo-console-exhibit">
    {/*
      The stage holds the scene and the curtain. The curtain sits over the
      scene instead of around it, so both share one positioned box.
    */}
    <div class="demo-console-stage">
      <DemoScene />

      {/*
        The curtain covers the scene and carries the one control that starts
        it. The reader looks at the scene while deciding to run it.

        Start fetches the code and raises the relay — nothing more. The devices
        come up one at a time, on the Register button each phone carries,
        because bringing a device up is the reader's own act and the thing this
        demo wants watched.

        The script lifts the curtain once the run is up, and Reset puts it
        back. A reader with no scripts keeps a blurred scene under a button
        that is visibly unavailable, with the recorded row below it.
      */}
      <div class="demo-console-curtain" data-console-curtain>
        <button type="button" class="oe-button" data-console-start disabled>Start demo</button>
      </div>
    </div>

    {/*
      The narrow screen's demo. Below 60rem the stage, the log, the status line
      and the note are all hidden — `global.css` owns the rule — and this
      figure plays the same conversation as an autonomous loop. Its own CSS
      keeps it `display: none` from 60rem up, so exactly one of the two is ever
      drawn.
    */}
    <DemoMobile a={NAMES.a} b={NAMES.b} />
  </div>

  <p class="demo-console-status" data-console-status role="status" aria-live="polite"></p>

  {/*
    The log, last, because it is the transcript rather than the story: the
    scene is paced for reading and this is the recording's own clock, printed
    the moment each event exists. A reader who wants the exact order and the
    exact call comes down here; nobody has to.
  */}
  <DemoLog />

  {/*
    Each sentence answers one misreading. The first: the drawing is a replay,
    and the run behind every figure went at full speed. The second: the timings
    under each device are not latency, because the relay runs in this tab. No
    number here contains a network, and nothing on the page simulates one.
  */}
  <p class="demo-console-note measure">
    Recorded at full speed, replayed at reading pace — every number comes from the run. The relay
    is in this tab, so no timing includes a network.
  </p>

  {/*
    The recorded capture: server-rendered, visible on arrival, hidden by the
    script once the console can actually be pressed, and restored if the run
    could not be brought up.

    The `<noscript>` is the only thing on the page that can address the reader
    it is for, because the script that would otherwise explain the panel is the
    thing that is not running. The copy above this component offers that reader
    an interaction — "type a sentence" — and a page that makes an offer to
    someone who cannot take it owes them the reason in the same breath.
  */}
  <div class="demo-console-recorded" data-console-recorded>
    <noscript>
      <p class="demo-console-note measure">
        The live demo needs JavaScript, which is off here, so what follows is a recording of a
        round trip rather than one running in your browser. Every value in it came off a real
        envelope.
      </p>
    </noscript>
    <CarrierPanel />
  </div>
</div>

<script>
  /*
   * The console's wiring.
   *
   * Nothing protocol-shaped is imported at the top of this file. `run.ts` pulls
   * the SDK behind it and the homepage is measured for what it fetches before a
   * reader asks for anything, so every import that carries weight is inside
   * `chunks()`, on the far side of a press.
   *
   * ------------------------------------------------- what follows which clock ---
   *
   * Two things arrive from the recording and they are deliberately on different
   * clocks.
   *
   * The metrics print the moment the measurement exists. They describe a run
   * that has already finished at full speed, they are not part of the story
   * being paced, and holding them back would make the transport look like it was
   * timing something.
   *
   * The log prints on that same measured clock, and deliberately: it is the
   * transcript, not the story, and a reader consulting it wants the order the
   * protocol really went in.
   *
   * Everything that tells the story — the scene, the bubbles inside the phones,
   * the relay's mailboxes — waits for the reel. A reader should not be shown
   * the sentence arriving at the far device before the envelope has visibly got
   * there. `apply()` is the one place those move, so they cannot fall out of
   * step with each other.
   */
  import type { DemoRun, DeviceActor } from '../../lib/demo/run';
  import type { Playback } from '../../lib/demo/playback';
  import type { SceneCue, SceneToggles, SceneView, Side } from '../../lib/demo/scene-view';
  import type { TraceEvent } from '../../lib/demo/trace';

  /*
   * The log is a separate island with its own inline module, so neither script
   * can import the other's. `DemoLog.astro` hangs this on its own root element
   * once it has mounted, and this is that shape restated where it is called —
   * a structural type, so a change to the handle is a compile error here.
   */
  interface DemoLogHandle {
    append(event: TraceEvent): void;
    clear(): void;
  }

  const mount = document.querySelector<HTMLElement>('[data-demo="console"]');
  if (mount) upgrade(mount);

  function upgrade(root: HTMLElement) {
    const need = <E extends Element>(selector: string): E => {
      const found = root.querySelector<E>(selector);
      if (!found) throw new Error(`demo console: ${selector} is missing from the markup`);
      return found;
    };

    const startButton = need<HTMLButtonElement>('[data-console-start]');
    const curtain = need<HTMLElement>('[data-console-curtain]');
    const reset = need<HTMLButtonElement>('[data-console-reset]');
    const status = need<HTMLElement>('[data-console-status]');
    const recorded = need<HTMLElement>('[data-console-recorded]');
    const toggleBox = need<HTMLFieldSetElement>('[data-console-toggles]');
    const settings = need<HTMLDetailsElement>('[data-console-settings]');
    const sceneRoot = need<HTMLElement>('[data-demo-scene]');
    const logRoot = need<HTMLElement>('[data-demo-log]');
    /*
     * The readings, keyed the way the scene writes them: a device's three are
     * `a-keygen`, `a-kyber`, `a-establish` and the same for `b`. The relay has
     * none — it runs in this tab, so nothing it could report is a cost a
     * developer would pay.
     *
     * Looked up by key rather than held as named handles, because the routing
     * is by *actor* and a named handle invites the mistake this replaces. Each
     * of these measures is recorded by `run.ts` against the device that did the
     * work, and the console used to print figures under whichever column
     * looked tidy: every reply leg printed bob's work under alice's name. The
     * numbers were real and every one of them was under the wrong device.
     */
    const readings = new Map<string, HTMLElement>(
      [...root.querySelectorAll<HTMLElement>('[data-console-metric]')].map((element) => [
        element.dataset.consoleMetric ?? '',
        element,
      ]),
    );
    const reading = (key: string): HTMLElement | undefined => readings.get(key);
    /* Ten: five under each device. A selector that matched none of them would
       otherwise print nothing, silently, and a demo whose timings never appear
       looks exactly like one nobody pressed. */
    if (readings.size !== 10) {
      throw new Error(`demo console: expected 10 readings in the scene, found ${readings.size}`);
    }

    /* The composer belongs to the device now, so there are two of them and
       either may start a conversation. Both are read out of the scene rather
       than duplicated here: the phone that shows the message is the phone that
       accepted it, and one selector proves that rather than asserting it. */
    const composers: Record<Side, { input: HTMLInputElement; send: HTMLButtonElement }> = {
      a: {
        input: need<HTMLInputElement>('[data-scene-input="a"]'),
        send: need<HTMLButtonElement>('[data-scene-send="a"]'),
      },
      b: {
        input: need<HTMLInputElement>('[data-scene-input="b"]'),
        send: need<HTMLButtonElement>('[data-scene-send="b"]'),
      },
    };

    /* The activate buttons, one per phone, read from the scene like the
       composers are. The scene owns their *visibility* — the `registered` cue
       marks the phone activated and the overlay goes with it — and this script
       owns only whether they may be pressed, so the two states cannot fight
       over one attribute. */
    const activators: Record<Side, HTMLButtonElement> = {
      a: need<HTMLButtonElement>('[data-scene-activate="a"]'),
      b: need<HTMLButtonElement>('[data-scene-activate="b"]'),
    };

    const toggleInputs = new Map<string, HTMLInputElement>(
      [...root.querySelectorAll<HTMLInputElement>('[data-console-toggle]')].map((input) => [
        input.dataset.consoleToggle ?? '',
        input,
      ]),
    );

    const names = { a: root.dataset.consoleNameA ?? 'a', b: root.dataset.consoleNameB ?? 'b' };

    /*
     * The envelope fields this file names, and the only ones it may.
     *
     * The addressing drawn on the envelope graphic cannot be derived: something
     * has to say which field is the recipient. Everything else about a stored
     * row stays off the page — the mailbox drawing and its byte figure are the
     * relay's whole account of itself.
     *
     * They are gathered here rather than reached for inline so that the test
     * can lift them out of this source and check each against the installed
     * `Envelope`. Named inline, a rename in the SDK would leave the graphic
     * addressed to an em dash — quietly, and in the direction that flatters
     * us, which is how the same defect landed once already.
     *
     * The demo does not run sealed sender — it needs a trust root and a sender
     * certificate to mint against, and this page has neither — so that switch
     * is a lens over this addressing rather than a session setting: on, the
     * drawn envelope's `from` gives way to a lock while the relay's real copy
     * keeps its sender fields. The relay's own `messageType` says which mode
     * really ran, and `unidentified_sender` is not what these envelopes carry.
     */
    const NAMED_FIELDS = {
      to: 'targetUserId',
      from: 'senderUserId',
    } as const;

    type Loaded = {
      run: typeof import('../../lib/demo/run');
      playback: typeof import('../../lib/demo/playback');
      scene: typeof import('../../lib/demo/scene-view');
    };

    let loaded: Loaded | null = null;
    let run: DemoRun | null = null;
    let scene: SceneView | null = null;
    let reel: Playback<SceneCue> | null = null;
    /* One transport per device for the registration story, so a reader who
       presses the second Register button while the first story is playing
       watches both run beside each other instead of queueing. The scene
       scopes a lane cue's writes to its own device — `registrationLaneOf`
       in `scene-view.ts` is the shared rule — and the composers below wait
       for every transport, so conversation cues are never concurrent with
       anything. */
    let regLanes: Record<Side, Playback<SceneCue>> | null = null;
    let starting: Promise<void> | null = null;
    /** Whether a run has ever come up here. Reset drops the run; this survives. */
    let everStarted = false;
    let busy = false;
    /* Whether any transport — the reel or a registration lane — is still
       telling a story. The protocol runs well ahead of the reader, so `busy`
       clears milliseconds after a press while the drawing has tens of
       seconds of replay left — and a sentence accepted during that replay
       would seal, travel and open in the recording while the scene was still
       showing the last one, stacking a backlog the reader never asked to sit
       through. The composers wait for all of them. */
    let reelBusy = false;
    /* Set from the recording rather than from the press that caused it. The
       session is agreed inside the first send, so the only thing that knows one
       exists is the step the SDK recorded when it did. */
    let sessionExists = false;
    /* Which devices the reader has brought up. Set when an activation
       resolves, not when it is pressed — a press that threw did not activate
       anything — and cleared by Reset with the run it described. */
    const activated: Record<Side, boolean> = { a: false, b: false };
    /* Generation, per device, as a running total of the windows `run.ts`
       measured. A sum rather than the last figure seen, because a device that
       tops its keys up during a later sync generated keys twice, and the panel
       is answering how long this device spent making keys — not how long the
       most recent batch took. The keypair count travels with the time for the
       same reason: a figure that says how long is only a price once it says how
       long *for what*, and "100 keys · 1,200 ms" is the line a developer can
       take to their own budget. */
    const generatedMs: Record<Side, { keygen: number; kyber: number }> = {
      a: { keygen: 0, kyber: 0 },
      b: { keygen: 0, kyber: 0 },
    };
    const generatedKeys: Record<Side, number> = { a: 0, b: 0 };

    /*
     * Public keys the relay is holding for each device, as the relay itself
     * reports them.
     *
     * Not a count of publish events — that would say "two", which is the number
     * of devices rather than the number of keys, and would go on saying two
     * however much material each one actually put up. `run.ts` reads the relay
     * back after each publish and reports what is on the shelf for that one
     * device, so the shelf is drawn from the store rather than from the page's
     * own bookkeeping.
     *
     * The same number starts each device's own key store, because at publish
     * time the two ends really do agree: every public key the relay holds for
     * a device is one half of a pair whose other half never left that device.
     */
    const published: Record<Side, number> = { a: 0, b: 0 };

    /*
     * Private keys held, per device, read from each device's own store.
     *
     * A separate count from `published` because the two part company: a bundle
     * fetch consumes one-time public halves off the relay's shelf at once, and
     * the private halves fall later — the SDK deletes them when the first
     * successful decryption commits the session. `run.ts` reads the store
     * after each publish and after each opening, so the device's column dips
     * where and *when* the spend really lands rather than mirroring the shelf.
     */
    const held: Record<Side, number> = { a: 0, b: 0 };

    /*
     * Message keys derived, per device. The ratchet's notches are this count and
     * nothing else.
     *
     * Counted where the derivation happens rather than shared between the two:
     * the sender derives one when it seals, the receiver derives one when it
     * opens, and a single counter would draw both devices turning together,
     * which is the one thing a ratchet does not do.
     */
    const derived: Record<Side, number> = { a: 0, b: 0 };

    /** The switches, as the scene and the next session read them. */
    let toggles: SceneToggles = { sealedSender: true, braid: false };

    /** The sender's bubble that has not yet been confirmed at the far device. */
    let awaitingDelivery: HTMLElement | null = null;

    const say = (text: string) => {
      status.textContent = text;
    };

    /*
     * What the curtain says while it is still down.
     *
     * Two places, because they answer two different readers. The status line
     * below the stage keeps the sentences, and it is not where anyone is
     * looking on the first press: the reader pressed a button in the middle of
     * a blurred stage, so the button is where the answer has to appear. Each
     * stage writes both, synchronously at the boundary, so the first of them
     * lands in the frame the press did rather than after the first chunk has
     * arrived.
     *
     * One stage, for the one await the opening makes: fetching the code. The
     * devices are no longer part of the opening — each comes up on its own
     * Register press, where the scene narrates the work itself. Named for
     * what is happening rather than counted, because a progress figure would
     * be this page's estimate of work it cannot see the inside of.
     */
    /* Read off the button rather than spelled again here. What the control is
       called is the page's copy and it is written in the markup; a second
       spelling in the script is a second answer, and the two part company the
       first time either is edited. */
    const START_LABEL = startButton.textContent ?? '';
    const opening = (label: string, sentence: string) => {
      startButton.textContent = label;
      say(sentence);
    };

    /*
     * One event, the first time a sentence completes a round trip on this page,
     * carrying nothing about it — not the sentence, not its length, not the
     * byte counts or the milliseconds printed beside it. The beacon reads
     * `demo_run /` and there is no third field for it to read.
     *
     * Once per page rather than once per send. The question it exists to answer
     * (plan D5) is whether readers who ran the demo go on to enter and finish
     * the quickstart, and its denominator is readers; counting sends would
     * measure how much someone enjoyed pressing the button. Nothing here
     * identifies a page view, so this is the closest a cookieless model gets to
     * "a reader ran it", and it is deliberately the conservative direction.
     *
     * `public/measure.js` owns the beacon; this owns the moment. The site's
     * delegated click handler reads links, and this is a button in a module it
     * knows nothing about.
     */
    let reportedRun = false;
    const reportRun = () => {
      if (reportedRun) return;
      reportedRun = true;
      window.oeMeasure?.('demo_run');
    };
    const ms = (value: number) => `${value.toFixed(1)} ms`;
    const count = (value: number) => value.toLocaleString('en-US');

    /*
     * What may be pressed.
     *
     * The devices are the demo, so once they are up both composers are live and
     * there is nothing else to operate. Key agreement is not a control here — a
     * device publishes when it comes online and the session is agreed by the
     * first message that needs one, which is what `run.ts` does inside `send()`
     * whether or not anything asked it to.
     */
    const enable = () => {
      const running = run !== null;
      startButton.disabled = busy || running;
      reset.disabled = busy || !running;
      /* The curtain is up whenever no run is behind it. This state decides it,
         not the press. A start that throws leaves the reader the button that
         starts one, and Reset gives the button back. */
      curtain.hidden = running;
      /* Braid chooses what the *next* session negotiates, so it goes unavailable
         once one exists. A switch that appeared to change a running session
         would be describing key agreement wrongly, and Reset is the honest way
         back to a different answer. The sealed-sender lens is not a session
         setting and stays live throughout — see the note by `NAMED_FIELDS`. */
      toggleBox.disabled = false;
      for (const [key, input] of toggleInputs) {
        if (key !== 'sealedSender') input.disabled = busy || sessionExists;
      }
      /* Live once the run is up, until this side's device is. The scene hides
         the overlay when the `registered` cue plays; between the activation
         resolving and that cue, the button is disabled under the reader's
         finger — pressed, taken, and about to be dismissed by the replay. */
      for (const side of ['a', 'b'] as const) {
        activators[side].disabled = busy || !running || activated[side];
      }
      /* And not while the reel is mid-story: the scene must finish showing
         the last sentence's journey before it accepts the next one. Reset
         stays live through a replay — it is the way out of one. A composer
         also waits for both devices: a sentence needs somewhere to go, and
         `run.ts` would refuse a send to a device that does not exist. */
      const conversable = running && activated.a && activated.b;
      for (const side of ['a', 'b'] as const) {
        composers[side].input.disabled = busy || reelBusy || !conversable;
        composers[side].send.disabled = busy || reelBusy || !conversable;
      }
    };

    /**
     * The three modules the console needs, fetched together on the first press.
     *
     * One `Promise.all` rather than three awaited in turn: they are independent,
     * and a reader who pressed a button is waiting on the slowest of them rather
     * than on their sum. The SDK is behind `run`, which is the whole reason any
     * of this is here instead of at the top of the file.
     */
    async function chunks(): Promise<Loaded> {
      const [runModule, playback, sceneModule] = await Promise.all([
        import('../../lib/demo/run'),
        import('../../lib/demo/playback'),
        import('../../lib/demo/scene-view'),
      ]);
      return { run: runModule, playback, scene: sceneModule };
    }

    /**
     * Bring the run up, once, however many controls asked for it.
     *
     * The promise is shared rather than re-entered: a reader who presses
     * "Exchange keys" and then "Send" before the chunk lands has asked for one
     * run, and two would boot two pairs of devices against two relays and record
     * both into one drawing.
     *
     * Everything the opening does happens in here, behind the curtain, and the
     * reel is handed no cue until all of it has finished. Publishing used to be
     * awaited by the press handler *after* this resolved, so the curtain lifted
     * and the first dwell was armed while the opening was still running: the
     * reel began on a recording that was still being made, and it shared the
     * main thread with the work making it. Nothing on the reading clock may run
     * beside protocol work, whatever that work costs on the day it is measured
     * — the relay is in this page, and the same steps against a relay across a
     * network are the case this ordering has to be right for.
     */
    function start(): Promise<void> {
      if (run) return Promise.resolve();
      if (starting) return starting;

      opening('Fetching the SDK…', 'Fetching the SDK…');
      const attempt = (async () => {
        const parts = await chunks();
        loaded = parts;

        /* Mounted once for the life of the page. Reset drops the run and comes
           back through here, and a second mount would leave the first view
           holding elements the second one is also writing to. */
        scene ??= parts.scene.mountScene(sceneRoot, names);
        scene.setToggles(toggles);

        /*
         * The pace, with the per-step dwell `playback.ts` already publishes.
         *
         * Keyed on the same step names the recording uses, so a step added to
         * the protocol arrives here with a dwell rather than silently taking a
         * default. The dwell is a constant and is not derived from a duration
         * token: `tokens.css` collapses those to a hundredth of a millisecond
         * under `prefers-reduced-motion`, and a reader who asked for less motion
         * should lose the motion, not the information.
         */
        if (!reel) {
          reel = parts.playback.createPlayback<SceneCue>({
            show: apply,
            /* A replay from the top starts from an empty drawing. No current
               control reaches this — cues from a still-running protocol
               resume a spent reel without rewinding — but a transport that
               ever did replay must not draw on top of the first watch. The
               registration cues live on the lanes, so a real replay feature
               would have to replay those too. */
            rewind: () => {
              scene?.clear();
              awaitingDelivery = null;
            },
            dwellMs: parts.playback.STEP_DWELL_MS,
          });
          regLanes = {
            a: parts.playback.createPlayback<SceneCue>({
              show: apply,
              dwellMs: parts.playback.STEP_DWELL_MS,
            }),
            b: parts.playback.createPlayback<SceneCue>({
              show: apply,
              dwellMs: parts.playback.STEP_DWELL_MS,
            }),
          };
          /* A transport is the only thing that knows the last cue's dwell
             has been served with nothing behind it — `done` fires on the tick
             after that dwell, and a push starts it again. Each transport
             settles exactly what it was narrating: a lane rests its own
             device's wire and shelf, so a registration that finishes first
             goes dormant while the other story plays on, and the reel rests
             the whole scene — by the time conversation cues exist, both
             lanes are long dry; see `SceneView.settle`. The composers wait
             on the aggregate: they go quiet while any transport is telling
             a story and come back when none has anything left to show,
             which is what keeps a reader from writing the next sentence
             into the middle of the last one's replay. */
          const transports: [Playback<SceneCue>, readonly Side[] | undefined][] = [
            [reel, undefined],
            [regLanes.a, ['a']],
            [regLanes.b, ['b']],
          ];
          for (const [transport, sides] of transports) {
            transport.on((state) => {
              if (state === 'done') scene?.settle(sides);
              reelBusy = transports.some(
                ([t]) => t.state === 'playing' || t.state === 'paused',
              );
              enable();
            });
          }
        }

        /*
         * The protocol options, read here and nowhere later — this is the only
         * moment they can take effect, which is why braid locks once a session
         * exists. The devices they govern come up later, one Register press at
         * a time, against the policy captured here.
         *
         * `postQuantum` is not a switch on this page and is asked for outright.
         * `compatible` would not have been "post-quantum off": it still runs
         * PQXDH against a peer that has KEM material, and both peers here do, so
         * the two settings would have produced the same session and a control
         * offering them would have taught a reader something false. See the
         * `TOGGLES` note above.
         */
        const started = await parts.run.startDemoRun({
          a: names.a,
          b: names.b,
          protocol: {
            postQuantum: 'required',
            braid: toggles.braid ? 'required' : 'disabled',
          },
        });

        /*
         * The run is only now something the page has, which is what lifts the
         * curtain: `enable()` reads exactly this. Held back until the opening
         * has finished rather than set where it is created, so an opening that
         * threw leaves the reader the button that starts one instead of a lifted
         * curtain over a scene with nothing behind it.
         */
        run = started;
        /*
         * Replay whatever the recording already holds, then subscribe, with no
         * `await` between the two — so no event can arrive in the gap and none
         * is seen twice. A run comes up as the relay alone and records nothing
         * doing it, so the replay finds an empty trace; the ordering is the
         * invariant, because an opening that records again would otherwise
         * come up with its first steps silently missing from every surface.
         */
        for (const event of started.trace.events) record(event);
        started.trace.on(record);
        everStarted = true;
        say('');
      })();

      starting = attempt.finally(() => {
        starting = null;
        /* The curtain comes back on Reset, and it must not come back carrying
           the last thing the opening was doing. */
        startButton.textContent = START_LABEL;
      });
      return starting;
    }

    /** Recorded: print what was measured, log it, and queue the story for the reel. */
    function record(event: TraceEvent) {
      printMetrics(event);
      /* Looked up per event rather than held: the log is a separate island and
         may mount after this one, so a reference taken at upgrade time could be
         a reference to nothing. */
      (logRoot as HTMLElement & { demoLog?: DemoLogHandle }).demoLog?.append(event);
      if (event.step === 'bundles-published') {
        /* Absent when the relay had nothing for this device — `run.ts` keeps an
           unobserved reading out of the trace rather than reporting it as a
           zero, so an absent one leaves the last known count standing. */
        const detail = event.detail as
          | { publicKeys?: unknown; heldKeys?: unknown }
          | undefined;
        const keys = detail?.publicKeys;
        const actor = event.actor;
        if ((actor === 'a' || actor === 'b') && typeof keys === 'number') published[actor] = keys;
        if ((actor === 'a' || actor === 'b') && typeof detail?.heldKeys === 'number')
          held[actor] = detail.heldKeys;
      }
      if (event.step === 'opened') {
        /* The opener's store, re-read after the decrypt. On a session-creating
           message this is where the one-time private halves fall. */
        const heldKeys = (event.detail as { heldKeys?: unknown } | undefined)?.heldKeys;
        const actor = event.actor;
        if ((actor === 'a' || actor === 'b') && typeof heldKeys === 'number')
          held[actor] = heldKeys;
      }
      if (event.step === 'session-established') sessionExists = true;
      const cue = toCue(event);
      /* A registration step plays on its own device's lane and everything
         else on the shared reel, `registrationLaneOf`'s rule — the same
         derivation `show` scopes its writes with, because a cue routed to a
         lane but applied whole-scene would stomp the other lane's story. */
      const lane = loaded ? loaded.scene.registrationLaneOf(cue) : null;
      const transport = (lane ? regLanes?.[lane] : null) ?? reel;
      transport?.push(cue);
      /* The first cue is what makes the transport worth offering, so the
         controls are re-read here rather than only on a press. */
      enable();
      transport?.play();
    }

    /**
     * Print each measurement under the device that produced it.
     *
     * Routed by `event.actor`, which is the device `run.ts` recorded the work
     * against, and never by which column the figure would look tidy in. Every
     * row that prints is real cryptographic work on the device's own
     * processor: making keys, the post-quantum share of that, agreeing the
     * session, sealing a message and opening one — the last two bracketed at
     * the device's edge by `run.ts`, so neither contains the relay. The
     * publish and round-trip spans the recording also carries are deliberately
     * not printed — each is a span through a relay that runs in this same tab,
     * and a simulated network's timings price nothing a developer can use.
     */
    function printMetrics(event: TraceEvent) {
      const measures = event.measures;
      if (!measures) return;
      const actor = event.actor === 'a' || event.actor === 'b' ? event.actor : null;
      if (!actor) return;

      const put = (key: string, text: string) => {
        const element = reading(`${actor}-${key}`);
        if (element) element.textContent = text;
      };
      if (typeof measures.keygenMs === 'number') {
        generatedMs[actor].keygen += measures.keygenMs;
        /* The batch size arrives on the same event as the closing window —
           `run.ts` puts the keypair total on the report that carries the
           measure — so the count and the time it prices move together. */
        const total = (event.detail as { total?: unknown } | undefined)?.total;
        if (typeof total === 'number') generatedKeys[actor] += total;
        put(
          'keygen',
          generatedKeys[actor] > 0
            ? `${count(generatedKeys[actor])} keys in ${ms(generatedMs[actor].keygen)}`
            : ms(generatedMs[actor].keygen),
        );
      }
      if (typeof measures.kyberMs === 'number') {
        generatedMs[actor].kyber += measures.kyberMs;
        put('kyber', ms(generatedMs[actor].kyber));
      }
      if (typeof measures.establishMs === 'number') put('establish', ms(measures.establishMs));
      /* Latest rather than a running sum: each message prices one seal or one
         open, and the reading is "what does this cost", not "what has it
         cost so far" — the keygen rows accumulate because their batches are
         instalments of one job. */
      if (typeof measures.encryptMs === 'number') put('encrypt', ms(measures.encryptMs));
      if (typeof measures.decryptMs === 'number') put('decrypt', ms(measures.decryptMs));
      /* A device's first opening is also its share of the key agreement — the
         KEM decapsulation and DH ratchet run inside that first decrypt, and
         the trace prices the one interval once, as `establishMs` on the
         `opened` event (`run.ts` says why). The row is another matter: a
         decryption reading "—" after an envelope was visibly opened reads as
         a defect, not as bookkeeping. So the fused figure prints here too,
         marked as the shared span it is, and the steady-state cost of the
         next arrival overwrites it. */
      if (event.step === 'opened' && typeof measures.establishMs === 'number')
        put('decrypt', `${ms(measures.establishMs)} with key agreement`);
    }

    /**
     * A recorded event as something the drawing can be given.
     *
     * A projection and nothing else: it reads the event and returns a cue, and
     * the cue is where the paced half of the page gets everything it knows.
     *
     * A cue carries numbers on purpose. Five fields hold them and no others do,
     * which is the invariant `demo-run.test.mjs` holds: every number on a cue
     * lives on `ratchet`, `bundles`, `keys`, `keygen` or `bytes`, and every
     * other value, at any depth, is a string. A number arriving on a sixth
     * field is the regression, and telling it apart by size would not work —
     * `bundles` counts real prekeys and runs into the hundreds, the same order
     * as a byte count.
     *
     * Four of the five are counts of things: notches turned, bundles held, key
     * shapes shelved, keypairs generated. `bytes` is the exception and is a
     * measurement, carried because the mailbox prints the size of the row it is
     * holding and there is no honest way to draw a size without the size. It is
     * held to a stricter rule than the rest: it must be the byte count the
     * recording measured for that row, because a drawn size no event reported
     * would be a decoration.
     *
     * The two-clock separation survives this. It was never about numbers as
     * such — it is that nothing the drawing receives is a duration, so pacing
     * has nothing on a cue it could move. A byte count is not a clock reading.
     */
    function toCue(event: TraceEvent): SceneCue {
      const detail = (event.detail ?? {}) as Record<string, unknown>;
      /* A trace event's `from` and `to` may name the relay, and a sentence
         belongs to a device. Asked rather than asserted: which actor a step
         belongs to is a fact about the recording, and a cast here would let a
         step recorded against the relay put a sentence inside a relay slot. */
      const device = (actor: TraceEvent['from']): DeviceActor | null =>
        actor === 'a' || actor === 'b' ? actor : null;
      const from = device(event.from);
      const to = device(event.to);

      const base: SceneCue = {
        step: event.step,
        actor: event.actor,
        ...(event.from === undefined ? {} : { from: event.from }),
        ...(event.to === undefined ? {} : { to: event.to }),
      };

      /* Counted at the step that derives the key, and snapshotted into the cue
         rather than read from the counter when the cue plays. The protocol runs
         well ahead of the reader, so a cue that read a live counter would draw
         a ratchet that had already turned several more times than the step it
         is showing. */
      if (event.step === 'encrypted' && from) derived[from] += 1;
      if (event.step === 'opened' && to) derived[to] += 1;
      const turned = { ratchet: { a: derived.a, b: derived.b } };

      if (event.step === 'devices-ready') {
        return { ...base, ...turned };
      }
      /* Both figures off the report, and the side off the actor the work was
         recorded against. A cue that carried only the count would leave the bar
         to divide by a total it had kept for itself, and the day a device
         generated a different number of keys the bar would be drawn against the
         other one's. */
      if (event.step === 'generating-keys') {
        const side = device(event.actor);
        const keypairs = detail.keypairs;
        const total = detail.total;
        return {
          ...base,
          ...turned,
          ...(side && typeof keypairs === 'number' && typeof total === 'number'
            ? { keygen: { side, count: keypairs, total } }
            : {}),
        };
      }
      /*
       * Which ratchet ran, from the SDK rather than from the switches.
       *
       * `run.ts` puts the `ProtocolSelectionEvent` on this step, and this is the
       * one place the demo can honestly caption the wheel: the switches say what
       * was asked for, and the selection says what was agreed. They can differ —
       * `postQuantum: 'compatible'` against a peer with no ML-KEM is exactly the
       * case where they do — and the caption has to follow the second.
       *
       * Nullable all the way down and left that way. A callback that stops
       * firing leaves the wheel captioned plainly rather than captioned wrongly,
       * which is the direction that does not flatter us. `demo-run.test.mjs`
       * holds the event itself against a real key agreement so that the absent
       * case cannot quietly become the normal one.
       */
      /*
       * The peer's shelf, as the relay reports it once the bundle has been
       * taken off.
       *
       * Written into the same running count the publishes fill, so the shelf
       * carries one figure per account for the whole run rather than a
       * published one that a later step contradicts. It is the relay's own
       * reading — `run.ts` queries the account after the fetch — and the shelf
       * that falls is named on the reading rather than inferred from `to`.
       *
       * `keys` is deliberately not re-stated here. The device's column counts
       * private halves and the responder has not touched a key: the relay
       * handed out a bundle it was already holding, and the device it belongs
       * to has not so much as seen a message yet. This is the one step at which
       * the two figures are honestly different, which is the fact the frame
       * exists to show. The spend reaches the device's column on `opened`,
       * which carries the store's own count read after the decrypt that
       * commits it.
       */
      if (event.step === 'session-established') {
        const selection = detail.selection as { usedTripleRatchet?: unknown } | null | undefined;
        const spent = detail.peer as { side?: unknown; publicKeys?: unknown } | undefined;
        const side = spent?.side === 'a' || spent?.side === 'b' ? spent.side : null;
        if (side && typeof spent?.publicKeys === 'number') published[side] = spent.publicKeys;
        return {
          ...base,
          ...turned,
          ...(typeof selection?.usedTripleRatchet === 'boolean'
            ? { ratchetKind: selection.usedTripleRatchet ? ('triple' as const) : ('double' as const) }
            : {}),
          ...(side && typeof spent?.publicKeys === 'number'
            ? { bundles: { a: published.a, b: published.b } }
            : {}),
        };
      }
      if (event.step === 'bundles-published') {
        return {
          ...base,
          ...turned,
          /* A count per device, because the relay draws a shelf per device.
             The sum is not carried alongside them: a total the drawing does not
             print is a third figure to keep true, and the one place a total
             would go is a shelf that belongs to nobody. */
          bundles: { a: published.a, b: published.b },
          keys: { a: held.a, b: held.b },
        };
      }
      /* The addressing rides from the moment the envelope is sealed, not from
         the moment the relay files it. An envelope drawn in flight with an
         em dash where the recipient goes says the routing is decided somewhere
         between the two, which is the opposite of what this demo is for. These
         are the names this page gave the two devices; `stored-at-relay` below
         replaces them with the fields read off the relay's own copy, which is
         where the claim about what the relay can see has to come from. */
      if (event.step === 'encrypted' || event.step === 'in-transit') {
        const addressed = {
          ...(to === null ? {} : { to: names[to] }),
          ...(from === null ? {} : { from: names[from] }),
        };
        if (event.step === 'in-transit') return { ...base, ...turned, meta: addressed };
        /* The braid's progress rides the sealing step, pre-formatted: the last
           report this send raised is the state the envelope leaves in. A
           string and not a pair of counts — the five-field number invariant
           above is why — and absent in direct mode, where no report is ever
           raised and the tile never grows the strip. */
        const report = event.braid?.at(-1);
        /* The size travels from the sealing step, off the run's measure of the
           bytes the relay had already been handed — so the mark can ride the
           envelope for its whole journey rather than appear mid-way. */
        return {
          ...base,
          ...turned,
          meta: addressed,
          ...(typeof event.measures?.ciphertextBytes === 'number'
            ? { bytes: event.measures.ciphertextBytes }
            : {}),
          ...(report ? { chunk: `pq chunks ${report.chunksCarried} / ${report.chunksRequired}` } : {}),
          ...(typeof detail.text === 'string' && from
            ? { sentence: { side: from, text: detail.text } }
            : {}),
        };
      }
      if (event.step === 'stored-at-relay') {
        const envelope = (detail.envelope ?? {}) as Record<string, unknown>;
        /* The addressing on the drawn envelope is the addressing on the real
           one, read off the same object the relay stored, so the two cannot
           disagree about who the relay can see. The size travels with it, off
           the same event's own measure of the ciphertext it stored, so the
           figure the mailbox prints is the count the recording took rather
           than a number that agrees with it. */
        return {
          ...base,
          ...turned,
          ...(typeof event.measures?.ciphertextBytes === 'number'
            ? { bytes: event.measures.ciphertextBytes }
            : {}),
          meta: {
            ...(typeof envelope[NAMED_FIELDS.to] === 'string'
              ? { to: envelope[NAMED_FIELDS.to] as string }
              : {}),
            ...(typeof envelope[NAMED_FIELDS.from] === 'string'
              ? { from: envelope[NAMED_FIELDS.from] as string }
              : {}),
          },
        };
      }
      if (event.step === 'opened' && to) {
        const opened = detail.decrypted as { content?: unknown } | undefined;
        const text = typeof opened?.content === 'string' ? opened.content : '';
        /* The stores' counts ride every opening. On a session-creating message
           the opener's figure has just dipped — the SDK deleted the one-time
           private halves when this decrypt committed the session — and on
           every later one the restated number simply holds the bars still. */
        return {
          ...base,
          ...turned,
          sentence: { side: to, text },
          keys: { a: held.a, b: held.b },
        };
      }
      return { ...base, ...turned };
    }

    /**
     * How long the envelope takes to cross, in milliseconds.
     *
     * A share of the step's own dwell, capped, so travel always finishes inside
     * the time the step is held and a longer-held step gets a longer glide. It
     * is a presentation number derived from another presentation number, and it
     * touches no measurement — see the two-clock note at the top of this file.
     *
     * The share was two fifths and is now most of the step, which is the
     * difference between an animation and a slideshow: at the old dwells the
     * envelope was in motion for one and seven tenths of the twenty-eight and a
     * half seconds the reel took — six per cent of it — and the rest was still
     * frames. Shorter dwells and a larger share put the movement back where the
     * eye is already looking.
     */
    const FLIGHT_CAP_MS = 1600;
    const FLIGHT_SHARE = 0.75;
    function flightFor(step: string): number {
      if (!loaded) return 0;
      const dwell = loaded.playback.STEP_DWELL_MS[step] ?? loaded.playback.DEFAULT_DWELL_MS;
      return Math.min(FLIGHT_CAP_MS, dwell * FLIGHT_SHARE);
    }

    /** One step of the story, everywhere it is told. */
    function apply(cue: SceneCue) {
      scene?.show(cue, flightFor(cue.step));
      /* The bubble lands with the step that produced it: sealed at the sender
         when it is encrypted, plain at the receiver when it is opened. The
         receiver's copy arrives rather than appears — it stays invisible until
         the envelope above it has decrypted and folded away, or the chat would
         hold a plaintext the tile still shows sealed. */
      if (cue.sentence) {
        const mine = cue.step === 'encrypted';
        const bubble =
          scene?.say(cue.sentence.side, cue.sentence.text, mine, mine, cue.step === 'opened') ??
          null;
        if (mine) awaitingDelivery = bubble;
      }
      /* The sender's own bubble stops being pending when the far device has it,
         which is the only moment anything on this page knows that it does. */
      if (cue.step === 'delivered' && awaitingDelivery) {
        awaitingDelivery.dataset.pending = 'false';
        awaitingDelivery = null;
      }
    }

    /* One place that turns a thrown error into a sentence, so no path can fail
       silently and leave a reader pressing a button that has stopped working. */
    async function guard(what: string, action: () => Promise<void>) {
      busy = true;
      enable();
      try {
        await action();
      } catch (error) {
        say(`${what} did not finish: ${error instanceof Error ? error.message : String(error)}`);
      } finally {
        busy = false;
        /* If nothing was ever brought up, the demo could not run and the page
           owes the reader the recording again — the status line above says
           why. A failure after a run exists is one action's failure, not the
           demo's, and the reader keeps what they have already watched.
           Asked of `everStarted` rather than of `run`, because Reset drops the
           run on purpose and a reader who has just reset has not lost the
           demo. */
        recorded.hidden = everStarted;
        enable();
      }
    }

    startButton.addEventListener('click', () => {
      void guard('the start', async () => {
        await start();
        say(
          'The relay is up, holding nothing. Register each device with it — ' +
            'the phones carry the buttons.',
        );
      });
    });

    /* Bringing a device up is a press, one per phone, written once against a
       side like the composers below. The scene tells the story — the wire
       connects, the account builds, the keys arrive, the bundle publishes —
       so the status line only has to say what to do next. */
    for (const side of ['a', 'b'] as const) {
      activators[side].addEventListener('click', () => {
        const other = side === 'a' ? 'b' : 'a';
        void guard('the activation', async () => {
          await start();
          await run?.activate(side);
          /* On the resolution, not the press: an activation that threw did
             not bring a device up, and the guard's sentence says why. */
          activated[side] = true;
          say(
            activated[other]
              ? 'Both devices are online, public bundles on the relay and the private halves ' +
                  'still at home. Type a message on either device — the first one agrees the keys.'
              : `${names[side]}'s device is registered and its public keys are on the relay. ` +
                  `Register ${names[other]}'s device to give it someone to write to.`,
          );
        });
      });
    }

    /* Either device may send, so the handler is written once against a side.
       The device that accepted the sentence is the device the SDK is asked to
       send from, which is what makes the reply leg a real reply rather than a
       second outbound message drawn backwards. */
    for (const side of ['a', 'b'] as const) {
      const { input, send } = composers[side];
      send.addEventListener('click', () => {
        const text = input.value.trim();
        if (text === '') {
          say('Type something to send.');
          return;
        }
        void guard('the send', async () => {
          await start();
          await run?.send(side, text);
          /* Cleared after the send resolves rather than on the press: a field
             emptied by a send that threw takes the reader's sentence with it. */
          input.value = '';
          /* After the send resolves, not when it was pressed: the round trip is
             the thing being counted, and a press that threw is not one. */
          reportRun();
        });
      });

      /* The composer answers the return key, because a text field beside a
         button is a form to everyone who has ever used one. */
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          send.click();
        }
      });
    }

    /*
     * The switches.
     *
     * `sealedSender` is a lens and takes effect at once, including on a row the
     * relay is already showing. `braid` is session policy and is locked by
     * `enable()` once a session exists, so its handler only has to record the
     * choice that the next `startDemoRun` will read.
     */
    for (const [key, input] of toggleInputs) {
      input.addEventListener('change', () => {
        toggles = { ...toggles, [key]: input.checked };
        scene?.setToggles(toggles);
      });
    }

    reset.addEventListener('click', () => {
      void guard('the reset', async () => {
        reel?.reset();
        regLanes?.a.reset();
        regLanes?.b.reset();
        scene?.clear();
        (logRoot as HTMLElement & { demoLog?: DemoLogHandle }).demoLog?.clear();
        /*
         * Stopped and dropped rather than reset in place.
         *
         * `run.reset()` keeps the options the run was created with, so a
         * reader who came back here to change the protocol switches would
         * activate their next devices under the old policy and a page that
         * had lied to them about what Reset is for. Dropping the run means
         * the next press builds one from the switches as they now stand. The
         * modules are already fetched, so this costs nothing to download.
         */
        await run?.stop();
        run = null;
        sessionExists = false;
        activated.a = false;
        activated.b = false;
        for (const side of ['a', 'b'] as const) {
          generatedMs[side].keygen = 0;
          generatedMs[side].kyber = 0;
          generatedKeys[side] = 0;
        }
        published.a = 0;
        published.b = 0;
        derived.a = 0;
        derived.b = 0;
        awaitingDelivery = null;
        for (const side of ['a', 'b'] as const) composers[side].input.value = '';
        /* Every reading, from the same map that fills them — a hand-written list
           here would go on clearing whatever it was written for while a reading
           added to the scene kept a stale number through a reset. */
        for (const element of readings.values()) element.textContent = '—';
        say('Reset. A fresh relay, no devices, nothing recorded — braid is open again.');
      });
    });

    /* The settings float over the scene, so a press outside them puts them
       away. On `pointerdown`, before the press lands, so the press still does
       whatever it was for; a press inside the panel — the summary included,
       whose own toggle then runs — leaves it alone. */
    document.addEventListener('pointerdown', (event) => {
      if (settings.open && event.target instanceof Node && !settings.contains(event.target)) {
        settings.open = false;
      }
    });

    /* An insecure origin — plain http anywhere but localhost — has no
       `crypto.subtle`, and no code here can change that. The demo would come
       up anyway: registration runs on pure-JS primitives, and the run only
       reaches for WebCrypto at the first encrypt, three presses in, where the
       failure reads as the message's fault. That is the wrong place to learn
       the page cannot run, so the gate is here: the curtain stays down over
       the recording, exactly as it does for the reader with no scripts, and
       the button — where the reader is looking — carries the answer. */
    if (!window.isSecureContext) {
      startButton.textContent = 'Demo needs HTTPS';
      say(
        'This page is not a secure context, so the browser withholds WebCrypto and nothing ' +
          'here can encrypt. Open the demo over HTTPS or on localhost to run it live.',
      );
      return;
    }

    /* The console is interactive from here, so the recording stops being what
       the reader is looking at. This runs on script execution rather than on
       the first press: a reader who can press the buttons is not the reader
       the recording is for. */
    recorded.hidden = true;
    enable();
  }
</script>
