---
import { STEPS } from '../../lib/demo/trace';

/*
 * The scene: two devices with the relay between them, and a message that
 * travels through it.
 *
 * This is DOM rather than SVG, and the difference is not a preference. A device
 * here holds a real conversation with real reflowing bubbles and a real text
 * input; an envelope is one element that moves between anchors under a
 * transform. Both are things the browser already does well and that SVG makes
 * expensive.
 *
 * ------------------------------------------------------------- one picture ---
 *
 * There is one exhibit and every column of it is a place a thing can be: the
 * conversation is inside the device it belongs to, and the numbers for a device
 * are under that device rather than in a separate band that showed the same
 * event a second time.
 *
 * The order of the three columns is the order the message travels in, and it is
 * markup order rather than a grid trick. A reader following the page in source
 * order, or hearing it read aloud, meets the sender, then the relay, then the
 * receiver.
 *
 * ----------------------------------------------------------- the payload ---
 *
 * `design/DESIGN.md` keeps padlocks off diagrams, and this is the considered
 * exception rather than a lapse. The rule exists to stop a padlock standing in
 * for an explanation. Here the padlock is not the explanation — it is the state
 * of one object the reader watches change, and the same object shows its
 * plaintext at both ends of the journey. Sealed and open are the same envelope,
 * so the reader learns that a message is not replaced at the boundary, it is
 * *wrapped*.
 *
 * The two states are drawn with the diagram tokens rather than with black and
 * white, because `--oe-diagram-ciphertext-fill` inverts between light and dark
 * themes: it is near-black on the light theme and near-white on the dark one.
 * A hard-coded white padlock would vanish on one of the two. So the sealed
 * payload is the ciphertext fill with `--oe-surface` on top of it, and those
 * two invert together.
 *
 * The envelope ends its journey by shrinking into the receiving device's
 * conversation as the plaintext bubble appears there. It used to come to rest
 * beside the phone and stay, which drew a message that had arrived and also
 * still existed in the air.
 */

/* Which column is which, in travel order. Written once so the markup below
   cannot disagree with itself, and so the relay is structurally in the middle
   rather than placed there by a column count. */
const COLUMNS = ['a', 'relay', 'b'] as const;

const LABELS = { a: 'Device A', b: 'Device B' } as const;

/*
 * The readings under each device.
 *
 * Every one is a device-side operation the SDK actually measured, recorded
 * against the device that did the work — `run.ts` puts each measurement on its
 * own actor, and `DemoConsole.astro` routes by that actor rather than by which
 * column it would look tidy under. There is no network in any of them and none
 * is simulated: this relay runs in the reader's tab.
 */
const DEVICE_METRICS = [
  { key: 'publish', label: 'publish' },
  { key: 'establish', label: 'key agreement' },
  { key: 'send', label: 'seal + send' },
  { key: 'trip', label: 'round trip' },
] as const;

/* The relay's slots, in the order a message meets them. The bundle shelf is
   filled once when devices come online; the mailbox holds envelopes until the
   far device collects them, which is the whole of what a relay is for. */
const SLOTS = [
  { slot: 'bundles', label: 'public prekeys', empty: 'nothing published' },
  { slot: 'mailbox', label: 'mailbox', empty: 'nothing waiting' },
] as const;

/*
 * The ratchet wheel, drawn from its own definition rather than from typed
 * coordinates.
 *
 * A sawtooth outline and a pawl above it, because that is what makes the
 * drawing say *one way*. The wheel used to be a strip of four teeth that lit up
 * and then cleared on the fifth message, and a drawing that empties is a
 * drawing that can go back — the one thing a ratchet cannot do. This wheel is
 * turned by `scene-view.ts` through a rotation that only ever increases, so
 * there is no state it can return to.
 */
const TEETH = 4;
const WHEEL = { cx: 12, cy: 12, outer: 9.6, inner: 6.1 };
const at = (radius: number, degrees: number) => {
  const radians = (degrees * Math.PI) / 180;
  return `${(WHEEL.cx + radius * Math.cos(radians)).toFixed(2)},${(
    WHEEL.cy +
    radius * Math.sin(radians)
  ).toFixed(2)}`;
};
/* Out at a tooth tip, in along the tooth's back, then straight out again: the
   radial edge is the face the pawl catches. */
const WHEEL_PATH = `M${at(WHEEL.outer, 0)} ${Array.from({ length: TEETH }, (_, index) => {
  const angle = ((index + 1) * 360) / TEETH;
  return `L${at(WHEEL.inner, angle)} L${at(WHEEL.outer, angle)}`;
}).join(' ')} Z`;

/* The protocol steps, handed to the script so it never types a step name that
   `trace.ts` does not define. */
const STEP_LIST = STEPS.join(' ');
---

<div class="demo-scene" data-demo-scene data-scene-state="idle" data-scene-steps={STEP_LIST}>
  {/*
    The key, drawn once. `scene-view.ts` stamps this wherever a key belongs:
    filled in a device's key row, outlined on the relay's shelf. One drawing and
    not two, because the shape rhyme is the entire argument — the private key and
    its published half are the same key, and the fill is the only thing that
    changes between "only this device has it" and "this is meant to be handed
    out". Two paths would let that difference become a second difference.

    A round bow, a straight shaft and two square teeth, in the grammar's own
    language: flat, orthogonal, no gradient and no opacity. The scene is CSS at
    1:1, so a unit of this viewBox is a rendered pixel and the 2px the outlined
    form is stroked at is the same 2px the rack and the phones are drawn at.
  */}
  <template data-scene-key-glyph>
    <svg class="demo-key-glyph" viewBox="0 0 26 15" aria-hidden="true">
      <path d="M10.58 5 H25 V13 H21 V9 H17 V13 H13 V9 H10.58 A5 5 0 1 1 10.58 5 Z" />
    </svg>
  </template>

  {
    COLUMNS.map((column) =>
      column === 'relay' ? (
        <section class="demo-scene-column demo-scene-relay" aria-label="Relay">
          <div class="demo-relay-rack">
            <header class="demo-relay-header">
              <span class="demo-relay-title">relay</span>
              <span class="demo-relay-sub">never needs plaintext</span>
            </header>

            {SLOTS.map(({ slot, label, empty }) => (
              <div class="demo-relay-slot" data-scene-slot={slot}>
                <span class="demo-relay-slot-label">{label}</span>
                <div class="demo-relay-slot-body" data-scene-slot-body={slot}>
                  <span class="demo-relay-slot-empty">{empty}</span>
                </div>
              </div>
            ))}
          </div>

          {/*
            "Stored", not "holding", because the mailbox above it is drawn empty
            the moment the far device collects — and the relay still has the row,
            which is the point the whole column is making. One word per fact: the
            mailbox says what is waiting, this says what the relay has kept.
          */}
          <dl class="demo-readings" aria-label="Relay readings">
            <div class="demo-reading">
              <dt class="demo-reading-label">stored</dt>
              <dd class="demo-reading-value" data-console-metric="relay-holding">
                —
              </dd>
            </div>
          </dl>

          {/*
            The stored row, under the relay that stored it. The row is a fact
            about this column, so it belongs in this column. The log is the only
            thing left under the scene.

            The console's script fills these elements, so they carry the
            console's classes and `data-console-` names. It fills them from
            `Object.entries` of the envelope the relay stored, never from a
            list. `demo-panel.test.mjs` guards that.
          */}
          <div class="demo-relay-row">
            <p class="demo-console-empty" data-console-relay-empty>nothing stored yet</p>

            {/*
              How big the row is, drawn and named.

              Size is the thing about a stored envelope that a figure states and
              a reader still has to do arithmetic on, and it is also what the
              protocol switches move most: the same sentence measures around
              nine times larger on the wire with the braid switch off than with
              it on. A bar is what makes that difference something the column
              shows rather than something it reports.

              `scene-view.ts` fills it, from the byte count on the cue, which
              comes off the trace's own measure of the stored ciphertext. The
              elements carry the scene's `data-scene-` names for that reason,
              beside the console's row, which the console fills.
            */}
            <div class="demo-relay-size" data-scene-size hidden>
              <span class="demo-relay-size-label">size</span>
              <span class="demo-relay-size-track">
                <span class="demo-relay-size-bar" data-scene-size-bar data-over="false" />
              </span>
              <span class="demo-relay-size-figure" data-scene-size-figure />
            </div>

            {/*
              How much of the post-quantum key has travelled, and who has it.

              The braid spreads one ML-KEM key agreement across many messages, a
              chunk to a message, so the key is a thing under way for most of a
              conversation rather than a thing that happens in one. This is where
              that becomes visible: a fill that grows message by message, and a
              mark at the point a device reports it produced the epoch secret.

              Every number here is the braid's own, from `onBraidProgress` by way
              of the recording. Nothing on this page counts chunks — the braid's
              state machine is the only thing that can see one travel.

              The row is absent under the direct setting rather than empty. That
              mode sends the key whole in one message and raises no report, so
              there is nothing to draw and no epoch under way to draw it for.
            */}
            <div class="demo-relay-braid" data-scene-braid hidden>
              <span class="demo-relay-braid-label">key</span>
              <span class="demo-relay-braid-track">
                <span class="demo-relay-braid-bar" data-scene-braid-bar data-over="false" />
              </span>
              <span class="demo-relay-braid-figure" data-scene-braid-figure />
              <span class="demo-relay-braid-mark" data-scene-braid-mark hidden />
            </div>

            <pre class="demo-console-hex" data-console-hex hidden></pre>
            <dl class="demo-console-row" data-console-row hidden></dl>
            <p class="demo-console-row-note" data-console-row-note hidden></p>
          </div>
        </section>
      ) : (
        <section
          class="demo-scene-column"
          data-scene-device={column}
          aria-label={LABELS[column]}
        >
          <div class="demo-phone">
            <div class="demo-phone-notch" aria-hidden="true" />
            <div class="demo-phone-screen">
              <header class="demo-phone-header">
                <span class="demo-phone-who" data-scene-name={column}>
                  {LABELS[column]}
                </span>
                <span class="demo-phone-state" data-scene-device-state={column}>
                  offline
                </span>
              </header>

              <ol class="demo-phone-chat" data-scene-chat={column} aria-live="polite" />

              <div class="demo-phone-compose">
                <label class="oe-visually-hidden" for={`demo-scene-compose-${column}`}>
                  Message from {LABELS[column]}
                </label>
                <input
                  class="demo-phone-input"
                  id={`demo-scene-compose-${column}`}
                  type="text"
                  autocomplete="off"
                  placeholder="Type a message"
                  data-scene-input={column}
                  disabled
                />
                <button
                  type="button"
                  class="demo-phone-send"
                  data-scene-send={column}
                  disabled
                  aria-label={`Send from ${LABELS[column]}`}
                >
                  Send
                </button>
              </div>
            </div>
          </div>

          {/* The device's own key material. Filled forms are private and never
              leave; the outlined ones on the relay's shelf are the public halves
              of these. Keeping both on screen is what makes that difference
              visible rather than asserted.

              The shapes are a motif and the number is the fact — a device holds
              two hundred and four of these, and drawing one shape each would be
              a wall rather than a diagram. See `KEY_MOTIF` in `scene-view.ts`. */}
          <div class="demo-device-keys" data-scene-keys={column}>
            <span class="demo-device-keys-label">private keys</span>
            <ul class="demo-device-keys-list" data-scene-keys-list={column} />
            <span class="demo-device-keys-count" data-scene-keys-count={column}>
              0
            </span>
          </div>

          {/* The ratchet, and it turns one way.

              The wheel is rotated by a quarter turn per message key derived and
              the rotation is never reduced, so there is no frame in which it
              goes back and none in which it stops. The pawl above it is why:
              a reader who has seen one knows immediately which direction this
              can move in.

              `data-turns` is written by `scene-view.ts` and is deliberately
              absent from the shipped markup. The wheel itself ships in the HTML,
              so a scene whose script never mounted looks exactly like one that
              mounted and had nothing to report — the attribute is what tells
              them apart, and `demo-smoke.mjs` reads it for that reason.

              `scene-view.ts` writes the caption once a session exists, from the
              selection event the SDK raises at key agreement. It reads "triple
              ratchet" when the session runs the post-quantum ratchet. Before
              that event the page knows of no ratchet, so the shipped caption
              says so rather than name one. */}
          <div class="demo-ratchet" data-scene-ratchet={column}>
            <svg
              class="demo-ratchet-wheel"
              viewBox="0 0 24 24"
              aria-hidden="true"
              data-scene-ratchet-wheel={column}
            >
              <g class="demo-ratchet-turn" data-scene-ratchet-turn={column}>
                <path d={WHEEL_PATH} />
              </g>
              <path class="demo-ratchet-pawl" d="M12 2.4 L14.2 0 L9.8 0 Z" />
            </svg>
            <span class="demo-ratchet-label" data-scene-ratchet-label={column}>
              not yet agreed
            </span>
            <span class="demo-ratchet-count" data-scene-ratchet-count={column}>
              0 keys
            </span>
          </div>

          <dl class="demo-readings" aria-label={`${LABELS[column]} readings`}>
            {DEVICE_METRICS.map(({ key, label }) => (
              <div class="demo-reading">
                <dt class="demo-reading-label">{label}</dt>
                <dd class="demo-reading-value" data-console-metric={`${column}-${key}`}>
                  —
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ),
    )
  }

  {/*
    The envelope. One element for the whole journey — sealed at the sending
    device, carried to the relay, collected by the far one, opened there, and
    then folded into that device's conversation as the plaintext bubble appears.
    Reusing a single node is the point: a reader who sees the same object arrive
    and open learns that the message was wrapped rather than swapped.
  */}
  <div class="demo-envelope" data-scene-envelope hidden>
    <div class="demo-envelope-meta" data-scene-envelope-meta>
      <span class="demo-envelope-meta-row">
        <span class="demo-envelope-meta-key">to</span>
        <span class="demo-envelope-meta-value" data-scene-envelope-to>—</span>
      </span>
      <span class="demo-envelope-meta-row">
        <span class="demo-envelope-meta-key">from</span>
        <span class="demo-envelope-meta-value" data-scene-envelope-from>—</span>
        {/*
          The sealed sender's redaction. A separate element rather than a
          pseudo-element on the value, because the value is emptied when sealed
          and an empty inline box has no area to draw a lock in — the field read
          as merely blank, which says "we forgot to fill this in" rather than
          "the relay is not allowed to know". Shown and hidden by the same
          `data-sealed` switch the value uses, so there is one source of truth.
        */}
        <span class="demo-envelope-meta-redacted" aria-label="sender withheld">
          <svg class="demo-envelope-meta-lock" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M7 10V7a5 5 0 0 1 10 0v3"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"></path>
            <rect x="4.5" y="10" width="15" height="10.5" rx="2" fill="currentColor"></rect>
          </svg>
        </span>
      </span>
    </div>
    <div class="demo-envelope-payload" data-scene-envelope-payload>
      {/*
        The flap. It is what makes the shape read as an envelope rather than as
        a labelled box, and it is drawn over the payload in `currentColor` so it
        is legible against both payload states — the sealed fill and the open
        one invert together with the theme, and the flap goes with them.
      */}
      <svg
        class="demo-envelope-flap"
        viewBox="0 0 100 26"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M0 0 L50 24 L100 0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          vector-effect="non-scaling-stroke"></path>
      </svg>
      <svg
        class="demo-envelope-lock"
        viewBox="0 0 24 24"
        aria-hidden="true"
        data-scene-envelope-lock
      >
        <path
          d="M7 10V7a5 5 0 0 1 10 0v3"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"></path>
        <rect x="4.5" y="10" width="15" height="10.5" rx="2" fill="currentColor"></rect>
      </svg>
      <span class="demo-envelope-text" data-scene-envelope-text></span>
    </div>
  </div>
</div>

<style>
  .demo-scene {
    position: relative;
    display: grid;
    /* The relay is the middle column because the markup writes it between the
       two devices, not because a third column landed there. All three get the
       same `1fr`. The phones must match each other, and the relay holds the
       stored row, which is the widest content in the scene. */
    grid-template-columns: 1fr minmax(0, 1fr) 1fr;
    gap: var(--oe-space-6);
    align-items: start;
  }

  .demo-scene-column {
    display: flex;
    flex-direction: column;
    gap: var(--oe-space-3);
    min-width: 0;
  }

  /* --------------------------------------------------------------- device --- */

  .demo-phone {
    background: var(--oe-device-surface);
    border: 2px solid var(--oe-border);
    border-radius: 26px;
    padding: var(--oe-space-2);
    padding-top: var(--oe-space-3);
    position: relative;
  }

  .demo-phone-notch {
    width: 34%;
    height: 5px;
    margin: 0 auto var(--oe-space-2);
    border-radius: 999px;
    background: var(--oe-border);
  }

  .demo-phone-screen {
    background: var(--oe-surface);
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    min-height: 17rem;
    overflow: hidden;
  }

  .demo-phone-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--oe-space-2);
    padding: var(--oe-space-2) var(--oe-space-3);
    border-bottom: 1px solid var(--oe-border);
  }

  .demo-phone-who {
    font-weight: 600;
  }

  .demo-phone-state {
    font-family: var(--oe-font-mono);
    font-size: 0.75rem;
    color: var(--oe-text-muted, inherit);
    opacity: 0.7;
  }

  .demo-phone-chat {
    list-style: none;
    margin: 0;
    padding: var(--oe-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--oe-space-2);
    flex: 1;
    overflow-y: auto;
    max-height: 12rem;
  }

  /* Created by `scene-view.ts`, so scoped selectors never reach them — see the
     note further down beside the key and wheel shapes. */
  .demo-phone-chat :global(.demo-phone-bubble) {
    max-width: 82%;
    padding: var(--oe-space-2) var(--oe-space-3);
    border-radius: 14px;
    line-height: 1.35;
    overflow-wrap: anywhere;
    font-size: 0.85rem;
  }

  .demo-phone-chat :global(.demo-phone-bubble[data-mine='true']) {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: var(--oe-accent);
    color: var(--oe-accent-foreground);
  }

  .demo-phone-chat :global(.demo-phone-bubble[data-mine='false']) {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    background: var(--oe-surface-sunken);
    border: 1px solid var(--oe-border);
  }

  /* A bubble that is still sealed at this end: the far device has not opened it
     yet, so showing its text here would be the demo lying about what is known
     where. */
  .demo-phone-chat :global(.demo-phone-bubble[data-pending='true']) {
    opacity: 0.55;
  }

  .demo-phone-compose {
    display: flex;
    gap: var(--oe-space-2);
    padding: var(--oe-space-2);
    border-top: 1px solid var(--oe-border);
  }

  .demo-phone-input {
    flex: 1;
    min-width: 0;
    padding: var(--oe-space-2);
    border: 1px solid var(--oe-border-control);
    border-radius: var(--oe-radius-sm);
    background: var(--oe-surface-raised);
    font: inherit;
    color: inherit;
  }

  .demo-phone-send {
    padding: var(--oe-space-2) var(--oe-space-3);
    border: 0;
    border-radius: var(--oe-radius-sm);
    background: var(--oe-accent);
    color: var(--oe-accent-foreground);
    font: inherit;
    cursor: pointer;
  }

  .demo-phone-input:disabled,
  .demo-phone-send:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* ----------------------------------------------------------- key store --- */

  .demo-device-keys,
  .demo-ratchet {
    display: flex;
    align-items: center;
    gap: var(--oe-space-2);
    font-family: var(--oe-font-mono);
    font-size: 0.75rem;
  }

  .demo-device-keys-label,
  .demo-ratchet-label {
    opacity: 0.7;
  }

  /* The counts carry the real magnitude, so they are the emphatic part of the
     row and the shapes beside them are not. */
  .demo-device-keys-count,
  .demo-ratchet-count {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    margin-left: auto;
  }

  .demo-device-keys-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--oe-space-1);
  }

  /* ------------------------------------------------------------- ratchet --- */

  .demo-ratchet-wheel {
    width: 26px;
    height: 26px;
    flex: none;
    overflow: visible;
    color: var(--oe-diagram-ratchet-2);
  }

  .demo-ratchet-turn path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* Turned by `scene-view.ts` through a rotation that only ever grows, so the
     transition is always in one direction. `view-box` puts the origin in the
     SVG's own units, which is where the wheel's centre is written. */
  .demo-ratchet-turn {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition: transform var(--oe-duration-slow) cubic-bezier(0.22, 0.8, 0.24, 1);
  }

  /* Reset is the one moment the angle may decrease, and it must not be animated
     — see `rewindRatchet` in `scene-view.ts`. */
  .demo-ratchet-turn[data-rewind='true'] {
    transition: none;
  }

  .demo-ratchet-pawl {
    fill: currentColor;
  }

  /* --------------------------------------------------------- the readings --- */

  /*
   * The numbers for a column, under that column.
   *
   * They used to be a separate band below the whole scene, on a grid that
   * repeated the scene's own — one exhibit drawn twice, and the eye never fused
   * them. A reading is a fact about the thing above it, so it lives there.
   */
  .demo-readings {
    margin: 0;
    display: grid;
    gap: 2px;
    font-family: var(--oe-font-mono);
    font-size: 0.72rem;
  }

  .demo-reading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--oe-space-2);
  }

  .demo-reading-label {
    opacity: 0.7;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .demo-reading-value {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }

  /*
   * Everything below here dresses an element `scene-view.ts` creates rather
   * than one this file writes, so Astro's scoping attribute is never on it and
   * a plain selector matches nothing. This is not cosmetic drift that shows up
   * as slightly-wrong spacing: an unscoped run of these rules draws no keys and
   * no chat bubbles at all — the conversation rendered as five unstyled lines of
   * text and the key shelves rendered as bare numbers.
   *
   * `:global()` is confined to the child. The parent stays scoped, so these
   * cannot match a `.demo-key` anywhere but inside this component's markup.
   */

  /* A key is a box holding the one silhouette from the template above. The box
     carries the class the script counts and the `data-public` flag; the shape
     inside it is the same node in both places. `flex: none` because five of them
     sit in a row that also holds a label and a count, and a key that shrank to
     fit would be a different drawing at a different width. */
  .demo-device-keys-list :global(.demo-key),
  .demo-relay-slot-body :global(.demo-key) {
    display: flex;
    flex: none;
  }

  /* Neither fill nor stroke here: the two rules below are the only things that
     ink this shape, and which of them applies is the claim the drawing makes.
     The default being overridden is SVG's own, which is a solid black fill —
     and a filled key on the relay is the one thing this scene must never draw.
     A key that matched neither rule draws nothing instead, which is a hole in a
     row that still states its count.

     `overflow: visible` because the stroked form's outer edge lands exactly on
     the viewBox, and an svg clips to its box by default. */
  .demo-device-keys-list :global(.demo-key-glyph),
  .demo-relay-slot-body :global(.demo-key-glyph) {
    width: 26px;
    height: 15px;
    overflow: visible;
    fill: none;
    stroke: none;
  }

  /* Filled is private, and this selector is why it stays that way: the rule that
     fills a key is reachable only from inside a device's key row. */
  .demo-device-keys-list :global(.demo-key-glyph) {
    fill: var(--oe-diagram-ciphertext-fill);
  }

  /* Outlined is public: the same silhouette, open, because it travels and it is
     readable. */
  .demo-relay-slot-body :global(.demo-key[data-public='true'] .demo-key-glyph) {
    stroke: var(--oe-diagram-carrier-stroke);
    stroke-width: 2;
  }

  .demo-relay-slot-body :global(.demo-relay-slot-count) {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  /* ------------------------------------------------------------- the relay --- */

  .demo-relay-rack {
    border: 2px solid var(--oe-diagram-carrier-stroke);
    border-radius: var(--oe-radius-sm);
    padding: var(--oe-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--oe-space-3);
    background: var(--oe-surface);
  }

  .demo-relay-header {
    display: flex;
    flex-direction: column;
  }

  .demo-relay-title {
    font-family: var(--oe-font-mono);
    font-weight: 600;
  }

  .demo-relay-sub {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  /* A slot is a shelf, and an empty shelf is drawn lighter than the rack that
     holds it. Drawn at the rack's weight it reads as a stored row, which had a
     first-time reader seeing three held messages under a caption saying the
     relay held nothing. */
  .demo-relay-slot {
    border: 1px dashed var(--oe-border);
    border-radius: var(--oe-radius-sm);
    padding: var(--oe-space-2);
    min-height: 3.4rem;
    display: flex;
    flex-direction: column;
    gap: var(--oe-space-1);
  }

  .demo-relay-slot[data-holding='true'] {
    border-style: solid;
    border-color: var(--oe-diagram-carrier-stroke);
  }

  /* The mailbox is where the envelope comes to rest, and the envelope is drawn
     over the rack rather than inside it, centred on this shelf. Cut to the
     default shelf height it landed across the shelf above and the rack's own
     edge, which reads as a message sitting on top of the relay rather than in
     it. Tall enough here to hold the whole envelope with its label clear. */
  .demo-relay-slot[data-scene-slot='mailbox'] {
    min-height: 7rem;
  }

  .demo-relay-slot-label {
    font-family: var(--oe-font-mono);
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .demo-relay-slot-body {
    display: flex;
    align-items: center;
    gap: var(--oe-space-2);
    flex-wrap: wrap;
    min-height: 1.4rem;
  }

  .demo-relay-slot-empty {
    font-family: var(--oe-font-mono);
    font-size: 0.7rem;
    opacity: 0.45;
  }

  .demo-relay-slot[data-holding='true'] .demo-relay-slot-empty {
    display: none;
  }

  /* The stored row's own stack. `global.css` styles the parts inside it,
     because the console's script creates the `dt` and `dd` pairs. A scoped rule
     here would never reach them. */
  .demo-relay-row {
    display: flex;
    flex-direction: column;
    gap: var(--oe-space-2);
    min-width: 0;
  }

  /* ---------------------------------------------------------- the envelope --- */

  .demo-envelope {
    position: absolute;
    top: 0;
    left: 0;
    width: 8.5rem;
    z-index: 2;
    pointer-events: none;
    border-radius: var(--oe-radius-sm);
    overflow: hidden;
    border: 2px solid var(--oe-diagram-carrier-stroke);
    background: var(--oe-surface-raised);
    /* Position is set as a transform by the script from measured anchors, and
       the scale is a variable the CSS below owns, so the two can be animated
       together without either one having to know the other's value. */
    transform: translate(0, 0) scale(var(--demo-envelope-scale, 1));
    transition:
      transform var(--oe-duration-normal) ease-in-out,
      opacity var(--oe-duration-normal) ease-in-out;
    will-change: transform;
  }

  .demo-envelope[data-flying='true'] {
    /* Flight is paced by the reading clock, not by a duration token: the script
       sets this per journey. */
    transition-duration: var(--demo-flight-ms, 700ms);
  }

  /*
   * Arrival. The envelope shrinks into the receiving device's conversation as
   * the plaintext bubble appears there, so the message becomes the message
   * rather than a second copy of it parked beside the phone.
   *
   * The delay is the beat the reader gets to read the decrypted sentence before
   * it folds away, and it lives here rather than in a timer for a reason
   * `scene-view.ts` sets out: the scene owns no clock. It is a literal and not a
   * duration token, which is what keeps it from collapsing under
   * `prefers-reduced-motion` — a reader who asked for less motion did not ask to
   * be shown the plaintext for no frames at all. The fold itself is a token and
   * does collapse, which is the correct half to lose.
   */
  .demo-envelope[data-landing='true'] {
    --demo-envelope-scale: 0.35;
    opacity: 0;
    transition-delay: 520ms;
  }

  /* The metadata band. Present in both states, because what the relay can read
     is exactly the point — the payload closes, the addressing does not. */
  .demo-envelope-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 4px 6px;
    background: var(--oe-surface);
    border-bottom: 2px solid var(--oe-diagram-carrier-stroke);
    font-family: var(--oe-font-mono);
    font-size: 0.62rem;
  }

  .demo-envelope-meta-row {
    display: flex;
    justify-content: space-between;
    gap: var(--oe-space-2);
  }

  .demo-envelope-meta-key {
    opacity: 0.55;
  }

  .demo-envelope-meta-value {
    font-weight: 600;
  }

  /* Sealed sender: the addressing the relay may read loses the sender. The
     value gives way to the same lock the payload wears, so the reader sees one
     idea applied in two places rather than two unrelated treatments. */
  .demo-envelope-meta-value[data-sealed='true'] {
    display: none;
  }

  .demo-envelope-meta-redacted {
    display: none;
    align-items: center;
    padding: 0 5px;
    border-radius: 2px;
    background: var(--oe-diagram-ciphertext-fill);
    color: var(--oe-surface);
  }

  .demo-envelope-meta-value[data-sealed='true'] + .demo-envelope-meta-redacted {
    display: inline-flex;
  }

  .demo-envelope-meta-lock {
    width: 9px;
    height: 9px;
  }

  .demo-envelope-payload {
    position: relative;
    min-height: 3.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--oe-space-2);
    padding-top: calc(var(--oe-space-2) + 0.4rem);
    text-align: center;
    font-size: 0.78rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition:
      background-color var(--oe-duration-normal) ease,
      color var(--oe-duration-normal) ease;
  }

  .demo-envelope-flap {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 1.15rem;
    opacity: 0.85;
  }

  /* Sealed: the payload is the ciphertext fill with the surface colour on top.
     Both tokens invert with the theme, so the lock and the flap stay legible on
     either. */
  .demo-envelope[data-sealed='true'] .demo-envelope-payload {
    background: var(--oe-diagram-ciphertext-fill);
    color: var(--oe-surface);
  }

  .demo-envelope[data-sealed='false'] .demo-envelope-payload {
    background: var(--oe-surface-raised);
    color: inherit;
  }

  .demo-envelope-lock {
    width: 26px;
    height: 26px;
    display: none;
  }

  .demo-envelope[data-sealed='true'] .demo-envelope-lock {
    display: block;
  }

  .demo-envelope[data-sealed='true'] .demo-envelope-text {
    display: none;
  }

  /* ------------------------------------------------------------ narrow ------ */

  @media (max-width: 60rem) {
    .demo-scene {
      grid-template-columns: 1fr;
    }

    /* The flying envelope is a three-column idea. Stacked, it would cross
       unrelated boxes, so the journey is told by the relay's slots filling and
       emptying instead. */
    .demo-envelope {
      display: none;
    }
  }

  /* ---------------------------------------------------- reduced motion ------
   *
   * There is no reduced-motion rule in this file, and its absence is the whole
   * of the behaviour: `global.css` zeroes every transition duration on the page
   * with `!important`, so under `prefers-reduced-motion` the envelope is placed
   * at each anchor rather than gliding to it, the wheel jumps to its new angle,
   * and the two bars jump to their new widths. Nothing here can opt out of that
   * and nothing here tries to.
   *
   * What survives is the reel. Every step is still shown and still held for its
   * own dwell — `playback.ts` has no reduced-motion branch and says why — so
   * the journey is told in the same frames, without the movement between them.
   * The landing's `transition-delay` above survives too, which is why it is
   * written as a literal: a delay is not a duration, the blanket rule does not
   * reach it, and the beat the reader gets to read the decrypted sentence is
   * information rather than motion.
   */
</style>
