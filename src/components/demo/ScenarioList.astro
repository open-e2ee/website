---
import { Code } from 'astro:components';
import { codeThemes } from '../../lib/code-theme.mjs';
import { SCENARIOS } from '../../lib/demo/scenarios/catalog.ts';
import { scenarioCode } from '../../lib/demo/scenarios/source.ts';

/*
 * Where the SDK is asked to fail.
 *
 * This was `/demo`, a page of its own. The homepage panel above shows the
 * protocol working, which is the easy half: a reader who has already decided to
 * trust it learns nothing from watching a sentence come back. What decides an
 * adoption is the other half — what the thing does when something goes wrong —
 * and every project on the internet answers that in prose. So this answers it by
 * running it, in the reader's tab, against the installed package, and printing
 * the receiving device's own log rather than a description of what the log would
 * say.
 *
 * A component rather than markup pasted into `index.astro`, for two reasons that
 * are not line count. It keeps the scenarios owned by the demo concept alongside
 * `LiveCarrierPanel`, which is the panel this section is the second half of; and
 * `tests/site-content.test.mjs` scans `src/components/demo/` wholesale for the
 * relay-vocabulary rule, so the scenarios stay covered by a guard that would have
 * had to name `index.astro` — and then would have applied the demo's rule to the
 * whole marketing page.
 *
 * Each scenario is a closed `<details>`, and that is what "opened" means in the
 * one event this measures. It is also the shape this needs as more scenarios
 * land: a list a reader can read the titles of, and open the one they came for.
 * The `id` is on the `<details>`, so `/#flip-a-byte` both scrolls to the
 * scenario and opens it.
 *
 * `/demo#flip-a-byte` does not survive the fold, and that is a decision rather
 * than an oversight: `public/_redirects` sends `/demo` to this section's own
 * fragment, and a destination fragment replaces the one the reader arrived
 * with. The reasoning is in `_redirects` beside the rule.
 *
 * Nothing SDK-shaped is on the initial payload. The frontmatter's imports reach
 * the scenario catalogue, which holds words and a filename; the module that boots
 * two clients is fetched by a dynamic `import()` in the run handler, the same
 * discipline as the homepage panel (invariant 7).
 */

const scenarios = SCENARIOS.map((scenario) => ({
  ...scenario,
  code: scenarioCode(scenario),
  filename: scenario.source.replace(/^\.\//, ''),
}));
---

<div class="scenario-list">
  {
    scenarios.map((scenario) => (
      <details class="scenario" id={scenario.slug} data-scenario={scenario.slug}>
        <summary class="scenario-summary">
          <span class="scenario-title">{scenario.title}</span>
          <span class="scenario-expectation">{scenario.expectation}</span>
          {/*
            The marker, on the right rather than left of the title. It was
            removed on the reasoning that a triangle beside the first line of a
            two-line summary reads as a bullet, which is true and was the wrong
            conclusion: nothing replaced it, so four bordered cards sat on the
            page with no sign that any of them did anything. A reader who does
            not click one never reaches the thing this section exists to show
            them.

            On the trailing edge, aligned to the title's own line, it is a
            disclosure control and cannot be read as list furniture.
          */}
          <span class="scenario-marker" aria-hidden="true"></span>
        </summary>

        <div class="scenario-body">
          {/*
            The run, first.

            The code block used to open this body, and it is long — the
            scenarios run real programs and print all of them — so opening a
            scenario put about fifteen hundred pixels of TypeScript between the
            reader and the button. The promise is that it breaks something and
            shows you what the SDK said; the reader had to scroll past the setup
            to get to either.

            The listing has not moved out of the scenario, only below the result
            it produces, where it answers the question a reader has after the
            verdict rather than before it.
          */}
          <div class="scenario-controls">
            <button class="oe-button" type="button" data-scenario-run>
              {scenario.action}
            </button>
            <p class="scenario-status" data-scenario-status role="status">
              Nothing has run yet.
            </p>
          </div>

          <div class="scenario-output" data-scenario-output hidden />

          {/*
            Sliced out of the module the button imports, at build time. This is
            not an excerpt written to look like the code — it is the code, and
            `scenarioCode` throws rather than print an empty block if the markers
            ever go missing.

            Closed, and in its own disclosure. The claim that matters is that the
            program is here and is the one that ran, and a reader gets that from
            the line naming the file; unrolling seventy lines of it is a second,
            rarer question. This nests inside the scenario's own `<details>` and
            toggles independently of it — the outer one is what is measured.
          */}
          <details class="scenario-source">
            <summary class="scenario-source-summary">
              {/* Not `.code-filename`: that class is a code block's ruled header
                  — padding and a bottom border — and this is a line in a
                  disclosure. Only the type is shared. */}
              <span class="scenario-source-name">{scenario.filename}</span>
              <span class="scenario-source-hint">the program this ran</span>
              <span class="scenario-marker" aria-hidden="true"></span>
            </summary>
            <div class="code-block">
              <Code
                code={scenario.code}
                lang="ts"
                themes={codeThemes}
                defaultColor={false}
                role="group"
                aria-label={`The program this scenario runs: ${scenario.title}`}
              />
            </div>
          </details>

          <p class="scenario-link">
            <a href={scenario.link.href} target="_blank" rel="noopener">
              {scenario.link.label}
            </a>
          </p>
        </div>
      </details>
    ))
  }
</div>

<script>
  /*
   * What each scenario's button runs, keyed by the slug in the catalogue.
   *
   * The wiring below is generic — every `[data-scenario]` gets the same handler
   * — but the program behind a button is not: each scenario has its own runner
   * and its own result to print. This is the one place that knows which is
   * which, and a slug the catalogue ships without an entry here says so on the
   * page rather than doing nothing.
   *
   * Each `import()` stays inside its own function so that pressing one button
   * fetches one scenario. The 713 KB of SDK behind them is shared, and Vite
   * hands the second scenario the chunks the first already pulled.
   *
   * The renderers come the same way, in parallel, for the same reason: nothing a
   * reader has not asked for belongs on the initial path, and what the page says
   * about a result is only needed once there is a result. All four buttons pull
   * the one render chunk, so the second press fetches nothing new. That leaves
   * this script holding the wiring alone — which is all of it that runs before a
   * press.
   */
  const PROGRAMS: Record<
    string,
    (output: HTMLElement, status: HTMLElement) => Promise<void>
  > = {
    'flip-a-byte': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../../lib/demo/scenarios/flip-a-byte.ts'),
        import('../../lib/demo/render.ts'),
      ]);
      status.textContent = 'Booting two devices, then corrupting a message…';
      render.renderFlipAByte(output, await scenario.runFlipAByte(), scenario.describePayload);
    },
    'add-a-second-device': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../../lib/demo/scenarios/add-a-second-device.ts'),
        import('../../lib/demo/render.ts'),
      ]);
      status.textContent = 'Booting two accounts, then linking a device onto one of them…';
      render.renderSecondDevice(
        output,
        await scenario.runAddASecondDevice(),
        scenario.describePayload,
      );
    },
    'run-out-of-prekeys': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../../lib/demo/scenarios/run-out-of-prekeys.ts'),
        import('../../lib/demo/render.ts'),
      ]);
      status.textContent = 'Spending the prekey stash, then opening a new conversation…';
      render.renderRunOutOfPreKeys(output, await scenario.runOutOfPreKeys(), scenario.describePayload);
    },
    'reinstall-a-device': async (output, status) => {
      const [scenario, render] = await Promise.all([
        import('../../lib/demo/scenarios/reinstall-a-device.ts'),
        import('../../lib/demo/render.ts'),
      ]);
      status.textContent = 'Destroying the receiving device, then writing to it anyway…';
      render.renderReinstallADevice(
        output,
        await scenario.reinstallADevice(),
        scenario.describePayload,
      );
    },
  };

  /*
   * One handler for every scenario, wired from the `<details>` elements rather
   * than from a list this file keeps. A scenario added to the catalogue is a
   * scenario this runs, with no second place to edit.
   */
  for (const element of document.querySelectorAll<HTMLDetailsElement>('[data-scenario]')) {
    wire(element);
  }

  function wire(scenario: HTMLDetailsElement) {
    const slug = scenario.dataset.scenario ?? '';
    const run = scenario.querySelector<HTMLButtonElement>('[data-scenario-run]');
    const status = scenario.querySelector<HTMLElement>('[data-scenario-status]');
    const output = scenario.querySelector<HTMLElement>('[data-scenario-output]');
    if (!run || !status || !output) return;

    /*
     * One beacon the first time this scenario is opened, carrying the slug and
     * nothing else. Once per scenario per page: a reader who closes a scenario
     * and opens it again has not looked at a second scenario, and counting the
     * toggle would measure fidgeting.
     */
    let measured = false;
    scenario.addEventListener('toggle', () => {
      if (!scenario.open || measured) return;
      measured = true;
      window.oeMeasure?.('scenario_opened', slug);
    });

    /* Arriving at `/#flip-a-byte` is asking for this scenario, so open it. The
       `toggle` above then measures it, which is correct: the reader asked for
       this one by name. */
    if (location.hash === `#${slug}`) scenario.open = true;

    const program = PROGRAMS[slug];
    if (!program) {
      /* Said out loud, on the scenario, rather than left as a button that does
         nothing: the catalogue ships this scenario, so the missing half is
         this component's. */
      status.textContent = 'No program is wired to this scenario, so there is nothing to run.';
      run.disabled = true;
      return;
    }

    let running = false;
    run.addEventListener('click', async () => {
      if (running) return;
      running = true;
      run.disabled = true;
      output.hidden = true;
      status.textContent = 'Loading the SDK…';

      try {
        /* The 713 KB the page has kept off its own payload, fetched now that
           the reader has asked for it. */
        await program(output, status);
        output.hidden = false;
        /* Every scenario boots its own devices and puts them away again, so
           this is true of all of them: nothing is reused between presses. */
        status.textContent = 'Done. Press it again and it runs again on new devices.';
      } catch (cause) {
        /* A scenario that cannot run says so in its own status line. There is
           no recorded fallback here as there is for the panel above: this
           section promises a live failure, and a recording of one would be
           worth nothing. */
        status.textContent =
          `This scenario could not run: ${cause instanceof Error ? cause.message : String(cause)}`;
        output.hidden = true;
      } finally {
        running = false;
        run.disabled = false;
      }
    });
  }
</script>
