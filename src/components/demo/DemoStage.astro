---
import {
  CIPHERTEXT_FILL,
  PLAINTEXT_STROKE,
  RATCHET_FILLS,
  STROKE_WIDTH,
  boundaryLine,
  deviceOutline,
  metadataTicks,
  notchedSlabPath,
  ratchetRects,
  slabPath,
} from '@open-e2ee/design/diagram';
import {
  COMPOSITIONS,
  BUNDLE_SIZE,
  PRIVATE_KEY_SIZE,
  RATCHET_SIZE,
  type BoundaryPlace,
  type DevicePlace,
  type DeviceSide,
  type StageComposition,
} from '../../lib/demo/stage-geometry';
import { STEPS } from '../../lib/demo/trace';

/*
 * The stage: two devices, the relay between them, and where the message is.
 *
 * Every shape is drawn here, at build time, from `@open-e2ee/design/diagram`.
 * Nothing is constructed in the browser and nothing is fetched to make the
 * first paint — the reader gets the whole drawing in the HTML and the script
 * only names which step it is in and fills the type. That keeps the stage off
 * the pre-interaction budget the SDK import is measured against, and it means a
 * reader whose script never arrives still sees the drawing rather than a gap.
 *
 * Every step is drawn at once and CSS shows one, which is `DemoFigure.astro`'s
 * arrangement carried forward. `global.css` owns the visibility rules under
 * `.demo-stage-figure`.
 *
 * The name is longer than it wants to be because `.demo-stage` is currently the
 * two-column layout this drawing is on its way to replacing. When that layout
 * goes, the shorter name is free and the rename is mechanical.
 *
 * ------------------------------------------------------------ two of them ---
 *
 * The markup below is written once and rendered against each of
 * `stage-geometry`'s two coordinate tables. That module explains why there are
 * two and what it costs; what matters here is that this file contains no
 * number. A position typed into this file would exist in one composition and
 * not the other, which is the failure the pair exists to prevent.
 *
 * ---------------------------------------------------------- the vocabulary ---
 *
 * `design/DESIGN.md`, and five of its rules do the work:
 *
 *   An open outlined form holds readable content. Here the content is the
 *   reader's own sentence rather than content bars — the bars measure 1.93:1
 *   against the 3:1 a meaning-bearing graphic is asked for, and real text
 *   clears 4.5:1.
 *   A solid slab is ciphertext, sheared in transit and upright at rest, never
 *   given an icon and never labelled with content.
 *   Its brass ticks are mandatory. An envelope drawn without them is a bug.
 *   A filled notched slab is a private key and may only be drawn inside a
 *   device. An outlined one is a public bundle, and it travels — which is why
 *   the two in the relay are outlined and the two in each store are filled.
 *   A local store is attached to its device's edge and never floats.
 *
 * The relay is a slotted container rather than the OpenE2EE mark. Drawing the
 * mark would put the vendor's logo on the one node this project insists the
 * reader hosts themselves; drawing a box would show where the relay is without
 * showing what it does. Slots show post, collect, and keep the copy, which is
 * the whole of it.
 */

/*
 * One copy of every string the drawing says out loud.
 *
 * Here rather than inline, so a change to the wording reaches both
 * compositions. `site-content.test.mjs` counts one of these renderings twice
 * for exactly that reason: a hardcoded string in either composition is how a
 * phone and a desktop end up making different promises about the relay.
 */
const LABELS = {
  devices: { a: 'Device A · Alice', b: 'Device B · Bob' },
  relay: 'relay · never needs plaintext',
  store: 'device store',
  bundles: 'public prekey bundles',
  ratchet: 'ratchet',
  /* What happens at a boundary follows from whose it is, because this drawing
     renders one trip: Alice composes, Bob receives. `BoundaryPlace.side`
     carries the reasoning and what changes when the reply is drawn. */
  boundary: { a: 'seal', b: 'open' } satisfies Record<DeviceSide, string>,
};

/*
 * Which steps each part is on screen for.
 *
 * Suffixes of the step order rather than single names, because a part that
 * arrives stays: a device that has an identity key still has it three steps
 * later. One long string per list rather than a concatenation —
 * `site-content.test.mjs` reads these out of the source and compares them to
 * the step order, and a `+` between two halves is a token in the middle of the
 * list it is reading.
 */
const AFTER_READY = 'devices-ready bundles-published session-established encrypted in-transit stored-at-relay delivered opened';
const AFTER_PUBLISHED = 'bundles-published session-established encrypted in-transit stored-at-relay delivered opened';
const AFTER_SESSION = 'session-established encrypted in-transit stored-at-relay delivered opened';
const AFTER_ENCRYPTED = 'encrypted in-transit stored-at-relay delivered opened';
const AT_RELAY = 'stored-at-relay delivered opened';
const OPENED = 'opened';

/*
 * Every list above is a suffix of the step order, checked rather than believed.
 *
 * A list that skipped a step in the middle would draw a part, remove it, and
 * bring it back, and the drawing would be claiming a device lost a key it still
 * holds. The check is here because these strings are written by hand.
 */
const SUFFIXES = [AFTER_READY, AFTER_PUBLISHED, AFTER_SESSION, AFTER_ENCRYPTED, AT_RELAY, OPENED];

/*
 * Searched through a `readonly string[]` view rather than through `STEPS`.
 *
 * `STEPS.indexOf(parts[0])` does not compile: `parts[0]` is a string and the
 * parameter is a `Step`. The cast that satisfies the compiler — `parts[0] as
 * Step` — asserts the one thing this loop exists to prove, because the strings
 * above are written by hand and the question is whether they are steps at all.
 * Widening the haystack keeps that a runtime question, so a typo in any of the
 * six constants still throws while the page is being built.
 */
const STEP_ORDER: readonly string[] = STEPS;
for (const list of SUFFIXES) {
  const parts = list.split(' ');
  const at = STEP_ORDER.indexOf(parts[0]);
  if (at < 0 || parts.join(' ') !== STEP_ORDER.slice(at).join(' ')) {
    throw new Error(`demo stage: "${list}" is not a suffix of the step order`);
  }
}

/*
 * Which device holds a readable sentence, and from when.
 *
 * A's arrives at `encrypted`, because that is the first step at which the run
 * has a sentence at all — the reader has typed one and it has been encrypted.
 * B's arrives at `opened`, which is the step that put it there. Between those,
 * B's device is drawn empty, and that is the honest picture: the ciphertext has
 * reached it and has not been read.
 */
const CONTENT_PARTS: Record<DeviceSide, string> = { a: AFTER_ENCRYPTED, b: OPENED };

/*
 * The one mark on the canvas that says "look here now".
 *
 * Exactly one is visible in any step, and that is a property of this list
 * rather than of the CSS. Two steps have the whole row as their subject —
 * both devices coming up, and a session that spans both boundaries — and they
 * share the one rule that runs the length of the drawing rather than taking a
 * mark each, because two marks is not one mark.
 */
const accents = (composition: StageComposition) => [
  { part: 'devices-ready session-established', box: composition.spanAccent },
  { part: 'bundles-published stored-at-relay', box: composition.relay.accent },
  { part: 'encrypted', box: composition.envelopes['at-device'].accent },
  { part: 'in-transit', box: composition.envelopes['crossing-out'].accent },
  { part: 'delivered', box: composition.envelopes['crossing-in'].accent },
  { part: 'opened', box: composition.devices.b.accent },
];

/*
 * Every step but `idle` is accented exactly once.
 *
 * Checked by counting rather than by reading, because the failure is silent in
 * both directions: a step named twice lights two rules at once and the reader
 * has nowhere to look, and a step named nowhere leaves a beat of the animation
 * with no subject. `idle` is deliberately absent — nothing has happened, so
 * there is nothing to point at.
 */
const accented = accents(COMPOSITIONS[0]).flatMap(({ part }) => part.split(' '));
const expected = STEPS.filter((step) => step !== 'idle');
for (const step of expected) {
  const times = accented.filter((name) => name === step).length;
  if (times !== 1) {
    throw new Error(`demo stage: ${step} carries ${times} accents, and every step carries one`);
  }
}
for (const name of accented) {
  if (!expected.includes(name as (typeof expected)[number])) {
    throw new Error(`demo stage: an accent is assigned to ${name}, which is not a step`);
  }
}

/*
 * The boundary's dashes, taken from the package rather than matched to it.
 *
 * `boundaryLine()` draws vertically, and the stacked composition's boundaries
 * are horizontal, so this file cannot call it for both. What it can do is
 * refuse to have an opinion about how a boundary looks: the attributes below
 * are parsed out of the package's own output, so the horizontal rule is that
 * line turned rather than a second line that resembles it. A package that
 * restyles its boundary restyles both of these; a package that stops emitting
 * one of the three attributes fails the build here.
 */
const SPECIMEN = boundaryLine({ x: 0, top: 0, bottom: 1 });
const attribute = (name: string) => {
  const found = SPECIMEN.match(new RegExp(`${name}="([^"]*)"`));
  if (!found) {
    throw new Error(`demo stage: the design package's boundary line has no ${name}`);
  }
  return found[1];
};
const BOUNDARY = {
  stroke: attribute('stroke'),
  width: attribute('stroke-width'),
  dash: attribute('stroke-dasharray'),
};

/* The ratchet run's steps, positioned by the package from the geometry's own
   sizes. Two rects per step — an open one that is on screen for as long as the
   session is, and a filled one over it that the canvas lights — because a
   stylesheet that switched a fill would be a second copy of the grammar. */
const ratchetSteps = (device: DevicePlace) =>
  ratchetRects({
    x: device.ratchet.x,
    y: device.ratchet.y,
    width: RATCHET_SIZE.step,
    height: RATCHET_SIZE.height,
    gap: RATCHET_SIZE.gap,
  });

/* `seal` beside A, `open` beside B, from the one mapping above. */
const boundaryWord = (boundary: BoundaryPlace) => LABELS.boundary[boundary.side];
---

<figure
  class="demo-stage-figure"
  data-demo-stage-figure
  data-stage-state="idle"
  data-stage-ratchet-a=""
  data-stage-ratchet-b=""
>
  {
    COMPOSITIONS.map((composition) => (
      <svg
        class={`demo-stage-figure-canvas demo-stage-figure-${composition.id}`}
        viewBox={`0 0 ${composition.width} ${composition.height}`}
        aria-hidden="true"
      >
        {/* The boundaries, behind everything, because the drawing crosses them. */}
        {composition.boundaries.map((boundary) => (
          <g>
            <line
              x1={boundary.x1}
              y1={boundary.y1}
              x2={boundary.x2}
              y2={boundary.y2}
              stroke={BOUNDARY.stroke}
              stroke-width={BOUNDARY.width}
              stroke-dasharray={BOUNDARY.dash}
            />
            <text
              x={boundary.label.x}
              y={boundary.label.y}
              text-anchor={boundary.label.anchor}
              class="diagram-boundary-label"
            >
              {boundaryWord(boundary)}
            </text>
          </g>
        ))}

        {/* The two devices, each with its own store holding its own keys. Both
            are drawn from the first paint: a reader looking at a page that has
            run nothing should see the shape of what is about to happen. What
            they do not hold yet is anything inside them. */}
        {(['a', 'b'] as const).map((side) => {
          const device = composition.devices[side];
          return (
            <g>
              <g
                set:html={deviceOutline({
                  x: device.outline.x,
                  y: device.outline.y,
                  width: device.outline.width,
                  height: device.outline.height,
                  bars: 0,
                })}
              />
              <g
                set:html={deviceOutline({
                  x: device.store.x,
                  y: device.store.y,
                  width: device.store.width,
                  height: device.store.height,
                  bars: 0,
                  divider: device.storeDivider,
                })}
              />

              <text
                x={device.label.x}
                y={device.label.y}
                text-anchor={device.label.anchor}
                class="diagram-label"
              >
                {LABELS.devices[side]}
              </text>

              {/* The store's name, in the band above its divider. The band
                  below is where its keys sit, which is why the label is not
                  centred in the box. */}
              <text
                x={device.storeLabel.x}
                y={device.storeLabel.y}
                text-anchor={device.storeLabel.anchor}
                class="diagram-label"
                data-stage-part={AFTER_READY}
              >
                {LABELS.store}
              </text>

              {/* This device's own identity key, and then the key this session
                  derived. Filled and notched, inside the store, inside the
                  device — the grammar allows a private key nowhere else, and
                  the two stores holding their own is the whole of what makes
                  the separation visible rather than promised. */}
              <path
                d={notchedSlabPath({
                  x: device.privateKey.x,
                  y: device.privateKey.y,
                  width: device.privateKey.width,
                  height: device.privateKey.height,
                  notch: PRIVATE_KEY_SIZE.notch,
                })}
                fill={CIPHERTEXT_FILL}
                data-stage-part={AFTER_READY}
              />
              <path
                d={notchedSlabPath({
                  x: device.sessionKey.x,
                  y: device.sessionKey.y,
                  width: device.sessionKey.width,
                  height: device.sessionKey.height,
                  notch: PRIVATE_KEY_SIZE.notch,
                })}
                fill={CIPHERTEXT_FILL}
                data-stage-part={AFTER_SESSION}
              />

              {/* The sentence this device holds, written by the script from
                  what the reader typed and what the far device decrypted.
                  Empty in the shipped HTML, because nothing has been sent. */}
              <text
                x={device.content.x}
                y={device.content.y}
                text-anchor={device.content.anchor}
                class="demo-stage-figure-content"
                data-stage-part={CONTENT_PARTS[side]}
                data-stage-content={side}
              >
                {Array.from({ length: device.content.lines }, (_, index) => (
                  <tspan
                    x={device.content.x}
                    dy={index === 0 ? 0 : device.content.leading}
                    data-stage-content-line
                  />
                ))}
              </text>

              {/* The session's advance, one step per message this device has
                  carried. Every step is on the canvas from the moment a session
                  exists, open until it is taken: a run that drew only the taken
                  steps was a row of one or two squares with nothing to say how
                  far there was to go. */}
              <g data-stage-part={AFTER_SESSION}>
                {ratchetSteps(device).map((rect) => (
                  <rect
                    x={rect.x}
                    y={rect.y}
                    width={rect.width}
                    height={rect.height}
                    fill="none"
                    stroke={PLAINTEXT_STROKE}
                    stroke-width={STROKE_WIDTH}
                  />
                ))}
                {ratchetSteps(device).map((rect, index) => (
                  <rect
                    x={rect.x}
                    y={rect.y}
                    width={rect.width}
                    height={rect.height}
                    fill={RATCHET_FILLS[index]}
                    data-stage-side={side}
                    data-stage-step={index + 1}
                  />
                ))}
                <text
                  x={device.ratchetLabel.x}
                  y={device.ratchetLabel.y}
                  text-anchor={device.ratchetLabel.anchor}
                  class="diagram-label"
                >
                  {LABELS.ratchet}
                </text>
              </g>
            </g>
          );
        })}

        {/* The relay: an open container with compartments, so a reader can see
            what is in it. No notched key is ever drawn filled in here. */}
        <g>
          <g
            set:html={deviceOutline({
              x: composition.relay.outline.x,
              y: composition.relay.outline.y,
              width: composition.relay.outline.width,
              height: composition.relay.outline.height,
              bars: 0,
            })}
          />
          {composition.relay.slots.map((slot) => (
            <rect
              x={slot.x}
              y={slot.y}
              width={slot.width}
              height={slot.height}
              fill="none"
              stroke={PLAINTEXT_STROKE}
              stroke-width={STROKE_WIDTH}
            />
          ))}

          <text
            x={composition.relay.label.x}
            y={composition.relay.label.y}
            text-anchor={composition.relay.label.anchor}
            class="diagram-label"
          >
            {LABELS.relay}
          </text>

          {/* Both devices' public bundles, outlined because they are public and
              they travel. The filled keys in the two stores are inches away in
              the same drawing and at the same moment, which is what makes the
              outline mean something. */}
          <g data-stage-part={AFTER_PUBLISHED}>
            {composition.relay.bundles.map((bundle) => (
              <path
                d={notchedSlabPath({
                  x: bundle.x,
                  y: bundle.y,
                  width: bundle.width,
                  height: bundle.height,
                  notch: BUNDLE_SIZE.notch,
                })}
                fill="none"
                stroke={PLAINTEXT_STROKE}
                stroke-width={STROKE_WIDTH}
              />
            ))}
            <text
              x={composition.relay.bundleLabel.x}
              y={composition.relay.bundleLabel.y}
              text-anchor={composition.relay.bundleLabel.anchor}
              class="diagram-label"
            >
              {LABELS.bundles}
            </text>
          </g>

          {/* What the relay is holding, in the envelope's own words. Written by
              the script from the row itself, so a reader can check these lines
              against the panel that prints the whole of it. Empty in the
              shipped HTML, because the relay is holding nothing. */}
          <text
            x={composition.relay.fields.x}
            y={composition.relay.fields.y}
            text-anchor={composition.relay.fields.anchor}
            class="demo-stage-figure-fields"
            data-stage-part={AT_RELAY}
            data-stage-fields
          >
            {Array.from({ length: composition.relay.fields.lines }, (_, index) => (
              <tspan
                x={composition.relay.fields.x}
                dy={index === 0 ? 0 : composition.relay.fields.leading}
                data-stage-field-line
              />
            ))}
          </text>
        </g>

        {/* The envelope, in each place it is ever in. Upright at rest, sheared
            in transit, and the two crossing positions straddle a boundary each
            — the one instant a still picture carries unaided. Its ticks are on
            it in every position, because what the relay can read does not
            shrink when the envelope moves. */}
        {(
          [
            ['at-device', 'encrypted'],
            ['crossing-out', 'in-transit'],
            ['at-relay', AT_RELAY],
            ['crossing-in', 'delivered'],
          ] as const
        ).map(([position, part]) => {
          const place = composition.envelopes[position];
          return (
            <g data-stage-part={part}>
              <path
                d={slabPath({
                  x: place.slab.x,
                  y: place.slab.y,
                  width: place.slab.width,
                  height: place.slab.height,
                  shear: place.shear,
                })}
                fill={CIPHERTEXT_FILL}
              />
              <g
                set:html={metadataTicks({
                  x: place.ticks.x,
                  y: place.ticks.y,
                  count: place.ticks.count,
                })}
              />
            </g>
          );
        })}

        {accents(composition).map((accent) => (
          <rect
            x={accent.box.x}
            y={accent.box.y}
            width={accent.box.width}
            height={accent.box.height}
            class="demo-stage-figure-accent"
            data-stage-part={accent.part}
          />
        ))}
      </svg>
    ))
  }
</figure>
