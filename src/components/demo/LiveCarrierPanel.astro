---
import CarrierBoundary from '../CarrierBoundary.astro';
import CarrierPanel from '../CarrierPanel.astro';
import sdkManifest from '@open-e2ee/signal-protocol-sdk/package.json';

/*
 * The recording, made reproducible — and then made into a stage.
 *
 * `CarrierPanel` prints a round trip that happened once, on a machine the
 * reader does not have. This component keeps that panel exactly where it was
 * and puts a live one in front of it: the reader's own sentence, encrypted by
 * the installed `@open-e2ee/signal-protocol-sdk` in their tab, with the
 * envelope the relay held printed from the object itself.
 *
 * Four things about the shape are load-bearing rather than stylistic.
 *
 * **The recorded panel is the default, not the fallback that gets rendered on
 * failure.** It is server-rendered and stays in the DOM; the script hides it
 * and shows the live panel, and puts it back if the SDK never arrives
 * (invariant 6). A failure handler that had to *construct* the fallback would
 * be useless in the case that matters most — the script itself being blocked,
 * unsupported, or never fetched — because then no handler runs at all.
 *
 * **The controls are live from the first paint**, before any SDK code exists.
 * They are the activation trigger: focusing the field or pressing send starts
 * the 713 KB import that invariant 7 keeps off the initial payload, and a send
 * pressed early is queued rather than dropped. An input that appeared only
 * once the chunk had landed would have nothing to trigger the landing.
 *
 * **Nothing here hand-writes an envelope field.** The metadata list is built by
 * iterating the live object (invariant 4). The recorded panel's list was
 * maintained by hand and drifted from ten fields to six, in the direction that
 * flattered us, on the one panel whose whole job is not overstating the
 * evidence.
 *
 * **There is one composer, and it has two things it can be wired to.** Solo,
 * it drives `./driver`'s pair of clients in this tab. Paired, it drives
 * `./two-tab`'s single client and reaches the other tab's. The panes are the
 * same panes either way, and which one is live is decided by whether a real
 * session with a real other tab exists — never by anything the page assumed.
 * A second device is drawn only once a tab has said, over its own channel,
 * that it has a client up.
 */

const installedVersion = sdkManifest.version;
const packageName = sdkManifest.name;

/* Long enough to hold a sentence a reader would actually send, short enough
 * that the ciphertext underneath still looks like a wall rather than a line. */
const MAX_LENGTH = 140;
const PLACEHOLDER = 'Type a sentence and watch it become the row below.';

/*
 * The fragment the pairing control opens, and the one the arriving tab acts on.
 *
 * Deliberately not `#demo`. That anchor is the hero's scroll target and a
 * link a reader may well have bookmarked, and a page that started a 713 KB
 * import because someone followed it would be spending the budget invariant 7
 * protects on a reader who only asked to look. This fragment exists for one
 * purpose and is only ever produced by the control below.
 */
const PAIR_FRAGMENT = 'demo-pair';
---

<div class="live-carrier" data-demo="live-carrier-panel" data-pair-fragment={PAIR_FRAGMENT}>
  {/*
    The recorded capture. Server-rendered, visible on arrival, and the state
    the page returns to if the live demo cannot run. `data-demo-recorded` is
    what the smoke harness asserts is still on screen when it blocks the chunk.
  */}
  <div class="live-carrier-recorded" data-demo-recorded>
    {/*
      The page's lead offers the reader a sentence to type. With scripts off
      there is no field to type it into, and the fallback note above stays
      correctly empty, because from where that reader sits nothing failed —
      so nothing else on the page would ever say why the offer cannot be
      taken up. This is the one line that only they see, and it is the only
      honest place to put it: a script cannot write it.
    */}
    <noscript>
      <p class="carrier-cipher-note live-carrier-noscript">
        The panel below is a recording. The live version needs JavaScript — it runs the SDK
        in your browser, so with scripts off there is nothing to run it with.
      </p>
    </noscript>
    <CarrierPanel />
    {/*
      Empty, and server-rendered empty on purpose. It is filled only when the
      script ran and then could not deliver a live demo — the one failure a
      handler can actually describe. A reader with no JavaScript gets the
      recorded panel with no apology attached, because nothing failed for them.
    */}
    <p class="carrier-cipher-note live-carrier-fallback-note" data-demo-fallback-note></p>
  </div>

  {/*
    The live panel. `hidden` until the script runs, so a reader with no
    JavaScript never sees an inert set of controls, and the recorded panel is
    the only thing on the page.
  */}
  <figure class="carrier-panel live-carrier-live" data-demo-live hidden>
    <div class="carrier-pane">
      {/*
        Who is at this end, always on screen rather than only once something
        has been paired. Solo it says both devices are in this tab, because
        both of them are; paired it says which account this tab holds. Neither
        line is ever written from anything but a session that exists.
      */}
      <span class="label" data-demo-near-label>your device · this tab</span>
      <div class="live-carrier-compose">
        <label class="oe-visually-hidden" for="live-demo-input">
          A sentence to encrypt, up to {MAX_LENGTH} characters
        </label>
        <input
          id="live-demo-input"
          class="live-carrier-input"
          data-demo-input
          data-two-tab-input
          type="text"
          autocomplete="off"
          spellcheck="false"
          maxlength={MAX_LENGTH}
          placeholder={PLACEHOLDER}
        />
        <button
          class="oe-button live-carrier-send"
          data-demo-send
          data-two-tab-send
          type="button"
        >
          Encrypt it
        </button>
      </div>
      <p class="carrier-cipher-note" data-demo-status role="status">
        The SDK loads when you start typing.
      </p>
      <ul class="two-tab-transcript live-carrier-transcript" data-demo-sent hidden></ul>
    </div>

    <CarrierBoundary kind="seal" />

    <div class="carrier-pane carrier-pane-relay">
      <span class="label">relay — the row in your database</span>
      {/*
        What the pane will hold, until it holds it.

        These two panes are the argument — the row a relay keeps, and the
        sentence that comes out the far side — and before the first send they
        were two labelled boxes with nothing in them, about a third of the
        panel's height reserved for output that did not exist yet. A reader
        skimming past got a label and a void, which reads as something that
        failed to load rather than something waiting to be run.

        So the space says what is coming instead of standing empty. It is
        removed by the first render rather than overwritten, because these are
        promises about the panel and every other line in it is a measurement.
      */}
      <p class="carrier-cipher-note" data-demo-idle>
        The envelope your relay would store lands here — the ciphertext, then every field the
        relay can read, printed from the object itself.
      </p>
      {/*
        Hidden from assistive technology for the same reason the recorded
        panel's blob is: several hundred base64 characters read aloud one at a
        time, with no landmark to escape to, immediately before the line that
        already carries the whole meaning. The note below states what it is and
        how much of it there is, which is more than a listener could recover
        from hearing it.
      */}
      <p class="carrier-cipher" data-demo-cipher aria-hidden="true"></p>
      <p class="carrier-cipher-note" data-demo-cipher-note></p>
      <dl class="carrier-meta" data-demo-meta></dl>
      <p class="carrier-cipher-note" data-demo-meta-note></p>
    </div>

    <CarrierBoundary kind="open" />

    <div class="carrier-pane">
      <span class="label" data-demo-far-label>the second device · also this tab</span>
      <p class="carrier-cipher-note" data-demo-idle>
        The same sentence lands here, decrypted by the receiving device, with what each half of
        the trip cost.
      </p>
      <p class="carrier-message" data-demo-decrypted></p>
      <p class="carrier-cipher-note" data-demo-timing></p>
      <ul class="two-tab-transcript live-carrier-transcript" data-demo-received hidden></ul>
    </div>

    <figcaption class="carrier-caption">
      {/*
        Invariant 5, adjacent to the thing it discloses. The cryptography is
        the shipped cryptography; what is simulated is the infrastructure
        around it, and both stand-ins are named in the reader's own vocabulary
        rather than as "a demo backend". The version is the installed one,
        read from the package at build time, so it cannot drift from what the
        page actually imported.
      */}
      {/*
        `and{' '}` rather than a line break before the second `<code>`: Astro
        collapses the whitespace between a text node and a following inline
        element, so the source looks correctly spaced and the build reads
        "and<code>inMemoryRelay()". `tests/site-content.test.mjs` catches it,
        which is how this comment came to exist.
      */}
      <span>
        real protocol and cryptography, simulated infrastructure — <code>inMemoryStore()</code>{' '}
        and <code>inMemoryRelay()</code> run in this tab
      </span>
      <span>{packageName}@{installedVersion}</span>
      {/*
        Invariant 8's claim, stated where it can be checked, and phrased as an
        instruction rather than a reassurance: the reader has the network tab
        and the page has nothing to hide from it. It says nothing about the
        console, because LD0 found WebKit prints an AES-CBC advisory whenever
        `crypto.subtle` is asked for the cipher the double ratchet specifies —
        a clean-console claim would be false on Safari.

        In the caption rather than under the pairing controls, where it was a
        sentence floating between two blocks and belonging to neither. This is
        the panel's disclosure line and the caption is where the panel's other
        disclosure already is.
      */}
      <span class="live-carrier-claim" data-demo-claim hidden>
        That ran in this tab. Nothing left the page — check the network tab.
      </span>
    </figcaption>
  </figure>

  {/*
    The pairing control, and the one thing on this page that needs a second
    window. It is the primary action under the panel rather than a section of
    its own further down: a reader who has just watched a sentence travel
    between two clients in one tab is at the moment the question "but were they
    really separate?" occurs to them, and the answer is one press away.
  */}
  <div class="live-carrier-pairing">
    <button class="oe-button" type="button" data-two-tab-connect>Open the second device</button>
    {/*
      The same destination as a link, revealed when the press could not open a
      tab itself — a blocked pop-up, or a browser that does not tell a page
      whether a click was a real one. Hidden rather than absent so the reveal
      costs no layout and the destination is the same string in both paths.
    */}
    <a
      class="live-carrier-pair-link"
      data-two-tab-pair-link
      href={`#${PAIR_FRAGMENT}`}
      target="_blank"
      rel="noopener"
      hidden
    >
      Open the second device in a new tab
    </a>
    <p class="scenario-status" data-two-tab-status role="status">
      Both devices are in this tab until you open a second one.
    </p>
    <div class="live-carrier-peers" data-two-tab-output hidden>
      <p class="two-tab-identity" data-two-tab-identity></p>
      <button class="oe-button oe-button-secondary" type="button" data-two-tab-disconnect>
        Disconnect this tab
      </button>
    </div>
  </div>
</div>

<script>
  import { ciphertextBytes } from '../../lib/demo/ciphertext';
  import { createDemoLoader } from '../../lib/demo/loader';
  import type { DemoExchange, DemoSession } from '../../lib/demo/driver';
  import type { StageDirection, StageFigure, StageState } from '../../lib/demo/figure';
  import type { Presence } from '../../lib/demo/presence';
  import type { TwoTabSession } from '../../lib/demo/two-tab';

  const panel = document.querySelector<HTMLElement>('[data-demo="live-carrier-panel"]');
  if (panel) upgrade(panel);

  function upgrade(panel: HTMLElement) {
    const pick = <T extends HTMLElement>(selector: string) =>
      panel.querySelector<T>(selector) as T;

    const recorded = pick('[data-demo-recorded]');
    const live = pick('[data-demo-live]');
    const claim = pick('[data-demo-claim]');
    const input = pick<HTMLInputElement>('[data-demo-input]');
    const send = pick<HTMLButtonElement>('[data-demo-send]');
    const status = pick('[data-demo-status]');
    const cipher = pick('[data-demo-cipher]');
    const cipherNote = pick('[data-demo-cipher-note]');
    const meta = pick<HTMLDListElement>('[data-demo-meta]');
    const metaNote = pick('[data-demo-meta-note]');
    const decrypted = pick('[data-demo-decrypted]');
    const timing = pick('[data-demo-timing]');
    const nearLabel = pick('[data-demo-near-label]');
    const farLabel = pick('[data-demo-far-label]');
    const sentLines = pick('[data-demo-sent]');
    const receivedLines = pick('[data-demo-received]');

    const connect = pick<HTMLButtonElement>('[data-two-tab-connect]');
    const pairLink = pick<HTMLAnchorElement>('[data-two-tab-pair-link]');
    const pairStatus = pick('[data-two-tab-status]');
    const peers = pick('[data-two-tab-output]');
    const peerIdentity = pick('[data-two-tab-identity]');
    const leave = pick<HTMLButtonElement>('[data-two-tab-disconnect]');

    /* The upgrade itself. Running at all is the evidence that JavaScript works,
       which is the one thing the recorded panel is the fallback for. */
    recorded.hidden = true;
    live.hidden = false;

    const loader = createDemoLoader();
    let session: DemoSession | null = null;
    let booting: Promise<DemoSession> | null = null;
    let inFlight = false;

    /*
     * Exactly two fields are held back, and the reader is told about both.
     *
     *   ciphertext — printed above as the bytes themselves, not as a table row.
     *   id         — the in-memory relay counts sends, so this reads `msg-1`. A
     *                production relay assigns its own format, and printing this
     *                one would teach a reader something false about their own
     *                database.
     *
     * This is a list of what is deliberately *not* shown. It is not a list of
     * what is shown: every other field arrives by iterating the envelope, so a
     * field the SDK adds appears here without anyone editing this file, and a
     * field it removes vanishes rather than lingering as a stale row.
     */
    const HELD_BACK = new Set(['ciphertext', 'id']);

    const setStatus = (text: string) => {
      status.textContent = text;
    };

    const setPairStatus = (text: string) => {
      pairStatus.textContent = text;
    };

    /*
     * The figure beside the panel, fetched on the same press that fetches the
     * SDK and never before it.
     *
     * It is a few hundred bytes of DOM handling with no protocol code in it,
     * and it still waits: the pre-interaction payload is measured, the whole
     * drawing is already in the HTML, and a module that only decides which
     * parts of it are on screen has nothing to do until a reader has asked for
     * something. Until it lands the figure sits in the state the build shipped
     * it in, which is the state a page that has run nothing is honestly in.
     */
    let figure: StageFigure | null = null;
    let figureLoading: Promise<void> | null = null;
    let lastState: StageState = 'idle';

    /*
     * What the figure would have been told, for the stretch before it exists.
     *
     * Everything below can happen before the chunk lands — a tab opened on the
     * pairing fragment names both ends and counts a message while the import is
     * still in flight — and a call that went to a null figure would be a fact
     * the drawing never receives, silently, on exactly the slow connection
     * where the gap is widest. So each of the three is remembered and replayed
     * on mount, in the same order the run produced them.
     */
    let lastDirection: StageDirection = 'out';
    let lastLabels: [string, string] = ['this tab', 'second device'];
    let lastCipher: unknown = null;
    let messages = 0;

    const mounted = (ready: StageFigure) => {
      figure = ready;
      ready.direction(lastDirection);
      ready.label(...lastLabels);
      ready.ratchet(messages);
      if (lastCipher !== null) ready.cipher(lastCipher);
      ready.jump(lastState);
    };

    /* Remembered for the same reason the labels are: the relay reports the
       stored row a few milliseconds after the press that started the import,
       and a strip handed to a figure that did not exist yet is a lane the run
       leaves empty for good. */
    const printCipher = (value: unknown) => {
      lastCipher = value;
      figure?.cipher(value);
    };

    const stage = (state: StageState) => {
      lastState = state;
      if (figure) {
        figure.advance(state);
        return;
      }
      if (figureLoading) return;
      figureLoading = import('../../lib/demo/figure')
        .then((module) => {
          const root = document.querySelector<HTMLElement>('[data-demo-figure]');
          if (!root) return;
          mounted(module.mountStageFigure(root));
        })
        .catch(() => {
          /* Same reasoning as the SDK chunk: a figure that never arrived leaves
             the drawing at the state the build shipped, and the panel beside it
             is where the evidence was always going to be. */
        });
    };

    /* Which way the next states travel. The near device is always this tab, so
       a tab that is receiving watches the same trip from the other end. */
    const face = (direction: StageDirection) => {
      lastDirection = direction;
      figure?.direction(direction);
    };

    /* One ratchet step per message the session carries, in either direction —
       which is what the double ratchet itself advances on. */
    const ratcheted = () => {
      messages += 1;
      figure?.ratchet(messages);
    };

    /* A failed load is not an error box. It is the recorded panel, back where
       it was, with one line saying why the reader is looking at a recording. */
    const fallBack = (reason: string) => {
      live.hidden = true;
      claim.hidden = true;
      recorded.hidden = false;
      const note = recorded.querySelector<HTMLElement>('[data-demo-fallback-note]');
      if (note) note.textContent = reason;
    };

    /* Only `loading` is worth saying from here. `failed` is published on the way
       to rejecting `load()`, so anything this callback wrote about it would be
       overwritten a microtask later by the catch in `boot()` — which is the line
       a reader has always actually seen. */
    loader.subscribe((state) => {
      if (state.status === 'loading') {
        setStatus('Loading the SDK…');
        stage('sdk-loading');
      }
    });

    /*
     * Boot on the first sign of interest, and only once.
     *
     * Focus is the earliest honest signal — a reader who has put the cursor in
     * the field intends to type — and it lets the handshake overlap with their
     * typing instead of starting after it.
     *
     * Scrolling the panel into view is deliberately not a signal. An
     * IntersectionObserver here would warm the session before the first
     * keystroke, which reads well until you notice it bills every reader who
     * scrolls past for the whole import — 30 chunks, 679 KB gzip measured off
     * this build, ~713 KB on the wire — of SDK they never asked for, the exact
     * cost invariant 7 exists to keep off people who do not use the demo. A
     * reader who clicks send without focusing first is covered anyway:
     * `submit` awaits `boot()` rather than assuming a session exists.
     */
    const boot = () => {
      if (booting) return booting;
      booting = loader
        .load()
        .then(async (module) => {
          setStatus('Booting two devices…');
          session = await module.startDemoSession();
          session.on((event) => {
            if (event.type === 'message-sent') {
              established();
              ratcheted();
              stage('encrypted');
              stage('in-transit');
            } else if (event.type === 'envelope-stored') {
              printCipher((event.envelope as unknown as Record<string, unknown>).ciphertext);
              stage('stored-at-relay');
              stage('delivered');
            } else {
              stage('opened');
            }
          });
          stage('devices-ready');
          /* The handshake number, with the thing to do next attached to it.
             It read `Two devices, N ms to a shared secret.` and arrived on
             the first keystroke — a timing for work the reader had not asked
             for, standing in the one line that is otherwise the panel's only
             instruction. The measurement is worth keeping; leading with it
             is not. */
          setStatus(`Two devices ready in ${Math.round(session.bootMs)} ms. Press Encrypt it.`);
          return session;
        })
        .catch((cause: unknown) => {
          /* Both shapes land here: a chunk that never arrived, and a handshake
             that threw after it did. They read differently to us and identically
             to a reader, who has the same recording either way. */
          fallBack('The live demo could not start, so this is the recording.');
          throw cause;
        });
      return booting;
    };

    /*
     * Fire and forget, but not unhandled.
     *
     * The failure this can produce is already dealt with — the catch inside
     * `boot` puts the recorded panel back — yet the promise returned here has
     * no reader, and a rejected promise nobody read is an uncaught error in the
     * console. That is not a rare race: a request the browser refuses fails in
     * about a millisecond, so the rejection lands long before the reader gets
     * as far as pressing send. The blocked-chunk pass of `demo:smoke` found
     * this by watching the console on a page that was otherwise recovering
     * correctly.
     */
    input.addEventListener(
      'focus',
      () => {
        /* Paired, the other module owns this tab's client and booting a second
           pair of devices behind it would be 713 KB of nothing. */
        if (paired) return;
        void boot().catch(() => {});
      },
      { once: true },
    );

    /* PQXDH runs inside the first `send()`, so the first report of a sealed
       envelope is also the first evidence of a session. Said once. */
    let announced = false;
    const established = () => {
      if (announced) return;
      announced = true;
      stage('session-established');
    };

    /*
     * The row the relay is holding, printed the one way this page prints a row.
     *
     * Solo and paired both arrive here. They used to arrive at two different
     * printers — this one, and a second inside `two-tab-view.ts` that summarised
     * long values, dropped the not-set treatment and stringified an absent field
     * to the literal `undefined`. A reader who paired therefore got a worse
     * account of the row than a reader who did not, on the pane the section
     * exists for, and the two lists disagreed about how many fields an envelope
     * even has.
     */
    const printRow = (envelope: Record<string, unknown>) => {
      /* The promises about what these panes would hold, retired by the thing
         itself. Removed rather than emptied so the panel's height comes from
         its content in both states. */
      for (const idle of panel.querySelectorAll('[data-demo-idle]')) idle.remove();

      /* Decoded rather than divided by four thirds. The field is base64 of
         base64 — the SDK serialises the message to a base64 document and the
         row carries that document encoded again — so the arithmetic that
         stood here reported the size of the inner document and called it
         bytes, a third again over the real figure, on the one line whose
         subject is how much the relay is holding. `ciphertext.ts` peels it,
         and the figure's hex strip is taken from the same bytes. */
      const encoded = String(envelope.ciphertext);
      const bytes = ciphertextBytes(encoded)?.length ?? 0;
      cipher.textContent = encoded.slice(0, 420);
      cipher.append(Object.assign(document.createElement('span'), { textContent: '…' }));
      cipherNote.textContent =
        `ciphertext — ${encoded.length.toLocaleString('en-US')} base64 ` +
        `characters, ${bytes.toLocaleString('en-US')} bytes decoded, excerpt shown`;

      /* Invariant 4: the rows are the envelope's own keys. Nothing in this
         function names a field, so nothing in it can disagree with one. */
      meta.replaceChildren();
      let shown = 0;
      for (const [field, value] of Object.entries(envelope)) {
        if (HELD_BACK.has(field)) continue;
        const dt = document.createElement('dt');
        dt.textContent = field;
        const dd = document.createElement('dd');
        /* A key the envelope carries with no value is still a key the relay
           holds, so the row stays and the field is named. What it must not
           print is `undefined` — the JavaScript literal is an artefact of how
           this list is built, and on the one panel whose subject is what a
           relay can read it looks like the page failed to fill a cell. */
        if (value === undefined || value === null) {
          dd.textContent = 'not set';
          dd.classList.add('carrier-meta-unset');
        } else {
          dd.textContent = typeof value === 'string' ? value : String(value);
        }
        meta.append(dt, dd);
        shown += 1;
      }
      /* `shown` counts the rows that are on the screen, and this line called
         them "more" — a reader who had just counted ten of them was told
         there were ten further ones. What is genuinely not above is the
         ciphertext, printed as bytes rather than as a row, and the id. */
      metaNote.textContent =
        `${shown} fields, read off the envelope itself — plus the ciphertext above, ` +
        `and an id your relay assigns in whatever format it uses`;
    };

    const render = (exchange: DemoExchange) => {
      printRow(exchange.envelope as unknown as Record<string, unknown>);

      decrypted.textContent = exchange.decrypted.content;
      timing.textContent =
        `encrypted in ${exchange.encryptMs.toFixed(1)} ms, ` +
        `decrypted on the other device ${exchange.roundTripMs.toFixed(1)} ms after you pressed send`;
      claim.hidden = false;
    };

    /*
     * One event, the first time a sentence completes a round trip on this page,
     * carrying nothing about it — not the sentence, not its length, not the
     * byte counts or the milliseconds the panel just printed beside it. The
     * beacon reads `demo_run /` and there is no third field for it to read.
     *
     * Once per page rather than once per send. The question this exists to
     * answer (plan D5) is whether readers who ran the demo go on to enter and
     * finish the quickstart, and its denominator is readers; counting sends
     * would measure how much someone enjoyed pressing the button. Nothing here
     * identifies a page view, so this is the closest a cookieless model gets to
     * "a reader ran it", and it is deliberately the conservative direction.
     *
     * Solo only, and that is not an oversight. The paired panel is a
     * conversation between two windows, has never been a measured surface, and
     * `demo:smoke` fails the run if a beacon appears while it is being driven.
     *
     * `public/measure.js` owns the beacon; this owns the moment. The site's
     * delegated click handler reads links, and this is a button in a module it
     * knows nothing about.
     */
    let reportedRun = false;
    const reportRun = () => {
      if (reportedRun) return;
      reportedRun = true;
      window.oeMeasure?.('demo_run');
    };

    /* ------------------------------------------------------------ pairing --- */

    let paired: TwoTabSession | null = null;
    let joining: Promise<void> | null = null;
    let unmount: (() => void) | null = null;
    let presence: Presence | null = null;
    let peerHere: string | null = null;

    /*
     * Who is at each end, in the panes rather than in a sentence.
     *
     * Solo, both devices are in this tab and the labels say so — the panel is
     * two clients talking to each other, and a label that implied otherwise
     * would be the one lie this whole band exists to avoid. Paired, the far
     * label names the account this tab is writing to, and says whether a tab
     * holding it has actually announced itself. It never names a peer that has
     * not.
     *
     * Before a second tab arrives there is no name to print at all, because a
     * session no longer guesses one: identities are minted per session, so the
     * only tab that knows the far account's name is the far tab. The label says
     * the device is waiting rather than naming an account nobody holds.
     */
    const describe = () => {
      if (!paired) {
        nearLabel.textContent = 'your device · this tab';
        farLabel.textContent = 'the second device · also this tab';
        labelFigure('also this tab');
        return;
      }
      nearLabel.textContent = `${paired.me} · this tab`;
      farLabel.textContent = peerHere
        ? `${peerHere} · the other tab`
        : 'the second device · no tab has it yet';
      labelFigure(peerHere ? 'the other tab' : 'no tab yet');
    };

    /*
     * The same two facts, in the figure's own vocabulary.
     *
     * Short forms rather than the pane labels above. The figure is a 520-unit
     * canvas whose type is set in those units, so `alice-4f2c · the other tab`
     * is a label wider than the device it names; and a generated identifier is
     * the one part of those lines the drawing does not need, because the
     * drawing is about which window a device is in. The near end is never
     * written from here at all — it is this tab in every state the figure has.
     */
    const labelFigure = (far: string) => {
      lastLabels = ['this tab', far];
      figure?.label(...lastLabels);
    };

    const pairUrl = () => {
      const url = new URL(window.location.href);
      url.hash = `#${panel.dataset.pairFragment ?? ''}`;
      return url.toString();
    };

    /*
     * Opening the second tab, only when the browser says a person asked.
     *
     * `window.open` is called before anything is awaited, because a browser
     * counts a click as permission to open a window for a short moment and the
     * SDK import is longer than that moment. The activation check in front of
     * it is what makes this deterministic rather than dependent on a pop-up
     * blocker's mood: a click carrying no activation opens no tab, and the link
     * below the button is revealed instead. Both paths reach the same fragment.
     *
     * No `noopener` in the feature string, and that is the whole reason the
     * branch below can be believed: `window.open` returns null when the caller
     * asks for `noopener`, whether or not a tab opened. With it, the fallback
     * link was revealed on every press — including the presses that had just
     * opened the tab it offers to open — which is an invitation to a third
     * participant that neither tab is expecting. The tab this opens is this
     * site on this origin, and nothing on either side reads `window.opener`.
     */
    let linkOffered = false;
    const openSecondTab = () => {
      const activation = (navigator as Navigator & { userActivation?: { isActive: boolean } })
        .userActivation;
      const opened = activation?.isActive === true ? window.open(pairUrl(), '_blank') : null;
      if (opened) return;
      linkOffered = true;
      pairLink.hidden = false;
    };

    const join = () => {
      if (joining) return joining;
      connect.disabled = true;
      setPairStatus('Loading the SDK…');
      stage('sdk-loading');

      joining = Promise.all([
        import('../../lib/demo/two-tab'),
        import('../../lib/demo/two-tab-view'),
        import('../../lib/demo/presence'),
      ])
        .then(async ([twoTab, view, presenceModule]) => {
          setPairStatus('Registering a device in this tab…');
          const started = await twoTab.startTwoTabSession();
          paired = started;

          /*
           * The solo run's output, taken down with the session that produced it.
           *
           * A reader who typed once before pairing had that round trip's
           * ciphertext, its field table and its decrypted line still on screen
           * beside the paired conversation's first stored row — two answers to
           * "what does the relay hold", one of them from a pair of clients that
           * no longer exists. The panes are the same panes in both modes; what
           * changes is which session is writing to them, so the handover empties
           * them rather than layering.
           *
           * The lines that say what a pane is *going* to hold are deliberately
           * left alone. They are removed by the first row printed into the pane,
           * whichever session prints it, and a tab that arrived on the pairing
           * fragment has not printed one yet — clearing them here gave that
           * reader a labelled grey band with nothing in it and no promise that
           * anything was coming, which is what a broken pane looks like.
           */
          cipher.textContent = '';
          cipherNote.textContent = '';
          meta.replaceChildren();
          metaNote.textContent = '';
          decrypted.textContent = '';
          timing.textContent = '';
          claim.hidden = true;
          /* The run goes with the panes. `onMet` clears it too, but that is the
             far end of a window this tab spends showing a session that has
             carried nothing under a step lit by the one before it — a second or
             two normally, and until the reader finds the fallback link when the
             pop-up was blocked. The counter behind it cannot move in here:
             `send()` refuses before `meet()`, which is the same event that
             resets it. */
          figure?.ratchet(0);

          /* The composer's own line still offered to load the SDK when the
             reader started typing, to a tab that had just loaded it and in some
             cases had already decrypted a sentence with it. */
          setStatus(
            'The SDK is loaded in this tab. What you type is encrypted for the other one.',
          );

          sentLines.hidden = false;
          receivedLines.hidden = false;
          peers.hidden = false;
          connect.hidden = true;

          unmount = view.mountTwoTab(started, {
            identity: peers,
            sent: sentLines,
            received: receivedLines,
            setStatus: setPairStatus,
            /*
             * A new correspondent is a new session, and both of the counters
             * this panel keeps per session start again here.
             *
             * This is the seam that knows. `meet()` fires it once when the
             * second tab first names itself and again whenever that answer
             * changes, which is what a reloaded tab coming back under a new
             * name looks like — and nothing else on this page is told.
             *
             * `messages` is the ratchet run, whose contract is how many
             * messages *this session* has carried. Left alone it spanned both
             * halves of a reload, drawing three steps over a session that had
             * carried one. `announced` is "PQXDH has run", and left alone it
             * suppressed the arrival of the second tab as old news: first for
             * a reader who had typed solo before pairing, and then again for
             * every rejoin after a tab had sent anything at all.
             */
            onMet: () => {
              messages = 0;
              figure?.ratchet(0);
              announced = false;
            },
            /*
             * Every row the relay takes, in either direction, printed into the
             * pane and drawn in the lane.
             *
             * The pane holds the newest row rather than a growing list. "The row
             * in your database" is a claim about what is there now, and a list
             * that only ever grew in one direction made it false twice over: a
             * tab watched only its own outgoing rows, so the row it had just
             * been sent never appeared at all, and the row it had sent first
             * stayed at the top long after the relay had taken two more.
             */
            onEnvelope: (envelope) => {
              const row = envelope as unknown as Record<string, unknown>;
              printRow(row);
              printCipher(row.ciphertext);
            },
            /*
             * The other end of the trip, drawn from this tab's point of view.
             *
             * Two states and no more. `two-tab.ts` publishes `sent`,
             * `received` and `envelope-stored`, and none of them is a receipt.
             * A receiving tab is told that the relay took a row addressed to it
             * and that the row decrypted here — it is told nothing about when
             * the other tab encrypted, and the figure does not draw what it was
             * not told. The two are shown in sequence because they arrived
             * together, the same presentation `session-established` and
             * `encrypted` get.
             */
            onReceived: () => {
              ratcheted();
              face('in');
              stage('delivered');
              stage('opened');
            },
          });

          peerIdentity.textContent =
            started.role === 'host'
              ? `This tab is ${started.me} and is holding the relay, so keep it open.`
              : `This tab is ${started.me}. The other tab is holding the relay.`;

          presence = presenceModule.openPresence({
            me: started.me,
            role: started.role,
            onJoin: (peer) => {
              /* The address to write to, learned rather than assumed. Sessions
                 mint their own names now, so this is the first moment this tab
                 has anywhere to send — and the moment a returning tab's new
                 name replaces the one it had before it reloaded. */
              started.meet(peer.me);
              peerHere = peer.me;
              describe();
              /* The offer of a second tab, withdrawn by the second tab
                 arriving. It stays on screen until then even though the button
                 above it has gone, because it is the only route left to the
                 fragment when a pop-up blocker ate the window; what makes it
                 wrong is a tab that already has its pair still advertising a
                 place for a third. The button goes the same way and for the
                 same reason — `onLeave` puts both back. */
              pairLink.hidden = true;
              connect.hidden = true;
              setPairStatus(`${peer.me} is here, in another tab. Type in either one.`);
              /* The figure acknowledges the second window, once, and only
                 while it is still the newest thing that has happened. A tab
                 that has already sent something is further along than this
                 and must not be walked backwards to say so. */
              if (!announced) stage('peer-connected');
            },
            onLeave: () => {
              peerHere = null;
              describe();
              /*
               * The instruction on the status line, made pressable.
               *
               * Both routes to a second tab come back, and the button comes
               * back unconditionally. It used to be hidden for good by the
               * first successful pairing, with only the blocked-pop-up link
               * restored — so a reader whose browser opens windows normally,
               * which is most of them, was told to open a second tab again
               * and given nothing to do it with. An accidental reload of the
               * second tab is an ordinary thing to do, and it left the demo
               * with no way forward on either side.
               *
               * Pressing it here opens a tab and does not re-join: `join()`
               * hands back the settled promise it is already holding, because
               * this tab's own device never went anywhere.
               *
               * "Disconnect this tab" stays where it is, deliberately. It is
               * not an offer to disconnect from the tab that has gone — it
               * says *this tab*, and what it does is unchanged: it stops this
               * tab's paired session and hands the panel back to the one-tab
               * demo. That is the only route back to solo mode, and it is the
               * only `stop()` this page ever calls, so hiding it here would
               * strand a reader whose second tab closed with a paired session
               * they cannot end.
               */
              connect.hidden = false;
              connect.disabled = false;
              pairLink.hidden = !linkOffered;
              setPairStatus('The other tab has gone. Open a second one again to carry on.');

              /*
               * The drawing, walked back off a claim that has stopped being
               * true.
               *
               * Only this one state. `peer-connected` is the single caption
               * whose subject is the other tab and whose tense is present —
               * "the far device is another window now" — so a departure left
               * it asserting a window that had closed, directly above a far
               * label reading "no tab has it yet". Every state after it
               * narrates a trip that did happen and stays as it is: the
               * sentence really was sealed, stored and opened, and a reader
               * who steps away mid-read should not find the evidence rewound.
               */
              if (lastState === 'peer-connected') stage('peer-gone');
            },
          });
          presence.announce();

          describe();
          stage('devices-ready');
        })
        .catch((cause: unknown) => {
          /*
           * Same rule as a scenario: this promises live cryptography, so a tab
           * that could not boot one says so rather than showing a pane.
           *
           * In this page's own words, though. The SDK's sentence used to be
           * interpolated straight onto the status line, and the SDK calls the
           * far end by the name this band's whole vocabulary avoids — the one
           * messaging.md §4 replaces with *relay*. No scanner can catch that:
           * the string is assembled at run time out of somebody else's
           * message, and the source it is assembled in is clean. The cause
           * still goes to the console in full, where it is a diagnostic rather
           * than the page's voice.
           */
          console.error('[open-e2ee demo] the two-tab session could not start', cause);
          setPairStatus(
            'This tab could not reach the relay, so it stayed on its own. ' +
              'The console has the reason.',
          );
          peers.hidden = true;
          connect.hidden = false;
          connect.disabled = false;
          joining = null;
        });

      return joining;
    };

    connect.addEventListener('click', () => {
      openSecondTab();
      void join();
    });

    /*
     * Leaving, as something the reader does rather than something that happens.
     *
     * A tab that is closed takes its device and its subscriptions with it and
     * nobody finds out whether putting them away worked. That matters more here
     * than it reads: both `subscribe()` and `subscribeRetryRequests()` hand back
     * an unsubscribe function synchronously, and a relay that returned a promise
     * from either would send, deliver and decrypt perfectly and then fail in
     * `stop()` — the one call no scenario on this page makes. So the tab has a
     * way to leave, the smoke harness presses it in both tabs, and a teardown
     * that throws says so on the status line.
     */
    leave.addEventListener('click', () => {
      const going = paired;
      if (!going) return;
      leave.disabled = true;
      setPairStatus('Closing this tab’s device and letting go of the relay…');
      void going
        .stop()
        .then(() => {
          unmount?.();
          unmount = null;
          presence?.close();
          presence = null;
          paired = null;
          peerHere = null;
          peers.dataset.twoTabStopped = '';
          describe();
          setPairStatus(
            going.role === 'host'
              ? `${going.me} has left and the relay went with it. Reload both tabs to start again.`
              : `${going.me} has left. The other tab is still holding the relay.`,
          );
        })
        .catch((error: unknown) => {
          /* Loud, and not only on the console. A teardown that throws is the
             failure this control exists to expose, so it goes where the reader
             and the harness both read. */
          setPairStatus(
            `This tab could not close cleanly. The SDK reported: ` +
              `“${error instanceof Error ? error.message : String(error)}”`,
          );
        });
    });

    /* The other tab finds out this one has gone, rather than holding a label
       for a device that is not there any more. */
    window.addEventListener('pagehide', () => presence?.close());

    /* ------------------------------------------------------------- typing --- */

    const submit = async () => {
      const text = input.value.trim();
      if (text.length === 0) {
        setStatus('Type something first.');
        input.focus();
        return;
      }
      if (inFlight) return;

      inFlight = true;
      send.disabled = true;
      try {
        if (paired) {
          setStatus('Encrypting, and handing the envelope to the relay…');
          const conversation = paired;
          await conversation.send(text);
          established();
          /* Back to this tab's own point of view, which the last thing it
             received may have turned around. */
          face('out');
          ratcheted();
          stage('encrypted');
          stage('in-transit');
          stage('stored-at-relay');
          input.value = '';
          setStatus(`The relay is holding it for ${conversation.peer}.`);
          claim.hidden = false;
        } else {
          setStatus(session ? 'Encrypting…' : 'Loading the SDK…');
          const ready = await boot();
          const exchange = await ready.send(text);
          render(exchange);
          reportRun();
          /* Emptied on the way out, the way the paired branch does it. It used
             not to be, so "type another and press it again" appended the next
             sentence to the one still sitting in the box — and the panel then
             printed a round trip for the two of them run together. */
          input.value = '';
          setStatus('Sent. Type another and press it again.');
        }
      } catch (cause: unknown) {
        /* `fallBack` has already run for the solo failures that reach here. A
           paired send has no recording to fall back to — the other tab is the
           other half of it — so it says what went wrong and stays where it is. */
        if (paired) {
          /* Quoted and attributed rather than spoken. It is the SDK's sentence,
             in the SDK's vocabulary, and a reader has to be able to tell that
             from the page's own lines around it. */
          setStatus(
            `That send did not go through. The SDK reported: ` +
              `“${cause instanceof Error ? cause.message : String(cause)}”`,
          );
        }
      } finally {
        inFlight = false;
        send.disabled = false;
      }
    };

    send.addEventListener('click', submit);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        void submit();
      }
    });

    /*
     * The tab that was opened by the press in the other one.
     *
     * Read once, from the fragment the page loaded with, and never from a
     * `hashchange`. Every other link to this band uses `#demo`, and a listener
     * would turn any of them into a 713 KB import for a reader who only
     * followed an anchor.
     */
    if (window.location.hash === `#${panel.dataset.pairFragment ?? ''}`) {
      panel.scrollIntoView({ block: 'center' });
      void join();
    }
  }
</script>
