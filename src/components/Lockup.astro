---
import Mark from './Mark.astro';

interface Props {
  /**
   * The product line turns the horizontal lockup into the product lockup.
   * Product names are typography beside the organization identity; they never
   * get a mark of their own.
   */
  product?: string;
  size?: number;
  class?: string;
}

const { product, size = 16, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-[0.437em] text-[length:var(--oe-chrome-lockup-size)] leading-none text-text-1',
    '[&_.oe-mark]:h-[1.3em] [&_.oe-mark]:w-[1.3em] [&_.oe-mark]:min-h-4 [&_.oe-mark]:min-w-4 [&_.oe-mark]:flex-none [&_.oe-mark]:translate-y-[0.161em]',
    product && 'flex-col items-start gap-[0.4em]',
    className,
  ]}
>
  <span style="display: inline-flex; align-items: baseline; gap: 0.4875em;">
    <Mark size={size} lockup />
    <span class="oe-wordmark"><span>Open</span><span>E2EE</span></span>
  </span>
  {product && (
    <span
      class="font-[family-name:var(--oe-heading-font-family)] text-[0.62em] font-medium tracking-[0.01em] text-text-3"
      >{product}</span
    >
  )}
</span>
