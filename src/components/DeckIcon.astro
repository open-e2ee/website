---
/*
 * The icon that labels one row of the homepage deck.
 *
 * Octicons 19.32.0 (MIT, GitHub Inc.), the same family the header chrome draws
 * from, at the 24-unit master rather than the 16 — these sit at 2rem beside a
 * heading, and the 16 masters are drawn for 16 and thicken visibly when scaled.
 * The licence text ships at `third-party/Octicons-MIT.txt` and
 * `THIRD_PARTY_NOTICES.md` names every path this site inlines, these seven
 * included. A test fails the build if a name here is missing from that list.
 *
 * The paths live here rather than in `@open-e2ee/design/icons`, which is where
 * `Icon.astro` correctly says an icon set belongs. These seven label one deck on
 * one page and have not earned a place in a package two products pin; if a
 * second surface needs them, they move there and this file imports them like
 * the chrome does.
 *
 * These are labels, not diagrams. DESIGN.md's material law — open is outlined,
 * opaque is filled — governs what a shape means inside a diagram, and a filled
 * lock beside a heading that already says "ciphertext" is not making a second,
 * quieter claim about encryption. The drawings that do carry meaning are in
 * `src/components/diagrams/`, at the scale that vocabulary needs.
 *
 * Every icon is aria-hidden, because the heading beside it is the row's name.
 */
export type DeckIconName =
  | 'devices'
  | 'key'
  | 'server'
  | 'package'
  | 'search'
  | 'law'
  | 'lock';

interface Props {
  name: DeckIconName;
}

const { name } = Astro.props;

