---
/*
 * Two rows, identical infrastructure, one difference: what the middle box is.
 *
 * The top row is TLS. It has four trust boundaries because TLS terminates at
 * the server, so the message is opened there and re-sealed on the way out —
 * and the middle is therefore drawn as an open outlined form with readable
 * content bars. The bottom row is end-to-end encryption: two boundaries, and
 * the middle is the relay container, holding sealed slabs it routes without
 * ever needing their plaintext.
 *
 * The boundary rules used to run from 18 units above each row to 24 below it,
 * which put them through the labels at both ends: measured, the rule at x=310
 * crossed the word "open" above it and the 265-unit row label below it, and six
 * more crossings like it stood in the same figure. The rules now start below the
 * words that name them and stop above the words that name the boxes, so a rule
 * marks a gutter rather than striking out a caption.
 *
 * The devices, envelopes and boundary positions are pinned to the same x
 * coordinates in both rows so the only thing the eye can compare is the middle.
 */

import {
  CIPHERTEXT_FILL,
  CONTENT_BAR_FILL,
  PLAINTEXT_STROKE,
  STROKE_WIDTH,
  contentBarRects,
  deviceOutline,
  keySilhouettePath,
  slabPath,
} from '@open-e2ee/design/diagram';
import { relayContainer } from '../../lib/relay-form.mjs';

const DEVICE_WIDTH = 150;
const DEVICE_HEIGHT = 100;
const DEVICE_LEFT_X = 20;
const DEVICE_RIGHT_X = 680;

const ENVELOPE_ONE_X = 222;
const ENVELOPE_TWO_X = 534;
const ENVELOPE_WIDTH = 56;
const SHEAR = 8;

const MIDDLE_X = 330;
const MIDDLE_WIDTH = 170;

/* The device labels start at their box's left edge, but the middle label is
   the long one in both rows — naming what the middle holds runs it into the
   right-hand device's label. Centered under the box it names instead, in both
   rows, so the two rows stay the same drawing apart from the middle. */
const MIDDLE_LABEL_X = MIDDLE_X + MIDDLE_WIDTH / 2;

/* Row origins: the y of each row's device top edge. */
const rows = [
  { top: 72, boundaries: [200, 310, 520, 640] },
  { top: 272, boundaries: [200, 640] },
];

/* The rule stands between the boundary label above the row and the box label
   below it. 16 above the box edge clears a 12px word whose baseline sits 28
   higher; 104 below it stops 24 short of a 13px caption. */
const RULE_TOP = 16;
const RULE_BOTTOM = 104;
---

<svg viewBox="0 0 860 452" role="img" aria-labelledby="plaintext-title plaintext-desc">
  <title id="plaintext-title">
    Who holds readable plaintext under TLS, and who holds it under end-to-end encryption
  </title>
  <desc id="plaintext-desc">
    Two rows with the same devices, the same sealed envelopes in transit and the same middle
    position. In the top row, labeled TLS only, four dotted boundaries mark the message being
    sealed, opened at the server, re-sealed and opened again; the server is drawn as an open
    outlined box holding readable content, because it does. In the bottom row, labeled end-to-end
    encrypted, there are only two boundaries — one at each device — and the middle is a relay
    container holding two sealed slabs with metadata ticks above them, carrying envelopes it has no
    way to open.
  </desc>

  {rows.map((row) => (
    <g>
      {[DEVICE_LEFT_X, DEVICE_RIGHT_X].map((x) => (
        <g>
          <Fragment
            set:html={deviceOutline({ x, y: row.top, width: DEVICE_WIDTH, height: DEVICE_HEIGHT })}
          />
          {/* The key is the device's own: a device is the only form in this
              grammar that holds one. */}
          <path
            d={keySilhouettePath({ x: x + 18, y: row.top + 78, width: 44, height: 15 })}
            fill={PLAINTEXT_STROKE}
          />
        </g>
      ))}

      {row.boundaries.map((x) => (
        <line
          x1={x}
          y1={row.top - RULE_TOP}
          x2={x}
          y2={row.top + RULE_BOTTOM}
          stroke="var(--oe-diagram-boundary)"
          stroke-width={2}
          stroke-dasharray="2 6"
        />
      ))}

      {[ENVELOPE_ONE_X, ENVELOPE_TWO_X].map((x) => (
        <path
          d={slabPath({
            x,
            y: row.top + 8,
            width: ENVELOPE_WIDTH,
            height: 84,
            shear: SHEAR,
          })}
          fill={CIPHERTEXT_FILL}
        />
      ))}
    </g>
  ))}

  <text x={DEVICE_LEFT_X} y={40} class="diagram-label">TLS only</text>
  <text x={200} y={44} text-anchor="middle" class="diagram-boundary-label">seal</text>
  <text x={310} y={44} text-anchor="middle" class="diagram-boundary-label">open</text>
  <text x={520} y={44} text-anchor="middle" class="diagram-boundary-label">seal</text>
  <text x={640} y={44} text-anchor="middle" class="diagram-boundary-label">open</text>

  {/* The server is an open form holding solid bars. The bars used to be the
      device's own fill at 28% opacity, which draws content as partly readable —
      a state no encryption produces, and the one thing this row is drawn to
      deny about the row below it. */}
  <rect
    x={MIDDLE_X}
    y={72}
    width={MIDDLE_WIDTH}
    height={DEVICE_HEIGHT}
    fill="none"
    stroke={PLAINTEXT_STROKE}
    stroke-width={STROKE_WIDTH}
  />
  {contentBarRects({ x: MIDDLE_X + 20, y: 94, width: MIDDLE_WIDTH - 40 }).map((bar) => (
    <rect {...bar} fill={CONTENT_BAR_FILL} />
  ))}

  <text x={DEVICE_LEFT_X} y={196} class="diagram-label">device</text>
  <text x={MIDDLE_LABEL_X} y={196} text-anchor="middle" class="diagram-label">your server · reads every message</text>
  <text x={DEVICE_RIGHT_X} y={196} class="diagram-label">device</text>

  {/* The second row's heading sits 20 above the boundary labels rather than
      beside them. "TLS only" is 65 units wide and clears the first rule at
      x=200; "End-to-end encrypted" is 161, which ends 4 units short of the
      word "seal" on the same baseline and read as one run of text. */}
  <text x={DEVICE_LEFT_X} y={224} class="diagram-label">End-to-end encrypted</text>
  <text x={200} y={244} text-anchor="middle" class="diagram-boundary-label">seal</text>
  <text x={640} y={244} text-anchor="middle" class="diagram-boundary-label">open</text>

  <Fragment
    set:html={relayContainer({
      x: MIDDLE_X,
      y: 272,
      width: MIDDLE_WIDTH,
      height: DEVICE_HEIGHT,
      slabs: 2,
      ticks: 3,
    })}
  />

  <text x={DEVICE_LEFT_X} y={400} class="diagram-label">device</text>
  <text x={MIDDLE_LABEL_X} y={400} text-anchor="middle" class="diagram-label">your relay · carries, never needs plaintext</text>
  <text x={DEVICE_RIGHT_X} y={400} class="diagram-label">device</text>
  <text x={MIDDLE_X} y={424} class="diagram-tick-label">metadata still visible</text>
</svg>
