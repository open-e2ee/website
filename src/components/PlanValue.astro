---
/*
 * One value cell of a plan table, in either rendering. A figure prints as
 * itself. Three values are not figures: the em dash for a price that does not
 * exist, the same dash for a row a license does not carry, and the check for
 * a right a plan carries. Each shows its sign and gives a screen reader the
 * word. The check is in the color of a thing that
 * holds, the one place on the page that color appears.
 */
import Icon from './Icon.astro';
import { INCLUDED, INCLUDED_LABEL, NO_OVERAGE, NO_OVERAGE_LABEL, NOT_INCLUDED, NOT_INCLUDED_LABEL, NOT_INCLUDED_SIGN } from '../lib/plan-values.mjs';

interface Props {
  value: string;
}

const { value } = Astro.props;
---

{value === NO_OVERAGE ? <><span aria-hidden="true">{NO_OVERAGE}</span><span class="sr-only">{NO_OVERAGE_LABEL}</span></> : value === NOT_INCLUDED ? <><span aria-hidden="true">{NOT_INCLUDED_SIGN}</span><span class="sr-only">{NOT_INCLUDED_LABEL}</span></> : value === INCLUDED ? <><Icon name="check" class="text-success" /><span class="sr-only">{INCLUDED_LABEL}</span></> : value}
