---
import BaseLayout from './BaseLayout.astro';
import ArticleToc from '../components/ArticleToc.astro';
import { maturityLine } from '../lib/sdk.mjs';
import { BACK_LINK, LABEL, LEAD, MATURITY } from '../lib/recipes';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Neighbor {
  id: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  tags: string[];
  image?: string;
  headings: Heading[];
  readingMinutes: number;
  next?: Neighbor;
  previous?: Neighbor;
}

const {
  author,
  description,
  headings,
  image,
  next,
  previous,
  publishedAt,
  readingMinutes,
  tags,
  title,
  updatedAt,
} = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  /* content.config.ts coerces publishedAt to a UTC midnight Date. Without this,
   * Intl formats in the build machine's zone and every date west of Greenwich
   * renders one day early: the shipped cards read "Jul 24, 2026" beside a
   * datetime attribute of 2026-07-25. The same source built on a UTC runner
   * printed a different date, so this was also non-deterministic. */
  timeZone: 'UTC',
});
---

{/* Each article ships its own card, drawn by scripts/generate-blog-cards.mjs:
    the title, the publication date, the tags, the author, and the site
    address. `imageAlt` says what that card shows, because the default one
    describes the site-wide card this page does not use. */}
<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={`Social card for the article ${title}, on the OpenE2EE canvas.`}
  ogType="article"
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  author={author}
>
  {/*
    One grid for the whole article, so the header, the contents, the prose, and
    the furniture sit on the same column rather than each carrying its own
    wrapper and its own idea of the measure. src/styles/article.css names the
    lines.
  */}
  <article class="oe-article">
    <header class="oe-article-header">
      <a class={BACK_LINK} href="/blog">Engineering journal</a>
      <p class={LABEL}>{tags.join(' · ')}</p>
      <h1>{title}</h1>
      <p class={LEAD}>{description}</p>
      <p class="oe-article-meta">
        <span>{author}</span>
        <time datetime={publishedAt.toISOString()}>{dateFormatter.format(publishedAt)}</time>
        {updatedAt && <span>Updated {dateFormatter.format(updatedAt)}</span>}
        <span>{readingMinutes} min read</span>
      </p>
    </header>

    <ArticleToc headings={headings} />

    <div class="prose">
      <slot />
    </div>

    <footer class="oe-article-footer">
      {
        (previous || next) && (
          <nav class="oe-article-neighbors" aria-label="More from the journal">
            {previous && (
              <div class="oe-article-neighbor">
                <a href={`/blog/${previous.id}/`}>
                  <span class="oe-article-neighbor-label">Older</span>
                  <span class="oe-article-neighbor-title">{previous.title}</span>
                </a>
              </div>
            )}
            {next && (
              <div class="oe-article-neighbor oe-article-neighbor-next">
                <a href={`/blog/${next.id}/`}>
                  <span class="oe-article-neighbor-label">Newer</span>
                  <span class="oe-article-neighbor-title">{next.title}</span>
                </a>
              </div>
            )}
          </nav>
        )
      }
      {/*
        A standing disclosure, rendered once per post rather than typed into
        post bodies. It was in two of the three: the Expo post closed on a
        paraphrase of the audit formula, the TLS post carried the maturity half
        mid-article after an install block, and the architecture post carried
        neither. messaging.md §7 requires the audit sentence everywhere audit
        status arises, and every post asks a reader to trust SDK behavior, so
        the gap was on the two posts rather than the one.

        The version composes from src/lib/sdk.mjs. A typed literal here would go
        stale on the next release and tests/site-content.test.mjs forbids one.
      */}
      <p class={MATURITY}>
        <code>@open-e2ee/signal-protocol-sdk</code> {maturityLine} Reviewed continuously by
        adversarial AI agents; not audited by any independent firm.
      </p>
    </footer>
  </article>
</BaseLayout>
