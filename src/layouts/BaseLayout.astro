---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  /** `article` on blog posts so shares render as writing rather than a product page. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
}

const {
  title,
  description,
  image = '/brand/social/open-e2ee-design-og.png',
  canonical = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;
const siteTitle = title === 'OpenE2EE' ? title : `${title} · OpenE2EE`;
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script src="/theme-init.js" is:inline></script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090806" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:site_name" content="OpenE2EE" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="OpenE2EE — Engineering journal"
      href="/rss.xml"
    />
    <link rel="icon" href="/brand/open-e2ee-favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/brand/png/32/open-e2ee-mark-light.png" sizes="32x32" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {/* Deferred and external: nothing here should compete with the page, and
        the CSP is script-src 'self' with no 'unsafe-inline'. */}
    <script src="/measure.js" defer></script>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
