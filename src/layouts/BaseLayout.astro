---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/*
 * The one face that is on every page, in every heading, from the first paint.
 *
 * Without this the browser cannot know the font exists until it has fetched
 * and parsed the stylesheet, so the request that decides when text stops
 * swapping starts a round trip late. Vite resolves the `?url` import to the
 * emitted, hashed asset, which is why the hint cannot drift from what the
 * @font-face rule in `@open-e2ee/design/fonts.css` actually loads.
 *
 * Only this face. The other two subsets of Public Sans, Newsreader, and
 * JetBrains Mono are correctly left to the stylesheet: `unicode-range` on the
 * generated @font-face rules already stops the browser fetching a face no
 * text on the page needs, and preloading a font a page does not use costs
 * bandwidth on the critical path to save nothing.
 */
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  /** `article` on blog posts so shares render as writing rather than a product page. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
}

const {
  title,
  description,
  image = '/brand/social/open-e2ee-website-og.png',
  canonical = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;
const siteTitle = title === 'OpenE2EE' ? title : `${title} · OpenE2EE`;
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* `initial-scale=1` is not decoration. Without it a phone is free to
        shrink the whole page to fit its widest element, so an overflow defect
        renders as a silently zoomed-out page instead of a sideways scroll.
        This site had one: while the diagram briefly painted its 512 px wide
        composition on a phone, Chrome reported a 528 px viewport at a 390 px
        device and `scrollWidth > innerWidth` stayed false — the overflow check
        passed on a page rendering at about three quarters size. Pinning the
        initial scale makes overflow visible to the reader and measurable here.
        Nothing caps `maximum-scale` or sets `user-scalable=no`; pinch zoom is
        untouched. */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {/* The colour a phone paints its status bar with, and it has to be the
        canvas the header is actually sitting on. These two are the no-script
        fallback and they answer the system preference; `theme-init.js` rewrites
        both to the resolved canvas before first paint, because the site's own
        switch can put a dark page under a light system — which painted a cream
        strip above a dark header on an iPhone, read as a gap in the page.

        The dark value was `#090806` here, which is the light theme's
        foreground rather than the dark theme's canvas. It was close enough to
        black to look intentional and 5% off the surface it was meant to
        match. A test holds both to `--oe-canvas` in the installed tokens. */}
    <meta name="theme-color" content="#faf7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0e0b" media="(prefers-color-scheme: dark)" />
    {/* After the tags it rewrites, and still before first paint: a blocking
        script in the head runs where it stands, so from above them it would
        query a head the parser has not reached yet. */}
    <script src="/theme-init.js" is:inline></script>
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:site_name" content="OpenE2EE" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="OpenE2EE — Engineering journal"
      href="/rss.xml"
    />
    <link rel="icon" href="/brand/open-e2ee-favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/brand/png/32/open-e2ee-mark-light.png" sizes="32x32" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {/* Deferred and external: nothing here should compete with the page, and
        the CSP is script-src 'self' with no 'unsafe-inline'. */}
    <script src="/measure.js" defer></script>
    <Header />
    {/* `tabindex="-1"` is what makes the skip link land. Without it the URL
        fragment moves the scroll position but not the focus ring, so the next
        Tab resumes in the header the link was pressed to escape. */}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
